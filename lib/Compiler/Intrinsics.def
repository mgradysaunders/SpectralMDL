// Table of every SMDL intrinsic, in the form
//
//     SMDL_INTRINSIC(Enumerator, "sourceSpelling")
//
// This is the single registry: it generates the 'IntrinsicID' enumeration,
// the name lookup, and the reverse mapping used in diagnostics. Adding an
// intrinsic means adding a line here and a 'case' in
// 'Emitter::emitIntrinsic()'; the switch is exhaustive over 'IntrinsicID', so
// the compiler reports the missing case.
//
// The enumerator is the spelling with a capitalized first letter. It is kept
// separate rather than derived so that spellings which collide with standard
// macros ('assert', and 'min'/'max' on Windows) cannot be substituted.
#ifndef SMDL_INTRINSIC
#error "SMDL_INTRINSIC(Enumerator, Spelling) must be defined"
#endif

SMDL_INTRINSIC(Abs,                       "abs")
SMDL_INTRINSIC(Acos,                      "acos")
SMDL_INTRINSIC(AlbedoLUT,                 "albedoLUT")
SMDL_INTRINSIC(AlignOf,                   "alignOf")
SMDL_INTRINSIC(All,                       "all")
SMDL_INTRINSIC(Any,                       "any")
