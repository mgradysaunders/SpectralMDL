//--{ simple_glossy_bsdf
@(pure) float integrateSimpleGlossyBSDF(float cosTheta, float roughness) {
  cosTheta = #max(cosTheta, 0.0001);
  cosTheta = #min(cosTheta, 0.9999);
  const float3 wo = float3(#sqrt(1 - cosTheta * cosTheta), 0, cosTheta);
  const float alpha(roughness * roughness);
  const float e(2 / (alpha * alpha + EPSILON));
  return integrateAlbedo(1024 * 512, \(const float2 xi) {
    const float3 wm = math::normalize(df::microfacet::blinn_normal_sample(xi.x, xi.y, float2(e)));
    const float3 wi = math::normalize(df::specular::reflect(wo, wm));
    const float dotWoWm = math::dot(wo, wm);
    return wi.z > 0 && dotWoWm > 0 ? (2 + e) / (1 + e) * #min(1, 2 * wm.z * #min(wo.z, wi.z) / dotWoWm) * dotWoWm : 0.0;
  }) / wo.z;
}
//--}

//--{ microfacet_ggx_smith_bsdf, microfacet_beckmann_smith_bsdf
@(pure) float integrateMicrofacetSmith(const df::microfacet::distribution distribution, float cosTheta, float roughness) {
  cosTheta = #max(cosTheta, 0.0001);
  cosTheta = #min(cosTheta, 0.9999);
  const float3 wo = float3(#sqrt(1 - cosTheta * cosTheta), 0, cosTheta);
  const float2 alpha = float2(#max(roughness * roughness, 1e-6));
  return integrateAlbedo(1024 * 512, \(const float2 xi) {
    const float3 wm = math::normalize(df::microfacet::smith_visible_normal_sample(distribution, xi.x, xi.y, alpha, wo));
    const float3 wi = math::normalize(df::specular::reflect(wo, wm));
    if (wi.z > 0) {
      // `1 + Lambda(w)` through the projected area, which avoids the
      // ratio `cos(theta) / |alpha w.xy|` that is singular for a
      // direction exactly on the macro normal.
      const float onePlusLambdao = df::microfacet::smith_projected_area(distribution, alpha, wo) / #abs(wo.z);
      const float onePlusLambdai = df::microfacet::smith_projected_area(distribution, alpha, wi) / #abs(wi.z);
      return onePlusLambdao / (onePlusLambdao + onePlusLambdai - 1);
    }
    return 0.0;
  });
}
//--}

//--{ ward_geisler_moroder_bsdf
@(pure) float integrateWardGeislerMoroderBSDF(float cosTheta, float roughness) {
  cosTheta = #max(cosTheta, 0.0001);
  cosTheta = #min(cosTheta, 0.9999);
  const float3 wo = float3(#sqrt(1 - cosTheta * cosTheta), 0, cosTheta);
  const float alpha(#max(0.001, roughness * roughness));
  return integrateAlbedo(1024 * 512, \(const float2 xi) {
    const auto phi(#atan2(alpha * #sin(t := $TWO_PI * xi.x), alpha * #cos(t)));
    const auto cosPhi(#cos(phi));
    const auto sinPhi(#sin(phi));
    const auto theta(#atan(#sqrt(-#log(1 - xi.y) / (#pow(cosPhi / alpha, 2) + #pow(sinPhi / alpha, 2)))));
    const auto wm(float3(#sin(theta) * float2(cosPhi, sinPhi), #cos(theta)));
    const auto wi(math::normalize(df::specular::reflect(wo, wm)));
    return wi.z > 0 ? 2 * wi.z / (wo.z + wi.z) : 0.0;
  });
}
//--}

exec {
  /* #tabulateAlbedo("diffuse_reflection_bsdf", 64, 64, integrateDiffuseReflectionBSDF); */
  /* #tabulateAlbedo("sheen_bsdf", 64, 64, integrateSheenBSDF); */
  #tabulateAlbedo("simple_glossy_bsdf", 64, 64, integrateSimpleGlossyBSDF);
  #tabulateAlbedo(
    "microfacet_ggx_smith_bsdf", 64, 64,
    \(const float cosTheta, const float roughness) = integrateMicrofacetSmith(df::microfacet::ggx(), cosTheta, roughness));
  #tabulateAlbedo(
    "microfacet_beckmann_smith_bsdf", 64, 64,
    \(const float cosTheta, const float roughness) = integrateMicrofacetSmith(df::microfacet::beckmann(), cosTheta, roughness));
  #tabulateAlbedo("ward_geisler_moroder_bsdf", 64, 64, integrateWardGeislerMoroderBSDF);
}
