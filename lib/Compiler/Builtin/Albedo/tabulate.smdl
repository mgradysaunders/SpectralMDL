// vim:foldmethod=marker:foldlevel=0:fmr=--{,--}
/// The offline generator of the directional albedo tables in this
/// directory, which the multiscatter compensation in `df.smdl` looks up
/// through `#albedoLUT`. Each BSDF is numerically integrated over a 64 by
/// 64 grid of view angle cosine and roughness, and the `exec` block at the
/// bottom writes the results out as the `.inl` files.
///
/// NOTE: This module is not embedded in the compiler and is not built
/// with the others. Run it by hand with `smdl` when a BSDF changes in a
/// way that invalidates its table.
#smdl

import ::df::*;
import ::math::*;
using sampling = ::extras::sampling;
import sampling::*;

const float EPSILON = 1e-6;

//--{ Integration skeleton
/// The average of `sample(xi)` over `numSamples` points of a
/// low-discrepancy sequence, returned as a `double` so the caller controls
/// the final rounding of any scaling applied on top.
@(pure macro)
double integrateAlbedo(const int numSamples, const auto sample) {
  float2 xi = float2(0.713, 0.489);
  double fSum = 0;
  for (int i = 0; i < numSamples; i++, sampling::next_low_discrepancy(&xi)) {
    fSum += sample(xi);
  }
  return fSum / numSamples;
}
//--}

