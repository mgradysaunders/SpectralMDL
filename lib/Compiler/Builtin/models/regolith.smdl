// smdl format on

/// Evaluate the regolith albedo model, mapping eleven normalized parameters
/// to a reflectance spectrum.
///
/// The 12 component curves in `REGOLITH_TABLE_CURVES` are interpolated onto
/// `$state.wavelength_base` and combined with weights derived from the
/// parameters: iron and aridity are polar coordinates onto the two pigment
/// curves, and moisture sensitivity acts only through its product with
/// moisture. The logistic link keeps every output strictly in (0, 1),
/// including at the extrapolated corners of the parameter box. RMSE ~1e-3
/// against the full-resolution fit.
///
/// Valid from 400nm to 2500nm; wavelengths outside clamp to the nearest end.
///
/// The parameters may also be kept in an 11-component vector in the order
/// below and expanded into the call with the call-site `inline` keyword,
/// which is the idiom for barycentric preset mixing.
///
@(noinline)
export color regolith_albedo(
  const float base = 0.5,        ///< The overall reflectance level of the parent material. 0 = darkest, 1 = brightest.
  const float fineness = 0.5,    ///< The particle-size axis. Finer material brightens the VIS/NIR and lowers the SWIR, pivoting near 1.2um.
  const float organic = 0.5,     ///< The organic-matter load. Darkens at every wavelength, strongest in the visible.
  const float iron = 0.5,        ///< The iron-oxide pigment load. 0 = neutral gray, 1 = maximally pigmented.
  const float aridity = 0.5,     ///< The hematite:goethite balance of the pigment. 0 = cool/moist goethite-yellow, 1 = hot/dry hematite-red.
  const float phyllo = 0.5,      ///< The phyllosilicate (clay mineral) content, carving the 2.2um Al-OH absorption.
  const float hydrous = 0.5,     ///< The bound-water (hydration) band depth, most visible at 1.4um and 1.9um.
  const float ferrous = 0.5,     ///< The ferrous-iron (Fe2+) absorption near 1um, typical of unoxidized mafic minerals.
  const float unstained = 0.5,   ///< The stain-free vs. stained/coated surface axis: lifts the blue end and lowers the red edge, inert past ~700nm.
  const float moisture = 0.0,    ///< The moisture darkening. 0 = bone dry, 1 = the darkest saturated state in the corpus.
  const float moisture_sensitivity = 0.5, ///< How strongly moisture darkens this material; acts only through the product with `moisture`.
) {
  // Parameter to logit-space weights, each affine on its clamped [0, 1] axis
  // except the pigment pair: iron is the radius and aridity the angle of a
  // polar parameterization, so the pigment load and its hematite:goethite hue
  // vary independently. Assembly is linear, so combining the component curves
  // at the entries and interpolating equals interpolating then combining.
  const float wBase = -1.9334647 + saturate(base) * 3.82128093;
  const float wFineness = -0.771195433 + saturate(fineness) * 1.47958768;
  const float wOrganic = -1.52287876 + saturate(organic) * 2.45108859;
  const float pigment = saturate(iron) * 37.7429834;
  const float hue = 0.0863341967 + saturate(aridity) * 0.665630234; // radians
  const float wPhyllo = saturate(phyllo) * 0.55782978;
  const float wHydrous = -0.079147908 + saturate(hydrous) * 0.374074132;
  const float wFerrous = saturate(ferrous) * 0.57688462;
  const float wUnstained = saturate(unstained) * 0.83533401;
  const float wWater = saturate(moisture) * 1.28826562;
  const float wSensitivity = -0.392247964 + saturate(moisture_sensitivity) * 0.667877052;
  const auto weights = auto(
    1.0, wBase, wFineness, wOrganic, pigment * #sin(hue), pigment * #cos(hue),
    wPhyllo, wHydrous, wFerrous, wUnstained, wWater, wWater * wSensitivity);
  return _spectralInit(\(const float wavelength) {
    const auto {t0, t} = _uniformLerpIndexAndFraction(REGOLITH_TABLE_SIZE, REGOLITH_MIN_WAVELENGTH, REGOLITH_MAX_WAVELENGTH, wavelength);
    return link(dot(lerp(REGOLITH_TABLE_CURVES[t0], REGOLITH_TABLE_CURVES[t0 + 1], t), weights));
  });
}

// BEGIN GENERATED PRESETS
// Each constant is one measured specimen at its own fitted
// coordinates, in the parameter order of `regolith_albedo`.
// 58 presets; every one reconstructs its own measurement
// within 1.5 dE. Quoted reflectance ranges are over
// 400-700 nm.
// smdl format off

