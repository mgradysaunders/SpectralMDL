// smdl format on

// The five monotone parameter warps, endpoint-constrained cubic fits to the
// 65-entry warp tables of the C++ reference: u(0) = 0 and u(1) = 1 exactly,
// strictly increasing on [0, 1], within 9.4e-4 of the tables everywhere,
// which is inside the fit's own downsampling noise.
static const auto WARP_BASE = float2(0.09271134, -0.4264215);
static const auto WARP_TANNIN = float2(-0.10436588, -0.04969672);
static const auto WARP_FIBRE = float2(0.063141525, -0.085354604);
static const auto WARP_EPIPHYTE = float2(-0.008220836, -0.0137877185);
static const auto WARP_WATER = float2(-0.09495192, -0.22414328);

// Warp a parameter onto its fit coordinate. The saturate is what implements
// the parameter box: the endpoint-constrained polynomial extrapolates
// instead of clamping on its own.
@(pure macro)
float warp(const float p, const float2 c) {
  const float x = saturate(p);
  return x + x * (1.0 - x) * (c[0] + c[1] * x);
}

/// Evaluate the woody albedo model, mapping five normalized parameters to a
/// reflectance spectrum.
///
/// The 6 component curves in `WOODY_TABLE_CURVES` are interpolated onto
/// `$state.wavelength_base` and combined with weights derived from the
/// parameters, each passing through a monotone cubic warp and an affine map
/// onto its fit coordinate. The logistic link keeps every output strictly in
/// (0, 1) at every point of the parameter box. RMSE ~1e-3 against the
/// full-resolution fit.
///
/// Valid from 400nm to 2500nm; wavelengths outside clamp to the nearest end.
///
/// The parameters may also be kept in a 5-component vector in the order below
/// and expanded into the call with the call-site `inline` keyword, which is
/// the idiom for barycentric preset mixing.
///
@(noinline)
export color woody_albedo(
  const float base = 0.5,     ///< The overall lightness of the wood. 0 = darkest, 1 = brightest.
  const float tannin = 0.5,   ///< The tannin pigmentation. 0 = neutral gray, 1 = the most saturated warm brown. Inert past ~1.3um.
  const float fibre = 0.5,    ///< The exposed-fibre axis. Brightens at every wavelength.
  const float epiphyte = 0.5, ///< The green epiphytic cover (algae, moss, lichen).
  const float water = 0.0,    ///< The moisture darkening. 0 = bone dry, 1 = the darkest saturated state in the corpus.
) {
  // Parameter to logit-space weights: each parameter passes through its
  // monotone warp (which saturates to the box) and an affine map. Assembly is
  // linear, so combining the component curves at the entries and interpolating
  // equals interpolating then combining.
  const float wLightness = 31.3152562 + warp(base, WARP_BASE) * 44.9022237;
  const float wChroma = warp(tannin, WARP_TANNIN) * 24.5823726;
  const float wFibre = -0.307246553 + warp(fibre, WARP_FIBRE) * 0.540344935;
  const float wGreen = warp(epiphyte, WARP_EPIPHYTE) * 0.422861915;
  const float wWater = warp(water, WARP_WATER) * 1.28826562;
  const auto weights = auto(1.0, wLightness, wChroma, wFibre, wGreen, wWater);
  return _spectralInit(\(const float wavelength) {
    const auto {t0, t} = _uniformLerpIndexAndFraction(WOODY_TABLE_SIZE, WOODY_MIN_WAVELENGTH, WOODY_MAX_WAVELENGTH, wavelength);
    return link(dot(lerp(WOODY_TABLE_CURVES[t0], WOODY_TABLE_CURVES[t0 + 1], t), weights));
  });
}

// BEGIN GENERATED PRESETS
// 11 measured specimens at their own fitted coordinates,
// in the parameter order of `woody_albedo`, plus 2 derived
// vectors marked as such. Every measured preset reconstructs its
// own spectrum within 4.90 dE -- this corpus's replicate
// floor, which is how much two pieces of one trunk disagree.
// Quoted reflectance ranges are over 400-700 nm.
// smdl format off

// ---- bark and branches ---------------------------------------------------

/// Pale smooth periderm of paper birch (ECOSTRESS, Betula papyrifera, bark,
/// header records lichen and moss). sRGB D65 #c2bdb3, pale warm grey;
/// 42-58% VIS.
export const auto WOODY_PRESET_BIRCH_BARK = auto(
  1.0, 0.282, 0.733, 0.39, 0.116);

/// Fibrous incense-cedar bark (ECOSTRESS, Calocedrus decurrens, bark). sRGB
/// D65 #8d7966, warm brown; 11-35% VIS.
export const auto WOODY_PRESET_CEDAR_BARK = auto(
  0.483, 0.587, 1.0, 0.298, 0.277);

/// Plated ponderosa pine bark (ECOSTRESS, Pinus ponderosa, bark). sRGB D65
/// #777068, warm grey; 13-22% VIS.
export const auto WOODY_PRESET_PONDEROSA_BARK = auto(
  0.386, 0.235, 0.868, 0.235, 0.225);

/// Dark furrowed conifer bark (ECOSTRESS, Pinus lambertiana, bark). sRGB
/// D65 #61554b, dark greyish warm brown; 6-16% VIS. Medoid of 8 spectra
/// over 4 taxa; also stands for Abies concolor, Pinus strobus, Pinus
/// coulteri, all within the corpus's 4.90 dE replicate floor of it.
export const auto WOODY_PRESET_PINE_BARK = auto(
  0.134, 0.387, 0.858, 0.192, 0.311);

/// Lichened red-oak bark (ECOSTRESS, Quercus rubra, bark, header records
/// lichen and moss). sRGB D65 #615c4f, dark greyish olive brown; 6-14% VIS.
export const auto WOODY_PRESET_OAK_BARK = auto(
