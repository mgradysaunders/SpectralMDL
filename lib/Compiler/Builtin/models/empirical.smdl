/// Empirical albedo models: standalone parametric reflectance spectra fitted
/// directly to measured data, in contrast to the physically based models in
/// the sibling modules. Every model here works the same way: tabulated
/// logit-space component curves are combined linearly per wavelength with
/// weights derived from a few normalized [0, 1] parameters, and the logistic
/// link maps the result back to a reflectance, so every output is strictly
/// inside (0, 1) by construction.
#smdl

using ::math import *;

// The logistic link, mapping a logit-space value back to (0, 1).
@(pure macro)
auto logit(const auto x) = 1.0 / (1.0 + #exp(-x));

/// The minimum wavelength of the soil albedo table in nanometers.
export const float SOIL_MIN_WAVELENGTH = 400.0;
/// The maximum wavelength of the soil albedo table in nanometers.
export const float SOIL_MAX_WAVELENGTH = 2298.0;
/// The number of knots in the soil albedo table.
export const int SOIL_TABLE_SIZE = 261;

// smdl format off
