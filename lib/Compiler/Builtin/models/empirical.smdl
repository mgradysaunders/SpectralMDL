// smdl format on

/// Evaluate the empirical soil albedo model, mapping four normalized
/// pedogenic parameters to a dry-state reflectance spectrum.
///
/// The 6 component curves in `SOIL_CURVES` are interpolated onto
/// `$state.wavelength_base` and combined with weights derived from the
/// parameters; the conversion to the underlying lightness/chroma/redness
/// color parameterization happens internally, and the logistic link keeps
/// every output strictly in (0, 1). Max reflectance error vs. the
/// full-resolution model is ~5e-3.
///
/// Valid from 400nm to 2298nm; wavelengths outside clamp to the nearest end.
@(noinline)
export color soil_albedo(
  const float humus = 0.5,    ///< The humus content. 0 = pale quartz/carbonate (~40% VIS), 1 = dark topsoil (~6% VIS).
  const float iron = 0.5,     ///< The iron-pigment load. 0 = gray, 1 = maximally pigmented.
  const float aridity = 0.5,  ///< The hematite:goethite balance. 0 = cool/moist goethite-yellow, 1 = hot/dry hematite-red.
  const float moisture = 0.0, ///< The moisture darkening. 0 = bone dry, 1 = the darkest wet state the soil reaches.
) {
  const float h = saturate(humus);
  const float fe = saturate(iron);
  const float ar = saturate(aridity);
  const float m = saturate(moisture);
  // Pedogenic -> color. This is a bijection of the color parameters onto
  // cause, so the pale end member and the fully-developed soils reach exactly
  // the same spectra as the underlying color parameterization.
  const float lightness = 1.0 - h;
  const float chroma = #pow(fe, #exp(0.45 * (h - 0.5) - 0.55 * (ar - 0.5)));
  const float redness = ar;
  // Logit-space weights. Assembly is linear, so combining the component
  // curves at the knots and interpolating equals interpolating each component
  // then combining.
  const float l = lerp(-1.138774, -0.2968323, lightness);
  const float c = lerp(-0.04893016, 0.0518981, chroma);
  const float r = redness <= 0.5 ? +0.01466600 * (1.0 - 2.0 * redness) : -0.02271506 * (2.0 * redness - 1.0);
  // Perceptual moisture warp, pinned g(0)=0, g(1)=1, so CIE L* darkens at a roughly
  // constant rate as moisture rises.
  const float w = 1.04202 * (((3.89536 * m - 6.037163) * m + 3.081546) * m + 0.06025699) * m;
  const auto weights = auto(1.0, l, c, r, w, w * w);
  color result(0);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    const auto {t0, t} = _uniform_lerp_index_and_fraction(
      SOIL_TABLE_SIZE,
      SOIL_MIN_WAVELENGTH,
      SOIL_MAX_WAVELENGTH,
      $state.wavelength_base[i],
    );
    result[i] = logit(dot(lerp(SOIL_CURVES[t0], SOIL_CURVES[t0 + 1], t), weights));
  }
  return result;
}

/// The minimum wavelength of the asphalt/brick albedo table in nanometers.
export const float ASPHALT_BRICK_MIN_WAVELENGTH = 400.0;
/// The maximum wavelength of the asphalt/brick albedo table in nanometers.
export const float ASPHALT_BRICK_MAX_WAVELENGTH = 2438.0;
/// The number of knots in the asphalt/brick albedo table.
export const int ASPHALT_BRICK_TABLE_SIZE = 96;

