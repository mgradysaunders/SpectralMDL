// smdl format on

/// Evaluate the empirical asphalt/brick albedo model, mapping three normalized
/// parameters to a reflectance spectrum. Like `soil_albedo`, this is an
/// empirical fit (here to the asphalt and brick reflectance curves in the
/// USGS Spectral Library).
///
/// The 7 component curves in `ASPHALT_BRICK_CURVES` are interpolated onto
/// `$state.wavelength_base` and combined with weights derived from the
/// parameters -- binder is first capped by brightness, so a bright material
/// cannot also be binder-rich -- and the logistic link keeps every output
/// strictly in (0, 1). Reflectance error vs. the full-resolution fit:
/// RMSE ~5e-4.
///
/// Valid from 400nm to 2438nm; wavelengths outside clamp to the nearest end.
@(noinline)
export color asphalt_brick_albedo(
  const float brightness = 0.5, ///< The overall reflectance level. 0 = darkest (~3% VIS), 1 = brightest (~47% VIS).
  const float iron = 0.5,       ///< The iron-oxide pigment load. 0 = neutral gray, 1 = maximally red.
  const float binder = 0.5,     ///< The asphalt-binder axis, internally capped by brightness. 0 = binder-free, 1 = binder-rich.
) {
  const float b = saturate(brightness);
  const float fe = saturate(iron);
  // Binder capped by brightness (a bright material cannot also be
  // binder-rich) then split into +/- half-axes about 0.5 so the fit shapes
  // the two ends of the binder axis independently.
  const float w = saturate(binder) * #min(1.0, 0.3 + #pow(1.0 - b, 2.1));
  const float bp = #max(2.0 * w - 1.0, 0.0);
  const float bm = #max(1.0 - 2.0 * w, 0.0);
  const auto weights = auto(1.0, b, fe, bp, bm, fe * fe, bp * bp);
  color result(0);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    const auto {t0, t} = _uniform_lerp_index_and_fraction(
      ASPHALT_BRICK_TABLE_SIZE,
      ASPHALT_BRICK_MIN_WAVELENGTH,
      ASPHALT_BRICK_MAX_WAVELENGTH,
      $state.wavelength_base[i],
    );
    result[i] = logit(dot(lerp(ASPHALT_BRICK_CURVES[t0], ASPHALT_BRICK_CURVES[t0 + 1], t), weights));
  }
  return result;
}
