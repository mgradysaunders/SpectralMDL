    float3(0.87465, 0.00004, 0.39997), float3(0.87549, 0.00003, 0.39069), float3(0.87626, 0.00006, 0.38171),
    float3(0.87676, 0.00004, 0.37342), float3(0.87714, 0.00006, 0.36523), float3(0.87859, 0.00006, 0.35675),
    float3(0.87952, 0.00009, 0.34897), float3(0.87958, 0.00003, 0.34187)));

/// The cosine-weighted average of the `R` column of `SHEEN_LTC_TABLE` per
/// roughness row, for multiscatter energy compensation.
static const auto SHEEN_LTC_AVERAGE_R = float[32](
  0.00000, 0.00000, 0.00026, 0.00149, 0.00379, 0.00706, 0.01137, 0.01684,
  0.02359, 0.03168, 0.04118, 0.05208, 0.06438, 0.07798, 0.09297, 0.10917,
  0.12663, 0.14516, 0.16462, 0.18485, 0.20591, 0.22761, 0.24971, 0.27224,
  0.29480, 0.31728, 0.33982, 0.36221, 0.38402, 0.40553, 0.42656, 0.44686);
// smdl format on

/// Bilinearly interpolate the sheen LTC table by roughness and view
/// cosine, returning `(aInv, bInv, R)`.
@(pure)
float3 sheenLTCFetch(const float roughness, const float mu) {
  float rowF(saturate(roughness) * 31);
  float colF(saturate(mu) * 31);
  const int ri(#min(int(rowF), 30));
  const int ci(#min(int(colF), 30));
  rowF -= ri;
  colF -= ci;
  return lerp(lerp(SHEEN_LTC_TABLE[ri + 0][ci + 0], SHEEN_LTC_TABLE[ri + 0][ci + 1], colF), lerp(SHEEN_LTC_TABLE[ri + 1][ci + 0], SHEEN_LTC_TABLE[ri + 1][ci + 1], colF), rowF);
}

/// The threshold on the inverse LTC transform coefficient `aInv` below
/// which the sheen fit is treated as degenerate (the low-roughness table
/// rows contain exact zeros). Sampling and the reported densities both
/// fall back to cosine-hemisphere sampling below it, so the threshold
/// must be shared exactly between `scatterEvaluate` and `scatterSample`.
const float SHEEN_LTC_AINV_MIN = 1e-6;

/// Evaluate the sheen LTC lobe shape: `sheenLTCEval` with its leading
/// clamped-cosine factor divided back out exactly, for callers that apply
/// a cosine of their own. The transformed length can only vanish together
/// with the numerator (a degenerate zero-albedo fit), so the division is
/// guarded by an exact branch rather than an epsilon.
@(pure)
float sheenLTCEvalShape(const float3 wiStd, const float aInv, const float bInv) {
  const float3 wiOrig(float3(aInv * wiStd.x + bInv * wiStd.z, aInv * wiStd.y, wiStd.z));
  const float len4((len2 := #sum(wiOrig * wiOrig)) * len2);
  return len4 > 0.0 ? (1 / $PI) * (aInv * aInv) / len4 : 0.0;
}

/// Evaluate the sheen LTC lobe: the normalized density over `wiStd` given
/// the coefficients fetched for the view direction, with `wiStd` rotated
/// into the frame where the view lies in the xz-plane. Includes the cosine
/// of the incoming direction by construction.
@(pure)
float sheenLTCEval(const float3 wiStd, const float aInv, const float bInv) {
  return #max(wiStd.z, 0.0) * sheenLTCEvalShape(wiStd, aInv, bInv);
}

/// The sheen BSDF for fabric-like grazing highlights, using the
/// multiple-scattering LTC sheen of Zeltner, Burley, and Chiang.
export struct sheen_bsdf: bsdf {
  /// The roughness.
  ///
  /// > Roughness coefficient. Range: `[0,inf)`, with `0` specifying pure
  /// > specular reflection.
  ///
  float roughness;

  /// The tint.
  ///
  /// > Scaling factor, defined as a color, multiplied by the
  /// > result of the distribution function.
  ///
  const $(color | float) tint = 1.0;

  /// The multiscatter tint.
  ///
  /// > Scaling factor, defined as a color, of the diffuse multiscattering
  /// > compensation, `color(0.0)` does not add any, `color(1.0)` fully
  /// > compensates the energy loss.
  ///
  /// NOTE: `none` means no multiscatter, matching the specification's
  /// `color(0.0)` default; see the module note.
  const $(?(color | float)) multiscatter_tint = none;

  /// The multiscatter lobe.
  ///
  /// Currently unused, part of the later MDL spec?
  ///
  void multiscatter = none;

  /// The handle.
  void handle = "";

  /// The flags.
  static const int df_lobes = DF_SMOOTH_BRDF;

  finalize {
    roughness = saturate(roughness);
  }
};

@(pure)
auto scatterEvaluate(const &sheen_bsdf this, inline const &ScatterEvaluateParameters params) {
  if (mode == scatter_reflect && recalculateTangentSpace(params)) {
    const auto cosThetao(#abs(wo.z));
    const auto cosThetai(#abs(wi.z));
    const auto coO(sheenLTCFetch(this.roughness, cosThetao));
    const auto coI(sheenLTCFetch(this.roughness, cosThetai));
    // Rotate each direction into the azimuthal frame of the other, then
    // evaluate the LTC lobe from both views and symmetrize for
    // reciprocity. The value includes the incoming cosine.
    const float2 eo(azimuthFrame(wo));
    const float2 ei(azimuthFrame(wi));
    const float3 wiStd(eo.x * wi.x + eo.y * wi.y, -eo.y * wi.x + eo.x * wi.y, wi.z);
    const float3 woStd(ei.x * wo.x + ei.y * wo.y, -ei.y * wo.x + ei.x * wo.y, wo.z);
    const float DfromO(sheenLTCEval(wiStd, coO.x, coO.y));
    // The lobe evaluated from the reverse view enters `f` with the
    // reciprocity factor `cosThetai / cosThetao`, and its own evaluation
    // carries a leading factor of exactly `cosThetao`, so the division
    // cancels exactly: evaluate the shape without the cosine and apply
    // `cosThetai` directly.
    const float shapeFromI(sheenLTCEvalShape(woStd, coI.x, coI.y));
    const float f(0.5 * (coO.z * DfromO + coI.z * cosThetai * shapeFromI));
    // The sampling densities match `scatterSample`: the LTC lobe of the
    // respective view, falling back to cosine sampling where the fit
    // degenerates at low roughness.
    const float2 pdf(float2(coO.x > SHEEN_LTC_AINV_MIN ? DfromO : cosThetai / $PI, coI.x > SHEEN_LTC_AINV_MIN ? cosThetao * shapeFromI : cosThetao / $PI));
    if (!#hasField(this, "multiscatter_tint") || (#typeOf(this.multiscatter_tint) == float && this.multiscatter_tint == 0.0)) {
      auto result(ScatterEvaluateResult(f: this.tint * f, pdf: pdf));
      result.f *= shadingNormalCorrection if (isImportance);
      return result;
    } else {
      // Diffuse compensation of the energy not reflected by the sheen
      // lobe, using the directional albedo `R` from the LTC table and its
      // cosine-weighted average per roughness row.
      float rowF(saturate(this.roughness) * 31);
      const int ri(#min(int(rowF), 30));
      rowF -= ri;
      const float avgR(lerp(SHEEN_LTC_AVERAGE_R[ri], SHEEN_LTC_AVERAGE_R[ri + 1], rowF));
      // The cosine-averaged albedo tops out at about 0.447 in the table,
      // so the energy deficit is bounded well away from zero and the
      // division needs no floor.
      const auto msF(cosThetai / $PI * #max(1 - coO.z, 0.0) * #max(1 - coI.z, 0.0) / (1 - avgR));
      const auto msPdf(float2(cosThetai, cosThetao) / $PI);
      auto result(ScatterEvaluateResult(f: this.tint * (f + this.multiscatter_tint * msF), pdf: lerp(pdf, msPdf, MULTISCATTER_DIFFUSE_CHANCE)));
      result.f *= shadingNormalCorrection if (isImportance);
      return result;
    }
  } else {
    return ScatterEvaluateResult(isBlack: true);
  }
}

@(pure)
auto scatterSample(const &sheen_bsdf this, inline const &ScatterSampleParameters params) {
  if ((tbn := recalculateTangentSpace(params))) {
    if (result := ScatterSampleResultWithMultiscatter(this, params, DF_SMOOTH_BRDF, DF_SMOOTH_BRDF, *tbn)) {
      return *result;
    }
    const auto co(sheenLTCFetch(this.roughness, wo.z));
    if (co.x > SHEEN_LTC_AINV_MIN) {
      // Perfect importance sampling of the LTC lobe: draw from the clamped
      // cosine and apply the (inverse of the) inverse transform.
      const float3 wiOrig(sampling::cosine_hemisphere_sample(xi.xy));
      const float3 wiStd(normalize(float3((wiOrig.x - wiOrig.z * co.y) / co.x, wiOrig.y / co.x, wiOrig.z)));
      const float2 e(azimuthFrame(wo));
      const float3 wiLocal(float3(e.x * wiStd.x - e.y * wiStd.y, e.y * wiStd.x + e.x * wiStd.y, wiStd.z));
      return ScatterSampleResult(wi: (*tbn) * wiLocal, mode: scatter_reflect);
    }
    return ScatterSampleResult(wi: (*tbn) * sampling::cosine_hemisphere_sample(xi.xy), mode: scatter_reflect);
  } else {
    return ScatterSampleResult(); // Reject
  }
}
//--}

//--{ ward_geisler_moroder_bsdf
/// The floor on the squared roughness of `ward_geisler_moroder_bsdf`.
/// The Ward Gaussian has no cancelled closed forms that stay conditioned
/// at microfacet-scale roughness, so its floor is much larger than
/// `MIN_ALPHA`, and must be shared exactly between `scatterEvaluate` and
/// `scatterSample`.
const float WARD_MIN_ALPHA = 0.001;

/// The anisotropic glossy reflection of the Ward BSDF in the
/// bounded-albedo Geisler-Moroder variant.
export struct ward_geisler_moroder_bsdf: bsdf {
  /// The roughness in U.
  ///
  /// > Roughness coefficient in the U direction. Range: `[0,inf)`, with `0`
  /// > specifying pure specular reflection.
  ///
  float roughness_u;

  /// The roughness in V.
  ///
  /// > Roughness coefficient in the V direction. Range: `[0,inf)`, with `0`
  /// > specifying pure specular reflection.
  ///
  float roughness_v = roughness_u;

  /// The tint.
  ///
  /// > Scaling factor, defined as a color, multiplied by the
  /// > result of the distribution function.
  ///
  $(color | float) tint = 1.0;

  /// The multiscatter tint.
  ///
  /// > Scaling factor, defined as a color, of the diffuse multiscattering
  /// > compensation, `color(0.0)` does not add any, `color(1.0)` fully
  /// > compensates the energy loss.
  ///
  /// NOTE: `none` means no multiscatter, matching the specification's
  /// `color(0.0)` default; see the module note.
  $(?(color | float)) multiscatter_tint = none;

  /// The tangent in U.
  float3 tangent_u = $state.texture_tangent_u[0];

  /// The handle.
  void handle = "";

  /// The flags.
  const int df_lobes = DF_GLOSSY_BRDF | multiscatterLobes(multiscatter_tint, int(scatter_reflect));

  finalize {
    // We limit to `[0,1]`!
    roughness_u = saturate(roughness_u);
    roughness_v = saturate(roughness_v);
  }
};

@(pure noinline)
auto scatterEvaluate(const &ward_geisler_moroder_bsdf this, inline const &ScatterEvaluateParameters params) {
  preserve tangent_u;
  tangent_u = this.tangent_u;
  if (mode == scatter_reflect && recalculateTangentSpace(params)) {
    const auto cosThetao(#abs(wo.z));
    const auto cosThetai(#abs(wi.z));
    // Horizon cull. This one is load-bearing: at double-grazing retro
    // configurations the half-vector height underflows, `h.z^4` rounds
    // to zero, and the Gaussian times the reciprocal becomes `0 * inf`,
    // i.e., NaN in both the value and the densities. The cull bounds
    // `h.z` at `2 * MIN_COS_THETA`, which keeps the denominator normal.
    return ScatterEvaluateResult(isBlack: true) if (!((cosThetao > MIN_COS_THETA) & (cosThetai > MIN_COS_THETA)));
    const auto roughness(this.roughness_u, this.roughness_v);
    const auto roughness0(#sqrt(#prod(roughness)));
    const auto alpha(#max(WARD_MIN_ALPHA, roughness * roughness));
    const auto f0(#sum((h := wo + wi) * h) / ($PI * alpha.x * alpha.y * #pow(h.z, 4)) * #exp(-#sum((g := h.xy / (h.z * alpha)) * g)));
    const auto f(f0 * cosThetai);
    const auto pdf(float2(f0 * (cosThetao + cosThetai) / 2));
    auto result(ScatterEvaluateResultWithMultiscatter(this, f, pdf, cosThetao, cosThetai, roughness0, "ward_geisler_moroder_bsdf", DF_GLOSSY_BRDF, DF_SMOOTH_BRDF, lobeMask));
    result.f *= shadingNormalCorrection if (isImportance);
    return result;
  } else {
    return ScatterEvaluateResult(isBlack: true);
  }
}

// The Ward microsurface normal and its solid-angle density. The sampling
// routine below draws the anisotropic Beckmann-like slope distribution
// exactly, so the density is that distribution and nothing has to be
// inverted to get it.
//
// It is NOT the reported scattering density over a half-vector Jacobian: the
// Geisler-Moroder variant reports `f0 (cos_o + cos_i) / 2`, which is a
// different weighting of the same lobe. That is allowed. What has to hold is
// that this agrees with the draw, which the normalization test checks.
@(pure macro)
float2 wardAlpha(const auto this) {
  return #max(WARD_MIN_ALPHA, (r := float2(this.roughness_u, this.roughness_v)) * r);
}

@(pure noinline)
auto normalSample(const &ward_geisler_moroder_bsdf this, inline const &ScatterNormalParameters params) {
  preserve tangent_u;
  tangent_u = this.tangent_u;
  auto tbn(recalculateTangentSpace(params));
  return ScatterNormalSampleResult() if (!tbn);
  const auto alpha(wardAlpha(this));
  const auto phi(#atan2(alpha.y * #sin(t := $TWO_PI * xi.x), alpha.x * #cos(t)));
  const auto cosPhi(#cos(phi));
  const auto sinPhi(#sin(phi));
  const auto theta(#atan(#sqrt(-#log(1 - xi.y) / (#pow(cosPhi / alpha.x, 2) + #pow(sinPhi / alpha.y, 2)))));
  const auto wmLocal(float3(#sin(theta) * float2(cosPhi, sinPhi), #cos(theta)));
  return ScatterNormalSampleResult() if (!(wmLocal.z > MIN_COS_THETA));
  return ScatterNormalSampleResult(wm: normalize((*tbn) * wmLocal), alpha: alpha, isValid: true);
}

@(pure noinline)
float normalEvaluate(const &ward_geisler_moroder_bsdf this, inline const &ScatterNormalParameters params) {
  preserve tangent_u;
  tangent_u = this.tangent_u;
  return 0.0 if (!recalculateTangentSpace(params));
  const auto wmLocal(normalize(wm));
  return 0.0 if (!(wmLocal.z > MIN_COS_THETA));
  const auto alpha(wardAlpha(this));
  const auto g(wmLocal.xy / (wmLocal.z * alpha));
  return #exp(-#sum(g * g)) / ($PI * alpha.x * alpha.y * #pow(wmLocal.z, 3));
}

@(pure noinline)
auto scatterSample(const &ward_geisler_moroder_bsdf this, inline const &ScatterSampleParameters params) {
  preserve tangent_u;
  tangent_u = this.tangent_u;
  if ((tbn := recalculateTangentSpace(params))) {
    // Sample multiscatter.
    if (result := ScatterSampleResultWithMultiscatter(this, params, DF_GLOSSY_BRDF, DF_SMOOTH_BRDF, *tbn)) {
      return *result;
    } else {
      // Sample specular.
      const auto roughness(this.roughness_u, this.roughness_v);
      const auto alpha(#max(WARD_MIN_ALPHA, roughness * roughness));
      const auto phi(#atan2(alpha.y * #sin(t := $TWO_PI * xi.x), alpha.x * #cos(t)));
      const auto cosPhi(#cos(phi));
      const auto sinPhi(#sin(phi));
      const auto theta(#atan(#sqrt(-#log(1 - xi.y) / (#pow(cosPhi / alpha.x, 2) + #pow(sinPhi / alpha.y, 2)))));
      const auto wm(float3(#sin(theta) * float2(cosPhi, sinPhi), #cos(theta)));
      const auto wi(normalize(specular::reflect(wo, wm)));
      if (wi.z > 0) {
        return ScatterSampleResult(wi: (*tbn) * wi, mode: scatter_reflect);
      }
    }
  }
  return ScatterSampleResult();
}
//--}

//--{ microfacet
/// The microfacet utilities: the distributions (GGX, Beckmann, Blinn),
/// their slope and normal sampling routines, and the shadowing
/// techniques, shared by all of the `microfacet_*_bsdf` variants.
export namespace microfacet {

/// The tag to identify microfacet distributions.
export tag distribution;

/// The GGX (Ground-Glass-X) or Trowbridge-Reitz distribution.
export struct ggx: default distribution {};

/// The Beckmann or Gaussian distribution.
export struct beckmann: distribution {};

/// The Smith Lambda function for the GGX distribution, in terms of the
/// ratio `m = cos(theta) / |alpha w.xy|`. That ratio is singular for a
/// direction exactly on the macro normal, so prefer `smith_projected_area()`
/// wherever `(1 + Lambda) cos(theta)` is what is wanted: it is the same
/// quantity in a form that never needs the ratio.
@(pure macro)
export float smith_lambda(const ggx this [[anno::unused()]], const float m) {
  return 1 / (2 * m * (#sqrt(m * m + 1) + m));
}

/// The Smith Lambda function for the Beckmann distribution.
@(pure macro)
export float smith_lambda(const beckmann this [[anno::unused()]], const float m) {
  return 0.5 * (#exp(-m * m) / m / #sqrt($PI) - float(erfc(m)));
}

/// The 2-dimensional Smith slope PDF for the GGX distribution.
@(pure macro)
export float smith_slope_pdf(const ggx this [[anno::unused()]], const float2 m) {
  return (1 / $PI) / #pow(1 + #sum(m * m), 2);
}

/// The 2-dimensional Smith slope PDF for the Beckmann distribution.
@(pure macro)
export float smith_slope_pdf(const beckmann this [[anno::unused()]], const float2 m) {
  return (1 / $PI) * #exp(-#sum(m * m));
}

/// The Smith slope sampling function for the GGX distribution, drawing the
/// slope distribution itself rather than the part of it a given direction
/// can see. Sampling `r = sqrt(xi / (1 - xi))` inverts the GGX slope CDF.
@(pure)
export float2 smith_slope_sample(
  const ggx this [[anno::unused()]],
  const float xi0, ///< A canonical random number in `[0,1]`
  const float xi1, ///< A canonical random number in `[0,1]`
) {
  const auto r(#sqrt(xi0 / #max(1 - xi0, 1e-9)));
  return r * float2(#cos(phi := $TWO_PI * xi1), #sin(phi));
}

/// The same for the Beckmann distribution, whose slopes are Gaussian, so
/// the radial inverse is `sqrt(-log(1 - xi))`.
@(pure)
export float2 smith_slope_sample(
  const beckmann this [[anno::unused()]],
  const float xi0, ///< A canonical random number in `[0,1]`
  const float xi1, ///< A canonical random number in `[0,1]`
) {
  const auto r(#sqrt(-#log(#max(1 - xi0, 1e-9))));
  return r * float2(#cos(phi := $TWO_PI * xi1), #sin(phi));
}

/// The microsurface normal of the distribution itself, as opposed to
/// `smith_visible_normal_sample`, which draws the part of it that a given
/// outgoing direction can see. The solid-angle density of the result is
/// `smith_normal_pdf() * wm.z`.
@(pure)
export float3 smith_normal_sample(
  const distribution this,
  const float xi0,    ///< A canonical random number in `[0,1]`
  const float xi1,    ///< A canonical random number in `[0,1]`
  const float2 alpha, ///< The squared roughness
) {
  const auto m(alpha * smith_slope_sample(this, xi0, xi1));
  return #all(isfinite(m)) ? normalize(float3(-m, 1)) : float3(0, 0, 1);
}

/// The Smith visible slope sampling function for the GGX distribution.
@(pure)
export float2 smith_visible_slope_sample(
  const ggx this [[anno::unused()]],
  const float xi0, ///< A canonical random number in `[0,1]`
  const float xi1, ///< A canonical random number in `[0,1]`
  float cosThetao, ///< The outgoing zenith angle cosine
) {
  return #sqrt(xi0 / (1 - xi0 + 1e-6)) * float2(#cos(phi := $TWO_PI * xi1), #sin(phi)) if (cosThetao > 1 - 1e-6);
  cosThetao = #max(cosThetao, -0.9999);
  const auto mx = return_from {
    const auto sinThetao(#sqrt(1 - cosThetao * cosThetao));
    const auto tanThetao(sinThetao / cosThetao);
    const auto mu(xi0 * (1 + 1 / cosThetao) - 1);
    const auto nu(1 / (1 - mu * mu));
    const auto D(#sqrt(#max(nu * (mu * mu - (1 - nu) * tanThetao * tanThetao), 0)));
    const auto mx0(-nu * tanThetao - D);
    const auto mx1(-nu * tanThetao + D);
    return #select((mu < 0) | (mx1 * sinThetao > cosThetao), mx0, mx1);
  };
  const auto my = return_from {
    const auto s(#select(xi1 > 0.5, +1.0, -1.0));
    const auto t(#min(s * (2 * xi1 - 1), 1));
    return #sqrt(1 + mx * mx) * s * ((t * (t * (t * 0.27385 - 0.73369) + 0.46341)) / (t * (t * (t * 0.093073 + 0.30942) - 1.0) + 0.597999));
  };
  return float2(mx, my);
}

/// The Smith visible slope sampling function for the Beckmann distribution.
@(pure)
export float2 smith_visible_slope_sample(
  const beckmann this [[anno::unused()]],
  float xi0,       ///< A canonical random number in `[0,1]`
  float xi1,       ///< A canonical random number in `[0,1]`
  float cosThetao, ///< The outgoing zenith angle cosine
) {
  return #sqrt(-#log(1 - xi0 + 1e-6)) * float2(#cos((phi := $TWO_PI * xi1)), #sin(phi)) if (cosThetao > 1 - 1e-6);
  xi0 = #max(xi0, 1e-6);
  xi1 = #max(xi1, 1e-6);
  // Implementation follows PBRT-v3
  const float invSqrtPi = 1 / #sqrt($PI);
  const float thetao = #acos(cosThetao);
  const float sinThetao = #sqrt(#max(0, 1 - cosThetao * cosThetao));
  const float tanThetao = sinThetao / cosThetao;
  const float cotThetao = 1 / tanThetao;
  float xmin = -1;
  float xmax = float(erf(cotThetao));
  float x = xmax - (1 + xmax) * #pow(1 - xi0, 1 + thetao * (-0.876 + thetao * (0.4265 - 0.0594 * thetao)));
  float norm = 1 / (1 + xmax + invSqrtPi * tanThetao * #exp(-cotThetao * cotThetao));
  for (int i = 0; i < 10; ++i) {
    if (!(xmin <= x && x <= xmax))
      x = 0.5 * (xmin + xmax);
    const float a = sampling::erf_inverse(x);
    const float f = norm * (1 + x + invSqrtPi * tanThetao * #exp(-a * a)) - xi0;
    break if (f ~== |1e-5| 0.0);
    if (f > 0)
      xmax = x;
    else
      xmin = x;
    x -= f / (norm * (1 - a * tanThetao));
  }
  return float2(
           sampling::erf_inverse(x),
           sampling::erf_inverse(2 * xi1 - 1),
         );
}

/// The Smith normal PDF for the GGX distribution with squared roughness
/// `alpha`. Because `alpha <= 1` the sum in the denominator is at least
/// 1 for unit `wm`, so the division is unconditionally well-behaved: no
/// epsilon, and the correct nonzero density survives all the way to
/// horizon-grazing normals, where the slope-space form degrades.
@(pure macro)
export float smith_normal_pdf(const ggx this [[anno::unused()]], const float2 alpha, const float3 wm) {
  return wm.z > 0.0 ? 1 / ($PI * alpha.x * alpha.y * #pow(#sum((m := wm.xy / alpha) * m) + wm.z * wm.z, 2)) : 0.0;
}

/// The Smith normal PDF for the Beckmann distribution with squared
/// roughness `alpha`, being the slope PDF mapped onto normals. The
/// Gaussian vanishes faster than the `cos^4` pole grows, so once the
/// squared slope is large enough to underflow the exponential the density
/// is zero outright; in the surviving region `wm.z` is bounded well away
/// from zero and the division needs no guard.
@(pure macro)
export float smith_normal_pdf(const beckmann this [[anno::unused()]], const float2 alpha, const float3 wm) {
  return 0.0 if (!(wm.z > 0.0));
  const float m2(#sum((m := wm.xy / alpha) * m) / (wm.z * wm.z));
  return m2 < 87.0 ? #exp(-m2) / ($PI * alpha.x * alpha.y * #pow(wm.z, 4)) : 0.0;
}

/// The Smith projected area `(1 + Lambda) cos(theta)` of the direction
/// `w` for the GGX distribution, in the exact cancelled form that reaches
/// the correct finite grazing limit.
@(pure macro)
export float smith_projected_area(const ggx this [[anno::unused()]], const float2 alpha, const float3 w) {
  const float cosTheta(#abs(w.z));
  return 0.5 * (cosTheta + length(float3(alpha * w.xy, cosTheta)));
}

/// The Smith projected area `(1 + Lambda) cos(theta)` of the direction
/// `w` for the Beckmann distribution, expanded so the lateral term is
/// scaled by `t = |alpha w.xy|` rather than divided by `cos(theta)`,
/// which reaches the correct finite grazing limit.
@(pure macro)
export float smith_projected_area(const beckmann this [[anno::unused()]], const float2 alpha, const float3 w) {
  const float cosTheta(#abs(w.z));
  const float t(length(alpha * w.xy));
  return cosTheta if (!(t > 0.0));
  const float m(cosTheta / t);
  return cosTheta * (1 - 0.5 * float(erfc(m))) + t * #exp(-m * m) * (0.5 / #sqrt($PI));
}

/// The Smith visible normal sampling function.
@(pure)
export float3 smith_visible_normal_sample(
  const distribution this,
  const float xi0,    ///< A canonical random number in `[0,1]`
  const float xi1,    ///< A canonical random number in `[0,1]`
  const float2 alpha, ///< The squared roughness
  const float3 wo,    ///< The outgoing direction
) {
  const auto w11(normalize(float3(alpha * wo.xy, wo.z)));
  const auto sinTheta(length(w11.xy));
  // On the macro normal the azimuth is undefined and the visible
  // distribution is rotationally symmetric, so any frame is correct.
  // Without the guard the ratio is `0/0`, and the fallback below would
  // collapse the draw onto the macro normal itself.
  const auto cosPhi(sinTheta > 0.0 ? w11.x / sinTheta : 1.0);
  const auto sinPhi(sinTheta > 0.0 ? w11.y / sinTheta : 0.0);
  const auto m11(smith_visible_slope_sample(this, xi0, xi1, w11.z));
  const auto m(float2(alpha.x * dot(float2(cosPhi, -sinPhi), m11), //
                      alpha.y * dot(float2(sinPhi, +cosPhi), m11)));
  return #all(isfinite(m)) ? normalize(float3(-m, 1)) : wo.z == 0 ? normalize(wo) : float3(0, 0, 1);
}

/// The bounded spherical-cap factor for GGX visible-normal sampling of
/// reflection-only lobes, after Eto and Tokuyoshi, "Bounded VNDF Sampling
/// for Smith-GGX Reflections", SIGGRAPH Asia 2023 Technical Communications.
/// Shrinks the spherical cap of Dupuy and Benyoub to exclude microsurface
/// normals whose reflection vectors would fall below the horizon. The
/// anisotropic bound uses the paper's conservative loosening with the
/// minimum roughness.
@(pure)
export float ggx_bounded_cap_factor(const float2 alpha, const float3 wo) {
  const float a(saturate(#min(alpha.x, alpha.y)));
  const float s(1 + length(wo.xy));
  const float a2(a * a);
  const float s2(s * s);
  return (1 - a2) * s2 / (s2 + a2 * wo.z * wo.z);
}

/// The GGX visible normal sampling function through a bounded spherical
/// cap, valid for reflection-only lobes. Equivalent to the standard
/// visible-normal distribution up to the tightened cap, whose density
/// correction is folded into the PDFs reported by `scatterEvaluate`.
@(pure)
export float3 ggx_bounded_visible_normal_sample(
  const float xi0,    ///< A canonical random number in `[0,1]`
  const float xi1,    ///< A canonical random number in `[0,1]`
  const float2 alpha, ///< The squared roughness
  const float3 wo,    ///< The outgoing direction
) {
  const float3 woStd(normalize(float3(alpha * wo.xy, wo.z)));
  const float b((wo.z > 0 ? ggx_bounded_cap_factor(alpha, wo) : 1.0) * woStd.z);
  const float z((1 - xi1) * (1 + b) - b);
  const float sinTheta(#sqrt(saturate(1 - z * z)));
  const float phi($TWO_PI * xi0);
  const float3 mStd(woStd + float3(sinTheta * #cos(phi), sinTheta * #sin(phi), z));
  return normalize(float3(alpha * mStd.xy, mStd.z));
}

/// The Blinn distribution.
export struct blinn: distribution {};

/// The Blinn normal first-quadrant sampling function.
@(pure)
export void blinn_normal_first_quadrant_sample(
  const float xi0, ///< A canonical random number in `[0,1]`
  const float xi1, ///< A canonical random number in `[0,1]`
  const float2 e,  ///< The exponent
  &float phi,      ///< The output azimuth angle
  &float cosTheta, ///< The output zenith angle cosine
) {
  if (e.x == e.y) {
    *phi = $HALF_PI * xi0;
    *cosTheta = #pow(xi1, 1 / (1 + e.x));
  } else {
    *phi = #atan(#sqrt((1 + e.x) / (1 + e.y)) * #tan($HALF_PI * xi0));
    *cosTheta = #pow(xi1, 1 / (1 + e.x * (cosPhi := #cos(*phi)) * cosPhi + e.y * (sinPhi := #sin(*phi)) * sinPhi));
  }
}

/// The Blinn normal sampling function.
@(pure)
export float3 blinn_normal_sample(
  const float xi0, ///< A canonical random number in `[0,1]`
  const float xi1, ///< A canonical random number in `[0,1]`
  const float2 e,  ///< The exponent
) {
  float phi = 0;
  float cosTheta = 0;
  if (xi0 < 0.25) {
    blinn_normal_first_quadrant_sample(4 * xi0, xi1, e, &phi, &cosTheta);
  } else if (xi0 < 0.5) {
    blinn_normal_first_quadrant_sample(4 * (0.5 - xi0), xi1, e, &phi, &cosTheta), phi = $PI - phi;
  } else if (xi0 < 0.75) {
    blinn_normal_first_quadrant_sample(4 * (xi0 - 0.5), xi1, e, &phi, &cosTheta), phi += $PI;
  } else {
    blinn_normal_first_quadrant_sample(4 * (1 - xi0), xi1, e, &phi, &cosTheta), phi = $TWO_PI - phi;
  }
  return float3(#sqrt(#max(1 - cosTheta * cosTheta, 0.0)) * float2(#cos(phi), #sin(phi)), cosTheta);
}

/// The tag to identify microfacet shadowing functions.
export tag shadowing;

/// The Smith shadowing function. (This is the principled correct solution!)
export struct smith: default shadowing {};

/// The V-cavities shadowing function. (This is the older simpler approximation!)
export struct vcavities: shadowing {};

@(foreign pure)
double lgamma(double x);

/// The beta function for Smith shadowing in transmission calculations.
@(pure)
export double beta(const double x, const double y) = #exp(lgamma(x) + lgamma(y) - lgamma(x + y));

} // namespace microfacet

/// The floor on the squared roughness `alpha` of `microfacet_bsdf`, an
/// effective roughness floor of 1e-3. Exactly zero roughness is handled
/// by `makeMicrofacetBSDF` degenerating to `specular_bsdf`; anything in
/// between is clamped here, once, at construction, so that no downstream
/// expression needs an epsilon of its own.
const float MIN_ALPHA = 1e-6;

/// The cap on the Blinn exponent `2 / alpha^2`, reached at roughness
/// about 0.03. Beyond it `pow(cos, e)` cannot resolve the lobe against
/// the spacing of float cosines near 1, so sharper Blinn lobes render
/// identically (and should degenerate to `specular_bsdf` instead). The
/// cap must be shared exactly between `scatterEvaluate` and the normal
/// sampling in `scatterSample`.
const float MAX_BLINN_EXPONENT = 2.0e6;

struct microfacet_bsdf: bsdf {
  /// The roughness in `[0,1]^2`.
  const float2 roughness;

  /// The geometric mean roughness.
  const float roughness0 = #sqrt(#prod(roughness));

  /// The roughness squared in `[MIN_ALPHA,1]^2`.
  ///
  /// NOTE: This is the effective roughness parameter that is actually
  /// used in microfacet equations. It is squared for perceptual linearity,
  /// meaning that adjusting the `roughness` parameter more closely tracks
  /// qualitative changes in the apparent roughness of the BSDF.
  ///
  const float2 alpha = clamp(roughness * roughness, MIN_ALPHA, 1.0);

  /// The tint.
  $(color | float) tint;

  /// The multiscatter tint, or `none` for no multiscatter, matching the
  /// specification's `color(0.0)` default; see the module note.
  $(?(color | float)) multiscatter_tint = none;

  /// The tangent direction for orienting anistropic roughness.
  float3 tangent_u = $state.texture_tangent_u[0];

  /// The scatter mode. With `scatter_reflect_transmit`, the reflect and
  /// transmit lobes are weighted by the dielectric Fresnel term, forming a
  /// complete rough dielectric in one lobe.
  const scatter_mode mode = scatter_reflect;

  /// The microfacet distribution.
  const microfacet::distribution distribution = microfacet::distribution();

  /// The microfacet shadowing technique.
  const microfacet::shadowing shadowing = microfacet::shadowing();

  /// The flags.
  const int df_lobes = modeLobes(int(mode), DF_GLOSSY) | multiscatterLobes(multiscatter_tint, int(mode));
};

@(pure noinline)
auto scatterEvaluate(const &microfacet_bsdf this, inline const &ScatterEvaluateParameters params) {
  // The query's domain, restricted to what the mask leaves this leaf.
  auto effectiveMode(this.mode & mode & scatter_mode(maskedModeBits(lobeMask & this.df_lobes)));
  preserve tangent_u;
  tangent_u = this.tangent_u;
  return ScatterEvaluateResult(isBlack: true) if (!recalculateTangentSpace(params) || effectiveMode == scatter_none);
  // If thin walled and the effective mode is to transmit, flip wi into the upper
  // hemisphere and pretend like the effective mode is to reflect.
  preserve wi, mode;
  bool thinTransmit = false;
  if (thin_walled && effectiveMode == scatter_transmit) {
    thinTransmit = true;
    effectiveMode = scatter_reflect;
    mode = scatter_reflect; // Necessary for `halfDirection()` call below
    wi.z = -wi.z;
  }
  const auto cosThetao(#abs(wo.z));
  const auto cosThetai(#abs(wi.z));
  // The lobes the reflect branch below answers for. A thin-walled
  // transmission arrives here with `wi` flipped, and the compensation lobe
  // goes with it: it is a transmission then, which is not a lobe this
  // distribution declares, so it stays with the single scattering rather
  // than being separable by mask.
  const int ssLobes(thinTransmit ? DF_GLOSSY_BTDF : DF_GLOSSY_BRDF);
  const int msLobes(thinTransmit ? DF_GLOSSY_BTDF : DF_SMOOTH_BRDF);
  // Horizon cull: below the threshold the `1/cos` factors are dominated
  // by the directional noise of normalized vectors (and can overflow),
  // so zero the result and the densities together.
  return ScatterEvaluateResult(isBlack: true) if (!((cosThetao > MIN_COS_THETA) & (cosThetai > MIN_COS_THETA)));
  const auto wm(halfDirection(params));
  const auto dotWoWm(#sum(wo * wm));
  const auto dotWiWm(#sum(wi * wm));
  // For `scatter_reflect_transmit`, the reflect and transmit lobes are
  // weighted by the dielectric Fresnel term at the half vector. The PDFs are
  // instead weighted by the term at the macro normal (the reverse lane from
  // the far side for solid transmission), which is the sampling routine's
  // selection chance exactly; that chance is deliberately independent of the
  // sampled microsurface normal so the reported densities stay exact for the
  // specular and multiscatter components alike. At total internal reflection
  // the transmit weight vanishes. Single modes keep unit weights.
  float fWeight = 1.0;
  float2 pdfWeight = float2(1.0);
  if (this.mode == scatter_reflect_transmit) {
    const auto F(specular::dielectric_fresnel(dotWoWm, ior));
    // The PDF weights are the (clamped) sampling selection chances; the
    // physical weight `F` at the half vector stays exact. Unlike the
    // layer combinators, the unit endpoint is clamped as well: the
    // Fresnel term saturates to exactly 1 at total internal reflection
    // while microfacet refraction remains feasible, so the transmit lobe
    // must keep a live density. See MIN_CHANCE.
    const auto Fo(#min(clampChance(specular::dielectric_fresnel(cosThetao, ior)), 1.0 - MIN_CHANCE));
    const auto Fi(#min(clampChance(specular::dielectric_fresnel(cosThetai, effectiveMode == scatter_reflect ? ior : 1 / ior)), 1.0 - MIN_CHANCE));
    const bool complement(thinTransmit | (effectiveMode == scatter_transmit));
    fWeight = complement ? 1 - F : F;
    pdfWeight = complement ? 1 - float2(Fo, Fi) : float2(Fo, Fi);
    // The physical weight at the half vector is unchanged by a mask, but
    // the density is: a mask leaving this leaf one domain makes the
    // sampler take it with certainty, so the selection weight drops out.
    pdfWeight = float2(1.0) if ((int(this.mode) & maskedModeBits(lobeMask & this.df_lobes)) != int(scatter_reflect_transmit));
  }
  if $(this.distribution <: microfacet::blinn) {
    const auto e(#min(2 / (this.alpha * this.alpha), MAX_BLINN_EXPONENT));
    // The exponent denominator `1 - wm.z^2` is exactly `|wm.xy|^2` for
    // unit `wm`, which is better conditioned near the pole; the pole
    // itself is the removable `0/0` limit `wm.z^e -> 1`.
    const auto sin2Theta(#sum(wm.xy * wm.xy));
    const auto D((sin2Theta > 0.0 ? #pow(wm.z, (e.x * wm.x * wm.x + e.y * wm.y * wm.y) / sin2Theta) : 1.0) / $TWO_PI);
    const auto norm1(#sqrt(#prod(1 + e)));
    const auto norm2(#sqrt(#prod(2 + e)));
    const auto G(#min(1, 2 * wm.z * #min(#abs(cosThetao / dotWoWm), //
                                         #abs(cosThetai / dotWiWm))));
    if (effectiveMode == scatter_reflect) {
      // Reflection requires the outgoing and incoming directions above the
      // microsurface normal; rounding at double-grazing configurations can
      // produce nonpositive projections, which would flip the sign of the
      // densities below rather than merely inflate them.
      return ScatterEvaluateResult(isBlack: true) if (!((dotWoWm > 0) & (dotWiWm > 0)));
      const auto pdf(norm1 * D / (4 * float2(dotWoWm, dotWiWm)));
      const auto f(norm2 * D * G / (4 * cosThetao));
      auto result(ScatterEvaluateResultWithMultiscatter(this, f, pdf, cosThetao, cosThetai, this.roughness0, "simple_glossy_bsdf", ssLobes, msLobes, lobeMask));
      result.f *= shadingNormalCorrection if (isImportance);
      result.f *= fWeight;
      result.pdf *= pdfWeight;
      return result;
    } else {
      return ScatterEvaluateResult(isBlack: true) if (!((dotWoWm > 0) & (dotWiWm < 0)));
      // Transmission never accounts for multiscatter. Note the sampling routine draws
      // the microsurface normal from the full distribution with density `norm1 * D`,
      // not the visible-normal distribution, so the PDFs have no projected-area terms.
      const auto jac(float2(specular::refraction_half_vector_jacobian(wo, wi, ior), //
                            specular::refraction_half_vector_jacobian(wi, wo, 1 / ior)));
      const auto pdf(norm1 * D * jac);
      const auto f(norm2 * D * G * jac[0] * dotWoWm / cosThetao);
      auto result(ScatterEvaluateResult(f: this.tint * f, pdf: pdf));
      result.f *= shadingNormalCorrection if (isImportance);
      // The `ior * ior` accounts for the solid-angle compression of refracted radiance,
      // which does not apply to importance. (See the corresponding Smith branch below.)
      result.f *= ior * ior if (!isImportance);
      result.f *= fWeight;
      result.pdf *= pdfWeight;
      return result;
    }
  } else {
    const auto D(microfacet::smith_normal_pdf(this.distribution, this.alpha, wm));
    const auto projAreao(microfacet::smith_projected_area(this.distribution, this.alpha, wo));
    const auto projAreai(microfacet::smith_projected_area(this.distribution, this.alpha, wi));
    const auto G = return_from {
      if $(this.shadowing <: microfacet::smith) {
        // `1 + Lambda(w)` comes from the projected area rather than from
        // `smith_lambda()` directly, whose argument `cos(theta) / |alpha
        // w.xy|` is singular for a direction exactly on the macro normal
        // and, at the horizon, infinite. The projected area is the same
        // quantity in the cancelled form, finite and positive at both
        // ends, and `cosTheta` is already above `MIN_COS_THETA`.
        const auto onePlusLambdao(projAreao / cosThetao);
        const auto onePlusLambdai(projAreai / cosThetai);
        if (effectiveMode == scatter_reflect) {
          return float(1 / (onePlusLambdao + onePlusLambdai - 1));
        } else {
          return float(microfacet::beta(onePlusLambdao, onePlusLambdai));
        }
      } else {
        // V-cavities
        return #min(1, 2 * wm.z * #min(#abs(cosThetao / dotWoWm), //
                                       #abs(cosThetai / dotWiWm)));
      }
    };
    if (effectiveMode == scatter_reflect) {
      const auto lutName(this.distribution <: microfacet::ggx ? "microfacet_ggx_smith_bsdf" : "microfacet_beckmann_smith_bsdf");
      auto pdf(D / (4 * float2(projAreao, projAreai)));
      if $(this.distribution <: microfacet::ggx) {
        // Bounded VNDF sampling (Eto and Tokuyoshi 2023): for reflection-only
        // GGX lobes, `scatterSample` draws visible normals from a tightened
        // spherical cap, so report the matching tightened densities. The
        // GGX identity `4 * (1 + lambda) * cosTheta = 2 * (cosTheta + t)`
        // folds the bound `k` into the projected-area denominators.
        if (this.mode == scatter_reflect) {
          // With the closed-form projected area this denominator is
          // exactly `2 (|(alpha xy, cos)| + k cos) > 0`, so it needs no
          // epsilon.
          const float2 k(float2(microfacet::ggx_bounded_cap_factor(this.alpha, wo), microfacet::ggx_bounded_cap_factor(this.alpha, wi)));
          pdf = D / (4 * float2(projAreao, projAreai) + 2 * (k - 1) * float2(cosThetao, cosThetai));
        }
      }
      const auto f(D * G / (4 * cosThetao));
      auto result(ScatterEvaluateResultWithMultiscatter(this, f, pdf, cosThetao, cosThetai, this.roughness0, lutName, ssLobes, msLobes, lobeMask));
      result.f *= shadingNormalCorrection if (isImportance);
      result.f *= fWeight;
      result.pdf *= pdfWeight;
      return result;
    } else {
      return ScatterEvaluateResult(isBlack: true) if (!((dotWoWm > 0) & (dotWiWm < 0)));
      const auto jac(float2(specular::refraction_half_vector_jacobian(wo, wi, ior), //
                            specular::refraction_half_vector_jacobian(wi, wo, 1 / ior)));
      const auto pdf(D * jac * float2(dotWoWm, -dotWiWm) / float2(projAreao, projAreai));
      const auto f(D * G * jac[0] * dotWoWm / cosThetao);
      auto result(ScatterEvaluateResult(f: this.tint * f, pdf: pdf));
      result.f *= shadingNormalCorrection if (isImportance);
      // The `ior * ior` accounts for the solid-angle compression of refracted radiance,
      // which does not apply to importance. This is consistent with the `specular_bsdf`
      // Dirac transmission weight, and is required for importance transport to be the
      // adjoint of radiance transport.
      result.f *= ior * ior if (!isImportance);
      result.f *= fWeight;
      result.pdf *= pdfWeight;
      return result;
    }
  }
  return ScatterEvaluateResult(isBlack: true);
}

// The microsurface normal the sampling routines draw, factored out so that
// `scatterSample` and the normal queries cannot come to draw from different
// distributions. The Blinn form is the plain normal distribution; the Smith
// forms are visible-normal, tightened to a bounded spherical cap for
// reflection-only GGX lobes (Eto and Tokuyoshi 2023).
//
// `visible` is the one difference between the two callers, and the normal
// queries pass false. `scatterSample` wants the visible-normal distribution,
// which is the better proposal for a scattering event because it accounts for
// what the outgoing direction can actually see; a caller constraining a half
// vector is not scattering through it, and the visible form would make the
// proposal depend on a direction the constraint solve then changes. Zeltner,
// Georgiev and Jakob sample the distribution itself for the same purpose, and
// disable visible-normal sampling explicitly to do it.
//
// Reflection-only GGX lobes tighten the visible form onto a bounded spherical
// cap (Eto and Tokuyoshi 2023) to avoid drawing normals that reflect `wo`
// below the horizon. That is a reflection concern and comes along with
// `visible`, which is just as well: the cap is conservative rather than
// exactly that set, so its support has no closed form to report a density
// against, and a density that is nonzero where the draw cannot reach is
// exactly the thing these queries may not do.
@(pure macro)
float3 microfacetNormalSample(const auto this, const float2 xi, const float3 wo [[anno::unused()]], const bool visible) {
  if $(this.distribution <: microfacet::blinn) {
    // The Blinn routine draws the distribution itself either way.
    return microfacet::blinn_normal_sample(xi.x, xi.y, #min(2 / (this.alpha * this.alpha), MAX_BLINN_EXPONENT));
  } else {
    if (!visible)
      return microfacet::smith_normal_sample(this.distribution, xi.x, xi.y, this.alpha);
    if $(this.distribution <: microfacet::ggx) {
      if (this.mode == scatter_reflect)
        return microfacet::ggx_bounded_visible_normal_sample(xi.x, xi.y, this.alpha, wo);
    }
    return microfacet::smith_visible_normal_sample(this.distribution, xi.x, xi.y, this.alpha, wo);
  }
}

// Its solid-angle density at `visible` false, which is the distribution's own
// and so does not depend on `wo` at all. `testing/language/df.smdl` asserts
// that it integrates to one and that it is the plain form rather than the
// visible one, which is the property that would silently regress.
@(pure macro)
float microfacetNormalPdf(const auto this, const float3 wm) {
  return 0.0 if (!(wm.z > 0.0));
  if $(this.distribution <: microfacet::blinn) {
    const auto e(#min(2 / (this.alpha * this.alpha), MAX_BLINN_EXPONENT));
    const auto sin2Theta(#sum(wm.xy * wm.xy));
    const auto D((sin2Theta > 0.0 ? #pow(wm.z, (e.x * wm.x * wm.x + e.y * wm.y * wm.y) / sin2Theta) : 1.0) / $TWO_PI);
    return #sqrt(#prod(1 + e)) * D;
  } else {
    return microfacet::smith_normal_pdf(this.distribution, this.alpha, wm) * wm.z;
  }
}

@(pure noinline)
auto normalSample(const &microfacet_bsdf this, inline const &ScatterNormalParameters params) {
  preserve tangent_u;
  tangent_u = this.tangent_u;
  auto tbn(recalculateTangentSpace(params));
  return ScatterNormalSampleResult() if (!tbn);
  const auto wmLocal(microfacetNormalSample(this, xi.xy, float3(0, 0, 1), /*visible=*/false));
  return ScatterNormalSampleResult() if (!(wmLocal.z > 0.0));
  return ScatterNormalSampleResult(wm: normalize((*tbn) * wmLocal), alpha: this.alpha, isValid: true);
}

@(pure noinline)
float normalEvaluate(const &microfacet_bsdf this, inline const &ScatterNormalParameters params) {
  preserve tangent_u;
  tangent_u = this.tangent_u;
  return 0.0 if (!recalculateTangentSpace(params));
  return microfacetNormalPdf(this, normalize(wm));
}

@(pure noinline)
auto scatterSample(const &microfacet_bsdf this, inline const &ScatterSampleParameters params) {
  preserve tangent_u;
  tangent_u = this.tangent_u;
  auto tbn(recalculateTangentSpace(params));
  if (!tbn)
    return ScatterSampleResult();
  // Decide whether to reflect or transmit. For `scatter_reflect_transmit`,
  // the choice is importance-sampled by the dielectric Fresnel term at the
  // macro normal, deliberately independent of the sampled microsurface normal
  // so the selection chance matches the PDF weights `scatterEvaluate` reports.
  // The chance is clamped into the `MIN_CHANCE` bounds, matching the clamped
  // PDF weights, so neither lobe's throughput ratio is unbounded near unit
  // relative IOR or total internal reflection. Single modes are deterministic.
  const auto rawReflectChance(this.mode == scatter_reflect_transmit                                             //
                           ? #min(clampChance(specular::dielectric_fresnel(#abs(wo.z), ior)), 1.0 - MIN_CHANCE) //
                           : scatterReflectChance(this.mode));
  // The mask may leave only one domain alive, and then that branch is
  // taken with certainty. Nothing has to be reweighted here: the caller
  // re-evaluates under the same mask, and `scatterEvaluate` drops the
  // selection weight from its density to match.
  const auto enabledMode(scatter_mode(int(this.mode) & maskedModeBits(lobeMask & this.df_lobes)));
  return ScatterSampleResult() if (enabledMode == scatter_none);
  const auto reflectChance(enabledMode == this.mode ? rawReflectChance
                                                    : scatterReflectChance(enabledMode));
  const auto mode(sampling::bool_sample(&xi.z, reflectChance) ? scatter_reflect : scatter_transmit);
  lobeChance *= mode == scatter_reflect ? rawReflectChance : 1 - rawReflectChance;
  if (mode == scatter_reflect || thin_walled) {
    // A transmission can only reach here through a thin wall, and the
    // compensation lobe is flipped along with it, so on that path it is not
    // the `DF_SMOOTH_BRDF` the lobe word declares and the mask cannot single it
    // out. See `ScatterEvaluateResultWithMultiscatter`.
    const int ssLobes(mode == scatter_transmit ? DF_GLOSSY_BTDF : DF_GLOSSY_BRDF);
    const int msLobes(mode == scatter_transmit ? DF_GLOSSY_BTDF : DF_SMOOTH_BRDF);
    if (result := ScatterSampleResultWithMultiscatter(this, params, ssLobes, msLobes, *tbn)) {
      if (mode == scatter_transmit)
        return ScatterSampleResult(wi: result.wi * float3(+1, +1, -1), mode: mode);
      return *result;
    }
  }
  // Otherwise, sample a microsurface normal direction from the distribution, then either reflect or
  // refract through the normal depending on whether we decided to reflect or transmit. Note: The Blinn
  // distribution is not a closed-form scale-invariant Smith distribution, so it has a separate normal
  // sampling routine.
  const auto wm(microfacetNormalSample(this, xi.xy, wo, /*visible=*/true));
  const auto wi = return_from {
    if (mode == scatter_reflect) {
      return specular::reflect(wo, wm);
    } else {
      // If thin walled, reflect in the upper hemisphere then flip wi to the lower hemisphere.
      if (thin_walled) {
        return specular::reflect(wo, wm) * float3(+1, +1, -1);
      } else {
        return specular::refract(wo, wm, ior);
      }
    }
  };
  return ScatterSampleResult(wi: normalize((*tbn) * wi), mode: mode);
}

@(macro)
auto makeMicrofacetBSDF(
  const float roughness_u,
  const float roughness_v = roughness_u,
  const $(color | float) tint = 1.0,
  const $(?(color | float)) multiscatter_tint = none,
  const float3 tangent_u = $state.texture_tangent_u[0],
  const scatter_mode mode = scatter_reflect,
  const string handle = "" [[anno::unused()]],
  const microfacet::distribution distribution = microfacet::distribution(),
  const microfacet::shadowing shadowing = microfacet::shadowing(),
) {
  if ((roughness_u > 0) | (roughness_v > 0)) {
    return microfacet_bsdf(
             roughness: float2(roughness_u, roughness_v),
             tint: tint,
             multiscatter_tint: multiscatter_tint,
             tangent_u: normalize(tangent_u),
             mode: mode,
             distribution: distribution,
             shadowing: shadowing,
           );
  } else {
    return specular_bsdf(tint: tint, mode: mode);
  }
}

/// The simple glossy BSDF, being a Blinn microfacet BSDF with V-cavities
/// shadowing, degenerating to `specular_bsdf` at zero roughness.
export auto simple_glossy_bsdf(*) = makeMicrofacetBSDF(distribution: microfacet::blinn(), shadowing: microfacet::vcavities());

/// The GGX microfacet BSDF with Smith shadowing, degenerating to
/// `specular_bsdf` at zero roughness.
export auto microfacet_ggx_smith_bsdf(*) = makeMicrofacetBSDF(distribution: microfacet::ggx(), shadowing: microfacet::smith());

/// The GGX microfacet BSDF with V-cavities shadowing, degenerating to
/// `specular_bsdf` at zero roughness.
export auto microfacet_ggx_vcavities_bsdf(*) = makeMicrofacetBSDF(distribution: microfacet::ggx(), shadowing: microfacet::vcavities());

/// The Beckmann microfacet BSDF with Smith shadowing, degenerating to
/// `specular_bsdf` at zero roughness.
export auto microfacet_beckmann_smith_bsdf(*) = makeMicrofacetBSDF(distribution: microfacet::beckmann(), shadowing: microfacet::smith());

/// The Beckmann microfacet BSDF with V-cavities shadowing, degenerating to
/// `specular_bsdf` at zero roughness.
export auto microfacet_beckmann_vcavities_bsdf(*) = makeMicrofacetBSDF(distribution: microfacet::beckmann(), shadowing: microfacet::vcavities());
//--}

//--{ micrograin
// NOTE: This is non-standard!

// The micrograin BSDF for porous and dusty layers, implementing "A
// Fully-correlated Anisotropic Micrograin BSDF Model" by Lucas, Ribardiere,
// Pacanowski, and Barla, ACM Transactions on Graphics 43(4), 2024. The
// diffuse micrograin component is the visibility integral of Eq. 21, which
// has no closed form: following the paper, it is estimated stochastically
// (one NDF-distributed normal per evaluation, drawn from the seeded
// generator on the parameter struct).
export namespace micrograin {

/// Clamp the filling factor away from the degenerate limits of the
/// logarithms it feeds.
@(pure macro)
export float clamp_filling_factor(const float tau0) = clamp(tau0, 1.0e-4, 0.999);

/// The micrograin Normal Distribution Function for filling factor `tau0`
/// and lateral inverse-stretching `beta`, a generalization of the
/// anisotropic Trowbridge-Reitz (GGX) distribution.
@(pure)
export float normal_pdf(const float tau0, const float2 beta, const float3 wm) {
  return 0.0 if (!(wm.z > MIN_COS_THETA));
  const float cosTheta2(wm.z * wm.z);
  const float t2((wm.x * wm.x / (beta.x * beta.x) + wm.y * wm.y / (beta.y * beta.y)) / cosTheta2);
  return -#log(1 - tau0) * #pow(1 - tau0, t2 / (1 + t2)) / (tau0 * $PI * (1 + t2) * (1 + t2) * beta.x * beta.y * cosTheta2 * cosTheta2);
}

/// Sample the micrograin NDF proportional to `normal_pdf(wm) * wm.z` by
/// closed-form CDF inversion [Eqs. 13-15].
@(pure)
export float3 normal_sample(const float tau0, const float2 beta, const float xi0, const float xi1) {
  const float phi($TWO_PI * xi1);
  const float2 e(normalize(float2(beta.x * #cos(phi), beta.y * #sin(phi))));
  const float g(e.x * e.x / (beta.x * beta.x) + e.y * e.y / (beta.y * beta.y));
  const float num(1 - saturate(xi0) * tau0);
  const float den(#log(num / (1 - tau0)) * g);
  const float cosTheta(den > 0.0 ? 1 / #sqrt(1 + (-#log(num) / den)) : 0.0);
  return float3(#sqrt(#max(1 - cosTheta * cosTheta, 0.0)) * e, cosTheta);
}

/// The area of the shadow cast by a unit spherical micrograin onto the
/// plane at height `h`, from the direction with zenith cosine `cosThetai`.
/// Zero when the spherical cap above `h` is fully visible, i.e., when
/// `tan(thetam) * tan(thetai) <= 1` with `cos(thetam) = h`.
@(pure)
export float shadow_area(float cosThetai, const float h) {
  const float cosThetam(saturate(h));
  const float sinThetam(#sqrt(#max(1 - cosThetam * cosThetam, 0.0)));
  cosThetai = clamp(cosThetai, MIN_COS_THETA, 1.0);
  const float sinThetai(#sqrt(#max(1 - cosThetai * cosThetai, 0.0)));
  return 0.0 if (!(sinThetam * sinThetai > cosThetam * cosThetai));
  const float cosPhiq(-(cosThetam * cosThetai) / (sinThetam * sinThetai));
  const float phiq(#acos(clamp(cosPhiq, -1.0, 1.0)));
  const float ex(sinThetai / cosThetai * cosThetam);
  const float sigmat(#abs(ex * sinThetam * #sin(phiq)));
  const float sigmac(($PI - phiq) * sinThetam * sinThetam);
  const float sigmae(#acos(clamp(-(sinThetam * cosPhiq - ex) * cosThetai, -1.0, 1.0)) / cosThetai);
  return #max(sigmae - sigmac - sigmat, 0.0);
}

/// Transform a direction into the space where micrograins are unit
/// spheres.
@(pure macro)
export float3 beta_transform(const float2 beta, const float3 w) = normalize(float3(beta * w.xy, w.z));

/// Transform a microfacet normal into the space where micrograins are
/// unit spheres, i.e., by the inverse-transpose of `beta_transform`.
@(pure macro)
export float3 beta_transform_normal(const float2 beta, const float3 wm) = normalize(float3(wm.xy / beta, wm.z));

/// The area of the overlap between the shadows cast by a unit spherical
/// micrograin above height `h` from two directions, which accounts for
/// the directional correlation responsible for retro-reflection on porous
/// layers. Directions are in the transformed space of `beta_transform`.
///
/// Each shadow crescent is star-shaped about the cap center, so the overlap
/// area reduces to a 1-dimensional integral of the radial extents over the
/// intersection of the two azimuthal arcs, evaluated here by midpoint
/// quadrature with error below a percent. This trades the intricate case
/// analysis of the paper's closed form for robustness.
@(pure)
export float shadow_overlap_area(const float3 wiT, const float3 woT, const float h) {
  const float sigmasi(shadow_area(wiT.z, h));
  const float sigmaso(shadow_area(woT.z, h));
  return 0.0 if (!(sigmasi > 0) || !(sigmaso > 0));
  // Aligned directions cast coincident shadows.
  const float sigmasMin(#min(sigmasi, sigmaso));
  return sigmasMin if (!(length(cross(wiT, woT)) > 1.0e-6));
  const float cosThetam(saturate(h));
  const float sinThetam(#sqrt(#max(1 - cosThetam * cosThetam, 0.0)));
  const float rc2(sinThetam * sinThetam);
  // The azimuthal arc of each shadow on the cap circle is centered on the
  // anti-azimuth of its direction with half-width pi - phiq [Appendix A].
  const float sinThetai(length(wiT.xy));
  const float sinThetao(length(woT.xy));
  const float2 ddi(wiT.xy / sinThetai);
  const float2 ddo(woT.xy / sinThetao);
  const float halfi($PI - #acos(clamp(-(cosThetam * wiT.z) / (sinThetam * sinThetai), -1.0, 1.0)));
  const float halfo($PI - #acos(clamp(-(cosThetam * woT.z) / (sinThetam * sinThetao), -1.0, 1.0)));
  const float delta(#atan2(ddi.x * ddo.y - ddi.y * ddo.x, ddi.x * ddo.x + ddi.y * ddo.y));
  const float alphai(#atan2(-ddi.y, -ddi.x));
  // Shadow ellipse constants: with the ellipse center at distance `ex`
  // along the azimuth and the transform that turns it into the unit
  // circle, the radial exit of the ray at azimuth `phi` solves a
  // quadratic with these coefficients.
  const float exi(sinThetai / wiT.z * cosThetam);
  const float exo(sinThetao / woT.z * cosThetam);
  const float ci(sinThetai * sinThetai * cosThetam * cosThetam - 1);
  const float co(sinThetao * sinThetao * cosThetam * cosThetam - 1);
  float total = 0;
  // The two arcs may intersect in up to two components on the circle.
  for (int component = 0; component < 2; component++) {
    const float d0(component == 0 ? delta : delta - #sign(delta) * $TWO_PI);
    const float lo(#max(-halfi, d0 - halfo));
    const float hi(#min(+halfi, d0 + halfo));
    continue if (!(hi > lo));
    const int n = 16;
    float acc = 0;
    for (int k = 0; k < n; k++) {
      const float phi(alphai + lo + (hi - lo) * ((k + 0.5) / n));
      const float2 u(float2(#cos(phi), #sin(phi)));
      // Radial exit through the shadow ellipse of each direction.
      const float dui(#sum(ddi * u));
      const float duo(#sum(ddo * u));
      const float ai2(wiT.z * wiT.z * dui * dui + (crossi := ddi.x * u.y - ddi.y * u.x) * crossi);
      const float ao2(woT.z * woT.z * duo * duo + (crosso := ddo.x * u.y - ddo.y * u.x) * crosso);
      const float bi(-2 * wiT.z * dui * wiT.z * exi);
      const float bo(-2 * woT.z * duo * woT.z * exo);
      const float ri((-bi + #sqrt(#max(bi * bi - 4 * ai2 * ci, 0.0))) / (2 * ai2 + 1e-6));
      const float ro((-bo + #sqrt(#max(bo * bo - 4 * ao2 * co, 0.0))) / (2 * ao2 + 1e-6));
      const float r(#min(ri, ro));
      acc += #max(r * r - rc2, 0.0);
    }
    total += 0.5 * acc * (hi - lo) / n;
  }
  return #min(total, sigmasMin);
}

/// The distant term of the fully-correlated bidirectional GAF,
/// taking directions and the microfacet height already in the transformed
/// space of `beta_transform`.
@(pure)
export float distant_gaf(const float tau0, const float3 wiT, const float3 woT, const float hT) {
  return #exp(#log(1 - tau0) / $PI * (shadow_area(wiT.z, hT) + shadow_area(woT.z, hT) - shadow_overlap_area(wiT, woT, hT)));
}

/// The unidirectional distant GAF at pore level.
@(pure macro)
export float distant_gaf1_at_surface(const float tau0, const float cosThetaT) {
  return #pow(1 - tau0, 0.5 * (1 / #max(cosThetaT, 0.0) - 1));
}

/// The chance that a light path from the direction with the given
/// transformed zenith cosine reaches the base surface through visible
/// pores, used to importance-sample the base component.
@(pure)
export float base_chance(const float tau0, const float cosThetaT) {
  const float g((1 - tau0) * distant_gaf1_at_surface(tau0, cosThetaT));
  return g / (tau0 + g);
}

} // namespace micrograin

/// The micrograin layering BSDF for porous and dusty layers, e.g., dust
/// deposition, rust, powder, and dirt. This is an extension beyond the MDL
/// specification, implementing Lucas et al, "A Fully-correlated
/// Anisotropic Micrograin BSDF Model" (2024), with the closed-form
/// coupled-diffuse approximation of their 2023 paper.
///
/// A random distribution of opaque half-ellipsoidal micrograins covers the
/// fraction `filling_factor` of the base surface: light either scatters at
/// the micrograin surface, or passes through the visible pores to the
/// `base` BSDF, with the balance controlled by exact spherical-cap shadow
/// areas so that grazing configurations show characteristically more
/// micrograin and less base. The equivalent GGX roughness of the grain
/// distribution is approximately
/// `sqrt(filling_factor / -log(1 - filling_factor)) * beta` [Eq. 28].
export struct micrograin_layer: bsdf {
  /// The filling factor, being the fraction of the base surface covered
  /// by micrograins when viewed at normal incidence. Range `(0,1)`,
  /// clamped away from both limits.
  float filling_factor;

  /// The lateral inverse-stretching factor of the micrograins along the
  /// tangent direction. Micrograins are hemispheres at 1; larger values
  /// make them proportionally narrower and the appearance rougher.
  float beta_u = 1.0;

  /// The lateral inverse-stretching factor along the bitangent, equal to
  /// `beta_u` by default for isotropic micrograins.
  float beta_v = beta_u;

  /// The diffuse albedo of the micrograin material.
  $(color | float) grain_diffuse_albedo = 0.0;

  /// The absolute index of refraction of the micrograin material.
  $(color | float) grain_ior = 1.5;

  /// The extinction coefficient of the micrograin material, or `none` for
  /// dielectric micrograins. Set from measured conductor data, e.g.,
  /// `::models::metal_ior`, for metallic dust.
  $(?(color | float)) grain_extinction = none;

  /// The base BSDF visible through the pores.
  bsdf base = bsdf();

  /// The normal to use for the layer, or `none` to use whatever normal
  /// is already active where this node sits.
  ///
  /// NOTE: The specification defaults this to `state::normal()`. We
  /// inherit instead, so that a normal map applied once through
  /// `material_geometry.normal` reaches this node and everything beneath
  /// it. Giving a normal pins this node and its subtree to it, as the
  /// specification says, and detaches them from `material_geometry`.
  ///
  $(?float3) normal = none;

  /// The tangent direction for orienting anisotropic micrograins.
  float3 tangent_u = $state.texture_tangent_u[0];

  /// The lobes.
  ///
  /// SMOOTH rather than GLOSSY, which is the exception in this module: the
  /// micrograin term does have a normal distribution, and it is still the
  /// wrong label. GLOSSY promises a lobe a caller can constrain a half vector
  /// through, and this is not that lobe. It is a grazing-angle dusting whose
  /// appearance is a sheen, sampled as a mixture of the grain distribution
  /// with a cosine hemisphere off `grain_diffuse_albedo`, so a caller asking
  /// for the normal distribution behind it would be handed a draw that half
  /// the time has nothing to do with one. `sheen_bsdf`, which it resembles,
  /// is SMOOTH for the same reason.
  const int df_lobes = DF_SMOOTH_BRDF | base.df_lobes | normalParamLobes(normal);

  finalize {
    filling_factor = micrograin::clamp_filling_factor(filling_factor);
    beta_u = #max(beta_u, 1e-5);
    beta_v = #max(beta_v, 1e-5);
    tangent_u = normalize(tangent_u);
  }
};

/// The Fresnel term of the micrograin material: dielectric when
/// `grain_extinction` is `none`, else conductor.
@(pure macro)
auto micrograinFresnel(const auto this, const auto params, const float cosTheta) {
  if (!#hasField(this, "grain_extinction")) {
    return specular::dielectric_fresnel(cosTheta, average(relativeIOR(params, this.grain_ior)));
  } else {
    return specular::conductor_fresnel(cosTheta, relativeIOR(params, complex(this.grain_ior, this.grain_extinction)));
  }
}

@(macro)
auto scatterEvaluate(const &micrograin_layer this, inline const &ScatterEvaluateParameters params) {
  const auto resultBase(scatterEvaluateMasked(visit &this.base, params));
  preserve wo, wi, tangent_u, normal;
  tangent_u = this.tangent_u;
  normal = layerNormal(this.normal, normal);
  return resultBase if (!recalculateTangentSpace(params));
  const float tau0(this.filling_factor);
  const float2 beta(this.beta_u, this.beta_v);
  const float cosThetao(#abs(wo.z));
  const float cosThetai(#abs(wi.z));
  // Horizon cull: the distant GAF drives every component to zero at
  // grazing anyway, so zero the value and the densities together before
  // the `1/cos` factors below lose meaning.
  return ScatterEvaluateResult(isBlack: true) if (!((cosThetao > MIN_COS_THETA) & (cosThetai > MIN_COS_THETA)));
  const auto woT(micrograin::beta_transform(beta, float3(wo.xy, cosThetao)));
  const auto wiT(micrograin::beta_transform(beta, float3(wi.xy, cosThetai)));
  // Pore visibility weighting the base component [Eq. 23 / App. C].
  const float Vp((1 - tau0) * micrograin::distant_gaf(tau0, wiT, woT, 0.0));
  // The base and this layer's own lobe are the two sides of the
  // selection, so the densities mix by whichever the mask leaves alive,
  // exactly as `scatterSample` chooses between them.
  const float2 pBase(maskedChance(float2(micrograin::base_chance(tau0, woT.z), micrograin::base_chance(tau0, wiT.z)),
                                  this.base.df_lobes, DF_SMOOTH_BRDF, lobeMask));
  // The micrograin term is this layer's own lobe, so it answers to the
  // mask here; the base answered to it on the way in. What the pores let
  // through is this layer's weight on the base rather than a lobe of its
  // own, so it applies either way.
  return ScatterEvaluateResult(f: Vp * resultBase.f, pdf: pBase * resultBase.pdf, isBlack: resultBase.isBlack) //
         if (!isLobeLive(DF_SMOOTH_BRDF, lobeMask));
  if (mode == scatter_reflect) {
    const auto wm(normalize(wo + wi));
    const auto dotWoWm(#abs(#sum(wo * wm)));
    const auto Fh(micrograinFresnel(this, params, dotWoWm));
    const auto Fo(micrograinFresnel(this, params, cosThetao));
    const auto Fi(micrograinFresnel(this, params, cosThetai));
    const float D(micrograin::normal_pdf(tau0, beta, wm));
    const float hT(micrograin::beta_transform_normal(beta, wm).z);
    const float Gdist(micrograin::distant_gaf(tau0, wiT, woT, hT));
    // Specular micrograin component [Eq. 22] plus the diffuse visibility
    // integral [Eq. 21], which has no closed form and is estimated
    // stochastically with a single micrograin normal drawn proportional to
    // `D(m) m.z`, as the paper evaluates it. The estimate is unbiased, and
    // because the generator stream depends only on the seed and the symmetric
    // direction-pair hash, never on the order or transport sense of the
    // directions, the evaluation remains exactly reciprocal. The
    // foreshortening and per-normal GAF concentrate the response in the
    // visible, doubly-lit part of the grain, which brightens toward grazing as
    // pores close up, instead of a flat Lambertian wash.
    const auto Kd(this.grain_diffuse_albedo);
    auto fDiffuse((1 - Fh) * (1 - Fh) * Kd * 0.0);
    if (average(Kd) > 0) {
      const auto uD(generate_float2(&rng));
      const auto wmD(micrograin::normal_sample(tau0, beta, uD.x, uD.y));
      const float dotWoWmD(#sum(wo * wmD));
      const float dotWiWmD(#sum(wi * wmD));
      if ((dotWoWmD > 0.0) & (dotWiWmD > 0.0)) {
        const float GD(micrograin::distant_gaf(tau0, wiT, woT, micrograin::beta_transform_normal(beta, wmD).z));
        fDiffuse = tau0 * Kd / $PI * (dotWoWmD * dotWiWmD / wmD.z * GD) * ((1 - micrograinFresnel(this, params, dotWoWmD)) * (1 - micrograinFresnel(this, params, dotWiWmD))) / cosThetao;
      }
    }
    auto fGrain(fDiffuse + tau0 * D * Gdist * Fh / (4 * cosThetao));
    fGrain *= shadingNormalCorrection if (isImportance);
    // Sampling densities: base through pores, else diffuse-or-specular
    // micrograin by the relative albedo chance [Eqs. 26-27]. The chance is an
    // exact guarded branch so it stays identical to the selection chance in
    // `scatterSample`, and the half-vector Jacobian division is guarded
    // against the corner where a valid half vector's projection rounds to zero.
    const float avgKd(average(Kd));
    const float2 avgF(average(Fo), average(Fi));
    const float2 pDiffuse(#select((t := avgKd + avgF) > 0.0, avgKd / t, float2(0.0)));
    const float pdfSpec(dotWoWm > 0.0 ? D * wm.z / (4 * dotWoWm) : 0.0);
    const float2 pdfGrain(pDiffuse * float2(cosThetai, cosThetao) / $PI + (1 - pDiffuse) * pdfSpec);
    return ScatterEvaluateResult(f: fGrain + Vp * resultBase.f, pdf: pBase * resultBase.pdf + (1 - pBase) * pdfGrain);
  } else {
    // Transmission passes through the pores only. The grain layer is
    // treated as symmetric front-to-back.
    return ScatterEvaluateResult(f: Vp * resultBase.f, pdf: pBase * resultBase.pdf, isBlack: resultBase.isBlack);
  }
}

@(macro)
auto normalSample(const &micrograin_layer this, const &ScatterNormalParameters params) =
  normalSampleMasked(visit &this.base, params);

@(macro)
auto normalEvaluate(const &micrograin_layer this, const &ScatterNormalParameters params) =
  normalEvaluateMasked(visit &this.base, params);

@(macro)
auto scatterSample(const &micrograin_layer this, inline const &ScatterSampleParameters params) {
  preserve tangent_u, normal;
  // The frame the base is seen in through the pores, which is the one
  // this layer inherited: the grains sit on the substrate and orient
  // themselves, they do not reorient it. Captured before the grain frame
  // displaces it, because the base is sampled below.
  const auto baseNormal(normal);
  const auto baseTangentU(tangent_u);
  tangent_u = this.tangent_u;
  normal = layerNormal(this.normal, normal);
  const auto tbn(recalculateTangentSpace(params));
  return ScatterSampleResult() if (!tbn);
  const float tau0(this.filling_factor);
  const float2 beta(this.beta_u, this.beta_v);
  // The first branch is the base, the second this layer's own lobe, which
  // is why the lobes of the second are spelled out rather than read off a
  // child.
  const float rawChanceBase(micrograin::base_chance(tau0, micrograin::beta_transform(beta, wo).z));
  const float chanceBase(maskedChance(rawChanceBase, this.base.df_lobes,
                                      DF_SMOOTH_BRDF, lobeMask));
  if (sampling::bool_sample(&xi.z, chanceBase)) {
    lobeChance *= rawChanceBase;
    // The base answers in the inherited frame, which is where
    // `scatterEvaluate` evaluates it and so where the density reported
    // for this draw comes from. Sampling it in the grain frame instead
    // would weigh a draw from one distribution by the density of
    // another. The grain frame is back in place for the reweight below.
    auto result(return_from {
      preserve tangent_u, normal, wo;
      tangent_u = baseTangentU, normal = baseNormal;
      return scatterSampleMasked(visit &this.base, params);
    });
    if (result.fDirac) {
      // Reweight sampled Dirac lobes by pore visibility over the selection
      // chance, mirroring `custom_curve_layer`. The ratio is intrinsically
      // bounded: the bidirectional GAF is at most the unidirectional pore
      // visibility that defines `chanceBase`, so the quotient never exceeds 1
      // and no defensive chance floor is needed.
      const auto wiLocal(result.wi * (*tbn));
      const auto woT(micrograin::beta_transform(beta, float3(wo.xy, #abs(wo.z))));
      const auto wiT(micrograin::beta_transform(beta, float3(wiLocal.xy, #abs(wiLocal.z))));
      *result.fDirac *= (1 - tau0) * micrograin::distant_gaf(tau0, wiT, woT, 0.0) / chanceBase;
    }
    return result;
  } else {
    lobeChance *= 1 - rawChanceBase;
    // This layer's own lobe is reached without a dispatcher, so it narrows
    // by hand. Both of its branches are the one lobe the struct declares.
    sampledLobe &= DF_SMOOTH_BRDF;
    const float avgF(average(micrograinFresnel(this, params, #abs(wo.z))));
    const float avgKd(average(this.grain_diffuse_albedo));
    // The exact guarded branch matches the `pDiffuse` weights reported
    // by `scatterEvaluate`.
    const float chanceDiffuse((t := avgKd + avgF) > 0.0 ? avgKd / t : 0.0);
    if (sampling::bool_sample(&xi.w, chanceDiffuse)) {
      return ScatterSampleResult(wi: (*tbn) * sampling::cosine_hemisphere_sample(xi.xy), mode: scatter_reflect);
    } else {
      const auto wm(micrograin::normal_sample(tau0, beta, xi.x, xi.y));
      const auto wiLocal(specular::reflect(wo, wm));
      return ScatterSampleResult() if (!(wiLocal.z > 0));
      return ScatterSampleResult(wi: (*tbn) * wiLocal, mode: scatter_reflect);
    }
  }
}
//--}

//--{ hapke_bsdf
// NOTE: This is non-standard!

// The Gauss-Legendre rule on the phase angle `g` over `[0,pi]` that normalizes the
// opposition surge and integrates the single-scattering albedo at construction. One
// row per node, `{weight, cos(g), sin(g), tan(g/2), 2 g/pi - 1}`, with everything the
// quadrature needs precomputed so the loop makes no trigonometric call and takes no
// square root or divide. The `sin(g)` column is the spherical measure of the surge
// normalizer, `tan(g/2)` is the surge argument, and the last column is the abscissa
// the W density below is evaluated at.
//
// 16 nodes cost at most 7.1e-5 relative on the single-scattering albedo, which is
// exactly the realized white-sky albedo error because the surge normalizer cancels
// between that albedo and the phase function. This quadrature runs once per
// instantiation, so the node count is worth choosing carefully.
//
// Regenerate with `misc/gen_hapke_smdl_tables.py`.
// smdl format off
static const auto HAPKE_QUAD = auto[16](
  auto(0.0426509835, 0.999861409, 0.0166482032, 0.00832467848, -0.989400935),
  auto(0.0977876067, 0.996212554, 0.086951409, 0.0435581917, -0.944575023),
  auto(0.149474641, 0.977808138, 0.209502376, 0.105926541, -0.865631202),
  auto(0.19576673, 0.927094889, 0.374826716, 0.194503508, -0.755404408),
  auto(0.23498483, 0.825200872, 0.564839376, 0.309466966, -0.617876244),
  auto(0.265710439, 0.658971885, 0.752167571, 0.453393802, -0.458016778),
  auto(0.286832774, 0.428057064, 0.903751708, 0.632854058, -0.281603551),
  auto(0.297588323, 0.148691866, 0.988883577, 0.860878018, -0.0950125098),
  auto(0.297588323, -0.148691866, 0.988883577, 1.16160476, 0.0950125098),
  auto(0.286832774, -0.428057064, 0.903751708, 1.58014314, 0.281603551),
  auto(0.265710439, -0.658971885, 0.752167571, 2.20558816, 0.458016778),
  auto(0.23498483, -0.825200872, 0.564839376, 3.23136267, 0.617876244),
  auto(0.19576673, -0.927094889, 0.374826716, 5.14129545, 0.755404408),
  auto(0.149474641, -0.977808138, 0.209502376, 9.44050459, 0.865631202),
  auto(0.0977876067, -0.996212554, 0.086951409, 22.9577942, 0.944575023),
  auto(0.0426509835, -0.999861409, 0.0166482032, 120.124759, 0.989400935));
// smdl format on

// The Chebyshev energy normalization. `HAPKE_W_CHEB` holds the tensor coefficients of
// the W DENSITY (mass per radian of phase angle) on `x = 2 g/pi - 1` and `y = 2 r - 1`,
// so `density(g, r) = sum_ab W[a][b] T_a(x) T_b(y)` clamped at zero, and
// `HAPKE_G_CHEB` the same for `G = Fhat/w` on `x = 2 gamma - 1`, giving
// `EbarK = w (A_ss + w G)`. Both are stored roughness-major, transposed relative to
// the reference implementation, so that collapsing the roughness axis is a handful
// of vector multiply-adds instead of a Clenshaw recurrence per coefficient. The
// fits carry 83 constants for an end-to-end albedo error of 1.4e-3.
// smdl format off
static const auto HAPKE_W_CHEB = auto[5](
  auto(0.0443692637, -0.0330322166, -0.0414806793, 0.0377322324,
       -0.0036831791, -0.00503835424, 0.000809641201, 0.000328879959,
       2.18482055e-05, -1.60545071e-05, -1.57504064e-05),
  auto(-0.00594076498, 0.000757196179, 0.0081566095, -0.000627186314,
       -0.00248094082, -0.000488022104, 0.000297539468, 0.000375439189,
       -8.86163641e-06, -3.29277167e-05, -3.83729896e-05),
  auto(-0.000963613192, 0.000466153409, 0.00149075512, -0.000673457031,
       -0.000758809229, 0.000127478645, 0.000295317848, 0.00011745609,
       -6.84391571e-05, -5.81575106e-05, -1.47705227e-05),
  auto(0.000275487885, 6.03421013e-05, -0.000403479982, -0.000190433817,
       0.000111667449, 0.000185513524, 6.24427123e-05, -7.37454173e-05,
       -7.16632707e-05, -2.55167593e-05, 1.67814334e-05),
  auto(-2.62793436e-05, -3.65689393e-05, 6.2527643e-06, 6.15744651e-05,
       6.90324901e-05, -6.91503114e-06, -5.56055434e-05, -4.09210276e-05,
       7.60283579e-06, 2.61753306e-05, 1.97457206e-05));
static const auto HAPKE_G_CHEB = auto[4](
  auto(0.299680994, -0.25994946, 0.0835171816, -0.0234697031, 0.0061327028, -0.00150566063, 0.00036640673),
  auto(-0.0526057365, 0.0529757455, -0.0205834026, 0.00702317686, -0.00220447865, 0.000635609701, -0.000179704911),
  auto(-0.0107799361, 0.00980414131, -0.00314615761, 0.000844617944, -0.00020008313, 4.17196758e-05, -7.49359084e-06),
  auto(0.00182228246, -0.00183367741, 0.00081867027, -0.000334625137, 0.000123845828, -4.06381678e-05, 1.27990763e-05));
// smdl format on

/// Evaluate a Chebyshev series by the Clenshaw recurrence, `x` in `[-1,1]`.
///
/// NOTE: Generic in both the coefficients and `x`, so the same routine serves
/// the scalar density evaluation at construction and the spectral `EbarK`
/// evaluation.
@(pure)
auto hapkeChebEval(const auto c, const int n, const auto x) {
  auto b1(0.0 * x);
  auto b2(0.0 * x);
  for (int k = n - 1; k >= 1; k--) {
    const auto t(2.0 * x * b1 - b2 + c[k]);
    b2 = b1;
    b1 = t;
  }
  return x * b1 - b2 + c[0];
}

/// The tangent of the half phase angle, which is the natural argument of the surge.
@(pure macro)
float hapkeTanHalfAngle(const float cosG) = #sqrt((1.0 - cosG) / #max(1.0 + cosG, 1e-12));

/// The two-lobe Henyey-Greenstein phase function in Hapke's convention, where the
/// first lobe peaks at `g = 0`, which is to say at backscatter. The sharpness `b`
/// narrows both lobes and the weight `c` balances backward against forward.
@(pure)
float hapkePhase(const float b, const float c, const float cosG) {
  const auto numer(1.0 - b * b);
  const auto back(1.0 - 2.0 * b * cosG + b * b);
  const auto fwd(1.0 + 2.0 * b * cosG + b * b);
  return 0.5 * (1.0 + c) * numer / (back * #sqrt(back)) + //
         0.5 * (1.0 - c) * numer / (fwd * #sqrt(fwd));
}

/// The shadow-hiding opposition effect (SHOE, Hapke 1986). Near `g = 0` a grain hides
/// its own shadow, brightening retro-reflection by `B0 / (1 + tan(g/2)/h)`.
@(pure macro)
float hapkeSurge(const float B0, const float h, const float tanHalfG) = B0 / (1.0 + tanHalfG / h);

/// The Chandrasekhar H-function in the Hapke (2002) rational-log approximation, whose
/// error is under 1 percent against the exact integral-equation solution. The product
/// `H(mu0) H(mu) - 1` is the isotropic approximation of everything scattered more than
/// once: it grows from 1 on a dark surface toward roughly 3 as `w` approaches 1 at
/// high cosines, which is where bright surfaces get their flattened limbs.
@(pure)
auto hapkeH(const float x, const auto w, const auto r0) {
  const auto xs(#max(x, 1e-6));
  return 1.0 / (1.0 - w * xs * (r0 + 0.5 * (1.0 - 2.0 * r0 * xs) * #log(1.0 + 1.0 / xs)));
}

/// The energy-conserving Hapke BRDF for granular surfaces.
///
/// The distribution is a normalized Hapke shape kernel times the prescribed `albedo`,
/// `f = albedo * K / EbarK`, where `EbarK` is the kernel's own bihemispherical albedo,
/// so that the realized white-sky albedo equals `albedo` exactly for every setting of
/// the four directional parameters. They redistribute energy without creating or
/// destroying it. The kernel itself is
///
///     K = w / (4 pi (mu0e + mue)) * [ptilde(g) + H(mu0e) H(mue) - 1] * S
///
/// which is the Lommel-Seeliger single-scattering core, the surge-folded two-lobe
/// Henyey-Greenstein phase function `ptilde`, isotropic multiple scattering built from
/// the Hapke (2002) H-functions, and the Hapke (1984) macroscopic-roughness shadowing
/// `S`, assembled in its manifestly reciprocal form.
///
/// NOTE: The `albedo` is not a tint. It is the reflectance the surface
/// actually realizes under uniform illumination, so it is meaningful to
/// drive it with a measured or modeled soil spectrum.
///
export struct hapke_bsdf: bsdf {
  /// The albedo, realized exactly as the bihemispherical (white-sky) reflectance.
  const $(color | float) albedo = 1.0;

  /// The roughness, being the Hapke mean facet slope `theta_bar = 30 degrees * roughness`.
  float roughness = 0.0;

  /// The mean facet slope in radians, set directly, overriding `roughness` and
  /// reaching past the 30 degrees that saturates it.
  ///
  /// The ceiling is there because the energy normalization is TABULATED against
  /// the roughness, unlike the phase function, which is integrated at
  /// construction. Going beyond 30 degrees therefore extrapolates the Chebyshev
  /// fits rather than evaluating them, which is affordable: they are low order
  /// in the roughness and the realized white-sky albedo drifts by 0.72 percent
  /// at 40 degrees, inside the 1.2 percent the normalization is accurate to. It
  /// is capped at 40 degrees because that is where both that budget and Hapke's
  /// own macroscopic-roughness formulation run out.
  ///
  /// NOTE: Worth reaching for only above 30 degrees. Below it, set `roughness`:
  /// the two are the same number through `theta_bar = 30 degrees * roughness`, and
  /// the fits are interpolating rather than extrapolating there.
  ///
  /// Retrievals over natural ground run from 15 to 35 degrees (Labarre et al.
  /// 2019, over twelve sites), so this only matters for the roughest of it,
  /// where, as that paper reports, the model does poorly anyway.
  ///
  const $(?float) mean_slope = none;

  /// The porosity. `0` is compacted, with a wide opposition surge, and `1` is fluffy
  /// fairy-castle structure, with a narrow one.
  float porosity = 0.5;

  /// The hotspot, being the amplitude `B0` of the shadow-hiding opposition surge.
  float hotspot = 0.8;

  /// The backscatter. `0` is forward-scattering translucent grains and `1` is rough
  /// opaque backscatterers, where soils sit high.
  float backscatter = 0.8;

  /// The two-lobe Henyey-Greenstein parameters `(b, c)` set directly, overriding
  /// `backscatter` and the hockey-stick locus it walks.
  ///
  /// The locus is a one-dimensional fit to laboratory phase functions of ISOLATED
  /// PARTICLES (Hapke 2012, Icarus 221), and it is narrow: the backscatter
  /// asymmetry `<cos g> = b c` caps at about `0.20` along it. Effective phase
  /// functions fitted to whole SURFACES routinely sit outside that, SOILSPECT
  /// (Jacquemoud et al. 1992) fitting soils near `0.55`, in part because it
  /// carries no macroscopic roughness term and absorbs into its phase function
  /// the roughness this BSDF handles separately. The locus cannot reach such a
  /// fit even in principle, so this is the way out for a caller with measured
  /// BRDF to fit against.
  ///
  /// NOTE: The energy normalization holds regardless. It is not tabulated against
  /// `b` and `c`: the constructor integrates the phase function it is actually
  /// given over the same quadrature, so the realized white-sky albedo still equals
  /// `albedo` exactly, on the locus or off it.
  ///
  /// NOTE: The caller owns the validity of what it passes. The two-lobe form
  /// weights its backward and forward lobes by `(1 + c)/2` and `(1 - c)/2`, so
  /// `|c| > 1` makes one negative, and the sum goes negative at some phase angle
  /// unless `b` is small enough to keep the other dominant. The normalization
  /// will faithfully normalize such a phase function, and the result is not a
  /// BRDF. Hapke's own locus reaches `c = 1.86` at `b = 0.10` and stays positive,
  /// which is roughly the shape of the safe region.
  ///
  const $(?float2) phase = none;

  /// The single-scattering albedo `w`.
  auto _ssa = albedo;

  /// The diffusive reflectance `r0`, which is the clamped albedo by construction.
  auto _diffRefl = albedo;

  /// The albedo per unit kernel, `A / (A_ss + w G)`.
  auto _scale = albedo;

  /// The Henyey-Greenstein lobe sharpness `b`.
  float _hgSharpness = 0.0;

  /// The Henyey-Greenstein backward-to-forward weight `c`.
  float _hgBackWeight = 0.0;

  /// The opposition surge width `h`.
  float _surgeWidth = 0.0;

  /// The reciprocal of the surge normalization `N_B`.
  float _invSurgeNorm = 1.0;

  /// The tangent of the mean facet slope, where `0` selects the smooth path.
  float _tanMeanSlope = 0.0;

  /// The handle.
  void handle = "";

  /// The flags.
  static const int df_lobes = DF_SMOOTH_BRDF;

  finalize {
    // The slope override enters as the roughness it corresponds to, so that
    // everything downstream, the Chebyshev collapse and the shadowing function
    // alike, has exactly one notion of how rough the surface is.
    roughness = #isVoid(mean_slope) ? saturate(roughness) : clamp(mean_slope * (6 / $PI), 0.0, 4.0 / 3.0);
    porosity = saturate(porosity);
    hotspot = saturate(hotspot);
    backscatter = saturate(backscatter);
    // The phase function follows from the backscatter parameter alone by the empirical
    // "hockey stick" relation (Hapke 2012, Icarus 221), which puts the two
    // Henyey-Greenstein shape parameters on a 1-dimensional locus: `b` walks from
    // 0.65, for smooth translucent grains with a forward lobe, down to 0.10, for rough
    // opaque agglomerates with a strong retro lobe, and `c` follows the locus centroid.
    // A caller that steps off the locus leaves `backscatter` unused; the quadrature
    // below integrates whatever it is handed.
    if (#isVoid(phase)) {
      _hgSharpness = 0.65 + (0.10 - 0.65) * backscatter;
      _hgBackWeight = 3.29 * #exp(-17.4 * _hgSharpness * _hgSharpness) - 0.908;
    } else {
      // `b` is clamped because it is a Henyey-Greenstein asymmetry and the lobe
      // denominators degenerate at 1. `c` is not, because there is no bound to
      // clamp it to that does not also exclude the locus itself.
      _hgSharpness = clamp(phase.x, 0.0, 0.99);
      _hgBackWeight = phase.y;
    }
    // The porosity sets the surge width through Hapke (1986), `h = -(3/8) ln(1 - phi)`
    // for a filling factor `phi`. Compacted soil (parameter 0, `phi = 0.48`, `h ~ 0.25`)
    // has the WIDE surge and fluffy fairy-castle structure (parameter 1, `phi = 0.10`,
    // `h ~ 0.04`) the narrow one, which puts the soil-typical `h ~ 0.11` mid-range.
    _surgeWidth = -0.375 * #log(1.0 - (0.10 + (0.48 - 0.10) * (1.0 - porosity)));
    const auto meanSlope(($PI / 6) * roughness);
    _tanMeanSlope = meanSlope < 1e-8 ? 0.0 : #tan(meanSlope);
    // Collapse the roughness axis of both Chebyshev fits, walking the basis up by the
    // recurrence `T_k = 2 y T_(k-1) - T_(k-2)`. Each leaves one coefficient vector.
    const auto y(2.0 * roughness - 1.0);
    const auto y2(2.0 * y * y - 1.0);
    const auto y3(2.0 * y * y2 - y);
    const auto y4(2.0 * y * y3 - y2);
    const auto wcol(
      HAPKE_W_CHEB[0] + y * HAPKE_W_CHEB[1] + y2 * HAPKE_W_CHEB[2] + //
      y3 * HAPKE_W_CHEB[3] + y4 * HAPKE_W_CHEB[4],
    );
    const auto gcol(
      HAPKE_G_CHEB[0] + y * HAPKE_G_CHEB[1] + y2 * HAPKE_G_CHEB[2] + //
      y3 * HAPKE_G_CHEB[3],
    );
    // The surge is made energy-neutral by folding `1 + B_S` into the phase function and
    // renormalizing over the sphere, `ptilde = p (1 + B_S) / N_B`, so that it steepens
    // the retro peak at the expense of mid phase angles instead of injecting energy; a
    // raw additive surge would inflate the single-scattering albedo. That albedo per
    // unit `w`, `A_ss`, integrates `ptilde` against the fitted W density over the same
    // rule, with no `sin(g)` because the density already carries the measure.
    // Accumulating it un-normalized folds both integrals into a single pass.
    float surgeAcc = 0.0;
    float ssAcc = 0.0;
    for (int j = 0; j < #num(HAPKE_QUAD); j++) {
      const auto node(HAPKE_QUAD[j]);
      const auto weightedPhase(node[0] * hapkePhase(_hgSharpness, _hgBackWeight, node[1]));
      const auto surge(hapkeSurge(hotspot, _surgeWidth, node[3]));
      const auto density(#max(hapkeChebEval(wcol, #num(wcol), node[4]), 0.0));
      surgeAcc += weightedPhase * surge * node[2];
      ssAcc += weightedPhase * (1.0 + surge) * density;
    }
    _invSurgeNorm = 1.0 / (1.0 + 0.5 * surgeAcc);
    const auto ssAlbedoPerW(ssAcc * _invSurgeNorm);
    // Bind the spectrum. Prescribing the albedo as the diffusive reflectance `r0` gives
    // the closed-form inversion `gamma = (1 - A)/(1 + A)` and `w = 1 - gamma^2`, so
    // bright bands get the physically correct multiple-scattering flattening (a
    // wavelength-dependent lobe SHAPE) while dividing by the kernel's own white-sky
    // albedo `EbarK = w (A_ss + w G)` makes the realized white-sky albedo equal `A`
    // exactly. The kernel's own factor of `w` cancels against `EbarK` in closed
    // form, which is better conditioned at the dark end than carrying both.
    const auto A(clamp(albedo, 1e-6, 1.0 - 1e-6));
    const auto gamma((1.0 - A) / (1.0 + A));
    _ssa = 1.0 - gamma * gamma;
    _diffRefl = A;
    _scale = A / (ssAlbedoPerW + _ssa * hapkeChebEval(gcol, #num(gcol), 2.0 * gamma - 1.0));
  }
};

/// Evaluate the Hapke BRDF, without the cosine factor, for directions expressed in the
/// shading tangent space and understood to be in the upper hemisphere.
@(pure noinline)
auto hapkeEvaluateBRDF(const &hapke_bsdf this, const float3 wo, const float3 wi) {
  const auto mu0(clamp(wi.z, 1e-4, 1.0));
  const auto mu(clamp(wo.z, 1e-4, 1.0));
  const auto cosG(clamp(#sum(wi * wo), -1.0, 1.0));
  // The relative azimuth between the incidence and exit planes, which degenerates to
  // zero when either direction comes within numerical reach of the pole.
  const auto sinScale(length(wi.xy) * length(wo.xy));
  const auto cosPsi(sinScale > 1e-6 ? clamp(#sum(wi.xy * wo.xy) / sinScale, -1.0, 1.0) : 1.0);
  const auto psi(#acos(cosPsi));
  const auto surge(hapkeSurge(this.hotspot, this._surgeWidth, hapkeTanHalfAngle(cosG)));
  const auto phase(hapkePhase(this._hgSharpness, this._hgBackWeight, cosG) * (1.0 + surge) * this._invSurgeNorm);
  // The geometry factor and the effective cosines that the H-functions see. On a smooth
  // surface the factor is just the Lommel-Seeliger denominator and `1/(4 pi)`.
  const auto geom = return_from {
    return auto(1.0 / (4.0 * $PI * (mu0 + mu)), mu0, mu) if (this._tanMeanSlope == 0.0);
    // With macroscopic roughness (Hapke 1984), facets with a Gaussian slope distribution
    // of mean angle `theta_bar` tilt and shadow the surface through the slope
    // normalization `chi`, the shadowing onset `E1` and depth `E2`, and the azimuth
    // correlation `f`, all assembled below in the manifestly reciprocal form. The
    // raw-`mu0` factor of Hapke's published shadowing function `S` cancels the BRDF's
    // `1/mu0`, which is what makes the swap of incidence and exit exact.
    const auto tanT(this._tanMeanSlope);
    const auto cotT(1.0 / tanT);
    const auto chi(1.0 / #sqrt(1.0 + $PI * tanT * tanT));
    const auto sin0(#sqrt(#max(1.0 - mu0 * mu0, 0.0)));
    const auto sine(#sqrt(#max(1.0 - mu * mu, 0.0)));
    // Both shadowing exponentials want `cot(theta_bar)` times the direction's own
    // cotangent, so the product is formed once.
    const auto cotI(cotT * mu0 / #max(sin0, 1e-6));
    const auto cotE(cotT * mu / #max(sine, 1e-6));
    const auto E1i(#exp(-(2.0 / $PI) * cotI));
    const auto E1e(#exp(-(2.0 / $PI) * cotE));
    const auto E2i(#exp(-(1.0 / $PI) * cotI * cotI));
    const auto E2e(#exp(-(1.0 / $PI) * cotE * cotE));
    const auto f(#exp(-2.0 * #tan(#min(0.5 * psi, 1.5707))));
    const auto etaI(chi * (mu0 + sin0 * tanT * E2i / (2.0 - E1i)));
    const auto etaE(chi * (mu + sine * tanT * E2e / (2.0 - E1e)));
    // The direction with the LARGER zenith angle leads in Hapke's two-branch formulas.
    const bool bigI(mu0 <= mu);
    const auto E1L(bigI ? E1i : E1e);
    const auto E1l(bigI ? E1e : E1i);
    const auto E2L(bigI ? E2i : E2e);
    const auto E2l(bigI ? E2e : E2i);
    const auto sinHalfPsi(#sin(0.5 * psi));
    const auto s2(sinHalfPsi * sinHalfPsi);
    const auto D(#max(2.0 - E1L - (psi / $PI) * E1l, 1e-6));
    const auto cosL(#min(mu0, mu));
    const auto cosl(#max(mu0, mu));
    const auto sinL(#sqrt(#max(1.0 - cosL * cosL, 0.0)));
    const auto sinl(#sqrt(#max(1.0 - cosl * cosl, 0.0)));
    const auto effL(chi * (cosL + sinL * tanT * (E2L - s2 * E2l) / D));
    const auto effl(chi * (cosl + sinl * tanT * (#cos(psi) * E2L + s2 * E2l) / D));
    const auto mu0Eff(bigI ? effL : effl);
    const auto muEff(bigI ? effl : effL);
    const auto etaMin(bigI ? etaE : etaI); // The eta of the smaller zenith
    const auto shadow(chi / (1.0 - f + f * chi * cosl / etaMin));
    const auto factor(mu0Eff * muEff / ((mu0Eff + muEff) * etaI * etaE) * shadow / (4.0 * $PI));
    return auto(factor, mu0Eff, muEff);
  };
  const auto H0(hapkeH(geom[1], this._ssa, this._diffRefl));
  const auto H1(hapkeH(geom[2], this._ssa, this._diffRefl));
  // The clamp guards the tiny negative excursions of the approximate H-functions.
  return this._scale * geom[0] * (phase + #max(H0 * H1 - 1.0, 0.0));
}

@(pure)
auto scatterEvaluate(const &hapke_bsdf this, inline const &ScatterEvaluateParameters params) {
  if (mode == scatter_reflect && recalculateTangentSpace(params)) {
    const auto cosTheta(#abs(auto(wi.z, wo.z)));
    const auto pdf(cosTheta / $PI);
    auto result(ScatterEvaluateResult(f: hapkeEvaluateBRDF(this, wo, wi) * cosTheta[0], pdf: pdf));
    result.f *= shadingNormalCorrection if (isImportance);
    return result;
  } else {
    return ScatterEvaluateResult(isBlack: true);
  }
}

@(pure)
auto scatterSample(const &hapke_bsdf this [[anno::unused()]], inline const &ScatterSampleParameters params) {
  if ((tbn := recalculateTangentSpace(params))) {
    return ScatterSampleResult(wi: (*tbn) * sampling::cosine_hemisphere_sample(xi.xy), mode: scatter_reflect);
  } else {
    return ScatterSampleResult(); // Reject
  }
}
//--}

//--{ hair
// The roughness floors of the hair model, following the reference
// implementation: the longitudinal variance and azimuthal logistic scale
// are floored rather than special-cased, so `(0, 0)` roughness is a
// near-specular but smooth lobe with no Dirac delta path.
const float HAIR_MIN_ROUGHNESS = 1e-7;

// The guard on the cosine denominators of the hair refraction geometry.
const float HAIR_MIN_COS_THETA = 1e-8;

// The cull threshold on the cosine between a direction and the fiber
// cross-section plane. Numerically parallel to the axis the cross-section
// projection degenerates, and a normalized `float` vector that started
// exactly on the axis can land at a cosine as large as about 5e-4, so the
// threshold must sit above that rather than at `MIN_COS_THETA`.
const float HAIR_MIN_AXIS_COS_THETA = 1e-3;

// The scale from the user-facing azimuthal roughness to the logistic
// scale, `sqrt(pi / 8)`, following the reference implementation.
const float HAIR_AZIMUTHAL_SCALE = 0.62665707;

/// Pure math for the Chiang hair model, individually testable. Directions
/// live in the hair frame: X is the fiber tangent pointing root to tip, Z
/// is the cross-section normal at the hit point, `sin(theta) = w.x`, and
/// `phi = atan2(w.z, w.y)`.
export namespace hair {

/// The modified Bessel function of the first kind and order zero, by its
/// power series (10 terms, accurate for arguments up to about 12).
@(pure)
export float bessel_i0(const float x) {
  float result(0.0);
  float term(1.0);
  const float x2(x * x);
  for (int i = 0; i < 10; i++) {
    result += term;
    term *= x2 / (4.0 * (i + 1.0) * (i + 1.0));
  }
  return result;
}

/// The natural logarithm of `bessel_i0`, switching to the asymptotic
/// expansion where the power series stops converging.
@(pure)
export float log_bessel_i0(const float x) {
  return x > 12.0 //
         ? x + 0.5 * (#log(1.0 / x) + 1.0 / (8.0 * x) - #log($TWO_PI)) : #log(bessel_i0(x));
}

/// The logistic density with scale `s`, in the overflow-safe form that
/// only ever exponentiates `-#abs(x) / s`.
@(pure)
export float logistic_pdf(const float x, const float s) {
  const float e(#exp(-#abs(x) / s));
  return e / (s * (1.0 + e) * (1.0 + e));
}

/// The logistic cumulative distribution with scale `s`.
@(pure)
export float logistic_cdf(const float x, const float s) = 1.0 / (1.0 + #exp(-x / s));

/// The logistic density with scale `s` renormalized to `[a, b]`.
@(pure)
export float trimmed_logistic_pdf(const float x, const float s, const float a, const float b) = logistic_pdf(x, s) / (logistic_cdf(b, s) - logistic_cdf(a, s));

/// Sample `trimmed_logistic_pdf` exactly by inverting the CDF.
@(pure)
export float trimmed_logistic_sample(const float xi, const float s, const float a, const float b) {
  const float cdfa(logistic_cdf(a, s));
  const float k(logistic_cdf(b, s) - cdfa);
  return clamp(-s * #log(1.0 / (xi * k + cdfa) - 1.0), a, b);
}

/// Wrap the angle to `[-pi, pi]`.
@(pure)
export float wrap_angle(const float phi) = phi - $TWO_PI * #floor(phi / $TWO_PI + 0.5);

/// The longitudinal scattering term of d'Eon et al., "An Energy-Conserving
/// Hair Reflectance Model" (2011), normalized so that its cosine-weighted
/// integral over `theta_i` in `[-pi/2, pi/2]` is 1. The small-variance
/// branch evaluates in log space: at the roughness floor the direct
/// `sinh(1 / v)` overflows immediately.
@(pure)
export float m_term(const float v, const float sinThetai, const float cosThetai, const float sinThetao, const float cosThetao) {
  const float a(cosThetai * cosThetao / v);
  const float b(sinThetai * sinThetao / v);
  return v <= 0.1 //
         ? #exp(log_bessel_i0(a) - b - 1.0 / v - #log(v)) : #exp(-b) * bessel_i0(a) / (2.0 * v * #sinh(1.0 / v));
}

/// The azimuthal deflection of the perfect specular path of lobe `p`,
/// entering the cross section at offset angle `gammao` and refracting to
/// `gammat`.
@(pure)
export float azimuthal_offset(const int p, const float gammao, const float gammat) = 2.0 * p * gammat - 2.0 * gammao + p * $PI;

/// The azimuthal scattering term of lobe `p`: a trimmed logistic with
/// scale `s` about `azimuthal_offset` for the R, TT, and TRT lobes, and
/// uniform for the residual lobe.
@(pure)
export float n_term(const int p, const float s, const float phi, const float gammao, const float gammat) {
  return p < 3 //
         ? trimmed_logistic_pdf(wrap_angle(phi - azimuthal_offset(p, gammao, gammat)), s, -$PI, $PI) : 0.5 / $PI;
}

/// Rotate the longitudinal `(sin, cos)` pair by the cuticle tilt of lobe
/// `p`, being `2 alpha` for R, `-alpha` for TT, `-4 alpha` for TRT, and
/// no tilt for the residual lobe. Pass `-alpha` for the inverse rotation
/// that makes sampling agree with evaluation.
@(pure)
export float2 tilt(const int p, const float alpha, const float2 sinCosTheta) {
  const float a((p < 3 ? 2 - 3 * p : 0) * alpha);
  return float2(sinCosTheta.x * #cos(a) + sinCosTheta.y * #sin(a), //
                sinCosTheta.y * #cos(a) - sinCosTheta.x * #sin(a));
}

/// The scalar attenuation of the four lobes as `(R, TT, TRT, residual)`,
/// where `fresnel` is the dielectric reflectance at the incidence cosine
/// `cos(theta_o) * cos(gamma_o)` and `transmittance` is the internal
/// transmittance of a single crossing. The residual component sums the
/// geometric tail of the higher-order roundtrips in closed form; with
/// unit transmittance the four components telescope to a sum of exactly 1.
@(pure)
export float4 attenuation(const float fresnel, const float transmittance) {
  // Defensive: the reflectance rounds to 1 at numerically grazing
  // incidence, where the transmitted lobes must vanish so the residual
  // denominator stays away from 0.
  const float T(fresnel < 1.0 ? transmittance : 0.0);
  const float A0(fresnel);
  const float A1((1.0 - fresnel) * (1.0 - fresnel) * T);
  const float A2(A1 * T * fresnel);
  const float A3(A2 * T * fresnel / (1.0 - T * fresnel));
  return float4(A0, A1, A2, A3);
}

}
//--}

//--{ chiang_hair_bsdf
/// The hair BSDF of Chiang et al., "A Practical and Controllable Hair and
/// Fur Model for Production Path Tracing" (2016): four factored lobes
/// `A_p * M_p * N_p` over the R, TT, TRT, and residual paths through the
/// fiber, with d'Eon's longitudinal term, trimmed-logistic azimuthal
/// terms, closed-form attenuation, and an optional extra diffuse lobe.
///
/// The fiber frame is the natural tangent space: X is the fiber tangent
/// pointing root to tip and Z is the shading normal on the fiber surface,
/// from which the cross-section offset is implied as `h = sin(gamma_o)`.
/// Backface flipping never applies: `wo.z < 0` is a legitimate hair
/// configuration, so the scatter parameters must be constructed with
/// `hitBackface: false`, as the hair entry points do.
export struct chiang_hair_bsdf: hair_bsdf {
  /// The diffuse weight.
  ///
  /// > Weight of the additional diffuse reflection component; the hair
  /// > shading model is weighted with `(1 - diffuse_reflection_weight)`.
  ///
  const float diffuse_reflection_weight = 0.0;

  /// The diffuse tint.
  ///
  /// > Scaling factor of the additional diffuse reflection component.
  ///
  const $(color | float) diffuse_reflection_tint = 1.0;

  /// The R lobe roughness.
  ///
  /// > Longitudinal and azimuthal roughness `(nu, s)`. Range
  /// > `[0, inf)^2`, with `(0, 0)` specifying pure specular scattering.
  ///
  const float2 roughness_R = float2(0.0);

  /// The TT lobe roughness, defaulting to `roughness_R`.
  const float2 roughness_TT = roughness_R;

  /// The TRT lobe roughness, defaulting to `roughness_TT`. The residual
  /// fourth lobe reuses the TRT longitudinal roughness and needs no
  /// azimuthal roughness.
  const float2 roughness_TRT = roughness_TT;

  /// The cuticle angle in radians.
  ///
  /// > Angle of the scales of the hair fiber's cuticle. A positive value
  /// > tilts the scales toward the root of the fiber. Range
  /// > `(-pi/2, pi/2)`.
  ///
  const float cuticle_angle = 0.0;

  /// The absorption coefficient.
  ///
  /// > Absorption coefficient of the interior of the hair fiber,
  /// > normalized to the hair fiber diameter.
  ///
  const $(color | float) absorption_coefficient = 0.0;

  /// The index of refraction.
  ///
  /// > The absolute index of refraction of the hair fiber. The default
  /// > of `1.55` corresponds to keratin.
  ///
  const float ior = 1.55;

  /// The handle.
  void handle = "";

  /// The flags. `DF_GLOSSY` is deliberately absent: hair scatters about
  /// a fiber axis rather than a surface half vector, so there is no
  /// normal distribution to sample.
  static const int df_lobes = DF_SMOOTH;
};

// The one-sided Chiang evaluation: the value and the density of sampling
// `wi` conditioned on `wo`, both with respect to solid angle. The reverse
// density is the same computation with the directions exchanged. The
// model is famously non-reciprocal in the value, which Chiang et al.
// acknowledge, so no reciprocity identity is expected of it.
struct ChiangHairEvaluation {
  /// The value, already including every cosine-like factor.
  $(color | float) f = 0.0;

  /// The density of sampling `wi` given `wo`.
  float pdf = 0.0;

  /// Is the configuration non-degenerate?
  bool isValid = false;
};

@(pure)
auto chiangHairEvaluate(const &chiang_hair_bsdf this, const float3 wo, const float3 wi) {
  const float sinThetao(wo.x);
  const float sinThetai(wi.x);
  const float cosThetao(#sqrt(#max(1.0 - sinThetao * sinThetao, 0.0)));
  const float cosThetai(#sqrt(#max(1.0 - sinThetai * sinThetai, 0.0)));
  // Cull directions numerically parallel to the fiber axis, where the
  // cross-section projection degenerates. The value and every reported
  // density zero together through the `isValid` convention.
  if (!((cosThetao > HAIR_MIN_AXIS_COS_THETA) & (cosThetai > HAIR_MIN_AXIS_COS_THETA)))
    return ChiangHairEvaluation();
  const float phi(#atan2(wi.z, wi.y) - #atan2(wo.z, wo.y));
  // The cross-section offset is implied by the normal: `cos(gamma_o)` is
  // the cosine between the normal and the projection of `wo` into the
  // cross-section plane, so `h = sin(gamma_o)` with the sign fixed
  // against the binormal. No texture coordinate is consulted.
  const float cosGammao(clamp(wo.z / cosThetao, -1.0, 1.0));
  float sinGammao(#sqrt(#max(1.0 - cosGammao * cosGammao, 0.0)));
  sinGammao = -sinGammao if (wo.y > 0.0);
  const float gammao(#asin(sinGammao));
  // The refraction geometry: the modified index `etap` refracts the
  // cross-section projection, and `theta_t` fixes the internal path
  // length per crossing at `2 cos(gamma_t) / cos(theta_t)` in units of
  // the fiber diameter.
  const float eta(this.ior);
  const float etap(#sqrt(#max(eta * eta - sinThetao * sinThetao, 0.0)) / #max(cosThetao, HAIR_MIN_COS_THETA));
  const float sinGammat(clamp(sinGammao / #max(etap, HAIR_MIN_COS_THETA), -1.0, 1.0));
  const float cosGammat(#sqrt(#max(1.0 - sinGammat * sinGammat, 0.0)));
  const float gammat(#asin(sinGammat));
  const float sinThetat(sinThetao / eta);
  const float cosThetat(#max(#sqrt(#max(1.0 - sinThetat * sinThetat, 0.0)), HAIR_MIN_COS_THETA));
  // The Fresnel term takes the air-to-hair ratio: the material `ior`
  // does not influence hair shading, and `relativeIOR()` deliberately
  // does not apply.
  const float F(specular::dielectric_fresnel(cosThetao * cosGammao, 1.0 / eta));
  const auto sigmaA(#max(this.absorption_coefficient, 0.0));
  const float pathLength(2.0 * cosGammat / cosThetat);
  const auto T(#exp(-sigmaA * pathLength));
  // The scalar lobe weights collapse the transmittance to its maximum
  // element, following the reference implementation.
  const float Ts(#exp(-#minValue(sigmaA) * pathLength));
  const float4 W(hair::attenuation(F, Ts));
  const float wSum(#sum(W));
  // Accumulate `A_p M_p N_p` over the four lobes, with the color-valued
  // attenuation advanced by the same recurrence as `hair::attenuation`.
  const auto Tsafe(F < 1.0 ? T : 0.0 * T);
  const float TsSafe(F < 1.0 ? Ts : 0.0);
  auto A(F + 0.0 * T);
  auto fGlossy(0.0 * T);
  float pdfGlossy(0.0);
  for (int p = 0; p < 4; p++) {
    if (p == 1) {
      A = (1.0 - F) * (1.0 - F) * Tsafe;
    } else if (p == 2) {
      A *= Tsafe * F;
    } else if (p == 3) {
      A *= Tsafe * F / (1.0 - TsSafe * F);
    }
    const float2 roughness(p == 0 ? this.roughness_R : p == 1 ? this.roughness_TT : this.roughness_TRT);
    const float v(#max(roughness.x, HAIR_MIN_ROUGHNESS));
    const float s(#max(roughness.y * HAIR_AZIMUTHAL_SCALE, HAIR_MIN_ROUGHNESS));
    const float2 sc(hair::tilt(p, this.cuticle_angle, float2(sinThetai, cosThetai)));
    const float M(hair::m_term(v, sc.x, #abs(sc.y), sinThetao, cosThetao));
    const float N(hair::n_term(p, s, phi, gammao, gammat));
    fGlossy += A * (M * N);
    pdfGlossy += W[p] * (M * N);
  }
  pdfGlossy = wSum > 0.0 ? pdfGlossy / wSum : 0.0;
  // The extra diffuse lobe of the MDL parameterization, Lambertian about
  // the cross-section normal.
  const float wd(saturate(this.diffuse_reflection_weight));
  const float pdfDiffuse(#max(wi.z, 0.0) / $PI);
  return ChiangHairEvaluation(f: wd * (saturate(this.diffuse_reflection_tint) * pdfDiffuse) + (1.0 - wd) * fGlossy, //
                              pdf: wd * pdfDiffuse + (1.0 - wd) * pdfGlossy,                                        //
                              isValid: true);
}

@(pure)
auto scatterEvaluate(const &chiang_hair_bsdf this, const &ScatterEvaluateParameters params) {
  // Hair is SMOOTH in both domains, so a mask can remove one of its
  // domains by kind while the whole-material gate keeps that domain
  // alive through kinds of other distributions.
  return ScatterEvaluateResult(isBlack: true) //
         if ((int(params.mode) & maskedModeBits(params.lobeMask & this.df_lobes)) == 0);
  // Work directly on the reference directions: the shading normal
  // machinery does not apply because `material.geometry` does not
  // influence hair shading.
  const auto fwd(chiangHairEvaluate(this, params.wo0, params.wi0));
  if (!fwd.isValid)
    return ScatterEvaluateResult(isBlack: true);
  const auto rev(chiangHairEvaluate(this, params.wi0, params.wo0));
  return ScatterEvaluateResult(f: fwd.f, pdf: float2(fwd.pdf, rev.pdf));
}

@(pure)
auto scatterSample(const &chiang_hair_bsdf this, const &ScatterSampleParameters params) {
  const auto wo(params.wo0);
  const float sinThetao(wo.x);
  const float cosThetao(#sqrt(#max(1.0 - sinThetao * sinThetao, 0.0)));
  if (!(cosThetao > HAIR_MIN_AXIS_COS_THETA))
    return ScatterSampleResult(); // Reject
  auto xi(params.xi);
  // One-sample selection between the diffuse lobe and the hair model.
  const float wd(saturate(this.diffuse_reflection_weight));
  if (xi.z < wd)
    return ScatterSampleResult(wi: sampling::cosine_hemisphere_sample(xi.xy), mode: scatter_reflect_transmit);
  xi.z = (xi.z - wd) / (1.0 - wd);
  // The `wo`-side geometry, mirroring `chiangHairEvaluate`.
  const float cosGammao(clamp(wo.z / cosThetao, -1.0, 1.0));
  float sinGammao(#sqrt(#max(1.0 - cosGammao * cosGammao, 0.0)));
  sinGammao = -sinGammao if (wo.y > 0.0);
  const float gammao(#asin(sinGammao));
  const float eta(this.ior);
  const float etap(#sqrt(#max(eta * eta - sinThetao * sinThetao, 0.0)) / #max(cosThetao, HAIR_MIN_COS_THETA));
  const float sinGammat(clamp(sinGammao / #max(etap, HAIR_MIN_COS_THETA), -1.0, 1.0));
  const float cosGammat(#sqrt(#max(1.0 - sinGammat * sinGammat, 0.0)));
  const float gammat(#asin(sinGammat));
  const float sinThetat(sinThetao / eta);
  const float cosThetat(#max(#sqrt(#max(1.0 - sinThetat * sinThetat, 0.0)), HAIR_MIN_COS_THETA));
  const float F(specular::dielectric_fresnel(cosThetao * cosGammao, 1.0 / eta));
  const float Ts(#exp(-#minValue(#max(this.absorption_coefficient, 0.0)) * (2.0 * cosGammat / cosThetat)));
  // Select the lobe by the discrete CDF of the scalar weights.
  const float4 W(hair::attenuation(F, Ts));
  const float wSum(#sum(W));
  if (!(wSum > 0.0))
    return ScatterSampleResult(); // Reject
  int p(3);
  float acc(0.0);
  const float u(xi.z * wSum);
  for (int q = 0; q < 3; q++) {
    acc += W[q];
    if (u < acc) {
      p = q;
      break;
    }
  }
  const float2 roughness(p == 0 ? this.roughness_R : p == 1 ? this.roughness_TT : this.roughness_TRT);
  const float v(#max(roughness.x, HAIR_MIN_ROUGHNESS));
  const float s(#max(roughness.y * HAIR_AZIMUTHAL_SCALE, HAIR_MIN_ROUGHNESS));
  // Longitudinal: the exact inversion of d'Eon et al. draws a cone about
  // the raw `theta_o`, then the inverse cuticle rotation makes sampling
  // agree with the tilt applied on the evaluate side.
  const float cosThetaCone(1.0 + v * #log(#max(xi.x + (1.0 - xi.x) * #exp(-2.0 / v), 1e-30)));
  const float sinThetaCone(#sqrt(#max(1.0 - cosThetaCone * cosThetaCone, 0.0)));
  float sinThetai(-cosThetaCone * sinThetao + sinThetaCone * #cos($TWO_PI * xi.y) * cosThetao);
  float cosThetai(#sqrt(#max(1.0 - sinThetai * sinThetai, 0.0)));
  const float2 sc(hair::tilt(p, -this.cuticle_angle, float2(sinThetai, cosThetai)));
  sinThetai = clamp(sc.x, -1.0, 1.0);
  cosThetai = #sqrt(#max(1.0 - sinThetai * sinThetai, 0.0));
  // Azimuthal: the trimmed logistic about the specular deflection, and
  // uniform for the residual lobe.
  const float phii(p < 3 //
                   ? #atan2(wo.z, wo.y) + hair::azimuthal_offset(p, gammao, gammat) + hair::trimmed_logistic_sample(xi.w, s, -$PI, $PI) : $TWO_PI * xi.w);
  return ScatterSampleResult(wi: float3(sinThetai, cosThetai * #cos(phii), cosThetai * #sin(phii)), mode: scatter_reflect_transmit);
}
//--}

//--{ diffuse_edf
/// A diffuse (Lambertian) Emission Distribution Function (EDF), i.e.,
/// constant radiance over the upper hemisphere.
export struct diffuse_edf: edf {
  /// The handle.
  void handle = "";

  /// The flags. Always zero: the `DF_` flags describe how a surface
  /// scatters, and emission does not scatter.
  static const int df_lobes = 0;
};

@(pure)
auto emissionEvaluate(const &diffuse_edf this [[anno::unused()]], inline const &EmissionEvaluateParameters params) {
  if (recalculateTangentSpace(params)) {
    return EmissionEvaluateResult(f: 1.0 / $PI, pdf: wi.z / $PI);
  } else {
    return EmissionEvaluateResult(isBlack: true);
  }
}

@(pure)
auto emissionSample(const &diffuse_edf this [[anno::unused()]], inline const &EmissionSampleParameters params) {
  return EmissionSampleResult(wi: calculateTangentSpace(normal, tangent_u) * sampling::cosine_hemisphere_sample(xi.xy), isValid: true);
}
//--}

//--{ spot_edf
/// A spot Emission Distribution Function (EDF), i.e., an exponentiated
/// cosine falloff restricted to a cone.
///
/// The cosine is remapped so that it reaches zero at the boundary of the
/// cone: with `theta0 = spread / 2` the distribution is proportional to
/// `((cos(theta) - cos(theta0)) / (1 - cos(theta0)))^exponent` inside the
/// cone and zero outside of it.
///
export struct spot_edf: edf {
  /// The exponent of the cosine falloff.
  float exponent;

  /// The spread, being the full angle of the emission cone in radians. The
  /// default of `$PI` corresponds to the full upper hemisphere.
  float spread = $PI;

  /// > Boolean that chooses between two interpretations of the EDF: the
  /// > directional distribution applied per point in tangent space, or the
  /// > distribution of the light source as a whole in the global frame.
  ///
  /// NOTE: Only the per-point tangent-space interpretation is supported, so
  /// this is accepted and ignored. The luminaire-as-a-whole interpretation
  /// is a host-side concern, e.g., a Dirac spot light.
  ///
  void global_distribution = true;

  /// The global frame.
  ///
  /// NOTE: Only the per-point tangent-space interpretation is supported, so
  /// this is accepted and ignored.
  ///
  void global_frame = float3x3(1.0);

  /// The handle.
  void handle = "";

  /// The precomputed cosine of the cone half angle.
  const float _cosSpread = #cos(0.5 * #min(#max(spread, 1e-6), $PI));

  /// The precomputed normalization such that the cosine-weighted integral
  /// over the cone is 1, i.e., with `c0 = _cosSpread` and `k = exponent`,
  /// the integral of `((x - c0)/(1 - c0))^k x 2 pi dx` over `x` in `[c0, 1]`.
  float _normalization = 0.0;

  /// The flags. Always zero: the `DF_` flags describe how a surface
  /// scatters, and emission does not scatter.
  static const int df_lobes = 0;

  finalize {
    exponent = #max(exponent, 0.0);
    _normalization = 2.0 * $PI * (1.0 - _cosSpread) * (_cosSpread / (exponent + 1.0) + (1.0 - _cosSpread) / (exponent + 2.0));
  }
};

@(pure)
auto emissionEvaluate(const &spot_edf this, inline const &EmissionEvaluateParameters params) {
  if (recalculateTangentSpace(params)) {
    const auto mu((wi.z - this._cosSpread) / (1.0 - this._cosSpread));
    if (!(mu > 0.0))
      return EmissionEvaluateResult(isBlack: true);
    const auto muPowK(#pow(mu, this.exponent));
    return EmissionEvaluateResult(
             f: muPowK / this._normalization,
             pdf: (this.exponent + 1.0) * muPowK / (2.0 * $PI * (1.0 - this._cosSpread)),
           );
  } else {
    return EmissionEvaluateResult(isBlack: true);
  }
}

@(pure)
auto emissionSample(const &spot_edf this, inline const &EmissionSampleParameters params) {
  // Sample `mu` proportional to `mu^exponent`, which is a good, though not
  // perfect, importance sample of the cosine-weighted distribution. The
  // PDF reported by `emissionEvaluate` matches this sampling exactly.
  const auto mu(#pow(xi.x, 1.0 / (this.exponent + 1.0)));
  const auto cosTheta(this._cosSpread + (1.0 - this._cosSpread) * mu);
  const auto sinTheta(#sqrt(#max(1.0 - cosTheta * cosTheta, 0.0)));
  const auto phi($TWO_PI * xi.y);
  return EmissionSampleResult(
           wi: calculateTangentSpace(normal, tangent_u) * float3(sinTheta * #cos(phi), sinTheta * #sin(phi), cosTheta),
           isValid: true,
         );
}
//--}

//--{ light_profile utilities
/// Is the light profile valid, i.e., backed by a loaded IES file?
@(pure macro)
export bool light_profile_isvalid(const light_profile profile) = bool(profile.ptr);

/// The total power emitted by the light profile in watts, being the
/// intensity integrated over the sphere of directions. This is zero if
/// the light profile is invalid.
@(pure macro)
export float light_profile_power(const light_profile profile) = profile.power;

/// The maximum intensity of the light profile in watts per steradian.
/// This is zero if the light profile is invalid.
@(pure macro)
export float light_profile_maximum(const light_profile profile) = profile.max_intensity;
//--}

//--{ measured_edf
/// Declare the light profile interpolation routine implemented in
/// `lib/LightProfile.cc` and registered as a JIT builtin by
/// `#loadLightProfile` in `lib/Compiler/Emitter.cc`.
@(pure foreign)
float smdlLightProfileInterpolate(const &void profile, const &float3 wo);

/// Declare the light profile direction PDF routine, being the exact
/// solid-angle density over the sphere of the direction sampling routine
/// in the profile's own coordinate system.
@(pure foreign)
float smdlLightProfileDirectionPDF(const &void profile, const &float3 wi);

/// Declare the light profile direction sampling routine.
@(pure foreign)
void smdlLightProfileDirectionSample(const &void profile, const &float2 xi, const &float3 wi, const &float pdf);

/// A measured Emission Distribution Function (EDF), i.e., an IES light
/// profile applied per point in tangent space: the profile's vertical
/// axis (vertical angle 0) is aligned with the shading normal, and its
/// horizontal angle 0 is aligned with `tangent_u`.
///
/// The EDF value is `multiplier * profile(wi) / max_intensity`, so unlike
/// `diffuse_edf` and `spot_edf` it is NOT normalized such that the
/// cosine-weighted hemisphere integral is 1: with `multiplier = 1`, the
/// `material_emission.intensity` is the radiance emitted in the peak
/// direction of the profile, and the profile shapes the falloff. Hosts
/// that need the true emitted power of the profile for light selection
/// should use `light_profile.power`.
///
/// NOTE: The lower hemisphere of the profile is clipped: a surface cannot
/// emit below its own horizon. Directions sampled there are rejected, and
/// the PDF is reported with respect to solid angle over the full sphere,
/// so evaluation and sampling remain consistent for MIS.
///
export struct measured_edf: edf {
  /// The light profile.
  light_profile profile;

  /// The multiplier.
  float multiplier = 1.0;

  /// > Boolean that chooses between two interpretations of the EDF: the
  /// > directional distribution applied per point in tangent space, or the
  /// > distribution of the light source as a whole in the global frame.
  ///
  /// NOTE: Only the per-point tangent-space interpretation is supported, so
  /// this is accepted and ignored. The luminaire-as-a-whole interpretation
  /// is a host-side concern, e.g., a Dirac point light driven directly by
  /// the C++ `smdl::LightProfile` API.
  ///
  void global_distribution = true;

  /// The global frame.
  ///
  /// NOTE: Only the per-point tangent-space interpretation is supported, so
  /// this is accepted and ignored.
  ///
  void global_frame = float3x3(1.0);

  /// The tangent direction, orienting the horizontal angle of the profile.
  float3 tangent_u = $state.texture_tangent_u[0];

  /// The handle.
  void handle = "";

  /// The precomputed scale, folding the multiplier and the normalization
  /// by the maximum intensity of the profile.
  const float _scale = profile.max_intensity > 0.0 ? #max(multiplier, 0.0) / profile.max_intensity : 0.0;

  /// The flags. Always zero: the `DF_` flags describe how a surface
  /// scatters, and emission does not scatter.
  static const int df_lobes = 0;
};

@(pure)
auto emissionEvaluate(const &measured_edf this, inline const &EmissionEvaluateParameters params) {
  preserve tangent_u;
  tangent_u = this.tangent_u;
  if ((this._scale > 0.0) && recalculateTangentSpace(params)) {
    const auto intensity(smdlLightProfileInterpolate(this.profile.ptr, &wi));
    if (!(intensity > 0.0))
      return EmissionEvaluateResult(isBlack: true);
    return EmissionEvaluateResult(
             f: this._scale * intensity,
             pdf: smdlLightProfileDirectionPDF(this.profile.ptr, &wi),
           );
  } else {
    return EmissionEvaluateResult(isBlack: true);
  }
}

@(pure)
auto emissionSample(const &measured_edf this, inline const &EmissionSampleParameters params) {
  if (!(this._scale > 0.0))
    return EmissionSampleResult();
  float2 xiDirection(xi.x, xi.y);
  float3 w(0.0);
  float pdf(0.0);
  smdlLightProfileDirectionSample(this.profile.ptr, &xiDirection, &w, &pdf);
  // Reject dead samples and the lower hemisphere of the profile, which a
  // surface cannot emit into. The PDF stays the density over the full
  // sphere, consistent with `emissionEvaluate`.
  if (!((pdf > 0.0) & (w.z > 0.0)))
    return EmissionSampleResult();
  return EmissionSampleResult(wi: calculateTangentSpace(normal, this.tangent_u) * w, isValid: true);
}
//--}

//--{ tint
/// A 1-value tint.
struct tint1: bsdf, edf, vdf, hair_bsdf {
  /// The tint multiplier.
  $(color | float) tint;

  /// The base `bsdf`, `edf`, `vdf`, or `hair_bsdf`.
  auto base;

  /// The flags.
  const int df_lobes = base.df_lobes;
};

/// A 2-value tint.
struct tint2: bsdf {
  /// The tint multiplier on reflection.
  $(color | float) reflection_tint;

  /// The tint multiplier on transmission.
  $(color | float) transmission_tint;

  /// The base `bsdf`.
  bsdf base;

  /// The flags.
  const int df_lobes = base.df_lobes;
};

/// Construct 1-value tint of the given `bsdf`.
@(macro)
export auto tint(const auto tint, const bsdf base) = tint1(tint, base);

/// Construct 1-value tint of the given `edf`.
@(macro)
export auto tint(const auto tint, const edf base) = tint1(tint, base);

/// Construct 1-value tint of the given `hair_bsdf`.
@(macro)
export auto tint(const auto tint, const hair_bsdf base) = tint1(tint, base);

/// Construct 1-value tint of the given `vdf`.
///
/// NOTE: The volume scattering entry points report a scalar phase value,
/// so a color tint is averaged down when a tinted VDF is evaluated
/// through them.
///
@(macro)
export auto tint(const auto tint, const vdf base) = tint1(tint, base);

/// Construct 2-value tint of the given `bsdf`.
@(macro)
export auto tint(const auto reflection_tint, const auto transmission_tint, const bsdf base) = tint2(reflection_tint, transmission_tint, base);

@(macro)
auto scatterEvaluate(const &tint1 this, const &ScatterEvaluateParameters params) {
  auto result(scatterEvaluateMasked(visit &this.base, params));
  // NOTE: Construct a fresh result instead of multiplying 'result.f' in
  // place: 'f' is '$(color | float)', and a color tint cannot store back
  // into a float-variant slot (cf. 'factorScatterEvaluate').
  if (!result.isBlack)
    return ScatterEvaluateResult(f: this.tint * result.f, pdf: result.pdf);
  return result;
}

@(macro)
auto scatterEvaluate(const &tint2 this, const &ScatterEvaluateParameters params) {
  auto result(scatterEvaluateMasked(visit &this.base, params));
  if (!result.isBlack) {
    if (params.mode == scatter_reflect) {
      return ScatterEvaluateResult(f: this.reflection_tint * result.f, pdf: result.pdf);
    } else {
      return ScatterEvaluateResult(f: this.transmission_tint * result.f, pdf: result.pdf);
    }
  }
  return result;
}

@(macro)
auto emissionEvaluate(const &tint1 this, const &EmissionEvaluateParameters params) {
  auto result(emissionEvaluate(visit &this.base, params));
  if (!result.isBlack)
    return EmissionEvaluateResult(f: this.tint * result.f, pdf: result.pdf);
  return result;
}

@(macro)
auto emissionSample(const &tint1 this, const &EmissionSampleParameters params) {
  return emissionSample(visit &this.base, params);
}

@(macro)
auto normalSample(const &tint1 this, const &ScatterNormalParameters params) =
  normalSampleMasked(visit &this.base, params);

@(macro)
auto normalEvaluate(const &tint1 this, const &ScatterNormalParameters params) =
  normalEvaluateMasked(visit &this.base, params);

@(macro)
auto normalSample(const &tint2 this, const &ScatterNormalParameters params) =
  normalSampleMasked(visit &this.base, params);

@(macro)
auto normalEvaluate(const &tint2 this, const &ScatterNormalParameters params) =
  normalEvaluateMasked(visit &this.base, params);

@(macro)
auto scatterSample(const &tint1 this, const &ScatterSampleParameters params) {
  auto result(scatterSampleMasked(visit &this.base, params));
  if ((result.mode != scatter_none) & bool(result.fDirac))
    *result.fDirac *= this.tint;
  return result;
}

@(macro)
auto scatterSample(const &tint2 this, const &ScatterSampleParameters params) {
  auto result(scatterSampleMasked(visit &this.base, params));
  if ((result.mode != scatter_none) & bool(result.fDirac)) {
    if (params.mode == scatter_reflect) {
      *result.fDirac *= this.reflection_tint;
    } else {
      *result.fDirac *= this.transmission_tint;
    }
  }
  return result;
}
//--}

//--{ weighted_layer, color_weighted_layer
/// The weighted layer, blending the `layer` BSDF over the `base` BSDF by
/// the given `weight`, with the layer evaluated using its own `normal`.
export struct weighted_layer: bsdf {
  /// The weight.
  $(color | float) weight;

  /// The layer BSDF.
  bsdf layer = bsdf();

  /// The base BSDF.
  bsdf base = bsdf();

  /// The normal to use for the layer, or `none` to use whatever normal
  /// is already active where this node sits.
  ///
  /// NOTE: The specification defaults this to `state::normal()`. We
  /// inherit instead, so that a normal map applied once through
  /// `material_geometry.normal` reaches this node and everything beneath
  /// it. Giving a normal pins this node and its subtree to it, as the
  /// specification says, and detaches them from `material_geometry`.
  ///
  $(?float3) normal = none;

  /// The chance of sampling the layer BSDF.
  ///
  /// NOTE: If the weight is a `float`, then the chance is the same
  /// as the weight. However, if the weight is a `color`, we
  /// have to average it down to a single probability.
  ///
  float chance = average(weight);

  /// The flags.
  const int df_lobes = layer.df_lobes | base.df_lobes | normalParamLobes(normal);

  finalize {
    weight = saturate(weight);
    chance = saturate(chance);
  }
};

@(macro)
auto scatterEvaluate(const &weighted_layer this, inline const &ScatterEvaluateParameters params) {
  auto result0(scatterEvaluateMasked(visit &this.base, params));
  preserve normal;
  normal = layerNormal(this.normal, normal);
  auto result1(scatterEvaluateMasked(visit &this.layer, params));
  // The value keeps the layering weight whatever the mask, but the
  // density is the density of the sampler under that mask, which takes a
  // side with certainty once the mask has removed the other.
  const float chance(maskedChance(this.chance, this.layer.df_lobes, this.base.df_lobes, lobeMask));
  return ScatterEvaluateResult(f: lerp(result0.f, result1.f, this.weight), pdf: lerp(result0.pdf, result1.pdf, chance), isBlack: result0.isBlack & result1.isBlack);
}

@(macro)
auto normalSample(const &weighted_layer this, inline const &ScatterNormalParameters params) {
  if (sampling::bool_sample(&xi.w, maskedNormalChance(this.chance, this.layer.df_lobes, this.base.df_lobes, lobeMask))) {
    preserve normal;
    normal = layerNormal(this.normal, normal);
    return normalSampleMasked(visit &this.layer, params);
  } else {
    return normalSampleMasked(visit &this.base, params);
  }
}

@(macro)
float normalEvaluate(const &weighted_layer this, inline const &ScatterNormalParameters params) {
  const float chance(maskedNormalChance(this.chance, this.layer.df_lobes, this.base.df_lobes, lobeMask));
  const float densityBase(normalEvaluateMasked(visit &this.base, params));
  preserve normal;
  normal = layerNormal(this.normal, normal);
  return lerp(densityBase, normalEvaluateMasked(visit &this.layer, params), chance);
}

@(macro)
auto scatterSample(const &weighted_layer this, inline const &ScatterSampleParameters params) {
  const float chance(maskedChance(this.chance, this.layer.df_lobes, this.base.df_lobes, lobeMask));
  if (sampling::bool_sample(&xi.w, chance)) {
    preserve normal;
    normal = layerNormal(this.normal, normal);
    lobeChance *= this.chance;
    auto result(scatterSampleMasked(visit &this.layer, params));
    // Dirac lobes fold their weight into `fDirac`, and the scalar
    // selection chance cannot represent a color weight, so reweight by
    // the exact ratio (identically 1 for float weights).
    *result.fDirac *= this.weight / chance if (result.fDirac);
    return result;
  } else {
    lobeChance *= 1 - this.chance;
    auto result(scatterSampleMasked(visit &this.base, params));
    *result.fDirac *= (1 - this.weight) / (1 - chance) if (result.fDirac);
    return result;
  }
}

/// The `color_weighted_layer` is also implemented by the `weighted_layer`.
export typedef weighted_layer color_weighted_layer;
//--}

// The shared implementation of the `*_factor` modifiers: evaluate the base
// BSDF, then multiply the reflection throughput by `factor`, a lambda over
// the half direction. The PDF is untouched, so the modulation is pure
// throughput and needs no matching change to any sampling density.
@(macro)
auto factorScatterEvaluate(const auto this, const &ScatterEvaluateParameters params, const auto factor) {
  auto result(scatterEvaluateMasked(visit &this.base, params));
  if (!result.isBlack && params.mode == scatter_reflect) {
    return ScatterEvaluateResult(f: factor(halfDirection(params)) * result.f, pdf: result.pdf);
  } else {
    return result;
  }
}

@(macro)
auto factorNormalSample(const auto this, const &ScatterNormalParameters params) =
  normalSampleMasked(visit &this.base, params);

@(macro)
auto factorNormalEvaluate(const auto this, const &ScatterNormalParameters params) =
  normalEvaluateMasked(visit &this.base, params);

@(macro)
auto factorScatterSample(const auto this, const &ScatterSampleParameters params, const auto factor) {
  auto result(scatterSampleMasked(visit &this.base, params));
  if ((result.mode == scatter_reflect) & bool(result.fDirac)) {
    *result.fDirac *= factor(halfDirection(params, &result));
  }
  return result;
}

//--{ thin_film
/// A thin film layer.
///
/// > Add reflective thin-film interference color to an elemental or
/// > compound BSDF.
///
export struct thin_film: bsdf {
  /// The thickness in nanometers.
  $(color | float) thickness;

  /// The index of refraction.
  $(color | float) ior;

  /// The base BSDF.
  bsdf base = bsdf();

  /// The flags.
  const int df_lobes = base.df_lobes;

  /// The wavelengths this instance was constructed at, in nanometers.
  /// The interference phase is spectral, so the factor needs them, and
  /// the scattering entry points are pure and cannot read `$state`;
  /// captured rather than accepted, like `df_lobes`.
  const color wavelengths = color($state.wavelength_base);
};

/// The maximum amplification `thinFilmFactor` may apply to the base BSDF,
/// bounding the model singularity on nearly index-matched substrates. See
/// the note at the end of `thinFilmFactor`.
const float THIN_FILM_FACTOR_MAX = 100.0;

/// Evaluate the thin-film interference factor.
///
/// This is the ratio of the Airy interference reflectance of the coated interface
/// (ambient medium, then a film of the given `thickness` in nanometers and `filmIOR`,
/// then the base medium of the given `baseIOR`, everything relative to the ambient
/// medium) to the plain Fresnel reflectance of the uncoated interface. The MDL
/// specification defines `thin_film` as modulating the Fresnel term of the base BSDF,
/// so the ratio converts an uncoated Fresnel reflectance into the coated one. It
/// reduces to the identity at zero thickness, consistent with the elimination rules
/// in the specification's normal form, and may exceed one at wavelengths with
/// constructive interference.
///
/// NOTE: The cosines through the film and into the base are clamped at zero,
/// so total internal reflection at a buried interface is handled with the
/// correct magnitude but without the phase shift of the evanescent case.
///
@(macro)
auto thinFilmFactor(const auto thickness, const auto filmIOR, const float baseIOR, const float cosTheta1, const color wavelengths) {
  const auto eta2(filmIOR);
  const auto eta3(baseIOR);
  const auto sin2Theta1(#max(1 - cosTheta1 * cosTheta1, 0.0));
  const auto cosTheta2(#sqrt(#max(1 - sin2Theta1 / (eta2 * eta2), 0.0)));
  const auto cosTheta3(#sqrt(#max(1 - sin2Theta1 / (eta3 * eta3), 0.0)));
  // The Fresnel amplitudes at the ambient-to-film (12) and film-to-base (23)
  // interfaces for both polarizations.
  const auto rs12((cosTheta1 - eta2 * cosTheta2) / (cosTheta1 + eta2 * cosTheta2));
  const auto rp12((eta2 * cosTheta1 - cosTheta2) / (eta2 * cosTheta1 + cosTheta2));
  const auto rs23((eta2 * cosTheta2 - eta3 * cosTheta3) / (eta2 * cosTheta2 + eta3 * cosTheta3));
  const auto rp23((eta3 * cosTheta2 - eta2 * cosTheta3) / (eta3 * cosTheta2 + eta2 * cosTheta3));
  // The Airy summation of the coated reflectance, with the spectral round-trip
  // phase through the film `4 pi n d cos / wavelength`.
  const auto phi(2.0 * $TWO_PI * eta2 * cosTheta2 * thickness / wavelengths);
  const auto phase(complex(#cos(phi), #sin(phi)));
  const auto Rs(#norm((rs12 + rs23 * phase) / (1 + rs12 * rs23 * phase)));
  const auto Rp(#norm((rp12 + rp23 * phase) / (1 + rp12 * rp23 * phase)));
  // The uncoated reflectance. By the Airy composition identity this is what the
  // coated reflectance reduces to at zero thickness, and it only depends on the
  // ambient-to-base contrast, so it is always a scalar.
  const auto rs13((cosTheta1 - eta3 * cosTheta3) / (cosTheta1 + eta3 * cosTheta3));
  const auto rp13((eta3 * cosTheta1 - cosTheta3) / (eta3 * cosTheta1 + cosTheta3));
  const float R13(0.5 * (rs13 * rs13 + rp13 * rp13));
  // The ratio has a genuine singularity as the ambient-to-base contrast
  // vanishes: a film on a nearly index-matched substrate reflects where the
  // bare interface does not, which a multiplicative modulation of the base
  // cannot express. A base carrying the matching Fresnel cancels the large
  // ratio exactly, but one without it multiplies `f` unboundedly with no
  // compensating density, hence the cap. Ordinary configurations sit far below
  // it and stay exact, antireflective factors included, and zero thickness
  // still yields exactly 1 because the Airy identity makes the ratio 1.
  return R13 > 0.0 ? #min(0.5 * (Rs + Rp) / R13, THIN_FILM_FACTOR_MAX) : color(1.0);
}

/// The film IOR relative to the incident medium. The user-facing film IOR is
/// absolute. From outside, the incident medium is the exterior. From inside
/// a solid (a backface hit), the incident medium is the base itself, whose
/// absolute index equals `params.ior * params.exterior_ior` after the
/// `finalize` reciprocation.
@(macro)
auto thinFilmIncidentRelativeIOR(const &thin_film this, const auto params) {
  if (params.hitBackface & !params.thin_walled) {
    return this.ior / (params.ior * params.exterior_ior);
  } else {
    return this.ior / params.exterior_ior;
  }
}

// The base IOR `1 / params.ior` is the far-side index relative to the
// incident side, which is correct from either side of the interface.
@(macro)
auto scatterEvaluate(const &thin_film this, const &ScatterEvaluateParameters params) = //
  factorScatterEvaluate(
    this,
    params,
    \(const float3 h) = thinFilmFactor(this.thickness, thinFilmIncidentRelativeIOR(this, params), 1 / params.ior, #abs(dot(params.wo, h)), this.wavelengths),
  );

@(macro)
auto normalSample(const &thin_film this, const &ScatterNormalParameters params) =
  factorNormalSample(this, params);

@(macro)
auto normalEvaluate(const &thin_film this, const &ScatterNormalParameters params) =
  factorNormalEvaluate(this, params);

@(macro)
auto scatterSample(const &thin_film this, const &ScatterSampleParameters params) = //
  factorScatterSample(
    this,
    params,
    \(const float3 h) = thinFilmFactor(this.thickness, thinFilmIncidentRelativeIOR(this, params), 1 / params.ior, #abs(dot(params.wo, h)), this.wavelengths),
  );
//--}

//--{ fresnel_factor
/// A fresnel factor.
///
/// > Modifier weighting a base BSDF based on the Fresnel reflection
/// > equation for a complex number IOR, comprising a real number IOR
/// > and an extinction coefficient. This modifier is useful to model
/// > the reflectance behavior of conductors and semi-conductors.
///
export struct fresnel_factor: bsdf {
  /// The index of refraction.
  $(color | float) ior;

  /// The extinction coefficient.
  $(color | float) extinction_coefficient;

  /// The base BSDF.
  bsdf base = bsdf();

  /// The flags.
  const int df_lobes = base.df_lobes;
};

@(macro)
auto scatterEvaluate(const &fresnel_factor this, const &ScatterEvaluateParameters params) = //
  factorScatterEvaluate(
    this,
    params,
    \(const float3 h) = specular::conductor_fresnel(#abs(dot(params.wo, h)), relativeIOR(params, complex(this.ior, this.extinction_coefficient))),
  );

@(macro)
auto normalSample(const &fresnel_factor this, const &ScatterNormalParameters params) =
  factorNormalSample(this, params);

@(macro)
auto normalEvaluate(const &fresnel_factor this, const &ScatterNormalParameters params) =
  factorNormalEvaluate(this, params);

@(macro)
auto scatterSample(const &fresnel_factor this, const &ScatterSampleParameters params) = //
  factorScatterSample(
    this,
    params,
    \(const float3 h) = specular::conductor_fresnel(#abs(dot(params.wo, h)), relativeIOR(params, complex(this.ior, this.extinction_coefficient))),
  );
//--}

//--{ directional_factor
/// The directional factor, modulating the base BSDF by a Schlick-style
/// curve from `normal_tint` to `grazing_tint`.
export struct directional_factor: bsdf {
  /// The normal tint.
  ///
  /// > Color scaling factor at the normal.
  ///
  $(color | float) normal_tint = 1.0;

  /// The grazing tint.
  ///
  /// > Color scaling factor at the grazing angle.
  ///
  $(color | float) grazing_tint = 1.0;

  /// The exponent.
  ///
  /// > Exponent for directional factor. Default value (5.0) is
  /// > from Schlick's approximation.
  ///
  float exponent = 5.0;

  /// The base BSDF.
  ///
  /// > Base BSDF to be modified by directional factor.
  ///
  bsdf base = bsdf();

  /// The flags.
  const int df_lobes = base.df_lobes;
};

@(macro)
auto scatterEvaluate(const &directional_factor this, const &ScatterEvaluateParameters params) = //
  factorScatterEvaluate(
    this,
    params,
    \(const float3 h) = specular::schlick_fresnel(dot(params.wo, h), this.normal_tint, this.grazing_tint, this.exponent),
  );

@(macro)
auto normalSample(const &directional_factor this, const &ScatterNormalParameters params) =
  factorNormalSample(this, params);

@(macro)
auto normalEvaluate(const &directional_factor this, const &ScatterNormalParameters params) =
  factorNormalEvaluate(this, params);

@(macro)
auto scatterSample(const &directional_factor this, const &ScatterSampleParameters params) = //
  factorScatterSample(
    this,
    params,
    \(const float3 h) = specular::schlick_fresnel(dot(params.wo, h), this.normal_tint, this.grazing_tint, this.exponent),
  );
//--}

//--{ measured_curve_factor
/// The measured curve factor, modulating the base BSDF by a measured
/// reflectance curve over the half-vector angle.
export struct measured_curve_factor: bsdf {
  /// The curve values.
  ///
  /// > Measured data for the reflection behavior. A 1-d function
  /// > measured in the pre-image range from zero to pi/2 with equally
  /// > spaced measured reflectance values.
  ///
  /// NOTE: The deferred size is inferred at construction and recovered
  /// with `#num` in the implementation.
  ///
  color[] curve_values;

  /// The base BSDF.
  ///
  /// > Base BSDF to be modified by the measured reflectance curve.
  ///
  bsdf base = bsdf();

  /// The flags.
  const int df_lobes = base.df_lobes;
};

/// Evaluate the reflectivity of a measured curve at `cosAlpha`, the cosine of the
/// angle between the outgoing direction and the half vector, linearly interpolating
/// the equally spaced `curve_values` over `[0, pi/2]`.
@(pure macro)
color evaluateMeasuredCurve(const color[<N>] curve_values, const float cosAlpha) {
  const auto t(saturate(#acos(saturate(#abs(cosAlpha))) * (2 / $PI)) * (N - 1));
  const int i(int(t));
  return saturate(lerp(curve_values[i], curve_values[#min(i + 1, N - 1)], t - i));
}

@(macro)
auto scatterEvaluate(const &measured_curve_factor this, const &ScatterEvaluateParameters params) = //
  factorScatterEvaluate(
    this,
    params,
    \(const float3 h) = evaluateMeasuredCurve(this.curve_values, dot(params.wo, h)),
  );

@(macro)
auto normalSample(const &measured_curve_factor this, const &ScatterNormalParameters params) =
  factorNormalSample(this, params);

@(macro)
auto normalEvaluate(const &measured_curve_factor this, const &ScatterNormalParameters params) =
  factorNormalEvaluate(this, params);

@(macro)
auto scatterSample(const &measured_curve_factor this, const &ScatterSampleParameters params) = //
  factorScatterSample(
    this,
    params,
    \(const float3 h) = evaluateMeasuredCurve(this.curve_values, dot(params.wo, h)),
  );
//--}

//--{ horizon_shadow_factor
/// The first-order relief self-shadowing factor. NOTE: This is non-standard!
///
/// Multiplies the base BSDF by a smooth horizon-visibility term for the
/// incoming direction, from four horizon slopes captured at material
/// evaluation time; see `::extras::parallax::horizon_slopes_with()`,
/// which derives them from the same height field the parallax march
/// displaces. Because the term modifies `f` inside the BSDF, next-event
/// estimation, BSDF sampling, and their MIS weights all see the same
/// shadowing and stay mutually consistent by construction.
///
/// The term applies to reflection off the front face under radiance
/// transport only:
/// - importance transport passes through unshadowed, the reciprocity
///   guard matching `::extras::parallax::view_vector()`,
/// - backface hits and transmission pass through,
/// - the view side is deliberately not shadowed, since the parallax march
///   already accounts for view-side occlusion geometrically.
///
/// PDFs are untouched: sampling still comes from the base and the factor
/// only removes energy, which keeps MIS weights valid at the cost of some
/// wasted samples where the shadow is deep. All-non-positive `slopes` are
/// an exact passthrough of `base`, so an unpopulated LOD state, a
/// faded-out relief, or downhill terrain shadows nothing.
export struct horizon_shadow_factor: bsdf {
  /// The horizon slopes `tan(elevation)` toward +U, -U, +V, -V in the
  /// natural tangent frame, in the same UV-commensurate units as the
  /// parallax `scale` (normalized horizon maps multiply by the same
  /// `scale` used for the march). Non-positive entries mean no horizon
  /// in that direction.
  float4 slopes = float4(0.0);

  /// The penumbra softness as a fraction of the horizon slope: the
  /// visibility ramps from 0 to 1 as the light elevation crosses
  /// `[(1 - softness) * horizon, horizon]`. 0 is a hard shadow edge.
  float softness = 0.25;

  /// The base BSDF.
  bsdf base = bsdf();

  /// The flags.
  const int df_lobes = base.df_lobes;

  finalize {
    softness = saturate(softness);
  }
};

/// The horizon visibility of the natural-tangent-frame direction `wi`
/// against the four axis slopes: 1 at or above the interpolated horizon,
/// 0 at or below its penumbra base, Hermite-smoothed between. The
/// interpolation weighs the quadrant's two axis slopes by the squared
/// direction cosines, which is continuous across the axes because the
/// switching term's weight vanishes at the switch.
@(pure)
float horizonShadowTerm(const float4 slopes, const float softness, const float3 wi) {
  return 1.0 if (!(wi.z > 0.0));
  return 1.0 if (#all(slopes <= 0.0));
  const float lenXY(length(wi.xy));
  const float2 d(wi.xy / #max(lenXY, 1.0e-8));
  // The light elevation as a slope. Near the pole it blows up and the
  // visibility saturates to 1, which is the correct limit.
  const float lightSlope(wi.z / #max(lenXY, 1.0e-8));
  const float horizonSlope(d.x * d.x * (d.x >= 0.0 ? slopes.x : slopes.y) + //
                           d.y * d.y * (d.y >= 0.0 ? slopes.z : slopes.w));
  return 1.0 if (!(horizonSlope > 0.0));
  // Redundant with the saturation below, but it short-circuits the common lit
  // case and it pins the fully hard shadow (`softness == 0`, where the ramp
  // degenerates to coincident edges) to lit exactly at the horizon.
  return 1.0 if (!(lightSlope < horizonSlope));
  return smoothstep(1.0 - softness, 1.0, lightSlope / horizonSlope);
}

@(macro)
auto scatterEvaluate(const &horizon_shadow_factor this, const &ScatterEvaluateParameters params) {
  auto result(scatterEvaluateMasked(visit &this.base, params));
  if (!result.isBlack && params.mode == scatter_reflect && !params.isImportance && !params.hitBackface) {
    return ScatterEvaluateResult(f: horizonShadowTerm(this.slopes, this.softness, params.wi0) * result.f, pdf: result.pdf);
  } else {
    return result;
  }
}

@(macro)
auto normalSample(const &horizon_shadow_factor this, const &ScatterNormalParameters params) =
  factorNormalSample(this, params);

@(macro)
auto normalEvaluate(const &horizon_shadow_factor this, const &ScatterNormalParameters params) =
  factorNormalEvaluate(this, params);

@(macro)
auto scatterSample(const &horizon_shadow_factor this, const &ScatterSampleParameters params) {
  auto result(scatterSampleMasked(visit &this.base, params));
  // Smooth lobes are shadowed on the evaluate path; only a sampled Dirac
  // carries its own `f` and must be shadowed here. The sampled `wi` is in
  // the natural tangent frame, the frame the slopes live in.
  if ((result.mode == scatter_reflect) & bool(result.fDirac) & !params.isImportance & !params.hitBackface) {
    *result.fDirac *= horizonShadowTerm(this.slopes, this.softness, result.wi);
  }
  return result;
}
//--}

//--{ relief_shadow_factor
/// The relief self-shadowing factor. NOTE: This is non-standard!
///
/// Multiplies the base BSDF by the binary visibility of the incoming
/// direction against a height field: `::extras::parallax::relief_visible()`
/// marches the direction through the maximum mip chain of `height` from
/// the surface point at `coord`, the same chain and the same traversal
/// that `::extras::parallax::parallax_uv()` displaces the view ray with,
/// so the shadow matches the relief exactly, thin features included, from
/// any azimuth. Because the term modifies `f` inside the BSDF, next-event
/// estimation, BSDF sampling, and their MIS weights all see the same
/// shadowing and stay mutually consistent by construction. The answer is
/// binary; a light's extent and the sampler make the penumbra.
///
/// The term applies to reflection off the front face under radiance
/// transport only:
/// - importance transport passes through unshadowed, the reciprocity
///   guard matching `::extras::parallax::view_vector()`,
/// - backface hits and transmission pass through,
/// - the view side is deliberately not shadowed, since the parallax march
///   already accounts for view-side occlusion geometrically.
///
/// PDFs are untouched: sampling still comes from the base and the factor
/// only removes energy, which keeps MIS weights valid at the cost of the
/// samples that land in shadow. A non-positive `scale`, an invalid
/// `height`, or a texture without a maximum chain is an exact passthrough
/// of `base`, so a forgotten `max_mipmap: true` reads as no shadowing
/// rather than as wrong shadowing.
///
/// The incoming direction is taken in the natural tangent frame, whose
/// axes are texture space 0's tangents and the normal: the frame
/// `parallax_uv()` marches in.
export struct relief_shadow_factor: bsdf {
  /// The height texture, constructed with `max_mipmap: true`; heights
  /// follow the parallax convention, 1 at the un-displaced surface and 0
  /// at the deepest point.
  texture_2d height;

  /// The UV coordinate of the shading point in the height field: the
  /// offset UV from `::extras::parallax::parallax_uv()`, so the shadow ray
  /// starts where the view ray landed.
  float2 coord = $state.texture_coordinate[0].xy;

  /// The relief depth in UV units, the `scale` of the march.
  float scale = 0.0;

  /// The wrap mode of the height texture along U.
  tex::wrap_mode wrap_u = tex::wrap_repeat;

  /// The wrap mode of the height texture along V.
  tex::wrap_mode wrap_v = tex::wrap_repeat;

  /// The height above the surface the shadow ray starts at, as a fraction
  /// of the relief depth, which keeps the surface from shadowing itself
  /// where the light grazes it.
  float bias = 0.02;

  /// The base BSDF.
  bsdf base = bsdf();

  /// The flags.
  const int df_lobes = base.df_lobes;
};

/// The visibility of the natural-tangent-frame direction `wi` as a
/// factor: 1 when the relief does not occlude it, and 0 when it does.
@(pure)
float reliefShadowTerm(const &relief_shadow_factor this, const float3 wi) {
  return 1.0 if (!(wi.z > 0.0) | !(this.scale > 0.0) | !this.height.max_mipmap);
  return relief_visible(this.height, this.coord, wi, this.scale, this.wrap_u, this.wrap_v, this.bias) ? 1.0 : 0.0;
}

@(macro)
auto scatterEvaluate(const &relief_shadow_factor this, const &ScatterEvaluateParameters params) {
  auto result(scatterEvaluateMasked(visit &this.base, params));
  if (!result.isBlack && params.mode == scatter_reflect && !params.isImportance && !params.hitBackface) {
    return ScatterEvaluateResult(f: reliefShadowTerm(this, params.wi0) * result.f, pdf: result.pdf);
  } else {
    return result;
  }
}

@(macro)
auto normalSample(const &relief_shadow_factor this, const &ScatterNormalParameters params) =
  factorNormalSample(this, params);

@(macro)
auto normalEvaluate(const &relief_shadow_factor this, const &ScatterNormalParameters params) =
  factorNormalEvaluate(this, params);

@(macro)
auto scatterSample(const &relief_shadow_factor this, const &ScatterSampleParameters params) {
  auto result(scatterSampleMasked(visit &this.base, params));
  // Smooth lobes are shadowed on the evaluate path; only a sampled Dirac
  // carries its own `f` and must be shadowed here. The sampled `wi` is in
  // the natural tangent frame, the frame the march runs in.
  if ((result.mode == scatter_reflect) & bool(result.fDirac) & !params.isImportance & !params.hitBackface) {
    *result.fDirac *= reliefShadowTerm(this, result.wi);
  }
  return result;
}
//--}

//--{ measured_factor
/// The measured factor, modulating the base BSDF by a 2-dimensional
/// measured reflectance texture over the half-vector angles.
export struct measured_factor: bsdf {
  /// The values.
  ///
  /// > Measured data of type color for the reflection behavior. A 2-d
  /// > function measured in the pre-image range `[0,pi/2]^2` with equally
  /// > spaced reflectance values, where the texture-space u-coordinate
  /// > corresponds to the angle alpha between the incoming direction and
  /// > the half-vector h from the microfacet model, and the texture-space
  /// > v-coordinate corresponds to the angle beta between the half-vector
  /// > h and the shading surface normal.
  ///
  texture_2d values;

  /// The base BSDF.
  ///
  /// > Base BSDF to be modified by the measured reflectance values.
  ///
  bsdf base = bsdf();

  /// The flags.
  const int df_lobes = base.df_lobes;

  /// The primaries the texture's RGB is upsampled against. Captured
  /// rather than accepted, like `df_lobes`; see `RGBPrimaries`.
  const RGBPrimaries primaries = RGBPrimaries();
};

/// Evaluate the reflectivity of the measured factor, where `cosAlpha` is the cosine
/// of the angle between the outgoing direction and the half vector `h`, and `cosBeta`
/// is the cosine of the angle between `h` and the shading normal. The lookup is
/// `float3` rather than `color` because this is pure; see `RGBPrimaries`.
@(pure macro)
color evaluateMeasuredFactor(const &measured_factor this, const float cosAlpha, const float cosBeta) {
  return saturate(
           upsample(
             this.primaries,
             tex::lookup_float3(
               this.values,
               float2(#acos(saturate(#abs(cosAlpha))), #acos(saturate(cosBeta))) * (2 / $PI),
               tex::wrap_clamp,
               tex::wrap_clamp,
             ),
           ),
         );
}

@(macro)
auto scatterEvaluate(const &measured_factor this, const &ScatterEvaluateParameters params) = //
  factorScatterEvaluate(
    this,
    params,
    \(const float3 h) = evaluateMeasuredFactor(this, dot(params.wo, h), h.z),
  );

@(macro)
auto normalSample(const &measured_factor this, const &ScatterNormalParameters params) =
  factorNormalSample(this, params);

@(macro)
auto normalEvaluate(const &measured_factor this, const &ScatterNormalParameters params) =
  factorNormalEvaluate(this, params);

@(macro)
auto scatterSample(const &measured_factor this, const &ScatterSampleParameters params) = //
  factorScatterSample(
    this,
    params,
    \(const float3 h) = evaluateMeasuredFactor(this, dot(params.wo, h), h.z),
  );
//--}

// The shared implementation of the curve-weighted `*_layer` combinators:
// blend the `layer` BSDF over the `base` BSDF by a directional curve. The
// combinators differ only in the curve itself, passed as three lambdas:
//
//   - `layerIOR()` is the relative IOR of the layer interface, active while
//     the layer evaluates AND while the curve weights it, so the curve sees
//     the same half vector the layer used. Combinators that define no
//     interface pass the identity `\() = ior`.
//   - `curve(...)` is the exact (possibly color) curve at the half direction,
//     used to weight the throughput.
//   - `curveChance(...)` is the scalar stand-in for `curve` at the given
//     cosines, used to weight the densities.
//
// The invariant this skeleton enforces structurally, rather than by parallel
// maintenance of six function bodies: the PDF weight in `layerScatterEvaluate`
// and the selection chance in `layerScatterSample` are BOTH
// `clampChance(this._averageWeight * curveChance(...))`, and the two Dirac
// reweights in `layerScatterSample` are the exact `curve` over that chance.
@(macro)
auto layerScatterEvaluate(const auto this, inline const &ScatterEvaluateParameters params, const auto layerIOR, const auto curve, const auto curveChance) {
  // The layer's own horizon test and curve cosines run against the same bent
  // normal the nested BSDFs build their tangent space from, in the natural
  // frame every layer normal lives in. Testing the raw normal here would
  // reject exactly the configurations the bend exists to rescue, one level
  // above the bend, and layer combinators are where a normal map usually
  // enters a material.
  const auto thisNormal(layerNormal(this.normal, normal));
  const auto bentNormal(bendShadingNormal(thisNormal, wo0, wi0));
  const auto cosThetao(dot(wo0, bentNormal));
  const auto cosThetai(dot(wi0, bentNormal));
  if ((cosThetao < MIN_COS_THETA)                                 //
      | ((mode == scatter_reflect) & (cosThetai < MIN_COS_THETA)) //
      | ((mode == scatter_transmit) & (cosThetai > -MIN_COS_THETA)))
    return ScatterEvaluateResult(isBlack: true);
  const auto result0(scatterEvaluateMasked(visit &this.base, params));
  // Evaluate the layer with this layer's interface, and keep the interface
  // active while weighting, so that the curve sees the same half
  // vector the layer itself used.
  preserve normal, ior;
  normal = thisNormal, ior = layerIOR();
  const auto result1(scatterEvaluateMasked(visit &this.layer, params));
  if (result0.isBlack & result1.isBlack) {
    return ScatterEvaluateResult(isBlack: true);
  } else {
    // The density weight is the selection chance of `layerScatterSample`
    // under the same mask, which is what makes the pair an estimator of
    // the masked part; the value weight is the exact curve and is blind
    // to the mask.
    const auto chance(maskedChance(clampChance(this._averageWeight * curveChance(cosThetao, cosThetai)),
                                   this.layer.df_lobes, this.base.df_lobes, lobeMask));
    return ScatterEvaluateResult(
             f: lerp(result0.f, result1.f, this.weight * curve(halfDirection(params))),
             pdf: lerp(result0.pdf, result1.pdf, chance),
           );
  }
}

// The normal-query mixture selects by the layer's average weight alone,
// not by the Fresnel or measured curve the scattering paths weigh with:
// the curves read an outgoing direction this query does not have. Any
// fixed positive chance is sound here, because it is a proposal mixture
// weight and the reported density mixes by the same number, so it
// cancels; it only has to keep every live side reachable, which the
// clamp guarantees. That the weights differ from the scattering
// selection chances is allowed for the same reason.
@(macro)
auto layerNormalSample(const auto this, inline const &ScatterNormalParameters params, const auto layerIOR) {
  const auto chance(maskedNormalChance(clampChance(this._averageWeight),
                                       this.layer.df_lobes, this.base.df_lobes, lobeMask));
  if (sampling::bool_sample(&xi.z, chance)) {
    preserve normal, ior;
    normal = layerNormal(this.normal, normal), ior = layerIOR();
    return normalSampleMasked(visit &this.layer, params);
  } else {
    return normalSampleMasked(visit &this.base, params);
  }
}

@(macro)
float layerNormalEvaluate(const auto this, inline const &ScatterNormalParameters params, const auto layerIOR) {
  const auto chance(maskedNormalChance(clampChance(this._averageWeight),
                                       this.layer.df_lobes, this.base.df_lobes, lobeMask));
  const float densityBase(normalEvaluateMasked(visit &this.base, params));
  preserve normal, ior;
  normal = layerNormal(this.normal, normal), ior = layerIOR();
  return lerp(densityBase, normalEvaluateMasked(visit &this.layer, params), chance);
}

@(macro)
auto layerScatterSample(const auto this, inline const &ScatterSampleParameters params, const auto layerIOR, const auto curve, const auto curveChance) {
  // The sampling path knows only `wo`, exactly as `recalculateTangentSpace`
  // does, so it bends against that alone. See `layerScatterEvaluate`.
  const auto thisNormal(layerNormal(this.normal, normal));
  const auto cosTheta(dot(wo0, bendShadingNormal(thisNormal, wo0, wo0)));
  if (cosTheta < MIN_COS_THETA)
    return ScatterSampleResult();
  const auto rawChance(clampChance(this._averageWeight * curveChance(cosTheta)));
  const auto chance(maskedChance(rawChance, this.layer.df_lobes, this.base.df_lobes, lobeMask));
  if (sampling::bool_sample(&xi.z, chance)) {
    lobeChance *= rawChance;
    preserve normal, ior;
    normal = thisNormal, ior = layerIOR();
    auto result(scatterSampleMasked(visit &this.layer, params));
    // Dirac lobes fold their weight into `fDirac`, and the scalar
    // selection chance cannot represent the exact color curve, so
    // reweight by the exact ratio.
    *result.fDirac *= this.weight * curve(halfDirection(params, &result)) / chance if (result.fDirac);
    return result;
  } else {
    lobeChance *= 1 - rawChance;
    auto result(scatterSampleMasked(visit &this.base, params));
    *result.fDirac *= (1 - this.weight * curve(halfDirection(params, &result))) / (1 - chance) if (result.fDirac);
    return result;
  }
}

//--{ fresnel_layer, color_fresnel_layer
/// The Fresnel layer, blending the `layer` BSDF over the `base` BSDF by
/// the exact dielectric Fresnel term of the given `ior`.
export struct fresnel_layer: bsdf {
  /// The index of refraction.
  ///
  /// NOTE: This is the absolute IOR of the layer interface. It both weights
  /// the layer by the dielectric Fresnel term and, non-standardly, defines
  /// the refractive interface for the nested `layer` BSDF (overriding the
  /// material IOR), so that the Fresnel weight and any refraction in the
  /// layer always agree with each other.
  ///
  $(color | float) ior;

  /// The weight.
  $(color | float) weight = 1.0;

  /// The layer BSDF.
  bsdf layer = bsdf();

  /// The base BSDF.
  bsdf base = bsdf();

  /// The normal to use for the layer, or `none` to use whatever normal
  /// is already active where this node sits.
  ///
  /// NOTE: The specification defaults this to `state::normal()`. We
  /// inherit instead, so that a normal map applied once through
  /// `material_geometry.normal` reaches this node and everything beneath
  /// it. Giving a normal pins this node and its subtree to it, as the
  /// specification says, and detaches them from `material_geometry`.
  ///
  $(?float3) normal = none;

  /// The precomputed average index of refraction.
  const float _averageIOR = average(ior);

  /// The precomputed average weight.
  float _averageWeight = 1.0;

  /// The flags.
  const int df_lobes = layer.df_lobes | base.df_lobes | normalParamLobes(normal);

  finalize {
    // The specification restricts the weight to [0,1]; enforcing it here
    // keeps the lerped values and densities nonnegative.
    weight = saturate(weight);
    _averageWeight = average(weight);
  }
};

@(macro)
auto scatterEvaluate(const &fresnel_layer this, inline const &ScatterEvaluateParameters params) = //
  layerScatterEvaluate(
    this,
    params,
    \() = relativeIOR(params, this._averageIOR),
    \(const float3 h) = specular::dielectric_fresnel(dot(wo, h), relativeIOR(params, this.ior)),
    \(const float co, const float ci) {
      // The scalar stand-in is the exact dielectric Fresnel term at the
      // averaged IOR. The reverse density models sampling from the far
      // side, so for transmission it sees the reciprocal ratio.
      const auto pdfIOR(relativeIOR(params, this._averageIOR));
      return float2(specular::dielectric_fresnel(co, pdfIOR), specular::dielectric_fresnel(ci, mode == scatter_reflect ? pdfIOR : 1 / pdfIOR));
    },
  );

@(macro)
auto normalSample(const &fresnel_layer this, inline const &ScatterNormalParameters params) = //
  layerNormalSample(this, params, \() = relativeIOR(params, this._averageIOR));

@(macro)
auto normalEvaluate(const &fresnel_layer this, inline const &ScatterNormalParameters params) = //
  layerNormalEvaluate(this, params, \() = relativeIOR(params, this._averageIOR));

@(macro)
auto scatterSample(const &fresnel_layer this, inline const &ScatterSampleParameters params) = //
  layerScatterSample(
    this,
    params,
    \() = relativeIOR(params, this._averageIOR),
    \(const float3 h) = specular::dielectric_fresnel(dot(wo, h), relativeIOR(params, this.ior)),
    // The selection chance uses the exact dielectric Fresnel term at the
    // averaged IOR, so that it stays proportional to the layer weight even
    // at total internal reflection, where a Schlick approximation would
    // drastically undersample the layer.
    \(const float cosTheta) = specular::dielectric_fresnel(cosTheta, relativeIOR(params, this._averageIOR)),
  );

/// The `color_fresnel_layer` is also implemented by the `fresnel_layer`.
export typedef fresnel_layer color_fresnel_layer;
//--}

//--{ custom_curve_layer, color_custom_curve_layer
/// A custom-curve layer.
///
/// NOTE: Unlike `fresnel_layer`, this combinator carries no IOR and does
/// not define a refractive interface: a nested transmissive `layer`
/// refracts with the enclosing interface, which is the material IOR by
/// default.
///
export struct custom_curve_layer: bsdf {
  /// The reflectivity at normal incidence.
  $(color | float) normal_reflectivity;

  /// The reflectivity at grazing incidence.
  $(color | float) grazing_reflectivity = 1.0;

  /// The exponent.
  float exponent = 5.0;

  /// The weight.
  $(color | float) weight = 1.0;

  /// The layer BSDF.
  bsdf layer = bsdf();

  /// The base BSDF.
  bsdf base = bsdf();

  /// The normal to use for the layer, or `none` to use whatever normal
  /// is already active where this node sits.
  ///
  /// NOTE: The specification defaults this to `state::normal()`. We
  /// inherit instead, so that a normal map applied once through
  /// `material_geometry.normal` reaches this node and everything beneath
  /// it. Giving a normal pins this node and its subtree to it, as the
  /// specification says, and detaches them from `material_geometry`.
  ///
  $(?float3) normal = none;

  /// The precomputed average normal reflectivity.
  float _averageNormalReflectivity = 0.0;

  /// The precomputed average grazing reflectivity.
  float _averageGrazingReflectivity = 0.0;

  /// The precomputed average weight.
  float _averageWeight = 1.0;

  /// The flags.
  const int df_lobes = layer.df_lobes | base.df_lobes | normalParamLobes(normal);

  finalize {
    // The specification restricts the reflectivities and the weight to
    // [0,1]; enforcing it here keeps the lerped values and densities
    // nonnegative.
    normal_reflectivity = saturate(normal_reflectivity);
    grazing_reflectivity = saturate(grazing_reflectivity);
    weight = saturate(weight);
    _averageNormalReflectivity = average(normal_reflectivity);
    _averageGrazingReflectivity = average(grazing_reflectivity);
    _averageWeight = average(weight);
  }
};

@(macro)
auto scatterEvaluate(const &custom_curve_layer this, inline const &ScatterEvaluateParameters params) = //
  layerScatterEvaluate(
    this,
    params,
    \() = ior,
    \(const float3 h) = specular::schlick_fresnel(dot(wo, h), this.normal_reflectivity, this.grazing_reflectivity, this.exponent),
    \(const float co, const float ci) = specular::schlick_fresnel(float2(co, ci), this._averageNormalReflectivity, this._averageGrazingReflectivity, this.exponent),
  );

@(macro)
auto normalSample(const &custom_curve_layer this, inline const &ScatterNormalParameters params) = //
  layerNormalSample(this, params, \() = ior);

@(macro)
auto normalEvaluate(const &custom_curve_layer this, inline const &ScatterNormalParameters params) = //
  layerNormalEvaluate(this, params, \() = ior);

@(macro)
auto scatterSample(const &custom_curve_layer this, inline const &ScatterSampleParameters params) = //
  layerScatterSample(
    this,
    params,
    \() = ior,
    \(const float3 h) = specular::schlick_fresnel(dot(wo, h), this.normal_reflectivity, this.grazing_reflectivity, this.exponent),
    \(const float cosTheta) = specular::schlick_fresnel(cosTheta, this._averageNormalReflectivity, this._averageGrazingReflectivity, this.exponent),
  );

/// The `color_custom_curve_layer` is also implemented by the `custom_curve_layer`.
export typedef custom_curve_layer color_custom_curve_layer;
//--}

//--{ measured_curve_layer, color_measured_curve_layer
/// A measured-curve layer.
///
/// NOTE: Unlike `fresnel_layer`, this combinator carries no IOR and does
/// not define a refractive interface: a nested transmissive `layer`
/// refracts with the enclosing interface, which is the material IOR by
/// default.
///
export struct measured_curve_layer: bsdf {
  /// The curve values.
  ///
  /// > Measured data for the reflection behavior. A 1-d function
  /// > measured in the pre-image range from zero to pi/2 with equally
  /// > spaced measured reflectance values.
  ///
  color[] curve_values;

  /// The weight.
  $(color | float) weight = 1.0;

  /// The layer BSDF.
  bsdf layer = bsdf();

  /// The base BSDF.
  bsdf base = bsdf();

  /// The normal to use for the layer, or `none` to use whatever normal
  /// is already active where this node sits.
  ///
  /// NOTE: The specification defaults this to `state::normal()`. We
  /// inherit instead, so that a normal map applied once through
  /// `material_geometry.normal` reaches this node and everything beneath
  /// it. Giving a normal pins this node and its subtree to it, as the
  /// specification says, and detaches them from `material_geometry`.
  ///
  $(?float3) normal = none;

  /// The precomputed average weight.
  float _averageWeight = 1.0;

  /// The flags.
  const int df_lobes = layer.df_lobes | base.df_lobes | normalParamLobes(normal);

  finalize {
    // The specification restricts the weight to [0,1]; enforcing it here
    // keeps the lerped values and densities nonnegative. (The curve
    // values are saturated at lookup by `evaluateMeasuredCurve`.)
    weight = saturate(weight);
    _averageWeight = average(weight);
  }
};

@(macro)
auto scatterEvaluate(const &measured_curve_layer this, inline const &ScatterEvaluateParameters params) = //
  layerScatterEvaluate(
    this,
    params,
    \() = ior,
    \(const float3 h) = evaluateMeasuredCurve(this.curve_values, dot(wo, h)),
    \(const float co, const float ci) = float2(average(evaluateMeasuredCurve(this.curve_values, co)), average(evaluateMeasuredCurve(this.curve_values, ci))),
  );

@(macro)
auto normalSample(const &measured_curve_layer this, inline const &ScatterNormalParameters params) = //
  layerNormalSample(this, params, \() = ior);

@(macro)
auto normalEvaluate(const &measured_curve_layer this, inline const &ScatterNormalParameters params) = //
  layerNormalEvaluate(this, params, \() = ior);

@(macro)
auto scatterSample(const &measured_curve_layer this, inline const &ScatterSampleParameters params) = //
  layerScatterSample(
    this,
    params,
    \() = ior,
    \(const float3 h) = evaluateMeasuredCurve(this.curve_values, dot(wo, h)),
    \(const float cosTheta) = average(evaluateMeasuredCurve(this.curve_values, cosTheta)),
  );

/// The `color_measured_curve_layer` is also implemented by the `measured_curve_layer`.
export typedef measured_curve_layer color_measured_curve_layer;
//--}

//--{ normalized_mix, clamped_mix, unbounded_mix
tag component;

/// The weighted BSDF component for use with the mixers.
export struct bsdf_component: component {
  $(color | float) weight = 0.0;  ///< The weight, either `float` or `color`.
  bsdf component = bsdf();        ///< The component BSDF.
  float chance = average(weight); ///< The sampling chance. NOTE: This is non-standard!
};
/// The weighted EDF component for use with the mixers.
export struct edf_component: component {
  $(color | float) weight = 0.0;  ///< The weight, either `float` or `color`.
  edf component = edf();          ///< The component EDF.
  float chance = average(weight); ///< The sampling chance. NOTE: This is non-standard!
};
/// The weighted VDF component for use with the mixers.
export struct vdf_component: component {
  $(color | float) weight = 0.0;  ///< The weight, either `float` or `color`.
  vdf component = vdf();          ///< The component VDF.
  float chance = average(weight); ///< The sampling chance. NOTE: This is non-standard!
};

/// The `color_bsdf_component` is also implemented by the `bsdf_component`.
export typedef bsdf_component color_bsdf_component;

/// The `color_edf_component` is also implemented by the `edf_component`.
export typedef edf_component color_edf_component;

/// The `color_vdf_component` is also implemented by the `vdf_component`.
export typedef vdf_component color_vdf_component;

struct component_mix: bsdf, edf, vdf {
  component[] components;

  int df_lobes = 0;
};

/// Constructs a mixture of the given components, normalizing the weights
/// when they sum to more than 1, componentwise for `color` weights.
@(macro)
export auto normalized_mix(component[<N>] components) {
  int df_lobes(0);
  auto total_weight(0.0 * components[0].weight);
  float total_chance(0);
  for (int i = 0; i < N; i++) {
    auto component(&components[i]);
    component.weight = #max(component.weight, 0.0);
    component.chance = #max(component.chance, 0.0);
    total_weight += component.weight;
    total_chance += component.chance;
    df_lobes |= component.component.df_lobes;
  }
  // Divide out the total wherever it exceeds 1 and leave the weights
  // alone wherever it does not; for `color` weights this is per channel.
  const auto weight_scale(1.0 / #max(total_weight, 1.0));
  total_chance = 1.0 / total_chance if (total_chance > 0.0);
  for (int i = 0; i < N; i++) {
    auto component(&components[i]);
    component.weight *= weight_scale;
    component.chance *= total_chance;
  }
  return component_mix(components, df_lobes);
}

/// Constructs a mixture of the given components, clamping the running
/// weight sum at 1 in declaration order, componentwise for `color`
/// weights.
@(macro)
export auto clamped_mix(component[<N>] components) {
  int df_lobes(0);
  auto total_weight(0.0 * components[0].weight);
  float total_chance(0);
  for (int i = 0; i < N; i++) {
    auto component(&components[i]);
    // MDL specification:
    // Once a component weight would cause the sum to exceed 1.0,
    // it is replaced with the result of subtracting the sum from 1.0.
    // All subsequent weights are then set to 0.0.
    //
    // A component that survives with nonzero weight, including the one
    // the clamp truncates, keeps its chance and flags; a component the
    // clamp zeroes loses both.
    if (#all(total_weight >= 1.0)) {
      component.weight *= 0.0;
      component.chance = 0.0;
    } else {
      component.weight = #min(#max(component.weight, 0.0), 1.0 - total_weight);
      component.chance = #max(component.chance, 0.0);
      total_weight += component.weight;
      total_chance += component.chance;
      df_lobes |= component.component.df_lobes;
    }
  }
  total_chance = 1.0 / total_chance if (total_chance > 0.0);
  for (int i = 0; i < N; i++) {
    components[i].chance *= total_chance;
  }
  return component_mix(components, df_lobes);
}

/// Constructs a mixture of the given components without normalizing or
/// clamping the weights.
@(macro)
export auto unbounded_mix(component[<N>] components) {
  int df_lobes(0);
  float total_chance(0);
  for (int i = 0; i < N; i++) {
    auto component(&components[i]);
    component.weight = #max(component.weight, 0.0);
    component.chance = #max(component.chance, 0.0);
    total_chance += component.chance;
    df_lobes |= component.component.df_lobes;
  }
  total_chance = 1.0 / total_chance if (total_chance > 0.0);
  for (int i = 0; i < N; i++) {
    components[i].chance *= total_chance;
  }
  return component_mix(components, df_lobes);
}

/// The `color_normalized_mix` is also implemented by the `normalized_mix`.
@(macro)
export auto color_normalized_mix(component[<N>] components) = normalized_mix(components);

/// The `color_clamped_mix` is also implemented by the `clamped_mix`.
@(macro)
export auto color_clamped_mix(component[<N>] components) = clamped_mix(components);

/// The `color_unbounded_mix` is also implemented by the `unbounded_mix`.
@(macro)
export auto color_unbounded_mix(component[<N>] components) = unbounded_mix(components);

@(macro)
auto scatterEvaluate(const &component_mix this, const &ScatterEvaluateParameters params) {
  auto result(ScatterEvaluateResult(f: color(0), isBlack: true));
  // The selection mass the mask leaves alive, which `scatterSample`
  // renormalizes its walk over. A live component counts whether or not it
  // evaluates to anything here: the question is what the sampler could
  // have chosen, not what this direction pair is worth.
  float liveChance(0.0);
  for (int i = 0; i < #num(this.components); i++) {
    visit component in this.components[i] { // In general this is a union!
      // A component with zero weight and zero chance must not clear
      // `isBlack`: reporting a live result whose value and densities are
      // all zero invites `0/0` in the renderer's throughput division.
      // `#any` because the weight may be a `color`.
      if (#any(component.weight > 0.0) | (component.chance > 0.0)) {
        liveChance += component.chance if (isLobeLive(component.component.df_lobes, params.lobeMask));
        auto component_result(scatterEvaluateMasked(visit &component.component, params));
        if (!component_result.isBlack) {
          result.pdf += component.chance * component_result.pdf;
          result.f += component.weight * component_result.f;
          result.isBlack = false;
        }
      }
    }
  }
  // The chances are normalized to 1 over every component, so this is 1
  // for an unmasked call and the densities are what they always were.
  result.pdf /= liveChance if (liveChance > 0.0);
  return result;
}

@(macro)
auto normalSample(const &component_mix this, inline const &ScatterNormalParameters params) {
  float liveChance(0.0);
  for (int i = 0; i < #num(this.components); i++) {
    visit component in this.components[i] {
      liveChance += component.chance if (hasNormalDistribution(component.component.df_lobes, lobeMask));
    }
  }
  return ScatterNormalSampleResult() if (!(liveChance > 0.0));
  const auto xi(&params.xi.z);
  *xi *= liveChance;
  for (int i = 0; i < #num(this.components); i++) {
    visit component in this.components[i] { // In general this is a union!
      const float chance(hasNormalDistribution(component.component.df_lobes, lobeMask) ? component.chance : 0.0);
      if (!(*xi < chance)) {
        *xi -= chance;
      } else {
        *xi /= chance;
        return normalSampleMasked(visit &component.component, params);
      }
    }
  }
  return ScatterNormalSampleResult();
}

@(macro)
float normalEvaluate(const &component_mix this, inline const &ScatterNormalParameters params) {
  float liveChance(0.0);
  float density(0.0);
  for (int i = 0; i < #num(this.components); i++) {
    visit component in this.components[i] { // In general this is a union!
      if (hasNormalDistribution(component.component.df_lobes, lobeMask)) {
        liveChance += component.chance;
        density += component.chance * normalEvaluateMasked(visit &component.component, params);
      }
    }
  }
  return liveChance > 0.0 ? density / liveChance : 0.0;
}

@(macro)
auto scatterSample(const &component_mix this, inline const &ScatterSampleParameters params) {
  // The selection mass the mask leaves alive. The chances are normalized
  // to 1 over every component, so this is 1 for an unmasked call and the
  // arithmetic below reduces to what it always was.
  float liveChance(0.0);
  for (int i = 0; i < #num(this.components); i++) {
    visit component in this.components[i] {
      liveChance += component.chance if (isLobeLive(component.component.df_lobes, lobeMask));
    }
  }
  return ScatterSampleResult() if (!(liveChance > 0.0));
  const auto xi(&params.xi.z);
  // Stretch the sample back over the live mass, which is the whole of
  // renormalizing an N-way choice: the walk below then always lands on a
  // live component instead of falling through the dead ones.
  *xi *= liveChance;
  for (int i = 0; i < #num(this.components); i++) {
    visit component in this.components[i] { // In general this is a union!
      // A dead component has no chance of being taken, and the walk steps
      // over it without consuming any of the sample.
      const float chance(isLobeLive(component.component.df_lobes, lobeMask) ? component.chance : 0.0);
      if (!(*xi < chance)) {
        *xi -= chance;
      } else {
        *xi /= chance;
        lobeChance *= component.chance;
        auto result(scatterSampleMasked(visit &component.component, params));
        // Dirac lobes report unit PDFs, so the discrete selection chance
        // must be divided out here, exactly as the layer combinators
        // divide their Dirac reweights by the selection chance. The
        // chance actually used is `chance / liveChance`.
        if ((result.mode != scatter_none) & bool(result.fDirac))
          *result.fDirac *= component.weight * liveChance / chance;
        return result;
      }
    }
  }
  return ScatterSampleResult();
}

@(macro)
auto emissionEvaluate(const &component_mix this, const &EmissionEvaluateParameters params) {
  auto result(EmissionEvaluateResult(f: color(0), isBlack: true));
  for (int i = 0; i < #num(this.components); i++) {
    visit component in this.components[i] { // In general this is a union!
      // See the matching note in `scatterEvaluate`: zero-weight
      // zero-chance components must not clear `isBlack`, and `#any`
      // because the weight may be a `color`.
      if (#any(component.weight > 0.0) | (component.chance > 0.0)) {
        auto component_result(emissionEvaluate(visit &component.component, params));
        if (!component_result.isBlack) {
          result.pdf += component.chance * component_result.pdf;
          result.f += component.weight * component_result.f;
          result.isBlack = false;
        }
      }
    }
  }
  return result;
}

@(macro)
auto emissionSample(const &component_mix this, const &EmissionSampleParameters params) {
  const auto xi(&params.xi.z);
  for (int i = 0; i < #num(this.components); i++) {
    visit component in this.components[i] { // In general this is a union!
      if (!(*xi < component.chance)) {
        *xi -= component.chance;
      } else {
        *xi /= component.chance;
        return emissionSample(visit &component.component, params);
      }
    }
  }
  return EmissionSampleResult();
}
//--}

//--{ anisotropic_vdf
/// The anisotropic VDF, being the Henyey-Greenstein phase function with
/// the given directional bias.
export struct anisotropic_vdf: vdf {
  /// The directional bias `g` in `(-1, 1)`: negative is backward
  /// scattering, `0` is isotropic, and positive is forward scattering.
  float directional_bias = 0.0;

  /// The handle.
  void handle = "";

  /// The flags.
  static const int df_lobes = 0;

  finalize {
    directional_bias = #max(directional_bias, -0.999);
    directional_bias = #min(directional_bias, +0.999);
  }
};

@(macro)
auto scatterEvaluate(const &anisotropic_vdf this, inline const &ScatterEvaluateParameters params) {
  const auto cosTheta = dot(wo, wi);
  const auto g = this.directional_bias;
  const auto p = (1.0 - g * g) / (4.0 * $PI * (denom := 1.0 + g * g + 2.0 * g * cosTheta) * #sqrt(denom));
  return ScatterEvaluateResult(f: p, pdf: float2(p));
}

@(macro)
auto scatterSample(const &anisotropic_vdf this, inline const &ScatterSampleParameters params) {
  const auto g = this.directional_bias;
  const auto cosTheta = #abs(g) < 0.001    //
                        ? 1.0 - 2.0 * xi.x //
                        : -(1.0 + g * g - #pow((1.0 - g * g) / (1.0 + g * (1.0 - 2.0 * xi.x)), 2)) / (2.0 * g);
  const auto sinTheta = #sqrt(#max(0.0, 1.0 - cosTheta * cosTheta));
  const auto phi = 2.0 * $PI * xi.y;
  return ScatterSampleResult(wi: orthonormalBasis(wo) * float3(sinTheta * #cos(phi), sinTheta * #sin(phi), cosTheta), mode: scatter_reflect_transmit);
}
//--}

//--{ fog_vdf
/// The fog VDF: an approximate Mie phase function for fog- and
/// cloud-like water droplet media, per the MDL 1.8 specification.
///
/// The model is the Henyey-Greenstein plus Draine blend of Jendersie
/// and d'Eon, "An Approximate Mie Scattering Function for Fog and
/// Cloud Rendering" (SIGGRAPH 2023 Talks): an HG lobe carries the
/// diffraction peak and a Draine lobe the bulk, with the four lobe
/// parameters driven by the particle diameter through the paper's
/// piecewise fits, and both lobes sampled by analytic CDF inversion,
/// so the phase value is its own solid-angle sampling density.
export struct fog_vdf: vdf {
  /// The water droplet diameter in micrometers, clamped into
  /// `[0, 50]`, the domain of the parameter fits.
  float particle_size = 8.0;

  /// The handle.
  void handle = "";

  /// The flags.
  static const int df_lobes = 0;

  /// The fitted Henyey-Greenstein lobe anisotropy. This and the three
  /// fields below are computed by `finalize` from `particle_size`;
  /// anything passed for them is overwritten.
  float fit_g_hg = 0.0;

  /// The fitted Draine lobe anisotropy.
  float fit_g_d = 0.0;

  /// The fitted Draine lobe shape parameter `alpha`.
  float fit_alpha = 0.0;

  /// The fitted Draine lobe mixture weight in `[0, 1]`.
  float fit_w_d = 0.0;

  finalize {
    // The piecewise diameter-to-parameter fits: supplemental sections
    // 3.1 through 3.4 of the paper, natural logarithms throughout. The
    // seams between ranges agree only approximately, like the fits
    // themselves.
    const auto d = #min(#max(particle_size, 0.0), 50.0);
    if (d <= 0.1) {
      fit_g_hg = 13.8 * d * d;
      fit_g_d = 1.1456 * d * #sin(9.29044 * d);
      fit_alpha = 250.0;
      fit_w_d = 0.252977 - 312.983 * #pow(d, 4.3);
    } else if (d < 1.5) {
      const auto logD = #log(d);
      fit_g_hg = 0.862 - 0.143 * logD * logD;
      fit_g_d = 0.379685 * #cos(1.19692 * #cos((logD - 0.238604) * (logD + 1.00667) / (0.507522 - 0.15677 * logD)) + 1.37932 * logD + 0.0625835) + 0.344213;
      fit_alpha = 250.0;
      fit_w_d = 0.146209 * #cos(3.38707 * logD + 2.11193) + 0.316072 + 0.0778917 * logD;
    } else if (d < 5.0) {
      const auto logD = #log(d);
      fit_g_hg = 0.0604931 * #log(logD) + 0.940256;
      fit_g_d = 0.500411 - 0.081287 / (-2.0 * logD + #tan(logD) + 1.27551);
      fit_alpha = 7.30354 * logD + 6.31675;
      fit_w_d = 0.026914 * (logD - #cos(5.68947 * (#log(logD) - 0.0292149))) + 0.376475;
    } else {
      fit_g_hg = #exp(-0.0990567 / (d - 1.67154));
      fit_g_d = #exp(-2.20679 / (d + 3.91029) - 0.428934);
      fit_alpha = #exp(3.62489 - 8.29288 / (d + 5.52825));
      fit_w_d = #exp(-0.599085 / (d - 0.641583) - 0.665888);
    }
  }
};

/// The Henyey-Greenstein phase function of the deflection cosine `u`,
/// measured from the direction of propagation.
@(pure macro)
float fogHgPhase(const float g, const float u) = (1.0 - g * g) / (4.0 * $PI * (denom := 1.0 + g * g - 2.0 * g * u) * #sqrt(denom));

/// The Draine phase function of the deflection cosine `u`.
@(pure macro)
float fogDrainePhase(const float g, const float a, const float u) = fogHgPhase(g, u) * (1.0 + a * u * u) / (1.0 + a * (1.0 + 2.0 * g * g) / 3.0);

/// The fog phase function of the deflection cosine `u`, which is also
/// its own sampling density. NOTE: This is non-standard, exported for
/// the unit tests!
@(pure macro)
export float _fogPhase(const fog_vdf fog, const float u) = (1.0 - fog.fit_w_d) * fogHgPhase(fog.fit_g_hg, u) + fog.fit_w_d * fogDrainePhase(fog.fit_g_d, fog.fit_alpha, u);

/// Sample the deflection cosine of the Henyey-Greenstein phase
/// function by analytic CDF inversion. NOTE: This is non-standard,
/// exported for the unit tests!
@(pure macro)
export float _fogHgSample(const float g, const float xi0) {
  return 1.0 - 2.0 * xi0 if (#abs(g) < 0.001);
  const auto t = (1.0 - g * g) / (1.0 - g + 2.0 * g * xi0);
  return (1.0 + g * g - t * t) / (2.0 * g);
}

/// Sample the deflection cosine of the Draine phase function by
/// analytic CDF inversion: the quartic solution of the Jendersie and
/// d'Eon supplemental, in the numerically robust factoring used by
/// Blender Cycles, validated against brute-force CDF inversion. NOTE:
/// This is non-standard, exported for the unit tests!
@(pure)
export float _fogDraineSample(const float g, const float a, const float xi0) {
  // Degenerates to Henyey-Greenstein as `alpha` vanishes, where the
  // quartic terms divide by zero.
  return _fogHgSample(g, xi0) if (a < 0.001);
  if (#abs(g) < 0.01) {
    // Near-isotropic: the `g` of 0 CDF is a depressed cubic with one
    // real root by Cardano. Using it below this threshold costs a CDF
    // error of order `g`, following the reference implementation; the
    // fitted `fit_g_d` only lands here for particles under about 0.03
    // micrometers.
    const auto invA = 1.0 / a;
    const auto b2 = (3.0 + a) * invA * (0.5 - xi0);
    const auto invU = -1.0 / #pow(b2 + #sqrt(b2 * b2 + invA * invA * invA), 1.0 / 3.0);
    return 1.0 / invU - invU * invA;
  }
  const auto g2 = g * g;
  const auto g3 = g * g2;
  const auto g4 = g2 * g2;
  const auto g6 = g2 * g4;
  const auto onePlusG2 = 1.0 + g2;
  const auto t1a = a * (g4 - 1.0);
  const auto t2 = -1296.0 * (g2 - 1.0) * (a - a * g2) * t1a * (4.0 * g2 + a * onePlusG2 * onePlusG2);
  const auto t9 = 2.0 + g2 + g3 * (1.0 + 2.0 * g2) * (2.0 * xi0 - 1.0);
  const auto t3 = 3.0 * g2 * (1.0 + g * (2.0 * xi0 - 1.0)) + a * t9;
  const auto t4a = 432.0 * t1a * t1a * t1a + t2 + 432.0 * (a * (1.0 - g2)) * t3 * t3;
  const auto t10 = a * (2.0 * g4 - g2 - g6);
  const auto t4b = 144.0 * t10;
  const auto t4 = t4a + #sqrt(#max(-4.0 * t4b * t4b * t4b + t4a * t4a, 0.0));
  const auto invT4p3 = 1.0 / #pow(#max(t4, 1e-30), 1.0 / 3.0);
  const auto cbrt2 = 1.2599210498948732;
  const auto t8 = 48.0 * cbrt2 * t10;
  const auto t6 = (2.0 * t1a + t8 * invT4p3 + 1.0 / (3.0 * cbrt2 * invT4p3)) / (a * (1.0 - g2));
  const auto t5 = 6.0 * onePlusG2 + t6;
  const auto t7 = 6.0 * onePlusG2 - (8.0 * t3) / (a * (g2 - 1.0) * #sqrt(#max(t5, 1e-30))) - t6;
  const auto s = #sqrt(#max(t7, 0.0)) - #sqrt(#max(t5, 0.0));
  return (1.0 + g2 - 0.25 * s * s) / (2.0 * g);
}

@(macro)
auto scatterEvaluate(const &fog_vdf this, inline const &ScatterEvaluateParameters params) {
  // The deflection cosine is measured from the direction of
  // propagation `-wo`.
  const auto p = _fogPhase(*this, -dot(wo, wi));
  return ScatterEvaluateResult(f: p, pdf: float2(p));
}

@(macro)
auto scatterSample(const &fog_vdf this, inline const &ScatterSampleParameters params) {
  // Select the lobe by the mixture weight, then sample it exactly, so
  // the mixture density of the sampled direction is exactly the phase
  // value.
  const auto u = xi.z < this.fit_w_d //
                 ? _fogDraineSample(this.fit_g_d, this.fit_alpha, xi.x) : _fogHgSample(this.fit_g_hg, xi.x);
  const auto sinTheta = #sqrt(#max(0.0, 1.0 - u * u));
  const auto phi = 2.0 * $PI * xi.y;
  return ScatterSampleResult(wi: orthonormalBasis(wo) * float3(sinTheta * #cos(phi), sinTheta * #sin(phi), -u), mode: scatter_reflect_transmit);
}
//--}

@(macro)
export int _scatterEvaluate(
  const &_MaterialInstance instance,
  const &float3 woWorld, ///< The outgoing direction in world space
  const &float3 wiWorld, ///< The incoming direction in world space
  const int lobeMask,    ///< Which lobes to evaluate, `DF_ALL` for every one
  const &float pdfFwd,   ///< output: The PDF of sampling `wi` from `wo`
  const &float pdfRev,   ///< output: The PDF of sampling `wo` from `wi`
  const &float f,        ///< output: The scattering function
) {
  const auto wo0(normalize((*woWorld) * instance.tangent_to_world));
  const auto wi0(normalize((*wiWorld) * instance.tangent_to_world));
  auto params = ScatterEvaluateParameters(
    isImportance: (instance.flags & 1) != 0,
    rng: make_rng(instance.seed, directionPairHash(wo0, wi0)),
    ior: instance.exterior_ior / instance.ior,
    exterior_ior: instance.exterior_ior,
    wo0: wo0,
    wi0: wi0,
    normal: normalize(instance.geometry.normal),
    thin_walled: instance.ptr.thin_walled,
    lobeMask: lobeMask,
  );
  // Whether this query is reflection or transmission follows from the
  // direction pair alone, so a mask that keeps no lobe in this domain
  // excludes the whole query, whatever lobes the material has.
  if ((int(params.mode) & maskedModeBits(lobeMask)) == 0) {
    *pdfFwd = 0.0;
    *pdfRev = 0.0;
    for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++)
      f[i] = 0.0;
    return false;
  }
  auto result = #isDefault(instance.ptr.backface) || !params.hitBackface           //
                ? scatterEvaluateMasked(visit &instance.ptr.surface.scattering, &params) //
                : scatterEvaluateMasked(visit &instance.ptr.backface.scattering, &params);
  visit result in result {
    if (result.isBlack) {
      *pdfFwd = 0.0;
      *pdfRev = 0.0;
      for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++)
        f[i] = 0.0;
    } else {
      *pdfFwd = result.pdf[0];
      *pdfRev = result.pdf[1];
      if (#typeOf(result.f) == float) {
        for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++)
          f[i] = result.f;
      } else {
        #memcpy(f, &result.f, #sizeOf(float) * $WAVELENGTH_BASE_MAX);
      }
    }
    return !result.isBlack;
  }
}

@(macro)
export int _scatterSample(
  const &_MaterialInstance instance,
  const &float4 xi,      ///< The canonical random sample in `[0,1]^4`
  const &float3 woWorld, ///< The outgoing direction in world space
  const int lobeMask,    ///< Which lobes to sample among, `DF_ALL` for every one
  const &float3 wiWorld, ///< output: The incoming direction in world space
  const &float pdfFwd,   ///< output: The PDF of sampling `wi` from `wo`
  const &float pdfRev,   ///< output: The PDF of sampling `wo` from `wi`
  const &float f,          ///< output: The scattering function
  const &int sampledLobe,  ///< output: The single lobe drawn from, 0 if none
  const &float lobeChance, ///< output: The unmasked chance of the same selection
) {
  auto wo = normalize((*woWorld) * instance.tangent_to_world);
  auto params = ScatterSampleParameters(
    isImportance: (instance.flags & 1) != 0,
    xi: *xi,
    wo0: wo,
    ior: instance.exterior_ior / instance.ior,
    exterior_ior: instance.exterior_ior,
    normal: normalize(instance.geometry.normal),
    thin_walled: instance.ptr.thin_walled,
    lobeMask: lobeMask,
  );
  auto result = #isDefault(instance.ptr.backface) || !params.hitBackface         //
                ? scatterSampleMasked(visit &instance.ptr.surface.scattering, &params) //
                : scatterSampleMasked(visit &instance.ptr.backface.scattering, &params);
  // The chance the unmasked sampler would have made these same
  // selections, whatever the outcome: a caller that got nothing still
  // learns nothing chose.
  *lobeChance = params.lobeChance;
  *sampledLobe = 0;
  visit result in result {
    const auto wi = #select(params.hitBackface, -result.wi, +result.wi);
    if (result.mode == scatter_none || ((wo.z < 0.0) == (wi.z < 0.0)) != (result.mode == scatter_reflect)) {
      *pdfFwd = 0.0;
      *pdfRev = 0.0;
      for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++)
        f[i] = 0.0;
      return false;
    }
    *wiWorld = normalize(instance.tangent_to_world * wi);
    // The descent narrowed to what the leaf can produce; the mode it
    // returned names the domain, and one domain of one leaf is one lobe.
    *sampledLobe = params.sampledLobe & modeLobes(int(result.mode), DF_ALL);
    if (bool(result.fDirac)) {
      *pdfFwd = 1.0;
      *pdfRev = 1.0;
      #memcpy(f, &*result.fDirac, #sizeOf(float) * $WAVELENGTH_BASE_MAX);
      return true;
    } else {
      // The evaluation reports what the sampling drew, so it must see
      // the same mask: a direction drawn from the masked distribution
      // weighed against the density of the whole one is biased.
      return _scatterEvaluate(instance, woWorld, wiWorld, lobeMask, pdfFwd, pdfRev, f);
    }
  }
}

/// The normal distribution evaluate entry point. NOTE: This is non-standard!
///
/// The density with which `_scatterNormalSample` draws `wmWorld` given
/// `woWorld`, per unit solid angle about it, mixed over every lobe the mask
/// keeps that could have produced it.
@(macro)
export int _scatterNormalEvaluate(
  const &_MaterialInstance instance,
  const int backface,    ///< Ask on the geometric backface side?
  const &float3 wmWorld, ///< The microfacet normal in world space
  const int lobeMask,    ///< Which lobes to consider, `DF_GLOSSY` for every one
  const &float pdf,      ///< output: The density of `wm` per unit solid angle
) {
  auto params = ScatterNormalParameters(
    hitBackface: bool(backface),
    wm0: normalize((*wmWorld) * instance.tangent_to_world),
    ior: instance.exterior_ior / instance.ior,
    exterior_ior: instance.exterior_ior,
    normal: normalize(instance.geometry.normal),
    thin_walled: instance.ptr.thin_walled,
    lobeMask: lobeMask,
  );
  *pdf = #isDefault(instance.ptr.backface) || !params.hitBackface           //
         ? normalEvaluateMasked(visit &instance.ptr.surface.scattering, &params) //
         : normalEvaluateMasked(visit &instance.ptr.backface.scattering, &params);
  return *pdf > 0.0;
}

/// The normal distribution sample entry point. NOTE: This is non-standard!
///
/// Draws a microfacet normal from the normal distribution of one lobe the
/// mask keeps, and reports the density of the whole masked mixture at it, so
/// that `_scatterNormalEvaluate` at the same directions returns the same
/// number. That is the one property a caller may depend on, and it holds by
/// construction because the density comes from that very function, exactly as
/// `_scatterSample` takes a non-Dirac density from `_scatterEvaluate`.
@(macro)
export int _scatterNormalSample(
  const &_MaterialInstance instance,
  const &float4 xi,      ///< The canonical random sample in `[0,1]^4`
  const int backface,    ///< Ask on the geometric backface side?
  const int lobeMask,    ///< Which lobes to consider, `DF_GLOSSY` for every one
  const &float3 wmWorld, ///< output: The microfacet normal in world space
  const &float pdf,      ///< output: The density of `wm` per unit solid angle
  const &float2 alpha,   ///< output: The squared roughness of the lobe drawn from
) {
  auto params = ScatterNormalParameters(
    xi: *xi,
    hitBackface: bool(backface),
    ior: instance.exterior_ior / instance.ior,
    exterior_ior: instance.exterior_ior,
    normal: normalize(instance.geometry.normal),
    thin_walled: instance.ptr.thin_walled,
    lobeMask: lobeMask,
  );
  auto result = #isDefault(instance.ptr.backface) || !params.hitBackface       //
                ? normalSampleMasked(visit &instance.ptr.surface.scattering, &params) //
                : normalSampleMasked(visit &instance.ptr.backface.scattering, &params);
  *pdf = 0.0;
  *alpha = float2(0.0);
  if (!result.isValid)
    return false;
  // Undo the backface flip the parameters applied, exactly as the scattering
  // sampler does, so the world-space normal comes back on the requested side.
  *wmWorld = normalize(instance.tangent_to_world * #select(params.hitBackface, -result.wm, +result.wm));
  *alpha = result.alpha;
  return _scatterNormalEvaluate(instance, backface, wmWorld, lobeMask, pdf);
}

@(macro)
export float _volumeScatterEvaluate(
  const &_MaterialInstance instance,
  const &float3 woWorld, ///< The outgoing direction in world space
  const &float3 wiWorld, ///< The incoming direction in world space
) {
  auto params = ScatterEvaluateParameters(
    isImportance: 0,
    wo0: normalize(*woWorld),
    wi0: normalize(*wiWorld),
    hitBackface: false, // Not applicable for volume scattering
    ior: 1.0,           // Not applicable for volume scattering
  );
  // The entry point is scalar, but `tint` and the mixers can produce a
  // color-valued phase; `average` folds it and is the identity for the
  // float-valued elemental VDFs.
  return average(scatterEvaluateMasked(visit &instance.ptr.volume.scattering, &params).f);
}

@(macro)
export float _volumeScatterSample(
  const &_MaterialInstance instance,
  const &float4 xi,      ///< The canonical random sample in `[0,1]^4`
  const &float3 woWorld, ///< The outgoing direction in world space
  const &float3 wiWorld, ///< output: The incoming direction in world space
) {
  auto wo = normalize(*woWorld);
  auto params = ScatterSampleParameters(
    isImportance: false, // Not applicable for volume scattering
    xi: *xi,
    wo0: wo,
    hitBackface: false, // Not applicable for volume scattering
    ior: 1.0,           // Not applicable for volume scattering
  );
  auto result = scatterSampleMasked(visit &instance.ptr.volume.scattering, &params);
  if (result.mode == scatter_none) {
    return 0.0;
  }
  *wiWorld = normalize(result.wi);
  return _volumeScatterEvaluate(instance, woWorld, wiWorld);
}

/// The hair scattering entry point, dispatching `material.hair`. NOTE:
/// This is non-standard!
///
/// The host contract at a hair hit: `$state.normal` must be the shading
/// normal on the fiber surface (the true normal of a tube; ribbon
/// geometry must synthesize it) and `$state.texture_tangent_u[0]` must be
/// the fiber tangent pointing root to tip. The cross-section offset is
/// implied by the normal as `h = sin(gamma_o)`, so no texture coordinate
/// is consulted here. Per the MDL specification, the material `ior`,
/// `thin_walled`, `volume`, and `geometry` fields do not influence hair
/// shading, and `wo.z < 0` is a legitimate configuration rather than a
/// backface hit: nothing is flipped. Hosts should gate on
/// `MATERIAL_HAS_HAIR`; calling anyway is safe because the default
/// `hair_bsdf()` reports black.
@(macro)
export int _hairScatterEvaluate(
  const &_MaterialInstance instance,
  const &float3 woWorld, ///< The outgoing direction in world space
  const &float3 wiWorld, ///< The incoming direction in world space
  const &float pdfFwd,   ///< output: The PDF of sampling `wi` from `wo`
  const &float pdfRev,   ///< output: The PDF of sampling `wo` from `wi`
  const &float f,        ///< output: The scattering function
) {
  auto params = ScatterEvaluateParameters(
    isImportance: (instance.flags & 1) != 0,
    wo0: normalize((*woWorld) * instance.tangent_to_world),
    wi0: normalize((*wiWorld) * instance.tangent_to_world),
    hitBackface: false, // Not applicable for hair scattering
    ior: 1.0,           // Not applicable for hair scattering
  );
  auto result = scatterEvaluateMasked(visit &instance.ptr.hair, &params);
  visit result in result {
    if (result.isBlack) {
      *pdfFwd = 0.0;
      *pdfRev = 0.0;
      for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++)
        f[i] = 0.0;
    } else {
      *pdfFwd = result.pdf[0];
      *pdfRev = result.pdf[1];
      if (#typeOf(result.f) == float) {
        for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++)
          f[i] = result.f;
      } else {
        #memcpy(f, &result.f, #sizeOf(float) * $WAVELENGTH_BASE_MAX);
      }
    }
    return !result.isBlack;
  }
}

/// The hair scattering sample entry point. NOTE: This is non-standard!
///
/// See `_hairScatterEvaluate` for the host contract. There are no Dirac
/// hair distributions and no lobe taxonomy for hair, so every accepted
/// sample simply reports its value and densities through
/// `_hairScatterEvaluate`. The surface hemisphere-versus-mode consistency
/// check deliberately does not apply: a rejected sample is reported by
/// `mode == scatter_none` alone.
@(macro)
export int _hairScatterSample(
  const &_MaterialInstance instance,
  const &float4 xi,      ///< The canonical random sample in `[0,1]^4`
  const &float3 woWorld, ///< The outgoing direction in world space
  const &float3 wiWorld, ///< output: The incoming direction in world space
  const &float pdfFwd,   ///< output: The PDF of sampling `wi` from `wo`
  const &float pdfRev,   ///< output: The PDF of sampling `wo` from `wi`
  const &float f,        ///< output: The scattering function
) {
  auto params = ScatterSampleParameters(
    isImportance: (instance.flags & 1) != 0,
    xi: *xi,
    wo0: normalize((*woWorld) * instance.tangent_to_world),
    hitBackface: false, // Not applicable for hair scattering
    ior: 1.0,           // Not applicable for hair scattering
  );
  auto result = scatterSampleMasked(visit &instance.ptr.hair, &params);
  visit result in result {
    if (result.mode == scatter_none) {
      *pdfFwd = 0.0;
      *pdfRev = 0.0;
      for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++)
        f[i] = 0.0;
      return false;
    }
    *wiWorld = normalize(instance.tangent_to_world * result.wi);
    return _hairScatterEvaluate(instance, woWorld, wiWorld, pdfFwd, pdfRev, f);
  }
}

//--{ Emission entry points
// Which side emits:
// - Solid materials emit only on the exterior side; a backface hit
//   returns black. (Scattering must handle backface hits of solids for
//   refraction exit; emission has no analogous need, and the interior of
//   a closed solid is the volume's business.)
// - Thin-walled materials emit `surface.emission` on the front side, and
//   on the back side `backface.emission` when `backface` is non-default,
//   else `surface.emission` mirrored.
//
// `_emissionSample` chooses the emitting side with chance proportional to
// each side's average intensity, and `_emissionEvaluate` folds the same
// chance into the reported PDF, so the two always agree for MIS.

/// Calculate the average emission intensities of the front and back sides.
@(macro)
float2 _emissionSideWeights(const &_MaterialInstance instance) {
  float frontWeight = 0.0;
  float backWeight = 0.0;
  if $(!#isDefault(instance.ptr.surface.emission.emission)) {
    frontWeight = #max(average(instance.ptr.surface.emission.intensity), 0.0);
  }
  if (instance.ptr.thin_walled) {
    if $(!#isDefault(instance.ptr.backface)) {
      if $(!#isDefault(instance.ptr.backface.emission.emission)) {
        backWeight = #max(average(instance.ptr.backface.emission.intensity), 0.0);
      }
    } else {
      backWeight = frontWeight;
    }
  }
  return float2(frontWeight, backWeight);
}

/// Evaluate the emission of the given `material_surface` side, weighting
/// the PDF by the side chance and applying the intensity.
@(macro)
int _emissionEvaluateSide(
  const &material_surface side,
  const float chance,
  const &EmissionEvaluateParameters params,
  const &float pdf,
  const &float Le,
) {
  if (!(chance > 0.0))
    return false;
  auto result = emissionEvaluate(visit &side.emission.emission, params);
  visit result in result {
    if (result.isBlack)
      return false;
    *pdf = chance * result.pdf;
    color LeResult(color(side.emission.intensity) * result.f);
    #memcpy(Le, &LeResult, #sizeOf(float) * $WAVELENGTH_BASE_MAX);
    return true;
  }
}

@(macro)
export int _emissionEvaluate(
  const &_MaterialInstance instance,
  const &float3 wiWorld, ///< The emission direction in world space
  const &float pdf,      ///< output: The PDF of sampling `wiWorld`
  const &float Le,       ///< output: The emitted radiance
) {
  *pdf = 0.0;
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++)
    Le[i] = 0.0;
  const auto weights = _emissionSideWeights(instance);
  const auto totalWeight = weights.x + weights.y;
  if (!(totalWeight > 0.0))
    return false;
  auto params = EmissionEvaluateParameters(
    wi0: normalize((*wiWorld) * instance.tangent_to_world),
    normal: normalize(instance.geometry.normal),
  );
  if (!params.hitBackface) {
    return _emissionEvaluateSide(&instance.ptr.surface, weights.x / totalWeight, &params, pdf, Le);
  } else {
    if (!instance.ptr.thin_walled)
      return false;
    if $(!#isDefault(instance.ptr.backface)) {
      return _emissionEvaluateSide(&instance.ptr.backface, weights.y / totalWeight, &params, pdf, Le);
    } else {
      return _emissionEvaluateSide(&instance.ptr.surface, weights.y / totalWeight, &params, pdf, Le);
    }
  }
}

@(macro)
export int _emissionSample(
  const &_MaterialInstance instance,
  const &float4 xi,      ///< The canonical random sample in `[0,1]^4`
  const &float3 wiWorld, ///< output: The emission direction in world space
  const &float pdf,      ///< output: The PDF of sampling `wiWorld`
  const &float Le,       ///< output: The emitted radiance
) {
  *pdf = 0.0;
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++)
    Le[i] = 0.0;
  const auto weights = _emissionSideWeights(instance);
  const auto totalWeight = weights.x + weights.y;
  if (!(totalWeight > 0.0))
    return false;
  auto params = EmissionSampleParameters(
    xi: *xi,
    normal: normalize(instance.geometry.normal),
  );
  const bool sampleFront = sampling::bool_sample(&params.xi.w, weights.x / totalWeight);
  auto result = return_from {
    if (sampleFront) {
      return emissionSample(visit &instance.ptr.surface.emission.emission, &params);
    } else if $(!#isDefault(instance.ptr.backface)) {
      return emissionSample(visit &instance.ptr.backface.emission.emission, &params);
    } else {
      return emissionSample(visit &instance.ptr.surface.emission.emission, &params);
    }
  };
  visit result in result {
    // Reject directions at or below the geometric horizon: `_emissionEvaluate`
    // would attribute them to the other side and disagree on the PDF.
    if (!result.isValid || !(result.wi.z > 0.0))
      return false;
    const auto wiNatural = sampleFront ? result.wi : -result.wi;
    *wiWorld = normalize(instance.tangent_to_world * wiNatural);
    return _emissionEvaluate(instance, wiWorld, pdf, Le);
  }
}
//--}
