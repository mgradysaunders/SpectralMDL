// vim:foldmethod=marker:foldlevel=0:fmr=--{,--}
/// The distribution functions, following the MDL specification: the
/// elemental BSDFs, EDFs, and VDFs, the modifier and layering
/// combinators, and the mixers, plus the internal scattering and
/// emission entry points the compiler exposes to renderers.
///
/// NOTE: The `handle` of every distribution function here should be a
/// `string` by the specification, but we `void` it because we have no
/// use for it.
///
/// NOTE: The `multiscatter_tint` contract is uniform across the lobes
/// that have one: `0.0` disables the multiple-scattering lobe and `1.0`
/// engages it at full compensation, while the default `none` means the
/// model's canonical form. For the microfacet, Ward, and sheen lobes the
/// canonical form is single scattering, matching the specification's
/// `color(0.0)` default; for `diffuse_reflection_bsdf` the canonical
/// form includes the EON multiple-scattering term, which is part of the
/// model itself rather than an add-on compensation lobe.
///
#smdl

using ::math import *;
using ::extras::rng import *;
using sampling = ::extras::sampling;
import sampling::*;
import ::tex::*;
using ::extras::parallax import relief_visible;

/// The scatter mode, describing the hemispheres a BSDF scatters into.
export enum scatter_mode {
  scatter_none = 0x0,             ///< None
  scatter_reflect = 0x1,          ///< Reflect (same hemisphere)
  scatter_transmit = 0x2,         ///< Transmit (opposite hemisphere)
  scatter_reflect_transmit = 0x3, ///< Reflect or transmit
};

@(pure macro)
float scatterReflectChance(const scatter_mode mode) {
  const auto reflWeight(#select((int(mode) & 1) != 0, 1.0, 0.0));
  const auto tranWeight(#select((int(mode) & 2) != 0, 1.0, 0.0));
  // The `#max` guards `scatter_none`, which must yield 0 instead of 0/0.
  return reflWeight / #max(reflWeight + tranWeight, 1.0);
}

// The distribution function lobes, mirrored in `smdl::JIT` (see
// `include/smdl/JIT.h`, which is the authority and must be kept in step).
//
// One bit per lobe, a lobe being a domain (which side of the surface it
// sends light to) paired with a kind (what structure it has to sample). A
// lobe word is the SET of lobes present, so `df_lobes` unions over a
// subtree without losing which domain went with which kind, and a lobe mask
// is a set of lobes in the same vocabulary: `|` unions, `&` intersects, and
// a lobe is live iff the two sets share a bit.
//
// A bit is a lobe and not a distribution type. One struct declares as many
// bits as it has ways to scatter: a rough BSDF with an energy-compensation
// term is GLOSSY and SMOOTH together, the two being different kinds on the
// same domain; see `multiscatterLobes`.
export const int DF_SMOOTH_BRDF = (1 << 0);

export const int DF_GLOSSY_BRDF = (1 << 1);

export const int DF_DIRAC_BRDF = (1 << 2);

export const int DF_SMOOTH_BTDF = (1 << 3);

export const int DF_GLOSSY_BTDF = (1 << 4);

export const int DF_DIRAC_BTDF = (1 << 5);

// The rows and columns of that table, as unions. They name an axis
// without constraining the other, so intersecting two of them names the
// single lobe their names spell: `DF_DIRAC & DF_BTDF` is `DF_DIRAC_BTDF`.
export const int DF_BRDF = DF_SMOOTH_BRDF | DF_GLOSSY_BRDF | DF_DIRAC_BRDF;

export const int DF_BTDF = DF_SMOOTH_BTDF | DF_GLOSSY_BTDF | DF_DIRAC_BTDF;

// A density that is a smooth function of direction with no normal
// distribution behind it, so there is no half vector to constrain.
export const int DF_SMOOTH = DF_SMOOTH_BRDF | DF_SMOOTH_BTDF;

// A sampleable normal distribution, so a half vector is meaningful.
export const int DF_GLOSSY = DF_GLOSSY_BRDF | DF_GLOSSY_BTDF;

// A Dirac delta: no density, and the half vector fixed by the geometry.
export const int DF_DIRAC = DF_DIRAC_BRDF | DF_DIRAC_BTDF;

// Every lobe with a density, which is every lobe but the Dirac ones.
export const int DF_FINITE = DF_SMOOTH | DF_GLOSSY;

// Every lobe, which is the lobe mask of a caller that wants the whole
// distribution.
export const int DF_ALL = DF_BRDF | DF_BTDF;

// Property bits riding above the lobes in the same word, NOT lobes and NOT
// in `DF_ALL`: a lobe mask never names them, so every `&` against a mask
// drops them, and unioning `df_lobes` over a subtree propagates them for
// free through every layer, mix, factor, and union.
//
// `DF_CAN_SET_NORMAL`: the subtree contains a node that was GIVEN a
// `normal`, which pins that node's lobes to it instead of the normal the
// node would otherwise inherit. A node left defaulted inherits and reports
// neither bit. `DF_SETS_NORMAL`: such a given normal is, at this instance
// evaluation, actually different from `$state.normal`.
//
// A manifold estimator solves against `geometry.normal`, which is the
// normal every defaulted node inherits, so it refuses `DF_SETS_NORMAL`
// outright (the node detaches whether or not the material remaps), and
// refuses `DF_CAN_SET_NORMAL` when the material also remaps
// `geometry.normal` (a given normal equal to `$state.normal` detaches from
// a remapped field).
export const int DF_SETS_NORMAL = (1 << 6);

export const int DF_CAN_SET_NORMAL = (1 << 7);

// The lobes of a leaf whose domains come from a `scatter_mode` and whose
// kind is fixed, e.g. a `specular_bsdf` is `DF_DIRAC` over whichever
// domains its mode admits. `scatter_reflect` and `scatter_transmit` are 1
// and 2, deliberately no longer the domain constants themselves: a lobe is
// the product of the two axes, so a mode has to be expanded into a domain
// row rather than reinterpreted as one.
@(pure macro)
int modeLobes(const int mode, const int kinds) {
  return (((mode & 1) != 0 ? DF_BRDF : 0) |
          ((mode & 2) != 0 ? DF_BTDF : 0)) & kinds;
}

// The domains a mask leaves alive, as `scatter_mode` bits. Leaves pass
// `lobeMask & this.df_lobes`: the mask names lobes, so the domains a leaf
// keeps are those its own kinds survive under, never a domain kept alive
// by a kind the leaf does not have.
@(pure macro)
int maskedModeBits(const int lobeMask) {
  return ((lobeMask & DF_BRDF) != 0 ? int(scatter_reflect) : 0) |
         ((lobeMask & DF_BTDF) != 0 ? int(scatter_transmit) : 0);
}

// Does the caller's lobe mask keep a distribution with these lobes? Both
// words are sets of lobes, so the question is whether they share one. This
// is exact at a combinator as well as at a leaf, because a lobe carries its
// domain and its kind together and the union that forms a subtree's word
// never separates them.
//
// A distribution declaring no lobes at all is always kept: that is every
// volume distribution and every empty default, and a lobe mask has nothing
// to say about a thing with no lobes. A mask naming nothing at all selects
// nothing, so that a zero-initialized variable does not quietly mean
// everything.
@(pure macro)
bool isLobeLive(const int dfLobes, const int lobeMask) {
  return false if (lobeMask == 0);
  return true if (dfLobes == 0);
  return (dfLobes & lobeMask) != 0;
}

// The selection chance of a two-way choice once the mask has removed
// whichever side it excludes, `chance` being the chance of the first.
// A live side facing a dead one takes the whole chance, which is all
// renormalizing a two-way choice over the live set amounts to.
@(pure macro)
float maskedChance(const float chance, const int firstLobes, const int secondLobes, const int lobeMask) {
  const bool firstLive(isLobeLive(firstLobes, lobeMask));
  return chance if (firstLive & isLobeLive(secondLobes, lobeMask));
  return 1.0 if (firstLive);
  return 0.0;
}

// Does a distribution have a normal distribution the caller can ask for?
// Unlike `isLobeLive`, a word declaring nothing is DEAD here: only a GLOSSY
// lobe has a normal distribution behind it, so a subtree with none has
// nothing to offer whatever the mask says.
@(pure macro)
bool hasNormalDistribution(const int dfLobes, const int lobeMask) {
  return (dfLobes & DF_GLOSSY & lobeMask) != 0;
}

// The selection chance of a two-way choice once the sides with no normal
// distribution have been removed, which is what a normal query renormalizes
// over. `maskedChance` with the liveness rule above.
@(pure macro)
float maskedNormalChance(const float chance, const int firstLobes, const int secondLobes, const int lobeMask) {
  const bool firstLive(hasNormalDistribution(firstLobes, lobeMask));
  return chance if (firstLive & hasNormalDistribution(secondLobes, lobeMask));
  return 1.0 if (firstLive);
  return 0.0;
}

// The same for the forward and reverse densities the evaluation path
// reports together.
@(pure macro)
float2 maskedChance(const float2 chance, const int firstLobes, const int secondLobes, const int lobeMask) {
  return float2(maskedChance(chance.x, firstLobes, secondLobes, lobeMask),
                maskedChance(chance.y, firstLobes, secondLobes, lobeMask));
}

// An arbitrary chance for sampling diffusely in BSDFs with multiple-scattering.
const float MULTISCATTER_DIFFUSE_CHANCE = 0.2;

// The threshold on the average energy deficit `1 - E_avg` below which the
// Kulla-Conty style multiple-scattering compensation lobes are dropped
// outright: the lobe redistributes less than this fraction of the
// reflected energy, and evaluating its `0 * 0 / 0` shape with a floored
// denominator would only distort it.
const float MULTISCATTER_MIN_DEFICIT = 1e-4;

// Does a `multiscatter_tint` field carry a compensation lobe at all? The
// tint is absent when it is `none`, and a scalar zero is the specification's
// way of asking for no compensation. A color zero is deliberately NOT tested:
// it is a runtime spectrum and the lobe costs nothing when it is black.
//
// Takes the tint rather than the distribution, so the same question can be
// asked from a `df_lobes` initializer, where there is no `this` yet.
@(pure macro)
bool hasMultiscatter(const auto multiscatterTint) {
  return false if (#typeOf(multiscatterTint) == void);
  return !(#typeOf(multiscatterTint) == float && multiscatterTint == 0.0);
}

// The lobes a compensation term adds to the distribution carrying it.
//
// The lobe is a cosine hemisphere with no normal distribution behind it, so
// it is SMOOTH where the lobe it compensates is GLOSSY, and declaring that
// is what lets a mask cut between the two: a caller asking for a normal
// distribution should not be handed the diffuse term that exists to make up
// for one.
//
// Only where the lobe actually contributes, which is the reflect domain of
// whichever modes the distribution admits. A thin wall delivers the same
// compensation as a transmission, but `thin_walled` is a material property
// and is not in scope where a distribution fixes its lobes; on that path
// the compensation stays with the single scattering it rides along with
// rather than claiming a lobe the material never declared. See
// `ScatterEvaluateResultWithMultiscatter`.
@(pure macro)
int multiscatterLobes(const auto multiscatterTint, const int mode [[anno::unused()]]) {
  return hasMultiscatter(multiscatterTint) ? modeLobes(mode, DF_SMOOTH_BRDF) : 0;
}

// The property bits a node's `normal` parameter contributes to its
// `df_lobes`; see `DF_SETS_NORMAL`. A defaulted normal is `void`, which
// reports nothing and folds the whole thing away: the node inherits, and
// there is nothing for an estimator to be told about.
@(macro)
int normalParamLobes(const auto normal [[anno::unused()]]) {
  if $(#isVoid(normal)) {
    return 0;
  } else {
    return DF_CAN_SET_NORMAL | (#all(normal == $state.normal) ? 0 : DF_SETS_NORMAL);
  }
}

// The cosine threshold below which a direction is treated as lying
// numerically in the surface plane. Configurations beyond this boundary are
// culled outright: the value and every reported density zeroed together
// through the `isBlack` convention. The threshold sits far above the roughly
// 1e-7 directional noise of normalized `float` vectors, and the culled ring
// carries about 1e-10 of the hemisphere's cosine-weighted throughput.
const float MIN_COS_THETA = 1e-5;

// The floor for one-sample selection chances between live lobes. Clamping
// a chance into `[MIN_CHANCE, 1 - MIN_CHANCE]` keeps the estimator unbiased
// while putting a hard `1/MIN_CHANCE` bound on the throughput of rarely
// selected lobes. The cost is bounded sampling waste on lobes whose true
// weight is below the floor. The value is set by how long a floored lobe
// takes to be drawn at all: at 0.1 every tenth sample reaches it, so an
// undersampled component (a few-percent Fresnel reflection of a bright
// source) resolves within practical per-pixel budgets, for a worst-case
// tenth of the samples spent on a negligible lobe.
const float MIN_CHANCE = 0.1;

// Clamp a one-sample selection chance between two lobes into
// `[MIN_CHANCE, 1 - MIN_CHANCE]` when it is strictly interior, and
// preserve the exact endpoints: a chance of exactly 0 or 1 arises from
// structurally saturated parameters (zero or unit weight and curve),
// where the unselected lobe carries no weight and the combinator must
// degenerate to the selected lobe exactly. Callers whose unselected
// lobe stays live at a saturated chance (the microfacet dielectric at
// total internal reflection) must clamp the relevant endpoint
// themselves.
@(pure macro)
auto clampChance(const auto chance) = #select((chance > 0.0) & (chance < 1.0), clamp(chance, MIN_CHANCE, 1.0 - MIN_CHANCE), saturate(chance));

// Every user-facing IOR is the ABSOLUTE index of the denser medium. Plastic
// is 1.4, never 1/1.4. The exterior medium defaults to 1 and may be overridden
// per instance by the host through `_MaterialInstance.exterior_ior` for nested
// dielectric tracking.
//
// The scatter parameter structs instead carry the RELATIVE ratio
// `ior = n(wo) / n(wt)` of the current frame. The entry points
// `_scatterEvaluate` and `_scatterSample` construct it as
// `exterior_ior / instance.ior` (entering), and the `finalize` blocks
// reciprocate it on backface hits of solid materials, so that `wo` is
// always in the upper hemisphere and the ratio is always oriented with it.
// Thin-walled materials never reciprocate: both sides face the exterior,
// and transmission does not refract.
//
// Every primitive in the `specular` namespace takes this relative incident
// to transmitted ratio. A modifier BSDF that carries a user-facing absolute
// IOR must convert it with `relativeIOR()`; never invert by hand.
const float DEFAULT_IOR = 1.4;

// Convert a user-facing absolute IOR to the relative ratio oriented with
// the current frame of the given scatter parameters, honoring the backface
// reciprocation applied in the parameter `finalize` blocks and the
// exterior medium of the instance.
@(pure macro)
auto relativeIOR(const auto params, const auto absoluteIOR) {
  if (params.hitBackface & !params.thin_walled) {
    return absoluteIOR / params.exterior_ior;
  } else {
    return params.exterior_ior / absoluteIOR;
  }
}

@(pure macro)
float3x3 orthonormalBasis(float3 z) {
  z = normalize(z);
  auto x = z.z < -0.9999            //
           ? float3(0.0, -1.0, 0.0) //
           : float3(-z.x / (z.z + 1.0) + 1.0, -z.y / (z.z + 1.0), -1.0);
  x = normalize(x - dot(x, z) * z);
  auto y = normalize(cross(z, x));
  return float3x3(x, y, z);
}

// Normalize the shading normal and orient it into the geometric upper
// hemisphere. Every tangent space is built in the natural tangent space,
// whose Z axis is the geometric normal, so a shading normal that points
// into the surface is nonsense that must be turned around before anything
// else looks at it.
@(pure macro)
float3 orientShadingNormal(const float3 normal) = (n := normalize(normal)) * #sign(n.z);

// Calculate the orthogonal right-handed tangent space from the
// given normal and tangent vectors.
@(pure noinline)
float3x3 calculateTangentSpace(const float3 normal, const float3 tangent_u) {
  const auto tw(orientShadingNormal(normal));
  const auto tu(normalize(tangent_u - dot(tangent_u, tw) * tw));
  const auto tv(normalize(cross(tw, tu)));
  return float3x3(tu, tv, tw);
}

// The shading cosine that `bendShadingNormal()` targets, as a fraction of the
// geometric cosine. Bending only until the shading cosine reaches zero would
// leave the shading normal exactly grazing at the contour, where the masking
// terms of the glossy lobes vanish and the black line survives as a dark one.
// A small positive fraction keeps the bent normal off the horizon without
// visibly flattening the perturbation elsewhere.
const float SHADING_NORMAL_MIN_COS_RATIO = 0.05;

// The fraction of the way from the shading normal to the geometric normal
// that the shading normal must be bent for direction `w` to end up on the
// side of the shading horizon that the geometry puts it on, with the margin
// fixed by `SHADING_NORMAL_MIN_COS_RATIO`. Expects `normal` to be oriented,
// i.e., unit length with non-negative Z.
//
// Both cosines are measured with the orientation of the geometric cosine, so
// the same algebra covers reflection and transmission. The fraction is solved
// on the unnormalized interpolant, which errs safe: its length is at most 1,
// so normalizing can only increase the cosine it achieves. The target being a
// fraction of the geometric cosine, the fully flattened normal always meets
// it, so the answer is always in `[0,1]`.
@(pure)
float shadingNormalBendFraction(const float3 normal, const float3 w) {
  const float s(#sign(w.z));
  const float cosGeom(s * w.z); // The geometric cosine, never negative.
  const float cosShade(s * dot(normal, w));
  const float cosTarget(SHADING_NORMAL_MIN_COS_RATIO * cosGeom);
  return 0.0 if (!(cosShade < cosTarget)); // Nothing to do.
  return 1.0 if (!(cosGeom > cosShade));   // Unreachable, but never divide by zero.
  return #min((cosTarget - cosShade) / (cosGeom - cosShade), 1.0);
}

// Bend the shading normal toward the geometric normal by the least amount
// that keeps both directions on the sides of the shading horizon that the
// geometry puts them on.
//
// A tangent-space normal map, or on a coarse mesh the interpolated vertex
// normal near a silhouette, routinely tips the shading normal far enough that
// the shading frame claims a direction is behind the surface while the
// geometry has it in front. The BSDF is undefined there, and rejecting
// outright paints a hard black contour along the locus where the shading
// cosine changes sign. Bending flattens the shading normal continuously back
// toward the geometry exactly where the perturbation stops being usable, and
// is the identity everywhere else.
//
// The fraction is the maximum over the two directions, which makes the bend
// symmetric under swapping them, so the BSDF stays reciprocal and the
// shading normal correction factor for importance transport stays valid.
// Pass the same direction twice to constrain only one, which is all the
// sampling path knows.
@(pure)
float3 bendShadingNormal(const float3 normal, const float3 wo, const float3 wi) {
  const auto n(orientShadingNormal(normal));
  const auto t(#max(shadingNormalBendFraction(n, wo), shadingNormalBendFraction(n, wi)));
  return n if (!(t > 0));
  return normalize(lerp(n, float3(0.0, 0.0, 1.0), t));
}

// The normal a node with a `normal` parameter scatters about: the one it
// was given, or, when it was left defaulted and so is `void`, the normal
// already active where the node sits. That is `geometry.normal` unless an
// enclosing node overrode it, so a normal map applied once at the top
// reaches every layer beneath it and nothing silently reverts to
// `$state.normal`. The choice is made at compile time and the defaulted
// arm compiles out.
@(pure macro)
float3 layerNormal(const auto normal [[anno::unused()]], const float3 active [[anno::unused()]]) =
  #isVoid(normal) ? active : normal;

/// Declare libm `erf`
@(pure foreign)
double erf(double x);

/// Declare libm `erfc`
@(pure foreign)
double erfc(double x);

//--{ specular
/// The specular utilities: reflection and refraction geometry and the
/// Fresnel equations, all in terms of relative IORs.
export namespace specular {

/// Reflect direction `wi` across normal direction `wm`.
@(pure)
export float3 reflect(const float3 wi, const float3 wm) = 2 * #sum(wi * wm) * wm - wi;

/// Reflect direction `wi` across normal direction `wm` with index of refraction `ior`.
@(pure)
export float3 refract(const float3 wi, const float3 wm, const float ior) {
  const auto cosThetai(#sum(wi * wm));
  const auto cos2Thetai(#min(cosThetai * cosThetai, 1));
  const auto cos2Thetat(#max(1 - ior * ior * (1 - cos2Thetai), 0));
  const auto cosThetat(#sqrt(cos2Thetat) * -#sign(cosThetai));
  return -ior * wi + (ior * cosThetai + cosThetat) * wm;
}

/// Calculate half vector that reflects direction `wo` to direction `wi`.
///
/// NOTE: The result is not normalized, and is guaranteed to be in the
/// upper Z hemisphere.
///
@(pure)
export float3 reflection_half_vector(const float3 wo, const float3 wi) = (vh := (wo + wi)) * #sign(vh.z);

/// Calculate half vector that refracts direction `wo` to direction `wi` through index-of-refraction `ior`.
///
/// NOTE: The result is not normalized, and is guaranteed to be in the
/// upper Z hemisphere.
///
@(pure)
export float3 refraction_half_vector(
  const float3 wo,
  const float3 wi,
  const float ior,
) = (vh := -(ior * wo + wi)) * #sign(vh.z);

/// Calculate the Jacobian of `refraction_half_vector` with respect to `wi`,
/// which converts microsurface normal densities into incoming direction
/// densities.
@(pure)
export auto refraction_half_vector_jacobian(
  const float3 wo,
  const float3 wi,
  const float ior,
) = #abs(#sum(wi * (vh := refraction_half_vector(wo, wi, ior)))) / ((vh2 := #sum(vh * vh)) * #sqrt(vh2));

/// The Schlick reflectance at normal incidence for the given relative IOR.
@(pure macro)
export auto schlick_f0(const auto ior) = #pow((ior - 1) / (ior + 1), 2);

/// The Schlick approximation of Fresnel reflectance, interpolating from
/// `F0` at normal incidence to `F90` at grazing incidence.
@(pure macro)
export auto schlick_fresnel(
  const auto cosTheta,
  const auto F0,
  const auto F90 = 1.0,
  const float exponent = 5,
) = F0 + (F90 - F0) * #pow(#max(1 - #abs(cosTheta), 0), exponent);

/// The exact unpolarized Fresnel reflectance of a dielectric interface
/// with the given relative IOR, folding total internal reflection to 1.
@(pure)
export auto dielectric_fresnel(const float cosThetai, const auto ior) {
  const auto cosThetat = #sqrt(#max(1.0 - ior * ior * (1.0 - cosThetai * cosThetai), 0.0)) * #sign(cosThetai);
  const auto iorCosThetai = ior * cosThetai;
  const auto iorCosThetat = ior * cosThetat;
  const auto rs = (iorCosThetai - cosThetat) / (iorCosThetai + cosThetat);
  const auto rp = (cosThetai - iorCosThetat) / (cosThetai + iorCosThetat);
  return #min(0.5 * (rs * rs + rp * rp), 1.0);
}

/// The exact unpolarized Fresnel reflectance of a conductor interface
/// with the given complex relative IOR.
@(pure)
export auto conductor_fresnel(const float cosThetai, const auto ior) {
  const auto cosThetat = #sqrt(1.0 - ior * ior * (1.0 - cosThetai * cosThetai)) * #sign(cosThetai);
  const auto iorCosThetai = ior * cosThetai;
  const auto iorCosThetat = ior * cosThetat;
  const auto rs = (iorCosThetai - cosThetat) / (iorCosThetai + cosThetat);
  const auto rp = (cosThetai - iorCosThetat) / (cosThetai + iorCosThetat);
  return #min(0.5 * (#norm(rs) + #norm(rp)), 1.0);
}

}
//--}

//--{ scattering infrastructure
/// Hash a direction pair into an `rng_t` stream selector. Symmetric under
/// swapping the two directions and invariant under jointly negating them,
/// so stochastic BSDF evaluations remain exactly reciprocal and agree
/// across radiance and importance transport, while distinct direction
/// pairs at the same shading point draw decorrelated streams.
@(pure)
int64_t directionPairHash(const float3 wa, const float3 wb) {
  const auto ws(#abs(wa + wb));
  return int64_t(ws.x * 2097152.0) ^ (int64_t(ws.y * 2097152.0) << 21) ^ (int64_t(ws.z * 2097152.0) << 42);
}

struct ScatterEvaluateParameters {
  /// Is transporting importance? i.e., tracing rays from lights to cameras?
  bool isImportance;

  /// The pseudo-random number generator for stochastically evaluated BSDF
  /// components, e.g., the diffuse micrograin term.
  rng_t rng = rng_t();

  /// The reference outgoing direction in the natural tangent space.
  float3 wo0;

  /// The reference incoming direction in the natural tangent space.
  float3 wi0;

  /// The reference mode.
  scatter_mode mode = (wo0.z < 0) == (wi0.z < 0) ? scatter_reflect : scatter_transmit;

  /// Hit backface?
  bool hitBackface = wo0.z < 0;

  /// Is thin walled?
  bool thin_walled = false;

  /// The relative upper-to-lower index of refraction.
  float ior = 1 / DEFAULT_IOR;

  /// The absolute index of refraction of the exterior medium, needed by
  /// modifier BSDFs to convert user-facing absolute IORs into relative
  /// ratios. See `relativeIOR()`.
  float exterior_ior = 1.0;

  /// The normal direction.
  float3 normal = float3(0, 0, 1);

  /// The tangent direction.
  float3 tangent_u = float3(1, 0, 0);

  /// The outgoing direction.
  float3 wo = wo0;

  /// The incoming direction.
  float3 wi = wi0;

  /// Which lobes to evaluate: a distribution contributes when its lobes
  /// share any bit with this. The default is everything.
  ///
  /// The mask selects lobes, not the branches within one: which of a
  /// `scatter_reflect_transmit` lobe's two branches is evaluated is
  /// decided by `wo` and `wi`, as it always was.
  ///
  /// The value is the masked part of the whole distribution, weighted as
  /// it is weighted inside it, so disjoint masks add. The densities are
  /// not that: they are the densities of the sampler restricted to the
  /// same mask, since the combinators renormalize their selection over
  /// whichever side the mask keeps. That is what makes a masked value and
  /// a masked density an estimator of the masked part.
  int lobeMask = DF_ALL;

  float shadingNormalCorrection = 1;

  finalize {
    // If we hit the backface, flip everything so that `wo`
    // is always in the upper hemisphere.
    if (hitBackface) {
      wo0 = -wo0;
      wi0 = -wi0;
      wo = -wo;
      wi = -wi;
      // Solid materials swap media across the interface. Thin-walled
      // materials face the exterior on both sides, so the relative
      // ratio is orientation-independent.
      ior = 1.0 / ior if (!thin_walled);
    }
  }
};

struct ScatterEvaluateResult {
  /// The Bidirectional Scattering Distribution Function (BSDF) evaluation.
  $(color | float) f = 0.0;

  /// The Probability Density Function (PDF) evaluations.
  /// - `pdf[0]` is the forward density of sampling `wi` given `wo`.
  /// - `pdf[1]` is the reverse density of sampling `wo` given `wi`.
  float2 pdf = float2(0.0);

  /// Is known to be black by construction? Faster than checking every
  /// element of `f`!
  bool isBlack = false;
};

/// Recalculate the effective tangent space. Returns `true` if the
/// directions are still consistent with the scatter mode after applying
/// the effective tangent space.
@(pure noinline)
bool recalculateTangentSpace(inline const &ScatterEvaluateParameters params) {
  auto tbn(calculateTangentSpace(bendShadingNormal(normal, wo0, wi0), tangent_u));
  wo = normalize(wo0 * tbn);
  wi = normalize(wi0 * tbn);
  if (isImportance) {
    const auto numer = wo.z * wi0.z;
    const auto denom = wi.z * wo0.z;
    shadingNormalCorrection = (denom == 0 ? 1 : #abs(numer / denom));
  } else {
    shadingNormalCorrection = 1;
  }
  return ((wo.z < 0) == (wo0.z < 0)) & ((wi.z < 0) == (wi0.z < 0));
}

@(pure)
float3 halfDirection(inline const &ScatterEvaluateParameters params) {
  return normalize(mode == scatter_reflect                    //
                   ? specular::reflection_half_vector(wo, wi) //
                   : specular::refraction_half_vector(wo, wi, ior));
}

struct ScatterSampleParameters {
  bool isImportance;

  /// The primary outgoing direction in the natural geometric tangent space.
  float3 wo0;

  /// Hit backface?
  bool hitBackface = wo0.z < 0;

  /// Is thin walled?
  bool thin_walled = false;

  /// The active index of refraction.
  float ior = 1 / DEFAULT_IOR;

  /// The absolute index of refraction of the exterior medium, needed by
  /// modifier BSDFs to convert user-facing absolute IORs into relative
  /// ratios. See `relativeIOR()`.
  float exterior_ior = 1.0;

  /// The active normal direction.
  float3 normal = float3(0, 0, 1);

  /// The active tangent direction.
  float3 tangent_u = float3(1, 0, 0);

  /// The active outgoing direction (expanded in the active tangent space).
  float3 wo = wo0;

  /// The canonical random sample in `[0,1]^4`.
  float4 xi;

  /// The discrete probability that an UNMASKED sample would have made
  /// the same selections this call did, accumulated as it descends.
  ///
  /// A masked call renormalizes its own chances over the live lobes, so
  /// this is the only way back to what the full distribution would have
  /// done, and a caller weighing its result against a strategy that
  /// samples the whole BSDF needs it. Exactly 1 when nothing chose.
  float lobeChance = 1.0;

  /// Which lobes to sample among: a distribution is a candidate when its
  /// lobes share any bit with this. The default is everything.
  ///
  /// Selection chances are renormalized over the lobes the mask keeps, so
  /// what comes back is a proper sample of the masked part of the
  /// distribution rather than a sample of the whole that sometimes lands
  /// outside the mask.
  int lobeMask = DF_ALL;

  /// The lobe the descent has narrowed to, intersected as it goes.
  ///
  /// It starts as everything and `scatterSampleMasked` cuts it down by each
  /// subtree the selection enters, so at a leaf it is what that leaf can
  /// produce. The entry point cuts it once more by the domain the sampled
  /// mode names, which leaves exactly one bit, since a lobe is one domain
  /// paired with one kind. A leaf offering two kinds on one domain has to
  /// narrow it by hand; there is one, the multiscatter compensation.
  int sampledLobe = DF_ALL;

  finalize {
    // If we hit the backface, flip everything so that `wo`
    // is always in the upper hemisphere.
    if (hitBackface) {
      wo0 = -wo0;
      wo = -wo;
      // Solid materials swap media across the interface. Thin-walled
      // materials face the exterior on both sides, so the relative
      // ratio is orientation-independent.
      ior = 1 / ior if (!thin_walled);
    }
  }
};

struct ScatterSampleResult {
  /// The sampled incoming direction.
  float3 wi = float3(0.0);

  /// The sampled scatter mode.
  scatter_mode mode = scatter_none;

  /// If sampled from a directional Dirac distribution, the BSDF evaluation (which is otherwise unevaluable).
  ?color fDirac = none;
};

@(pure noinline)
?float3x3 recalculateTangentSpace(inline const &ScatterSampleParameters params) {
  // Only `wo` is known here, so it is the only direction the bend can
  // constrain. The sampled direction is caught on the evaluate path, which
  // `_scatterSample` always runs to obtain the densities anyway.
  auto tbn(calculateTangentSpace(bendShadingNormal(normal, wo0, wo0), tangent_u));
  wo = wo0 * tbn;
  return tbn if ((wo.z < 0) == (wo0.z < 0));
}

// The normal distribution behind a GLOSSY lobe, which `DF_GLOSSY_BRDF`
// promises exists and these two queries are how a caller reaches. They are a
// proposal device: a host solving a manifold constraint needs a half vector it
// can draw and weigh, and needs nothing else of them. What such an estimator
// is worth is `scatterEvaluate` at the directions the constraint resolves to.
//
// So the one property that has to hold exactly is that `normalEvaluate`
// reports the density `normalSample` draws with. It need NOT be the density
// `scatterEvaluate` divides out, though matching it is what makes the proposal
// a good one, and the microfacet leaf matches it by construction.
struct ScatterNormalParameters {
  /// Is the query for the backface side of the interface? A normal query
  /// carries no outgoing direction, so the side is an input rather than
  /// something to derive: the caller asks about one side of one crossing
  /// and already knows which.
  bool hitBackface = false;

  /// Is thin walled?
  bool thin_walled = false;

  /// The active index of refraction.
  float ior = 1 / DEFAULT_IOR;

  /// The absolute index of refraction of the exterior medium.
  float exterior_ior = 1.0;

  /// The active normal direction.
  float3 normal = float3(0, 0, 1);

  /// The active tangent direction.
  float3 tangent_u = float3(1, 0, 0);

  /// The microfacet normal in the natural tangent space, which the evaluate
  /// path asks about and the sampling path leaves alone.
  float3 wm0 = float3(0, 0, 1);

  /// The microfacet normal (expanded in the active tangent space).
  float3 wm = wm0;

  /// The canonical random sample in `[0,1]^4`, unread on the evaluate path,
  /// which is why it has a default the sampling path always overrides.
  float4 xi = float4(0.0);

  /// Which lobes to consider. Intersected with `DF_GLOSSY` throughout, since
  /// nothing else has a normal distribution to report.
  int lobeMask = DF_ALL;

  finalize {
    // As on the scattering paths, everything is expressed with the query
    // side up in the natural frame: `wm` is a direction in that frame,
    // so it flips with the side, and so does the sense of the relative
    // index of refraction.
    if (hitBackface) {
      wm0 = -wm0;
      wm = -wm;
      ior = 1 / ior if (!thin_walled);
    }
  }
};

struct ScatterNormalSampleResult {
  /// The sampled microfacet normal in the natural tangent space.
  float3 wm = float3(0, 0, 1);

  /// The squared roughness of the lobe that drew it, so a caller can decide
  /// whether the lobe is smooth enough to be worth constraining.
  float2 alpha = float2(0.0);

  /// Is valid? False when nothing the mask kept had a normal distribution.
  bool isValid = false;
};

@(pure noinline)
?float3x3 recalculateTangentSpace(inline const &ScatterNormalParameters params) {
  // A microfacet normal is not a scattered direction, so there is no
  // direction pair for a bend to constrain: the distribution lives in
  // the unbent shading frame, which is what keeps the reported density
  // independent of anything a constraint solve later changes.
  auto tbn(calculateTangentSpace(orientShadingNormal(normal), tangent_u));
  wm = wm0 * tbn;
  return tbn;
}

@(pure)
float3 halfDirection(inline const &ScatterSampleParameters this, inline const &ScatterSampleResult result) {
  return normalize(mode == scatter_reflect ? specular::reflection_half_vector(wo, wi) : specular::refraction_half_vector(wo, wi, ior));
}

/// Calculate the shading-normal correction factor for a sampled Dirac direction under
/// importance transport, consistent with the convention `recalculateTangentSpace`
/// applies on the evaluate path. Expects the sampled incoming direction both in the
/// shading tangent space `wiShading` and in the natural tangent space `wiNatural`.
@(pure macro)
float sampleShadingNormalCorrection(inline const &ScatterSampleParameters params, const float3 wiShading, const float3 wiNatural) {
  const auto numer(wo.z * wiNatural.z);
  const auto denom(wiShading.z * wo0.z);
  return denom == 0 ? 1.0 : #abs(numer / denom);
}

// Bilinear fetch of the directional albedo from a `#albedoLUT` table at
// the roughness column interpolation fixed by `(j, t)`.
@(pure macro)
float fetchDirectionalAlbedo(const auto lut, const float cosTheta, const int j, const float t) {
  float s((lut.num_cos_theta - 1) * #min(cosTheta, 1));
  const int i(#min(int(#floor(s)), lut.num_cos_theta - 2));
  const &float ptr0(&lut.directional_albedo[lut.num_roughness * (i + 0) + j]);
  const &float ptr1(&lut.directional_albedo[lut.num_roughness * (i + 1) + j]);
  s = s - i;
  return #min(1.0, lerp(lerp(ptr0[0], ptr0[1], t), lerp(ptr1[0], ptr1[1], t), s));
}

// The single scattering value and densities of a lobe, plus the Kulla-Conty
// compensation lobe that makes up its energy deficit, resolved against the
// caller's mask.
//
// `ssLobes` is the lobe of the single scattering the caller just
// evaluated and `msLobes` the lobe of the compensation, which is
// `DF_SMOOTH_BRDF` wherever the two can be told apart. They are equal on the
// paths where they cannot: a thin-walled transmission delivers both through
// the reflect branch with the incoming direction flipped, and a lobe that is
// itself SMOOTH has nothing to distinguish. `maskedChance` then returns the
// unmasked chance and the two parts live or die together, as they did before
// the compensation had a lobe of its own.
@(pure macro)
auto ScatterEvaluateResultWithMultiscatter(
  const auto this,
  const auto f,
  const float2 pdf,
  float cosThetao [[anno::unused()]],
  float cosThetai [[anno::unused()]],
  const float roughness [[anno::unused()]],
  const string lutName [[anno::unused()]],
  const int ssLobes [[anno::unused()]],
  const int msLobes [[anno::unused()]],
  const int lobeMask [[anno::unused()]],
) {
  if (!hasMultiscatter(this.multiscatter_tint)) {
    return ScatterEvaluateResult(f: this.tint * f, pdf: pdf);
  } else {
    cosThetao = #abs(cosThetao);
    cosThetai = #abs(cosThetai);
    const auto lut(#albedoLUT(lutName));
    float t((lut.num_roughness - 1) * saturate(roughness));
    const int j(#min(int(#floor(t)), lut.num_roughness - 2));
    t = t - j;
    const float Ewo(fetchDirectionalAlbedo(lut, cosThetao, j, t));
    const float Ewi(fetchDirectionalAlbedo(lut, cosThetai, j, t));
    const float Eav = #min(1.0, lerp(lut.average_albedo[j], lut.average_albedo[j + 1], t));
    const auto msDeficit = 1 - Eav;
    const auto ms_f = msDeficit > MULTISCATTER_MIN_DEFICIT ? cosThetai / $PI * (1 - Ewo) * (1 - Ewi) / msDeficit : 0.0;
    const auto ms_pdf = auto(cosThetai, cosThetao) / $PI;
    // The value keeps only the parts the mask names, so disjoint masks add.
    // The density is the restricted sampler's, which takes whichever part is
    // left with certainty once the mask has removed the other.
    const float ssWeight(isLobeLive(ssLobes, lobeMask) ? 1.0 : 0.0);
    const float msWeight(isLobeLive(msLobes, lobeMask) ? 1.0 : 0.0);
    const float chance(maskedChance(MULTISCATTER_DIFFUSE_CHANCE, msLobes, ssLobes, lobeMask));
    return ScatterEvaluateResult(f: this.tint * (ssWeight * f + msWeight * (this.multiscatter_tint * ms_f)), pdf: lerp(pdf, ms_pdf, chance));
  }
}

/// The sampling twin, drawing the compensation lobe with the chance
/// `ScatterEvaluateResultWithMultiscatter` mixes its density by. Returns
/// `none` to mean the caller should sample its own single scattering.
@(pure macro)
?ScatterSampleResult ScatterSampleResultWithMultiscatter(
  const auto this,
  inline const &ScatterSampleParameters params,
  const int ssLobes [[anno::unused()]],
  const int msLobes [[anno::unused()]],
  const float3x3 tbn [[anno::unused()]],
) {
  if (!hasMultiscatter(this.multiscatter_tint)) {
    // Do nothing
  } else {
    // The selection is renormalized over whichever part the mask keeps, and
    // recorded at its unmasked chance, which is what `lobeChance` reports.
    if (sampling::bool_sample(&xi.w, maskedChance(MULTISCATTER_DIFFUSE_CHANCE, msLobes, ssLobes, lobeMask))) {
      lobeChance *= MULTISCATTER_DIFFUSE_CHANCE;
      sampledLobe &= msLobes;
      return ScatterSampleResult(wi: tbn * sampling::cosine_hemisphere_sample(xi.xy), mode: scatter_reflect);
    }
    lobeChance *= 1 - MULTISCATTER_DIFFUSE_CHANCE;
    sampledLobe &= ssLobes;
  }
}
//--}

//--{ emission infrastructure
// The Emission Distribution Function (EDF) at a shading point describes
// emitted radiance over the outgoing direction `wi`, pointing away from the
// surface. There is no reverse PDF and there are no Dirac delta EDFs, so the
// result structs are simpler than their scattering counterparts.
//
// The EDF value `f` is normalized such that the cosine-weighted integral over
// the upper hemisphere is 1, so that `intensity * f` is the emitted radiance
// when `material_emission.mode` is `intensity_radiant_exitance`. The entry
// points apply the intensity; under `intensity_power` the host must divide by
// the total emitting surface area, which is unknowable here.
struct EmissionEvaluateParameters {
  /// The emission direction in the natural tangent space, pointing away
  /// from the surface.
  float3 wi0;

  /// Hit backface?
  bool hitBackface = wi0.z < 0;

  /// The normal direction.
  float3 normal = float3(0, 0, 1);

  /// The tangent direction.
  float3 tangent_u = float3(1, 0, 0);

  /// The emission direction (expanded in the active tangent space).
  float3 wi = wi0;

  finalize {
    // If evaluating the backface, flip everything so that `wi`
    // is always in the upper hemisphere.
    if (hitBackface) {
      wi0 = -wi0;
      wi = -wi;
    }
  }
};

struct EmissionEvaluateResult {
  /// The Emission Distribution Function (EDF) evaluation, normalized such
  /// that the cosine-weighted integral over the upper hemisphere is 1.
  $(color | float) f = 0.0;

  /// The Probability Density Function (PDF) with respect to solid angle
  /// of sampling `wi`.
  float pdf = 0.0;

  /// Is known to be black by construction? Faster than checking every
  /// element of `f`!
  bool isBlack = false;
};

struct EmissionSampleParameters {
  /// The canonical random sample in `[0,1]^4`.
  float4 xi;

  /// The normal direction.
  float3 normal = float3(0, 0, 1);

  /// The tangent direction.
  float3 tangent_u = float3(1, 0, 0);
};

struct EmissionSampleResult {
  /// The sampled emission direction in the natural tangent space.
  float3 wi = float3(0.0);

  /// Is valid?
  bool isValid = false;
};

/// Recalculate the effective tangent space for emission evaluation.
/// Returns `true` if `wi` remains in the upper hemisphere after applying
/// the effective tangent space.
@(pure noinline)
bool recalculateTangentSpace(inline const &EmissionEvaluateParameters params) {
  auto tbn(calculateTangentSpace(bendShadingNormal(normal, wi0, wi0), tangent_u));
  wi = normalize(wi0 * tbn);
  return wi.z > 0;
}
//--}

//--{ _default_bsdf
@(pure macro)
auto scatterEvaluate(const &_default_bsdf this [[anno::unused()]], const &ScatterEvaluateParameters params [[anno::unused()]]) {
  return ScatterEvaluateResult(isBlack: true);
}

@(pure macro)
auto scatterSample(const &_default_bsdf this [[anno::unused()]], const &ScatterSampleParameters params [[anno::unused()]]) {
  return ScatterSampleResult();
}
//--}

//--{ _default_vdf
@(macro)
auto scatterEvaluate(const &_default_vdf this [[anno::unused()]], const &ScatterEvaluateParameters params [[anno::unused()]]) {
  return ScatterEvaluateResult(isBlack: true);
}

@(macro)
auto scatterSample(const &_default_vdf this [[anno::unused()]], const &ScatterSampleParameters params [[anno::unused()]]) {
  return ScatterSampleResult();
}
//--}

//--{ _default_edf
// The default `edf()` means no emission, consistent with `bsdf()` meaning
// black. Emission is enabled by constructing a distribution node, e.g.,
// `material_emission(emission: diffuse_edf(), intensity: ...)`.
@(pure macro)
auto emissionEvaluate(const &_default_edf this [[anno::unused()]], const &EmissionEvaluateParameters params [[anno::unused()]]) {
  return EmissionEvaluateResult(isBlack: true);
}

@(pure macro)
auto emissionSample(const &_default_edf this [[anno::unused()]], const &EmissionSampleParameters params [[anno::unused()]]) {
  return EmissionSampleResult();
}
//--}

//--{ _default_hair_bsdf
// The default `hair_bsdf()` is the black hair BSDF, consistent with
// `bsdf()` meaning black.
@(pure macro)
auto scatterEvaluate(const &_default_hair_bsdf this [[anno::unused()]], const &ScatterEvaluateParameters params [[anno::unused()]]) {
  return ScatterEvaluateResult(isBlack: true);
}

@(pure macro)
auto scatterSample(const &_default_hair_bsdf this [[anno::unused()]], const &ScatterSampleParameters params [[anno::unused()]]) {
  return ScatterSampleResult();
}
//--}

// Dispatch to a distribution's evaluation unless the caller's lobe mask
// excludes it, which also prunes a whole subtree whose union shares no
// bit with the mask.
@(macro)
auto scatterEvaluateMasked(const auto this, inline const &ScatterEvaluateParameters params) {
  return ScatterEvaluateResult(isBlack: true) if (!isLobeLive(this.df_lobes, lobeMask));
  return scatterEvaluate(this, params);
}

// The sampling twin. Where the combinators choose between subtrees, the
// chance of the choice is renormalized over whichever the mask keeps, so
// the result is a sample of the masked part and not a sample of the whole
// that lands outside the mask some of the time.
@(macro)
auto scatterSampleMasked(const auto this, inline const &ScatterSampleParameters params) {
  return ScatterSampleResult() if (!isLobeLive(this.df_lobes, lobeMask));
  // Only the subtree the selection actually enters reaches here, so
  // intersecting narrows along the taken path and nowhere else. A
  // distribution declaring nothing (every volume one) narrows nothing.
  sampledLobe &= this.df_lobes if (this.df_lobes != 0);
  return scatterSample(this, params);
}

// Everything with no normal distribution behind it: every SMOOTH and DIRAC
// leaf, every emission and volume node, and every empty default. The
// dispatchers below prune these by `df_lobes` before they are reached, so
// this is what makes the overload set total rather than what does the work.
@(pure macro)
auto normalSample(const auto this [[anno::unused()]], const &ScatterNormalParameters params [[anno::unused()]]) {
  return ScatterNormalSampleResult();
}

@(pure macro)
float normalEvaluate(const auto this [[anno::unused()]], const &ScatterNormalParameters params [[anno::unused()]]) {
  return 0.0;
}

// The normal-query dispatchers. They prune on a stricter rule than their
// scattering twins: a subtree with no GLOSSY lobe has no normal distribution
// anywhere in it, so it is pruned rather than descended into.
@(macro)
auto normalSampleMasked(const auto this, inline const &ScatterNormalParameters params) {
  return ScatterNormalSampleResult() if (!hasNormalDistribution(this.df_lobes, lobeMask));
  return normalSample(this, params);
}

@(macro)
float normalEvaluateMasked(const auto this, inline const &ScatterNormalParameters params) {
  return 0.0 if (!hasNormalDistribution(this.df_lobes, lobeMask));
  return normalEvaluate(this, params);
}

//--{ diffuse_reflection_bsdf
// The rough-diffuse model implemented here is the energy-preserving
// Oren-Nayar (EON) model of Portsmouth, Kutz, and Hill, "EON: A practical
// energy-preserving rough diffuse BRDF", Journal of Computer Graphics
// Techniques 14(1), 116-138, 2025. The single-scattering lobe is the
// qualitative Oren-Nayar variant of Fujii (FON), augmented with an
// analytical Kulla-Conty-style multiple-scattering lobe so the model
// preserves energy at all roughness values. Importance sampling uses the
// paper's Clipped Linearly Transformed Cosine (CLTC) technique, mixed with
// a uniform hemisphere lobe by one-sample MIS.
const float EON_CONSTANT1 = 0.5 - 2.0 / (3.0 * $PI);
const float EON_CONSTANT2 = 2.0 / 3.0 - 28.0 / (15.0 * $PI);

/// The directional albedo of the FON single-scattering lobe at unit
/// single-scattering albedo, using the rational fit from the EON paper
/// (error below 0.1% over the whole angular range).
@(pure)
float eonDirectionalAlbedo(const float mu, const float r) {
  const float mucomp(1 - saturate(mu));
  const float GoverPi(mucomp * (0.0571085289 + mucomp * (0.491881867 + mucomp * (-0.332181442 + mucomp * 0.0714429953))));
  return (1 + r * GoverPi) / (1 + EON_CONSTANT1 * r);
}

/// The LTC matrix coefficients `(a, b, c, d)` for CLTC sampling of the
/// EON model, fit as functions of the view cosine and roughness.
@(pure)
float4 eonLTCCoeffs(const float mu, const float r) {
  return float4(
           r * (-0.303392 + (-0.518982 + 0.111709 * mu) * mu + (-0.276266 + 0.335918 * mu) * r) + 1,
           r * (-1.16407 + 1.15859 * mu + (0.150815 - 0.150105 * mu) * r) / (mu * mu * mu - 1.43545),
           r * (0.20013 + (-0.506373 + 0.261777 * mu) * mu) + 1,
           r * (0.540852 + (-1.01625 + 0.475392 * mu) * mu) / (-1.0743 + (0.0725628 + mu) * mu),
         );
}

/// The azimuthal frame `(cos(phi), sin(phi))` of the given direction, or
/// `(1, 0)` at the pole.
@(pure macro)
float2 azimuthFrame(const float3 w) {
  const float len(length(w.xy));
  return len > 0.0 ? w.xy / len : float2(1, 0);
}

/// The density over `wi` of CLTC sampling for the EON model. Both
/// directions are in the local shading frame with `wo.z > 0`.
@(pure)
float eonCLTCPdf(const float3 wo, const float3 wi, const float r) {
  const float4 co(eonLTCCoeffs(wo.z, r));
  const float2 e(azimuthFrame(wo));
  const float3 wiStd(e.x * wi.x + e.y * wi.y, -e.y * wi.x + e.x * wi.y, wi.z);
  const float3 wh(co.z * (wiStd.x - co.y * wiStd.z), (co.x - co.y * co.w) * wiStd.y, -co.z * (co.w * wiStd.x - co.x * wiStd.z));
  const float detM(co.z * (co.x - co.y * co.w));
  const float len4((len2 := #sum(wh * wh)) * len2);
  return len4 > 0.0 ? detM * detM / len4 * #max(wh.z, 0.0) / ($PI * 0.5 * (1 + 1 / #sqrt(1 + co.w * co.w))) : 0.0;
}

/// Sample the CLTC lobe for the EON model. Returns the sampled incoming
/// direction in the local shading frame, guaranteed to be in the upper
/// hemisphere by the clipped construction.
@(pure)
float3 eonCLTCSample(const float3 wo, const float r, const float xi0, const float xi1) {
  const float4 co(eonLTCCoeffs(wo.z, r));
  const float rad(#sqrt(xi0));
  const float phi($TWO_PI * xi1);
  const float y(rad * #sin(phi));
  const float x(-lerp(#sqrt(#max(1 - y * y, 0.0)), rad * #cos(phi), 0.5 * (1 + 1 / #sqrt(1 + co.w * co.w))));
  const float3 wh(x, y, #sqrt(#max(1 - x * x - y * y, 0.0)));
  const float3 wiLTC(normalize(float3(co.x * wh.x + co.y * wh.z, co.z * wh.y, co.w * wh.x + wh.z)));
  const float2 e(azimuthFrame(wo));
  return float3(e.x * wiLTC.x - e.y * wiLTC.y, e.y * wiLTC.x + e.x * wiLTC.y, wiLTC.z);
}

/// The probability of choosing the uniform hemisphere lobe over the CLTC
/// lobe when sampling the EON model, by one-sample MIS.
@(pure macro)
float eonUniformLobeChance(const float mu, const float r) {
  return #pow(#max(r, 0.0), 0.1) * (0.162925 + mu * (-0.372058 + (0.538233 - 0.290822 * mu) * mu));
}

/// The diffuse reflection BSDF, being Lambertian reflection with optional
/// roughness, in which case it is the energy-preserving Oren-Nayar (EON)
/// model of Portsmouth, Kutz, and Hill.
export struct diffuse_reflection_bsdf: bsdf {
  /// The tint.
  ///
  /// > Scaling factor, defined as a color, multiplied by the
  /// > result of the distribution function.
  ///
  const $(color | float) tint = 1.0;

  /// The roughness.
  ///
  /// > Oren-Nayar roughness coefficient, simulating view-dependent diffuse
  /// > reflection. Range: `[0,1]`, with `0` specifying complete view
  /// > independence.
  ///
  const float roughness = 0.0;

  /// The handle.
  void handle = "";

  /// The multiscatter tint.
  ///
  /// NOTE: The EON multiple-scattering lobe is part of the model and is
  /// applied at full strength by default (`none`), which is what makes the
  /// model energy preserving. Setting an explicit value scales the
  /// multiple-scattering lobe for artistic control; `0.0` disables it,
  /// leaving the energy-losing single-scattering FON lobe.
  const $(?(color | float)) multiscatter_tint = none;

  /// The flags.
  static const int df_lobes = DF_SMOOTH_BRDF;
};

@(pure)
auto scatterEvaluate(const &diffuse_reflection_bsdf this, inline const &ScatterEvaluateParameters params) {
  if (mode == scatter_reflect && recalculateTangentSpace(params)) {
    const auto cosTheta(#abs(auto(wi.z, wo.z)));
    // Horizon cull: zero the value and the densities together.
    return ScatterEvaluateResult(isBlack: true) if (!(#minValue(cosTheta) > MIN_COS_THETA));
    if (this.roughness == 0) {
      const auto pdf(cosTheta / $PI);
      auto result(ScatterEvaluateResult(f: this.tint * pdf[0], pdf: pdf));
      result.f *= shadingNormalCorrection if (isImportance);
      return result;
    } else {
      // The EON single-scattering lobe, i.e., the FON model of Fujii.
      const float r(this.roughness);
      const float AF(1 / (1 + EON_CONSTANT1 * r));
      const float s(#sum(wo.xy * wi.xy));
      const float sOverT(s > 0 ? s / #maxValue(cosTheta) : s);
      const float fSS(cosTheta[0] / $PI * AF * (1 + r * sOverT));
      // The EON analytical multiple-scattering compensation lobe. The
      // geometric series for the multiple-scattering albedo is only meaningful
      // for single-scattering albedo at most 1, so the tint is saturated
      // entering it, which bounds the series denominator below by `avgEF` with
      // no epsilon. Below `MULTISCATTER_MIN_DEFICIT` the lobe carries less
      // than that fraction of the energy and is dropped outright.
      const float EFo(eonDirectionalAlbedo(cosTheta[1], r));
      const float EFi(eonDirectionalAlbedo(cosTheta[0], r));
      const float avgEF(AF * (1 + EON_CONSTANT2 * r));
      const float msDeficit(1 - avgEF);
      const auto rho(this.tint);
      const auto rhoS(#min(rho, 1.0));
      const auto rhoMS(rhoS * rhoS * avgEF / (1 - rhoS * msDeficit));
      const float msShape(msDeficit > MULTISCATTER_MIN_DEFICIT ? cosTheta[0] / $PI * #max(1 - EFo, 0.0) * #max(1 - EFi, 0.0) / msDeficit : 0.0);
      // The CLTC + uniform mixture densities, forward and reverse.
      const float2 chanceU(float2(eonUniformLobeChance(cosTheta[1], r), eonUniformLobeChance(cosTheta[0], r)));
      const float2 pdf(chanceU / $TWO_PI + (1 - chanceU) * float2(eonCLTCPdf(wo, wi, r), eonCLTCPdf(wi, wo, r)));
      if (!#hasField(this, "multiscatter_tint")) {
        auto result(ScatterEvaluateResult(f: rho * fSS + rhoMS * msShape, pdf: pdf));
        result.f *= shadingNormalCorrection if (isImportance);
        return result;
      } else {
        auto result(ScatterEvaluateResult(f: rho * fSS + this.multiscatter_tint * (rhoMS * msShape), pdf: pdf));
        result.f *= shadingNormalCorrection if (isImportance);
        return result;
      }
    }
  } else {
    return ScatterEvaluateResult(isBlack: true);
  }
}

@(pure)
auto scatterSample(const &diffuse_reflection_bsdf this, inline const &ScatterSampleParameters params) {
  if ((tbn := recalculateTangentSpace(params))) {
    if (this.roughness > 0) {
      // CLTC sampling of the EON model with one-sample MIS against a
      // uniform hemisphere lobe, matching the mixture densities reported
      // by `scatterEvaluate`.
      if (sampling::bool_sample(&xi.z, eonUniformLobeChance(wo.z, this.roughness))) {
        return ScatterSampleResult(wi: (*tbn) * sampling::uniform_hemisphere_sample(xi.xy), mode: scatter_reflect);
      } else {
        return ScatterSampleResult(wi: (*tbn) * eonCLTCSample(wo, this.roughness, xi.x, xi.y), mode: scatter_reflect);
      }
    }
    return ScatterSampleResult(wi: (*tbn) * sampling::cosine_hemisphere_sample(xi.xy), mode: scatter_reflect);
  } else {
    return ScatterSampleResult(); // Reject
  }
}
//--}

//--{ diffuse_transmission_bsdf
/// The diffuse transmission BSDF, being Lambertian transmission through
/// the surface.
export struct diffuse_transmission_bsdf: bsdf {
  /// The tint.
  ///
  /// > Scaling factor, defined as a color, multiplied by the
  /// > result of the distribution function.
  ///
  const $(color | float) tint = 1.0;

  /// The handle.
  void handle = "";

  /// The flags.
  static const int df_lobes = DF_SMOOTH_BTDF;
};

@(pure)
auto scatterEvaluate(inline const &diffuse_transmission_bsdf this, inline const &ScatterEvaluateParameters params) {
  if (mode == scatter_transmit && recalculateTangentSpace(params)) {
    const auto cosTheta(#abs(auto(wi.z, wo.z)));
    const auto pdf(cosTheta / $PI);
    auto result(ScatterEvaluateResult(f: tint * pdf[0], pdf: pdf));
    result.f *= shadingNormalCorrection if (isImportance);
    return result;
  } else {
    return ScatterEvaluateResult(isBlack: true);
  }
}

@(pure)
auto scatterSample(inline const &diffuse_transmission_bsdf this, inline const &ScatterSampleParameters params) {
  if ((tbn := recalculateTangentSpace(params))) {
    return ScatterSampleResult(wi: (*tbn) * -sampling::cosine_hemisphere_sample(xi.xy), mode: scatter_transmit);
  } else {
    return ScatterSampleResult(); // Reject
  }
}
//--}

//--{ specular_bsdf
/// The specular BSDF, being perfect mirror reflection and/or refractive
/// transmission as a directional Dirac distribution.
export struct specular_bsdf: bsdf {
  /// The tint.
  ///
  /// > Scaling factor, defined as a color, multiplied by the
  /// > result of the distribution function.
  ///
  const $(color | float) tint = 1.0;

  /// The scatter mode.
  ///
  /// > One of three values: `scatter_reflect`, `scatter_transmit`,
  /// > or (for both) `scatter_reflect_transmit`.
  ///
  /// NOTE: With `scatter_reflect_transmit`, the reflect/transmit split is
  /// weighted by the dielectric Fresnel term for the active IOR, matching
  /// the reference MDL semantics. Total internal reflection folds entirely
  /// into reflection.
  ///
  const scatter_mode mode = scatter_reflect;

  /// The handle.
  void handle = "";

  /// The flags.
  const int df_lobes = modeLobes(int(mode), DF_DIRAC);
};

@(pure macro)
auto scatterEvaluate(const &specular_bsdf this [[anno::unused()]], const &ScatterEvaluateParameters params [[anno::unused()]]) {
  return ScatterEvaluateResult(isBlack: true); // Dirac delta!
}

@(pure macro)
auto scatterSample(const &specular_bsdf this, inline const &ScatterSampleParameters params) {
  return ScatterSampleResult() if (this.mode == scatter_none);
  if ((tbn := recalculateTangentSpace(params))) {
    // For `scatter_reflect_transmit`, choose reflect or transmit with the
    // dielectric Fresnel weight clamped into the `MIN_CHANCE` bounds as
    // the selection chance. Exact Fresnel selection gives every branch
    // unit throughput however rarely it is drawn, so a few-percent
    // reflection of a bright source arrives as rare full-radiance
    // fireflies; the clamp bounds the rarity, and the weight-over-chance
    // ratio on the Dirac weights below dims each draw to match. Total
    // internal reflection folds the weight to exactly 1, which
    // `clampChance` preserves, so no samples are wasted on impossible
    // refractions.
    const auto reflectWeight(this.mode == scatter_reflect_transmit     //
                             ? specular::dielectric_fresnel(wo.z, ior) //
                             : scatterReflectChance(this.mode));
    const auto rawReflectChance(clampChance(reflectWeight));
    // The mask may leave only one domain alive, in which case that branch
    // is taken with certainty and the ratio below reduces to the bare
    // Fresnel weight.
    const auto enabledMode(scatter_mode(int(this.mode) & maskedModeBits(lobeMask & this.df_lobes)));
    return ScatterSampleResult() if (enabledMode == scatter_none);
    const auto reflectChance(enabledMode == this.mode ? rawReflectChance
                                                      : scatterReflectChance(enabledMode));
    if (xi.x < reflectChance) {
      const auto wiLocal(specular::reflect(wo, float3(0, 0, 1)));
      auto result = ScatterSampleResult(wi: (*tbn) * wiLocal, mode: scatter_reflect, fDirac: color(this.tint));
      lobeChance *= rawReflectChance;
      *result.fDirac *= reflectWeight / reflectChance;
      *result.fDirac *= sampleShadingNormalCorrection(params, wiLocal, result.wi) if (isImportance);
      return result;
    } else {
      // Thin-walled surfaces enclose no volume, so specular transmission
      // passes straight through with no refraction.
      const auto wiLocal(thin_walled ? -wo : specular::refract(wo, float3(0, 0, 1), ior));
      auto result = ScatterSampleResult(wi: (*tbn) * wiLocal, mode: scatter_transmit, fDirac: color(this.tint));
      lobeChance *= 1 - rawReflectChance;
      *result.fDirac *= (1 - reflectWeight) / (1 - reflectChance);
      if (isImportance) {
        *result.fDirac *= sampleShadingNormalCorrection(params, wiLocal, result.wi);
      } else if (!thin_walled) {
        // The `ior * ior` accounts for the solid-angle compression of refracted
        // radiance, which does not apply to importance, and does not apply to
        // thin-walled transmission because there is no change of medium.
        *result.fDirac *= ior * ior;
      }
      return result;
    }
  } else {
    return ScatterSampleResult(); // Reject
  }
}
//--}

//--{ RGB upsampling
/// The sRGB primary spectra of the wavelengths a value is constructed at.
///
/// A distribution that produces RGB at evaluation time cannot upsample it
/// there: the conversion is colorimetric and wants the wavelengths in
/// `$state`, and the scattering and emission entry points are pure and
/// take no `State`. Capturing the primaries at construction, where
/// `$state` is live, moves the only state-dependent part of the
/// conversion to where the state exists. The upsampling is linear in RGB
/// and the primaries sum to one at every wavelength, so `upsample`
/// reproduces the `color(float3)` constructor exactly, greys included.
struct RGBPrimaries {
  color r = color(float3(1.0, 0.0, 0.0));
  color g = color(float3(0.0, 1.0, 0.0));
  color b = color(float3(0.0, 0.0, 1.0));
};

@(pure macro)
color upsample(const RGBPrimaries this, const float3 rgb) = rgb.x * this.r + rgb.y * this.g + rgb.z * this.b;
//--}

//--{ measured_bsdf
/// Is the BSDF measurement valid, i.e., backed by loaded measurement data?
export bool bsdf_measurement_isvalid(const bsdf_measurement measurement) = bool(measurement.buffer);

/// Declare `smdBSDFMeasurementInterpolate` in `lib/BSDFMeasurement.cc`
@(pure foreign)
void smdBSDFMeasurementInterpolate(&void measurement, &float3 wo, &float3 wi, &float3 result);

/// Declare `smdBSDFMeasurementDirectionPDF` in `lib/BSDFMeasurement.cc`
@(pure foreign)
float smdBSDFMeasurementDirectionPDF(&void measurement, &float3 wo, &float3 wi);

/// Declare `smdBSDFMeasurementDirectionSample` in `lib/BSDFMeasurement.cc`
@(pure foreign)
void smdBSDFMeasurementDirectionSample(&void measurement, &float2 xi, &float3 wo, &float3 wi, &float pdf);

/// The measured BSDF, evaluating and importance sampling a loaded
/// `bsdf_measurement`.
export struct measured_bsdf: bsdf {
  /// The measurement.
  bsdf_measurement measurement;

  /// The multiplier.
  float multiplier = 1.0;

  /// The scatter mode.
  scatter_mode mode = scatter_reflect;

  /// The handle.
  void handle = "";

  /// The flags. `DF_SMOOTH` rather than `DF_GLOSSY` because tabulated
  /// data has no normal distribution behind it to sample a half vector
  /// from, which is the distinction the flag draws.
  const int df_lobes = modeLobes(int(mode) & measurement.mode, DF_SMOOTH);

  /// The primaries the RGB the measurement yields is upsampled against.
  /// Captured rather than accepted, like `df_lobes`; see `RGBPrimaries`.
  const RGBPrimaries primaries = RGBPrimaries();
};

@(macro)
auto scatterEvaluate(const &measured_bsdf this, inline const &ScatterEvaluateParameters params) {
  const auto enabledMode(int(this.mode) & this.measurement.mode & maskedModeBits(lobeMask & this.df_lobes));
  return ScatterEvaluateResult(isBlack: true) if (!bool(this.measurement.ptr) || (int(mode) & enabledMode) == 0);
  return ScatterEvaluateResult(isBlack: true) if (!recalculateTangentSpace(params));
  // The measurement table is hemisphere-agnostic, so look up with the incoming
  // direction flipped into the upper hemisphere. This only matters for
  // transmission, where the incoming direction is below the horizon.
  auto wiUpper(float3(wi.x, wi.y, #abs(wi.z)));
  auto f3(float3(0.0));
  smdBSDFMeasurementInterpolate(this.measurement.ptr, &wo, &wiUpper, &f3);
  const auto f(upsample(this.primaries, f3));
  auto result(ScatterEvaluateResult(
                f: this.multiplier * #abs(wi.z) * f,
                pdf: float2(
                  smdBSDFMeasurementDirectionPDF(this.measurement.ptr, &wo, &wiUpper),
                  smdBSDFMeasurementDirectionPDF(this.measurement.ptr, &wiUpper, &wo),
                ),
              ));
  result.f *= shadingNormalCorrection if (isImportance);
  return result;
}

@(macro)
auto scatterSample(const &measured_bsdf this, inline const &ScatterSampleParameters params) {
  const auto enabledMode(int(this.mode) & this.measurement.mode & maskedModeBits(lobeMask & this.df_lobes));
  return ScatterSampleResult() if (!bool(this.measurement.ptr) || enabledMode == 0);
  if ((tbn := recalculateTangentSpace(params))) {
    auto xi2(xi.xy);
    auto wiLocal(float3(0.0));
    float pdf = 0.0;
    smdBSDFMeasurementDirectionSample(this.measurement.ptr, &xi2, &wo, &wiLocal, &pdf);
    return ScatterSampleResult() if (!(pdf > 0.0));
    // The sampled direction is always in the upper hemisphere, so flip it
    // below the horizon for transmission measurements.
    wiLocal.z = -wiLocal.z if (enabledMode == int(scatter_transmit));
    return ScatterSampleResult(
             wi: normalize((*tbn) * wiLocal),
             mode: enabledMode == int(scatter_transmit) ? scatter_transmit : scatter_reflect,
           );
  } else {
    return ScatterSampleResult(); // Reject
  }
}
//--}

//--{ sheen_bsdf
// The sheen model implemented here is the practical multiple-scattering
// sheen of Zeltner, Burley, and Chiang, "Practical Multiple-Scattering
// Sheen Using Linearly Transformed Cosines", SIGGRAPH 2022 Talks: a
// Linearly Transformed Cosine (LTC) fit of the aggregate reflection of a
// volumetric fiber-like layer, including its internal multiple scattering.
// The LTC form permits perfect importance sampling of the lobe. The raw
// LTC lobe is parameterized by the view direction and therefore not
// reciprocal, so the evaluation below symmetrizes it, which preserves the
// appearance while restoring the reciprocity that bidirectional transport
// requires.

