// NOTE: This module is non-standard!
/// Parallax occlusion mapping (POM) at material evaluation time, against
/// the non-standard `state::direction()` contract: the ray direction the
/// renderer populated is marched through a height field to find the UV
/// coordinate the viewer actually sees, buying relief detail that would
/// otherwise take heavy subdivision and displacement.
///
/// There are two marches. The march core `parallax_offset_with()` is a
/// macro over a height *lambda* `float2 -> float`, so procedural height
/// fields are first-class; it samples fixed depth layers and refines the
/// crossing, and it can step over features thinner than one layer.
/// `parallax_offset_max()` marches a height *texture* through its maximum
/// mip chain (a `texture_2d` constructed with `max_mipmap: true`): each
/// chain texel bounds the field over its footprint, so whole cells the ray
/// clears are skipped at once and the crossing is solved exactly against
/// the bilinear patch it lands on, with a data-dependent step count that
/// is logarithmic in practice. `parallax_uv()` picks the hierarchical
/// march whenever the texture carries a maximum chain and the layer march
/// otherwise. Heights follow the convention **1 = un-displaced surface,
/// 0 = deepest**, and are clamped to `[0, 1]` when sampled.
///
/// Everything reduces to the identity (no offset, the unperturbed shading
/// normal) whenever the ray direction is unavailable or unusable:
/// - `state::direction()` zero (the renderer does not populate it),
/// - importance transport (light tracing must not see camera-direction
///   detail; this is the reciprocity guard, folded into `view_vector()`),
/// - backface incidence (`view_vector().z <= 0`),
/// - non-positive `scale` (which is also how a faded-out effect reads).
///
/// Grazing incidence is deliberately not culled: the marches divide by
/// `#max(view.z, PARALLAX_MIN_VIEW_Z)`, so toward the horizon the offset
/// saturates at the `PARALLAX_MAX_SLOPE` cap instead of snapping back to
/// the identity along a visible band.
///
/// The intended use computes the offset UV once with `parallax_uv()` and
/// feeds every downstream lookup, with the matching bump normal from
/// `perturbed_normal()` and a level-of-detail fade from `::extras::lod`.
///
/// Those marches lay the height field flat in the tangent plane of the
/// hit. On a surface that curves away under the ray that is wrong where it
/// shows most: a grazing ray travels a finite chord through the relief and
/// can leave it again without meeting it. `parallax_trace()` marches that
/// ray. With the second fundamental form from `state::surface_curvature()`
/// the height of the ray above the relief floor is a parabola in the march
/// parameter rather than a line, `1 - t + c t^2` (see `viewRay()`), and a
/// ray that leaves the relief is reported as a miss, which
/// `silhouette_opacity()` turns into a cutout so that the relief shows in
/// the outline. The relief lies inside the base surface, so an outline
/// only ever shrinks. The model is second order: it holds where the relief
/// is shallow against the radius of curvature, and it errs toward no
/// rejection as the two approach. With no curvature it is the flat march.
/// What it returns also carries the curvature and how far the base normal
/// has turned where the ray landed, which `perturbed_normal()` and
/// `relief_visible()` take, so that the bump and the shadow stand on the
/// surface where the relief is rather than where the ray came in.
///
/// Self-shadowing runs inside the BSDF, where next-event estimation and
/// BSDF sampling see it consistently, since light directions are unknown
/// at material evaluation time. `relief_visible()` marches the light
/// direction through the same maximum chain from the surface point, and
/// `df::relief_shadow_factor` applies it per evaluated direction: exact
/// binary visibility against the relief. The older first-order term
/// remains: `horizon_slopes_with()` compresses the field's directional
/// occlusion into four slopes at the offset UV for
/// `df::horizon_shadow_factor`, for height lambdas without a chain.
///
/// Limitations, by construction: backfaces are not offset, and an outline
/// changes only where the renderer provides curvature. A crease has none of
/// its own, so the outline along one stays the base surface's.
///
/// References:
///   Tatarchuk (2006): Practical Parallax Occlusion Mapping
///   McGuire and McGuire (2005): Steep Parallax Mapping
///   Tevs, Ihrke, and Seidel (2008): Maximum Mipmaps for Fast, Accurate,
///                                   and Scalable Dynamic Height Field
///                                   Rendering
///   Drobot (2009): Quadtree Displacement Mapping with Height Blending
///   Oliveira and Policarpo (2005): An Efficient Representation for
///                                  Surface Details
///   Wang et al. (2003): View-Dependent Displacement Mapping
#smdl

import ::math::*;
import ::state::*;
import ::tex::*;

/// The floor on the tangent-frame view Z the march divides by. Grazing
/// views compute their slope as if `view.z` were at least this, so the
/// offset saturates continuously toward the horizon (the
/// `PARALLAX_MAX_SLOPE` cap binds first) rather than cutting out at a
/// threshold. Only `view.z <= 0` (the exact zero of an unpopulated
/// `state::direction()`, the transport guard, and backface hits) is
/// the identity. On a curved surface it is also the most grazing angle
/// the ray's curvature is computed at.
export const float PARALLAX_MIN_VIEW_Z = 0.05;

/// The cap on the parallax slope `|view.xy| / view.z`, bounding the total
/// UV offset by `PARALLAX_MAX_SLOPE * scale` no matter how oblique the view.
/// A ray that curves by more than its own slope is bounded by its chord
/// instead, and the cap rises with its curvature; see `viewRay()`.
export const float PARALLAX_MAX_SLOPE = 8.0;

/// The cap on the cell steps of `parallax_offset_max()`. The traversal
/// is data dependent; one that runs out of steps stops at its current
/// depth, which is above the surface, never below it. Smooth relief
/// takes a few dozen steps; white noise at a grazing view takes about
/// two per texel crossed.
export const int PARALLAX_MAX_CELL_STEPS = 128;

/// The nudge in texels applied along the ray before choosing the cell a
/// position falls in, so that a position sitting on a cell boundary
/// after an exit lands in the cell ahead rather than the one behind.
const float PARALLAX_CELL_NUDGE = 0.002;

/// The unit view vector (from the shading point toward the viewer) in
/// the shading tangent frame of texture space `space`, as consumed by the
/// march. Exactly zero for "off" when `state::direction()` is unpopulated
/// and under importance transport, so light paths never see camera-direction
/// detail.
@(macro)
export float3 view_vector(const int space = 0) {
  return float3(0.0) if ($state.transport != 0);
  return -$state.direction * state::tangent_space(space);
}

/// What a march that can miss returns; see `parallax_trace()`.
export struct parallax_result {
  /// The lookup coordinate where the view ray meets the relief, or, on a
  /// miss, the one over which it left.
  float2 coord;

  /// Did the ray leave the relief without meeting it? Only ever on a
  /// surface that curves away under the ray.
  bool is_miss = false;

  /// The slope of the base surface's normal at `coord` against the normal
  /// at the entry point, in the tangent frame the march ran in: the
  /// curvature times the offset. Zero on a flat surface. The relief at
  /// `coord` stands on that normal and not on the entry's, which
  /// `perturbed_normal()` and `relief_visible()` take it to say.
  float2 tilt = float2(0.0);

  /// The curvature the march ran under, for the same two.
  float3 curvature = float3(0.0);
};

/// The view ray of a march. Its lookup coordinate is `coord - slope * t`
/// and its height above the relief floor is `1 - t + curve * t^2`, for `t`
/// in `[0, t_end]`: where it reaches the floor, or, if it `leaves`, where
/// it is back at the un-displaced surface.
struct ViewRay {
  float2 slope = float2(0.0);
  float curve = 0.0;
  float t_end = 1.0;
  bool leaves = false;
};

/// The quadratic coefficient of the height of a ray of tangent-plane
/// `slope` (its tangent, before the relief depth `scale` multiplies it)
/// over a surface of the given `curvature`: half the normal curvature
/// along the ray, times the scale, times the squared tangent.
@(pure macro)
float rayCurve(const float3 curvature, const float2 slope, const float scale) =
  0.5 * scale * (curvature.x * slope.x * slope.x + 2.0 * curvature.y * slope.x * slope.y + curvature.z * slope.y * slope.y);

/// The view ray for the tangent-frame `view`, the relief depth `scale`,
/// and the `curvature` of the surface as `texture_curvature()` gives it.
///
/// A surface of normal curvature `k` along the ray falls away from the
/// tangent plane as `k s^2 / 2` over a distance `s`, which takes
/// `curve = k scale tan^2(theta) / 2` off the depth the flat ray reaches.
/// Up to 1/4 the ray still reaches the floor. Past it the ray bottoms out
/// at height `1 - 1 / (4 curve)` and leaves at `t = 1 / curve`.
///
/// The slope cap is `PARALLAX_MAX_SLOPE` up to a curve of 1 and that many
/// times the curve past it, which bounds the offset at the cap times the
/// scale either way: a ray whose chord is shorter than the cap is traced
/// along the chord it has.
@(pure)
ViewRay viewRay(const float3 view, const float scale, const float3 curvature) {
  // Clamping the divisor (rather than culling grazing views) keeps the
  // offset continuous at the grazing band: it saturates at the slope cap
  // instead of snapping back to the identity, and the slope stays finite
  // for arbitrarily small positive view.z.
  auto slope(view.xy / #max(view.z, PARALLAX_MIN_VIEW_Z));
  const float curve(rayCurve(curvature, slope, scale));
  const auto slope_len(math::length(slope));
  const float cap(PARALLAX_MAX_SLOPE * #max(1.0, curve));
  slope *= cap / slope_len if (slope_len > cap);
  slope *= scale; // Always multiplies t, so fold into slope
  return ViewRay(slope, curve, 1.0 / curve, true) if (curve > 0.25);
  return ViewRay(slope, curve, 2.0 / (1.0 + #sqrt(1.0 - 4.0 * curve)), false);
}

/// The slope of the base normal the tangent-plane `offset` away, by the
/// `curvature` of the surface in the same frame and units.
@(pure macro)
float2 baseTilt(const float3 curvature, const float2 offset) = float2(
  curvature.x * offset.x + curvature.y * offset.y,
  curvature.y * offset.x + curvature.z * offset.y);

/// The vector `v` of the tangent frame where the base normal has the
/// slope `tilt`, in the frame of the entry point: the rotation that takes
/// the entry's normal onto the tilted one by the shortest way.
@(pure)
float3 fromTilted(const float3 v, const float2 tilt) {
  return v if ((tilt.x == 0.0) & (tilt.y == 0.0));
  const float3 base(math::normalize(float3(tilt.x, tilt.y, 1.0)));
  const float3 sum(base.x, base.y, base.z + 1.0);
  return v - sum * (math::dot(v, sum) / sum.z) + 2.0 * v.z * base;
}

/// The inverse of `fromTilted()`: the vector `v` of the entry point's
/// frame in the frame where the base normal has the slope `tilt`.
@(pure)
float3 toTilted(const float3 v, const float2 tilt) {
  return v if ((tilt.x == 0.0) & (tilt.y == 0.0));
  const float3 base(math::normalize(float3(tilt.x, tilt.y, 1.0)));
  const float3 sum(base.x, base.y, base.z + 1.0);
  return v - sum * (math::dot(v, sum) / sum.z) + float3(0.0, 0.0, 2.0 * math::dot(v, base));
}

/// The layer march of the height lambda `height_at` (`float2 -> float`,
/// heights clamped to `[0, 1]`, 1 = un-displaced surface), viewed along
/// the tangent-frame `view` as produced by `view_vector()`, with the
/// relief depth `scale` in UV units and the `curvature` of the surface as
/// `texture_curvature()` gives it. With no curvature this is the flat
/// march and never a miss.
///
/// The march samples between `min_steps` (normal incidence) and
/// `max_steps` (grazing) depth layers, then refines the crossing with
/// `1 + refine_steps` false-position (secant) iterations, which is exact
/// for constant and linear height fields and tightens the crossing when
/// the field bends within one layer. The within-layer residue is what
/// shows as banding on steep relief, where each layer sweeps a long UV
/// distance. Identity when `view.z <= 0` or `scale <= 0`; grazing views
/// divide by `#max(view.z, PARALLAX_MIN_VIEW_Z)` and so saturate at the
/// slope cap instead of cutting out.
///
/// A ray that leaves the relief is a miss when no layer finds it below
/// the field, so relief thinner than a layer that the hierarchical march
/// would have met is a hole in the outline here.
///
/// `jitter` in `[0, 1)` shifts the interior sampling layers down by that
/// fraction of one layer (the entry at 0 and the final layer stay
/// anchored, so a ray that reaches the floor is always bracketed). It is exactly zero
/// cost and a no-op on fields where the secant is already exact; fed
/// per-sample randomness in a Monte Carlo renderer, it decorrelates the
/// layer grid across samples, turning any residual banding into noise
/// that averages out.
@(pure macro)
// Non-positive scale (and the other guard conditions) is the documented off
// switch, and that comptime instantiation folds the body away, leaving every
// parameter past the guard unused there. The `[[anno::unused()]]` markers
// quiet that warning; all of these parameters are used on the live path.
export parallax_result parallax_trace_with(
  const auto height_at [[anno::unused()]],
  const float2 coord,
  const float3 view,
  const float scale,
  const float3 curvature = float3(0.0) [[anno::unused()]],
  const int min_steps = 8 [[anno::unused()]],
  const int max_steps = 32 [[anno::unused()]],
  const float jitter = 0.0 [[anno::unused()]],
  const int refine_steps = 2 [[anno::unused()]],
) {
  return parallax_result(coord) if (!(view.z > 0.0) | !(scale > 0.0));
  const auto ray(viewRay(view, scale, curvature));
  // The signed clearance `f = depth of the ray - depth of the field` is
  // negative strictly above the surface. At the entry, a non-negative
  // clearance means the surface is at its reference level and there is
  // nothing to march.
  float f0(-(1.0 - math::saturate(height_at(coord))));
  return parallax_result(coord, false, float2(0.0), curvature) if (f0 >= 0.0);
  const int n(#max(
    1,
    int(math::lerp(float(max_steps), float(min_steps), math::saturate(view.z)))));
  float l0(0.0);
  float l1(0.0);
  float f1(f0);
  // March until the ray dips below the surface. Because heights clamp to
  // [0, 1], the clearance where a ray reaches the floor is never negative,
  // so its crossing is always bracketed. A ray that leaves ends at depth
  // zero instead, and is a miss if no layer brackets it.
  const float xi(math::saturate(jitter));
  for (int i = 1; i <= n; i++) {
    l0 = l1;
    f0 = f1;
    l1 = i == n ? ray.t_end : ray.t_end * (float(i) - xi) / n;
    f1 = (1.0 - ray.curve * l1) * l1 - (1.0 - math::saturate(height_at(coord - ray.slope * l1)));
    break if (f1 >= 0.0);
  }
  return parallax_result(
           coord - ray.slope * l1,
           true,
           baseTilt(curvature, -ray.slope * l1),
           curvature) if (ray.leaves & (f1 < 0.0));
  // False-position refinement over the bracket `f0 < 0 <= f1`: the secant
  // estimate, then `refine_steps` passes that evaluate the clearance there
  // and shrink whichever side of the bracket it falls on.
  float l(math::lerp(l0, l1, #min(-f0 / #max(f1 - f0, $FLOAT_MIN), 1.0)));
  for (int r = 0; r < refine_steps; r++) {
    const float f(
      (1.0 - ray.curve * l) * l - (1.0 - math::saturate(height_at(coord - ray.slope * l))));
    if (f >= 0.0) {
      l1 = l;
      f1 = f;
    } else {
      l0 = l;
      f0 = f;
    }
    l = math::lerp(l0, l1, #min(-f0 / #max(f1 - f0, $FLOAT_MIN), 1.0));
  }
  return parallax_result(
           coord - ray.slope * l,
           false,
           baseTilt(curvature, -ray.slope * l),
           curvature);
}

/// The parallax-adjusted UV coordinate for the height lambda `height_at`:
/// `parallax_trace_with()` on a flat surface, where the ray always meets
/// the relief.
@(pure macro)
export float2 parallax_offset_with(
  const auto height_at,
  const float2 coord,
  const float3 view,
  const float scale,
  const int min_steps = 8,
  const int max_steps = 32,
  const float jitter = 0.0,
  const int refine_steps = 2,
) = parallax_trace_with(
      height_at,
      coord,
      view,
      scale,
      float3(0.0),
      min_steps,
      max_steps,
      jitter,
      refine_steps).coord;

/// The four horizon slopes of the height lambda at `coord` (pass the
/// *offset* UV from `parallax_offset_with()`) toward +U, -U, +V, -V,
/// as consumed by `df::horizon_shadow_factor` for first-order relief
/// self-shadowing. Each is the steepest blocker slope
/// `scale * (height - height(coord)) / distance` found by sampling the
/// axis geometrically from near to far (the near field, where the
/// horizon is usually decided, gets the density), clamped below at 0
/// and capped at `PARALLAX_MAX_SLOPE`.
///
/// The slopes are `scale`-proportional in the same UV-commensurate
/// units as the march, so the calibrated and faded `scale` used for the
/// offset is exactly the `scale` to pass here, and a non-positive
/// `scale` (the unpopulated LOD state, a faded-out relief, the
/// transport guard) returns all zeros, which the shadow factor treats
/// as an exact passthrough.
///
/// A blocker at distance `t` cannot contribute a slope above
/// `scale / t`, so searching much past `scale / PARALLAX_MIN_VIEW_Z` is
/// provably pointless; the `max_distance` default is generous for
/// typical relief scales. Cost: 4 x `steps` height samples on top of
/// the view march.
@(pure macro)
// See the note on 'parallax_trace_with': the annotations quiet the
// guarded-off comptime instantiation.
export float4 horizon_slopes_with(
  const auto height_at [[anno::unused()]],
  const float2 coord [[anno::unused()]],
  const float scale,
  const int steps = 8 [[anno::unused()]],
  const float max_distance = 0.25,
) {
  return float4(0.0) if (!(scale > 0.0) | !(max_distance > 0.0));
  const float h0(math::saturate(height_at(coord)));
  const int n(math::clamp(steps, 1, 24));
  float4 slopes(0.0);
  for (int k = 0; k < n; k++) {
    // Geometric spacing: each sample doubles the distance, ending at
    // `max_distance`.
    const float t(max_distance / float(1 << (n - 1 - k)));
    const float rise(scale / t);
    slopes.x = #max(
      slopes.x, (math::saturate(height_at(coord + float2(t, 0.0))) - h0) * rise);
    slopes.y = #max(
      slopes.y, (math::saturate(height_at(coord - float2(t, 0.0))) - h0) * rise);
    slopes.z = #max(
      slopes.z, (math::saturate(height_at(coord + float2(0.0, t))) - h0) * rise);
    slopes.w = #max(
      slopes.w, (math::saturate(height_at(coord - float2(0.0, t))) - h0) * rise);
  }
  return #min(slopes, PARALLAX_MAX_SLOPE);
}

/// Does the hierarchical march traverse the wrap mode exactly? Repeat
/// tiles the cells, and clamp holds the edge texel outside the image;
/// the other modes take the layer march.
@(pure macro)
export bool marches_wrap(const tex::wrap_mode wrap) =
  (int(wrap) == int(tex::wrap_repeat)) | (int(wrap) == int(tex::wrap_clamp));

/// The first root in `[0, ub]` of `q0 + q1 u + q2 u^2`, given `q0 < 0`,
/// or -1 if there is none. A root the quadratic formula loses to
/// rounding while the sign still changes over the interval is recovered
/// by the secant.
@(pure)
float firstRoot(const float q0, const float q1, const float q2, const float ub) {
  return 0.0 if (q0 >= 0.0);
  const float fb(q0 + (q1 + q2 * ub) * ub);
  float u(-1.0);
  if (#abs(q2) <= 1.0e-12) {
    u = q1 > 0.0 ? -q0 / q1 : -1.0;
  } else {
    const float disc(q1 * q1 - 4.0 * q2 * q0);
    if (disc >= 0.0) {
      const float sq(#sqrt(disc));
      const float qq(-0.5 * (q1 + (q1 >= 0.0 ? sq : -sq)));
      const float ra(qq / q2);
      const float rb(q0 / qq);
      const float lo(#min(ra, rb));
      const float hi(#max(ra, rb));
      u = lo >= 0.0 ? lo : (hi >= 0.0 ? hi : -1.0);
    }
  }
  return u if ((u >= 0.0) & (u <= ub));
  return fb >= 0.0 ? ub * (-q0) / #max(fb - q0, $FLOAT_MIN) : -1.0;
}

/// The crossing of the ray `p0 + d * t` (level-0 texel coordinates, ray
/// height `h_start + (h_rate + h_curve * t) * t`) with the one bilinear
/// patch the segment `[sa, sb]` lies in, as the ray parameter, or -1 if
/// the segment stays above it. The patch is the one under the segment's
/// midpoint: its corners are the four texel centers around it, fetched
/// through the wrap modes and clamped to `[0, 1]` like every sampled
/// height. Along the segment the bilinear height is quadratic in the
/// parameter and so is the ray's, so the crossing is a root of a
/// quadratic, solved from the segment start for conditioning.
@(pure)
float patchHit(
  const texture_2d height_tex,
  const tex::wrap_mode wrap_u,
  const tex::wrap_mode wrap_v,
  const float2 p0,
  const float2 d,
  const float h_start,
  const float h_rate,
  const float h_curve,
  const float sa,
  const float sb,
) {
  const float2 pm(p0 + d * (0.5 * (sa + sb)));
  const int2 i0(int2(#floor(pm - 0.5)));
  const float t00(math::saturate(tex::level_texel_float(
    height_tex, 0, i0, wrap_u, wrap_v)));
  const float t10(math::saturate(tex::level_texel_float(
    height_tex, 0, i0 + int2(1, 0), wrap_u, wrap_v)));
  const float t01(math::saturate(tex::level_texel_float(
    height_tex, 0, i0 + int2(0, 1), wrap_u, wrap_v)));
  const float t11(math::saturate(tex::level_texel_float(
    height_tex, 0, i0 + int2(1, 1), wrap_u, wrap_v)));
  const float2 xs(p0 + d * sa - float2(i0) - 0.5);
  const float bx(t10 - t00);
  const float by(t01 - t00);
  const float bxy(t00 - t10 - t01 + t11);
  const float h0(t00 + bx * xs.x + by * xs.y + bxy * xs.x * xs.y);
  const float h1(bx * d.x + by * d.y + bxy * (xs.x * d.y + xs.y * d.x));
  const float h2(bxy * d.x * d.y);
  // The clearance of the field under the ray over u in [0, sb - sa],
  // negative above the surface: the patch along the segment less the ray
  // expanded about `sa`.
  const float u(firstRoot(
    h0 - (h_start + (h_rate + h_curve * sa) * sa),
    h1 - (h_rate + 2.0 * h_curve * sa),
    h2 - h_curve,
    sb - sa));
  return u < 0.0 ? -1.0 : sa + u;
}

/// The result of `reliefMarch()`: whether the ray met the field, and the
/// ray parameter of the crossing, or of how far the march got when it
/// did not: the end of the ray, or, when `is_capped`, the step cap.
struct ReliefHit {
  bool hit = false;
  float t = 0.0;
  bool is_capped = false;
};

/// The quadtree traversal of the maximum mip chain of `height_tex` by
/// the ray `p0 + d * t` in level-0 texel coordinates at height
/// `h_start + (h_rate + h_curve * t) * t`, for `t` in `[0, t_end]`:
/// descending rays (`h_rate < 0`, the view march) and ascending rays
/// (`h_rate > 0`, the shadow march) alike, and a descending ray that
/// `h_curve > 0` turns back up before the end. From the coarsest level,
/// at each cell either the ray's lowest height in the cell (at one end of
/// it, or at the turn between them) clears the cell's bound, so the cell
/// is skipped (coarsening by one level only when the exit leaves the
/// parent cell, which spares a re-fetch of a parent bound that would only
/// send the traversal back down), or the traversal refines by one level,
/// a descending ray first advancing to the depth where it meets the
/// bound; at level 0 the segment is split where it crosses the
/// texel-center lines and each piece is solved by `patchHit()`. Cells
/// are chosen from a position nudged along the ray, so an exit lands in
/// the cell ahead. `tex::wrap_repeat` tiles the cells; every other wrap
/// mode holds the edge texel outside the image, which is exact for
/// `tex::wrap_clamp`.
@(pure)
ReliefHit reliefMarch(
  const texture_2d height_tex,
  const tex::wrap_mode wrap_u,
  const tex::wrap_mode wrap_v,
  const float2 p0,
  const float2 d,
  const float h_start,
  const float h_rate,
  const float h_curve,
  const float t_end,
  const int max_steps,
) {
  const int2 extent(tex::extent(height_tex));
  const float2 extentF(extent);
  const int2 clampAxis(int2(
    int(wrap_u) != int(tex::wrap_repeat) ? 1 : 0,
    int(wrap_v) != int(tex::wrap_repeat) ? 1 : 0));
  const float2 nudge(
    #select(d >= 0.0, PARALLAX_CELL_NUDGE, -PARALLAX_CELL_NUDGE));
  const int top(height_tex.num_levels - 1);
  // Where a ray that turns back up is lowest. A ray that does not is
  // lowest at one end of whatever interval it is asked over.
  const float tTurn(h_curve > 0.0 ? -h_rate / (2.0 * h_curve) : 0.0);
  int level(top);
  float t(0.0);
  for (int step = 0; step < max_steps; step++) {
    const int cellSize(1 << level);
    const int2 levelExtent(tex::level_extent(height_tex, level));
    const float2 p(p0 + d * t + nudge);
    const int2 xi(int2(#floor(p)));
    const int2 xw(((xi % extent) + extent) % extent);
    const int2 base(xi - xw);
    // A shift rather than a division by 'cellSize': 'xw' is non-negative,
    // so the two agree, while a signed division by a runtime power of two
    // lowers to 'idiv'. The range this gives 'c' is also what lets the
    // wrap inside the bound fetch below fold away.
    const int2 c(#min(xw >>> level, levelExtent - 1));
    // The cell's span in level-0 texels along the unwrapped ray, the
    // last cell of a level reaching the image edge (the chain widens it
    // the same way). Under clamp, outside the image lies a half-infinite
    // cell bounded by the edge cell, whose texel the field holds there.
    const auto below((clampAxis != 0) & (xi < 0));
    const auto above((clampAxis != 0) & (xi >= extent));
    const int2 cell(#select(below, 0, #select(above, levelExtent - 1, c)));
    float2 lo(float2(base + c * cellSize));
    float2 hi(float2(base + #select(
      c == levelExtent - 1, extent, (c + 1) * cellSize)));
    lo = #select(below, -1.0e30, #select(above, extentF, lo));
    hi = #select(below, 0.0, #select(above, 1.0e30, hi));
    const float2 dSafe(#select(d != 0.0, d, 1.0));
    float2 tExit2(1.0e30);
    tExit2 = #select(d > 0.0, (hi - p0) / dSafe, tExit2);
    tExit2 = #select(d < 0.0, (lo - p0) / dSafe, tExit2);
    const float tExit(#min(#min(tExit2.x, tExit2.y), t_end));
    const float parentSize(float(2 * cellSize));
    const auto leavesParent(#any(
      #floor((p0 + d * tExit + nudge) / parentSize) != #floor(p / parentSize)));
    const int levelAfterSkip(leavesParent ? #min(level + 1, top) : level);
    if (level > 0) {
      const float bound(tex::level_texel_float(
        height_tex, level, cell, wrap_u, wrap_v));
      // The ray's lowest height in the cell: at the exit descending, at
      // the entry ascending, and at the turn where there is one inside.
      const float tLow(
        h_curve > 0.0 ? #max(t, #min(tTurn, tExit)) : (h_rate < 0.0 ? tExit : t));
      const float hMin(h_start + (h_rate + h_curve * tLow) * tLow);
      if (hMin > bound) {
        t = tExit;
        level = levelAfterSkip;
      } else {
        // The first root of the ray's height at the bound, in the form
        // that stays finite as the curve goes to zero.
        if (h_rate < 0.0) {
          const float above(h_start - bound);
          const float disc(#max(h_rate * h_rate - 4.0 * h_curve * above, 0.0));
          t = #min(#max(t, 2.0 * above / (#sqrt(disc) - h_rate)), tExit);
        }
        level -= 1;
      }
    } else {
      // The leaf: the patches under this texel, split where the ray
      // crosses the texel-center lines (never for a half-infinite cell,
      // where the field is constant along that axis).
      float2 tc(1.0e30);
      tc = #select((d != 0.0) & !below & !above, (lo + 0.5 - p0) / dSafe, tc);
      tc = #select((tc > t) & (tc < tExit), tc, 1.0e30);
      const float tA(#min(tc.x, tc.y));
      const float tB(#max(tc.x, tc.y));
      float hit(patchHit(
        height_tex, wrap_u, wrap_v, p0, d, h_start, h_rate, h_curve, t, #min(tA, tExit)));
      hit = patchHit(
        height_tex, wrap_u, wrap_v, p0, d, h_start, h_rate, h_curve, tA, #min(tB, tExit)) if ((hit < 0.0) & (tA < tExit));
      hit = patchHit(
        height_tex, wrap_u, wrap_v, p0, d, h_start, h_rate, h_curve, tB, tExit) if ((hit < 0.0) & (tB < tExit));
      return ReliefHit(true, hit) if (hit >= 0.0);
      t = tExit;
      level = levelAfterSkip;
    }
    return ReliefHit(false, t_end) if (t >= t_end);
  }
  return ReliefHit(false, t, true);
}

/// The hierarchical march of the height texture `height_tex`, which must
/// carry a maximum mip chain (constructed with `max_mipmap: true`), viewed
/// along the tangent-frame `view` as produced by `view_vector()`, with the
/// relief depth `scale` in UV units and the `curvature` of the surface as
/// `texture_curvature()` gives it. With no curvature this is the flat
/// march and never a miss. The identity under the same guards as
/// `parallax_trace_with()`, when the texture is invalid, and when it
/// carries no maximum chain, so a forgotten `max_mipmap: true` reads as no
/// relief rather than as wrong relief.
///
/// The march is the quadtree traversal of Tevs et al. and Drobot over
/// the chain (see `reliefMarch()`), descending from the un-displaced
/// surface until it meets the field, with the crossing solved exactly
/// against the bilinear patch it lands on. So thin features are never
/// stepped over, and the answer does not depend on a layer count. The
/// traversal wraps under `tex::wrap_repeat` and holds the edge texel
/// under `tex::wrap_clamp` (see `marches_wrap()`); pass only those. It
/// runs over the first tile of a uv-tileset.
///
/// A ray that leaves the relief is a miss when the traversal reaches its
/// end without a crossing, and without a traversal at all when its lowest
/// height clears the highest texel of the image.
///
/// Cost: one bound fetch per step plus four texel fetches per patch
/// tested at the leaf, for a step count that grows with the chain depth
/// and the relief's roughness along the ray, and is capped by
/// `max_steps`; a capped ray stops above the surface, and is never a miss.
@(pure)
// See the note on 'parallax_trace_with': the annotations quiet the
// guarded-off instantiation, here the one for an invalid texture.
export parallax_result parallax_trace_max(
  const texture_2d height_tex,
  const float2 coord,
  const float3 view,
  const float scale,
  const float3 curvature = float3(0.0) [[anno::unused()]],
  const tex::wrap_mode wrap_u = tex::wrap_repeat [[anno::unused()]],
  const tex::wrap_mode wrap_v = tex::wrap_repeat [[anno::unused()]],
  const int max_steps = PARALLAX_MAX_CELL_STEPS [[anno::unused()]],
) {
  return parallax_result(coord) if (!(view.z > 0.0) | !(scale > 0.0) | !height_tex.max_mipmap);
  const int2 extent(tex::extent(height_tex));
  return parallax_result(coord) if (#any(extent <= 0));
  const auto ray(viewRay(view, scale, curvature));
  return parallax_result(coord, false, float2(0.0), curvature) if (math::saturate(tex::lookup_float(height_tex, coord, wrap_u, wrap_v)) >= 1.0);
  if (ray.leaves) {
    const float2 offset(-ray.slope * ray.t_end);
    const float highest(tex::level_texel_float(
      height_tex, height_tex.num_levels - 1, int2(0), wrap_u, wrap_v));
    return parallax_result(
             coord + offset, true, baseTilt(curvature, offset), curvature) if (1.0 - 0.25 / ray.curve > highest);
  }
  // The ray in level-0 texel coordinates, from the un-displaced surface
  // (height 1) down one relief depth per unit parameter at first.
  const float2 extentF(extent);
  const auto hit(reliefMarch(
    height_tex,
    wrap_u,
    wrap_v,
    coord * extentF,
    -ray.slope * extentF,
    1.0,
    -1.0,
    ray.curve,
    ray.t_end,
    max_steps));
  const float2 offset(-ray.slope * hit.t);
  return parallax_result(
           coord + offset,
           ray.leaves & !hit.hit & !hit.is_capped,
           baseTilt(curvature, offset),
           curvature);
}

/// The parallax-adjusted UV coordinate for the height texture
/// `height_tex`: `parallax_trace_max()` on a flat surface, where the ray
/// always meets the relief.
@(pure)
export float2 parallax_offset_max(
  const texture_2d height_tex,
  const float2 coord,
  const float3 view,
  const float scale,
  const tex::wrap_mode wrap_u = tex::wrap_repeat,
  const tex::wrap_mode wrap_v = tex::wrap_repeat,
  const int max_steps = PARALLAX_MAX_CELL_STEPS,
) = parallax_trace_max(
      height_tex, coord, view, scale, float3(0.0), wrap_u, wrap_v, max_steps).coord;

/// Is the light direction `wi` (in the tangent frame of the height
/// field, z up, as the BSDFs see it) unoccluded by the relief of
/// `height_tex`, which must carry a maximum mip chain, from the surface
/// point at `coord` (pass the *offset* UV from `parallax_uv()`), with the
/// relief depth `scale` in UV units? This is the light-side counterpart
/// of `parallax_offset_max()`: the same traversal, run upward from the
/// surface height at `coord` plus `bias` (a fraction of the relief depth,
/// which keeps the surface from shadowing itself where the light grazes
/// it) until the ray clears the un-displaced surface at height 1, above
/// which nothing can occlude. The answer is binary; a light's extent and
/// the sampler make the penumbra. `df::relief_shadow_factor` applies it
/// inside a BSDF, per evaluated direction.
///
/// On a curved surface pass the `curvature` and the `tilt` of the march
/// that found `coord` (see `parallax_result`). The light is then taken
/// in the frame of the base surface at `coord`, which stands turned
/// against the frame `wi` is given in, and the ray rises as that surface
/// falls away under it, `start + t + c t^2`, so it is clear of the relief
/// sooner than a flat ray is. A light under that frame's own tangent
/// plane is occluded: the surface itself stands in the way, and the BSDF
/// cannot know. A concave surface is taken as flat, since what it puts
/// in the way is the renderer's shadow ray's to find.
///
/// Visible whenever there is nothing to decide: `wi` at or below the
/// tangent plane (the BSDF's business), a non-positive `scale` or
/// `bias`, an invalid texture or one without a maximum chain, a point at
/// the un-displaced surface, and a traversal that runs out of steps,
/// which errs toward light rather than toward a false shadow. Grazing
/// light divides by
/// `#max(wi.z, PARALLAX_MIN_VIEW_Z)` and the ray's slope caps at
/// `PARALLAX_MAX_SLOPE`, as the view march does, so light within a few
/// degrees of the tangent plane is tested as if it were at the cap.
/// Exact under `tex::wrap_repeat` and `tex::wrap_clamp`; the other modes
/// hold the edge texel outside the image.
@(pure)
// See the note on 'parallax_trace_with': the annotations quiet the
// guarded-off instantiation, here the one for an invalid texture.
export bool relief_visible(
  const texture_2d height_tex,
  const float2 coord [[anno::unused()]],
  const float3 wi,
  const float scale,
  const tex::wrap_mode wrap_u = tex::wrap_repeat [[anno::unused()]],
  const tex::wrap_mode wrap_v = tex::wrap_repeat [[anno::unused()]],
  const float bias = 0.02 [[anno::unused()]],
  const int max_steps = PARALLAX_MAX_CELL_STEPS [[anno::unused()]],
  const float3 curvature = float3(0.0) [[anno::unused()]],
  const float2 tilt = float2(0.0) [[anno::unused()]],
) {
  return true if (!(wi.z > 0.0) | !(scale > 0.0) | !(bias > 0.0) | !height_tex.max_mipmap);
  const int2 extent(tex::extent(height_tex));
  return true if (#any(extent <= 0));
  const float3 w(toTilted(wi, tilt));
  return false if (!(w.z > 0.0));
  auto slope(w.xy / #max(w.z, PARALLAX_MIN_VIEW_Z));
  const float curve(#max(rayCurve(curvature, slope, scale), 0.0));
  const auto slope_len(math::length(slope));
  const float cap(PARALLAX_MAX_SLOPE * #max(1.0, curve));
  slope *= cap / slope_len if (slope_len > cap);
  slope *= scale;
  const float start(
    math::saturate(tex::lookup_float(height_tex, coord, wrap_u, wrap_v)) + bias);
  return true if (start >= 1.0);
  // The ray in level-0 texel coordinates, rising one relief depth per
  // unit parameter at first, until it reaches the un-displaced surface:
  // the root of `curve t^2 + t` at the rise it has to make.
  const float rise(1.0 - start);
  const float2 extentF(extent);
  return !reliefMarch(
           height_tex,
           wrap_u,
           wrap_v,
           coord * extentF,
           slope * extentF,
           start,
           1.0,
           curve,
           2.0 * rise / (1.0 + #sqrt(1.0 + 4.0 * curve * rise)),
           max_steps).hit;
}

/// The parallax-adjusted UV coordinate for the height texture
/// `height_tex`, from `state::direction()` via `view_vector(space)`.
/// This is the texture specialization of the marches: a texture that
/// carries a maximum mip chain (constructed with `max_mipmap: true`)
/// under a wrap mode that `marches_wrap()` takes the hierarchical
/// `parallax_offset_max()`, and any other texture the layer march
/// `parallax_offset_with()`, whose `min_steps`, `max_steps`, `jitter`,
/// and `refine_steps` apply only there. See those for the semantics,
/// and see the module documentation for the intended use. Identity
/// whenever the LOD state is unpopulated.
@(macro)
// The annotations quiet the instantiation that folds to the
// hierarchical march, where the layer parameters go unused.
export float2 parallax_uv(
  const texture_2d height_tex,
  const float scale,
  const float2 coord = state::texture_coordinate(0).xy,
  const int space = 0,
  const int min_steps = 8 [[anno::unused()]],
  const int max_steps = 32 [[anno::unused()]],
  const tex::wrap_mode wrap_u = tex::wrap_repeat,
  const tex::wrap_mode wrap_v = tex::wrap_repeat,
  const float jitter = 0.0 [[anno::unused()]],
  const int refine_steps = 2 [[anno::unused()]],
) {
  return parallax_offset_max(
           height_tex, coord, view_vector(space), scale, wrap_u, wrap_v) if (height_tex.max_mipmap & (height_tex.num_levels > 1) & marches_wrap(wrap_u) & marches_wrap(wrap_v));
  return parallax_offset_with(
           \(const float2 coord) =
             tex::lookup_float(height_tex, coord, wrap_u, wrap_v),
           coord,
           view_vector(space),
           scale,
           min_steps,
           max_steps,
           jitter,
           refine_steps,
         );
}

/// The curvature of the surface as a march takes it: the second
/// fundamental form of `state::surface_curvature()` against the shading
/// tangents of texture space `space`, as `(K_uu, K_uv, K_vv)`, per unit
/// of the coordinates the caller looks up at rather than per scene unit.
/// `uv_scale` is the scale of those coordinates relative to
/// `state::texture_coordinate(space)`, as `::extras::lod` takes it: a
/// material that tiles at `coord * m` passes `uv_scale: m`.
///
/// The conversion takes a unit of the lookup coordinate to be as long
/// along U as along V on the surface, which the marches take as well:
/// its length is one over the square root of `state::texture_density()`
/// times the scale. Zero, which is a flat surface to every march,
/// whenever the renderer provides no curvature or no density, and under
/// importance transport as `view_vector()` is.
@(macro)
export float3 texture_curvature(const int space = 0, const auto uv_scale = 1.0) {
  return float3(0.0) if ($state.transport != 0);
  const float2 s(float2(uv_scale));
  const float density($state.textureDensity[space] * #abs(s.x * s.y));
  return float3(0.0) if (!(density > 0.0));
  const float3 k($state.curvature / #sqrt(density));
  const float2 tu($state.textureTangentU[space].xy);
  const float2 tv($state.textureTangentV[space].xy);
  const float2 ku(k.x * tu.x + k.y * tu.y, k.y * tu.x + k.z * tu.y);
  const float2 kv(k.x * tv.x + k.y * tv.y, k.y * tv.x + k.z * tv.y);
  return float3(#sum(ku * tu), #sum(ku * tv), #sum(kv * tv));
}

/// The march of the height texture `height_tex` on the surface as it
/// curves, from `state::direction()` via `view_vector(space)` and
/// `state::surface_curvature()` via `texture_curvature(space, uv_scale)`:
/// `parallax_uv()` with a ray that bends, which can therefore miss. The
/// two agree wherever the renderer provides no curvature. The march is
/// chosen as `parallax_uv()` chooses it, between `parallax_trace_max()`
/// and `parallax_trace_with()`.
///
/// On a mesh the curvature is that of the smooth surface its shading
/// normals describe, and the faces at its outline reach a little further
/// out than that surface does. A ray that meets the front of a face
/// whose shading normal has already turned away from it is past the
/// outline of the smooth surface, and where that surface is convex along
/// the ray it is a miss as well, which no march is needed to say.
///
/// Feed `coord` to every downstream lookup and the result to
/// `silhouette_opacity()`.
@(macro)
// The annotations quiet the instantiation that folds to the
// hierarchical march, where the layer parameters go unused.
export parallax_result parallax_trace(
  const texture_2d height_tex,
  const float scale,
  const float2 coord = state::texture_coordinate(0).xy,
  const int space = 0,
  const auto uv_scale = 1.0,
  const int min_steps = 8 [[anno::unused()]],
  const int max_steps = 32 [[anno::unused()]],
  const tex::wrap_mode wrap_u = tex::wrap_repeat,
  const tex::wrap_mode wrap_v = tex::wrap_repeat,
  const float jitter = 0.0 [[anno::unused()]],
  const int refine_steps = 2 [[anno::unused()]],
) {
  const float3 view(view_vector(space));
  const float3 curvature(texture_curvature(space, uv_scale));
  return parallax_result(coord, true, float2(0.0), curvature) if (!(view.z > 0.0) & ($state.direction.z < 0.0) & (rayCurve(curvature, view.xy, 1.0) > 0.0));
  return parallax_trace_max(
           height_tex, coord, view, scale, curvature, wrap_u, wrap_v) if (height_tex.max_mipmap & (height_tex.num_levels > 1) & marches_wrap(wrap_u) & marches_wrap(wrap_v));
  return parallax_trace_with(
           \(const float2 coord) =
             tex::lookup_float(height_tex, coord, wrap_u, wrap_v),
           coord,
           view,
           scale,
           curvature,
           min_steps,
           max_steps,
           jitter,
           refine_steps,
         );
}

/// The cutout opacity that carries the relief into the outline: 0 where
/// the march missed, so that the ray goes on past the surface, and 1
/// elsewhere.
///
/// A ray that goes on meets the far side of the same surface from inside,
/// so an arrival from inside is 0 as well. That is only right for a
/// surface that is closed and does not transmit, where nothing has any
/// business being inside: use this on nothing else. Under importance
/// transport, and wherever the renderer provides no direction, it is 1.
@(macro)
export float silhouette_opacity(const parallax_result hit) {
  return 1.0 if ($state.transport != 0);
  return (hit.is_miss | ($state.direction.z > 0.0)) ? 0.0 : 1.0;
}

/// The bump-perturbed shading normal matching the relief: central
/// differences of the height lambda at `coord` (pass the *offset* UV so
/// the normal matches what the viewer sees) with spacing `delta` in UV
/// units, built in the tangent frame of `space` and returned in internal
/// space. A constant height gives `state::normal()` back to normalization
/// precision (fast-math lowers `normalize` through an approximate
/// reciprocal square root, so not bit-exactly); a non-positive `delta`
/// (the division guard) returns it exactly, untouched.
///
/// On a curved surface pass the `tilt` of the march that found `coord`
/// (see `parallax_result`): the relief there stands on the base normal at
/// `coord`, which the march left the entry point's normal to reach, and
/// the bump is turned with it.
@(macro)
// See the note on 'parallax_trace_with': the annotations quiet the
// guarded-off comptime instantiation.
export float3 perturbed_normal_with(
  const auto height_at [[anno::unused()]],
  const float2 coord [[anno::unused()]],
  const float scale [[anno::unused()]],
  const float2 delta,
  const int space = 0 [[anno::unused()]],
  const float2 tilt = float2(0.0) [[anno::unused()]],
) {
  return state::normal() if (!(delta.x > 0.0) | !(delta.y > 0.0));
  const float dhdu(
    (height_at(coord + float2(delta.x, 0.0)) - height_at(coord - float2(delta.x, 0.0))) / (2.0 * delta.x));
  const float dhdv(
    (height_at(coord + float2(0.0, delta.y)) - height_at(coord - float2(0.0, delta.y))) / (2.0 * delta.y));
  const float3 nt(fromTilted(
    math::normalize(float3(-scale * dhdu, -scale * dhdv, 1.0)), tilt));
  return math::normalize(
           nt.x * state::texture_tangent_u(space) + nt.y * state::texture_tangent_v(space) + nt.z * state::normal());
}

/// The bump-perturbed shading normal for the height texture `height_tex`
/// at `coord` (pass the UV from `parallax_uv()` so the normal matches
/// the relief) with the difference spacing `delta_texels` texels, turned
/// by the `tilt` of a march on a curved surface as
/// `perturbed_normal_with()` turns it. Returns `state::normal()` unchanged
/// for invalid textures.
@(macro)
export float3 perturbed_normal(
  const texture_2d height_tex,
  const float scale,
  const float2 coord = state::texture_coordinate(0).xy,
  const int space = 0,
  const float delta_texels = 1.0,
  const tex::wrap_mode wrap_u = tex::wrap_repeat,
  const tex::wrap_mode wrap_v = tex::wrap_repeat,
  const float2 tilt = float2(0.0),
) {
  const int2 extent(tex::extent(height_tex));
  return state::normal() if (#any(extent <= 0));
  return perturbed_normal_with(
           \(const float2 coord) =
             tex::lookup_float(height_tex, coord, wrap_u, wrap_v),
           coord,
           scale,
           float2(delta_texels) / float2(extent),
           space,
           tilt,
         );
}
