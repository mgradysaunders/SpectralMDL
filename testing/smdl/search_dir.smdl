#smdl
#search_dir "./search_dir_data/"

import ::tex::*;

unit_test "Search dir resolves resources not in the module directory" {
  // '4x4_only_here.png' exists only in 'search_dir_data/', so it can
  // only resolve through '#search_dir'.
  const auto t = texture_2d("4x4_only_here.png", tex::gamma_linear);
  #assert(tex::texture_isvalid(t));
  #assert(tex::width(t) == 4);
  #assert(tex::height(t) == 4);
}

unit_test "Search dir takes priority over the module directory" {
  // The module directory has the real 4x4 image; 'search_dir_data/' has
  // an 8x8 image under the same name, which must win. Conversely, the
  // 4x4 asserts in 'textures.smdl' prove '#search_dir' stays scoped to
  // this file.
  const auto t = texture_2d("4x4.png", tex::gamma_linear);
  #assert(tex::texture_isvalid(t));
  #assert(tex::width(t) == 8);
  #assert(tex::height(t) == 8);
}
