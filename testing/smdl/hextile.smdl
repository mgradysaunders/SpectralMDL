#smdl

using hextile = ::extras::hextile;
using noise = ::extras::noise;

import hextile::*;
import noise::*;
import ::math::*;
import ::tex::*;

// A deterministic spread of sample positions. The range is a parameter because
// the numerical conditioning of the lattice is the thing most worth testing,
// and it only shows up once the coordinate is large.
@(pure macro)
float2 samplePoint(const int i, const float range) = (noise::hash_float2(int2(i, i * 7919 + 13)) - 0.5) * range;

// A literal transcription of Listings 1 and 5 of Mikkelsen (2022), against
// which the module's folded and reconditioned form is checked.
struct referenceGrid {
  float3 w = float3(0.0);
  int2[3] v = int2[3](int2(0), int2(0), int2(0));
};

@(pure)
referenceGrid referenceTriangleGrid(float2 st) {
  st *= 2.0 * 1.7320508075688772;
  // 'gridToSkewedGrid' is row major in HLSL, with rows (1, -0.57735027) and
  // (0, 1.15470054), and is applied as 'mul(matrix, vector)'.
  const auto skewedCoord(float2(st.x - 0.57735027 * st.y, 1.15470054 * st.y));
  const auto baseId(int2(#floor(skewedCoord)));
  auto temp(float3(skewedCoord - #floor(skewedCoord), 0.0));
  temp.z = 1.0 - temp.x - temp.y;
  const auto s(math::step(0.0, -temp.z));
  const auto s2(2.0 * s - 1.0);
  return referenceGrid(
           w: float3(-temp.z * s2, s - temp.y * s2, s - temp.x * s2),
           v: int2[3](baseId + int2(int(s), int(s)),       //
                      baseId + int2(int(s), int(1.0 - s)), //
                      baseId + int2(int(1.0 - s), int(s))),
         );
}

@(pure)
float2 referenceMakeCenST(const int2 v) {
  // 'invSkewMat' is row major, with rows (1.0, 0.5) and (0.0, 1.0/1.15470054).
  return float2(float(v.x) + 0.5 * float(v.y), (1.0 / 1.15470054) * float(v.y)) / (2.0 * 1.7320508075688772);
}

unit_test "Hex tiling matches the published lattice" {
  // At a magnitude where float32 still resolves the published form, the tile
  // ids must agree exactly and the weights to rounding.
  float worstWeight = 0.0;
  for (int i = 0; i < 20000; i++) {
    const auto st(samplePoint(i, 40.0));
    const auto a(referenceTriangleGrid(st));
    const auto b(hextile::hex_tiling_at(st));
    for (int k = 0; k < 3; k++) {
      #assert(#all(a.v[k] == b.tiles[k].id), "tile ids must match the published lattice");
      worstWeight = #max(worstWeight, #abs(a.w[k] - b.tiles[k].weight));
    }
  }
  #assert(worstWeight < 1e-4, "weights must match the published lattice");
}

unit_test "Hex tiling weights are a partition of unity" {
  for (int i = 0; i < 20000; i++) {
    const auto tiling(hextile::hex_tiling_at(samplePoint(i, 200.0), 0.5));
    const auto raw(float3(tiling.tiles[0].weight, tiling.tiles[1].weight, tiling.tiles[2].weight));
    #assert(#all(raw >= -1e-5), "barycentric weights must be non-negative");
    #assert(#abs(#sum(raw) - 1.0) < 1e-4, "barycentric weights must sum to one");

    // The same must hold after every stage of weight shaping, including the
    // degenerate settings that drive the weights toward zero.
    const auto w0(hextile::hex_weights(tiling));
    const auto w1(hextile::hex_modulate(w0, float3(0.3, 0.6, 0.9)));
    const auto w2(hextile::hex_contrast(w1, 0.75));
    const auto w3(hextile::hex_contrast(hextile::hex_modulate(w0, float3(0.0), 1.0), 0.999));
    #assert(#all(w0 >= 0.0) && #abs(#sum(w0) - 1.0) < 1e-4, "hex_weights must be normalized");
    #assert(#all(w1 >= 0.0) && #abs(#sum(w1) - 1.0) < 1e-4, "hex_modulate must be normalized");
    #assert(#all(w2 >= 0.0) && #abs(#sum(w2) - 1.0) < 1e-4, "hex_contrast must be normalized");
    #assert(#all(w3 >= 0.0) && #abs(#sum(w3) - 1.0) < 1e-4, "degenerate weights must still be normalized");
  }

  // A contrast of exactly 0.5 is the identity.
  const auto w(float3(0.2, 0.3, 0.5));
  #assert(#all(hextile::hex_contrast(w, 0.5) == w), "contrast 0.5 must be the identity");
}

// A literal transcription of Listing 8 of Mikkelsen (2022), the S-curve ramp
// applied to the blending weights.
@(pure)
float3 referenceGain3(const float3 x, const float r) {
  const auto k(#log(1.0 - r) / #log(0.5));
  const auto s(2.0 * math::step(0.5, x));
  const auto m(2.0 * (1.0 - s));
  const auto res(0.5 * s + 0.25 * m * #pow(#max(float3(0.0), s + x * m), k));
  return res / #sum(res);
}

unit_test "Hex tiling contrast ramp matches the published curve" {
  for (int i = 0; i < 8192; i++) {
    const auto w(hextile::hex_weights(hextile::hex_tiling_at(samplePoint(i, 20.0))));
    for (int j = 1; j <= 3; j++) {
      // Sample r on either side of 0.5, where the curve reverses.
      const auto r(0.25 * float(j));
      #assert(#all(hextile::hex_contrast(w, r) ~== |1e-5| referenceGain3(w, r)), "hex_contrast must match the published Gain3");
    }
  }

  // The curve is an S about 0.5: below 0.5 is pushed down, above is pushed up.
  // Getting the sign of the upper branch wrong still normalizes, so check the
  // shape rather than only the sum.
  const auto sharpened(hextile::hex_contrast(float3(0.2, 0.3, 0.5), 0.75));
  #assert(sharpened.x < 0.2 && sharpened.z > 0.5, "contrast above 0.5 must sharpen");
  const auto softened(hextile::hex_contrast(float3(0.2, 0.3, 0.5), 0.25));
  #assert(softened.x > 0.2 && softened.z < 0.5, "contrast below 0.5 must soften");
}

unit_test "Hex tiling covers each position with three distinct tiles" {
  for (int i = 0; i < 20000; i++) {
    const auto tiling(hextile::hex_tiling_at(samplePoint(i, 200.0)));
    const auto id0(tiling.tiles[0].id), id1(tiling.tiles[1].id), id2(tiling.tiles[2].id);
    #assert(!#all(id0 == id1) && !#all(id1 == id2) && !#all(id0 == id2), "the three tiles must be distinct");
  }
}

unit_test "Hex tiling gives a tile full weight at its own center" {
  // The barycentric weights are those of the position in the triangle whose
  // corners are the three tile centers, so at a center the corresponding
  // weight must be one.
  for (int j = -6; j <= 6; j++) {
    for (int i = -6; i <= 6; i++) {
      const auto id(int2(i, j));
      const auto tiling(hextile::hex_tiling_at(referenceMakeCenST(id)));
      float best = 0.0;
      for (int k = 0; k < 3; k++)
        if (#all(tiling.tiles[k].id == id))
          best = #max(best, tiling.tiles[k].weight);
      #assert(best > 0.999, "a tile center must carry full weight for its own tile");
    }
  }
}

// The published form derives the lookup coordinate by subtracting the tile
// center from the position, which cancels catastrophically once the position is
// large. Deriving it from the fractional part instead keeps it bounded by the
// tile radius at any magnitude, which is what this pins down.
@(pure)
void checkOffsetBound(const float range) {
  for (int i = 0; i < 20000; i++) {
    const auto tiling(hextile::hex_tiling_at(samplePoint(i, range), 1.0));
    for (int k = 0; k < 3; k++) {
      const auto id(tiling.tiles[k].id);
      const auto offset(tiling.tiles[k].coord - noise::hash_float3(int3(id.x, id.y, 0)).xy);
      #assert(#sqrt(#sum(offset * offset)) < hextile::HEX_TILE_RADIUS + 1e-5, "the lookup offset must stay inside the tile");
    }
  }
}

unit_test "Hex tiling keeps the lookup coordinate bounded at any magnitude" {
  checkOffsetBound(2.0);
  checkOffsetBound(200.0);
  checkOffsetBound(20000.0);
  checkOffsetBound(2000000.0);
}

// A stand-in for a texture: a deterministic, bounded, high-frequency function
// of the lookup coordinate, so that the blend can be exercised without any
// image data.
@(pure)
float3 fakeTexture(const float2 c) {
  return float3(0.5) + 0.5 * float3(#sin(12.0 * c.x + 3.0 * c.y), #sin(9.0 * c.y - 2.0 * c.x), #sin(7.0 * (c.x + c.y)));
}

@(pure)
float3 blendedAt(const float2 st, const float rotate, const float contrast) {
  const auto tiling(hextile::hex_tiling_at(st, rotate));
  const auto value0(fakeTexture(tiling.tiles[0].coord));
  const auto value1(fakeTexture(tiling.tiles[1].coord));
  const auto value2(fakeTexture(tiling.tiles[2].coord));
  auto w(hextile::hex_weights(tiling));
  w = hextile::hex_modulate(w, hextile::hex_metric_luminance(value0, value1, value2));
  w = hextile::hex_contrast(w, contrast);
  return hextile::hex_blend(w, value0, value1, value2);
}

// A seam would appear as a jump in the blended result far larger than the local
// slope of the underlying function. The bound must not degrade with the
// coordinate magnitude, which is what the double-precision lattice buys.
@(pure)
void checkContinuity(const float range, const float rotate, const float contrast) {
  float worst = 0.0;
  for (int i = 0; i < 20000; i++) {
    const auto st((noise::hash_float2(int2(i + 5, i * 104729 + 7)) - 0.5) * range);
    const auto step(1e-4 * (noise::hash_float2(int2(i * 31 + 1, i * 17 + 2)) - 0.5));
    worst = #max(worst, #max_value(#abs(blendedAt(st + step, rotate, contrast) - blendedAt(st, rotate, contrast))));
  }
  #assert(worst < 0.02, "the blend must be continuous");
}

unit_test "Hex tiling blends continuously" {
  checkContinuity(2.0, 0.0, 0.5);
  checkContinuity(2.0, 1.0, 0.5);
  checkContinuity(2.0, 1.0, 0.75);
  checkContinuity(200.0, 1.0, 0.75);
  checkContinuity(20000.0, 1.0, 0.75);
}

unit_test "Hex tiling blends generically" {
  // The blend must work for anything arithmetic, not only texture lookups.
  const auto w(float3(0.25, 0.25, 0.5));
  #assert(#abs(hextile::hex_blend(w, 1.0, 2.0, 3.0) - 2.25) < 1e-6, "scalar blend");
  #assert(#abs(hextile::hex_blend(w, float3(1.0), float3(2.0), float3(3.0)).y - 2.25) < 1e-6, "vector blend");
  #assert(#abs(hextile::hex_blend(w, color(1.0), color(2.0), color(3.0))[0] - 2.25) < 1e-6, "color blend");

  // With equal weights the variance-preserving blend scales the deviation from
  // the mean by sqrt(3), since sum(w * w) is 1/3.
  const auto u(float3(1.0 / 3.0));
  const auto vp(hextile::hex_blend_variance_preserving(u, 1.0, 1.0, 1.0, 0.0));
  #assert(#abs(vp - #sqrt(3.0)) < 1e-5, "variance-preserving blend must rescale by 1/sqrt(sum(w * w))");

  // A single tile carrying all the weight must be reproduced exactly, with or
  // without variance preservation.
  const auto one(float3(0.0, 1.0, 0.0));
  #assert(#abs(hextile::hex_blend(one, 1.0, 2.0, 3.0) - 2.0) < 1e-6, "degenerate blend");
  #assert(#abs(hextile::hex_blend_variance_preserving(one, 1.0, 2.0, 3.0, 0.5) - 2.0) < 1e-5, "variance preservation must be exact when one tile dominates");
}

unit_test "Hex tiling stochastic selection is unbiased" {
  // Choosing a tile with probability equal to its weight must reproduce the
  // weighted blend in expectation, which is what lets a Monte Carlo renderer
  // trade the three lookups for one.
  auto rng(noise::hash(12345));
  for (int trial = 0; trial < 8; trial++) {
    const auto st((noise::hash_float2(int2(trial * 977 + 3, trial * 613 + 11)) - 0.5) * 20.0);
    const auto tiling(hextile::hex_tiling_at(st, 1.0));
    const auto w(hextile::hex_contrast(hextile::hex_weights(tiling), 0.75));
    const auto reference(hextile::hex_blend(w,                                  //
                                            fakeTexture(tiling.tiles[0].coord), //
                                            fakeTexture(tiling.tiles[1].coord), //
                                            fakeTexture(tiling.tiles[2].coord)));
    auto sum(float3(0.0));
    const int n = 200000;
    for (int i = 0; i < n; i++) {
      rng = noise::hash(rng);
      sum += fakeTexture(tiling.tiles[hextile::hex_select(w, noise::hash_float(rng))].coord);
    }
    #assert(#max_value(#abs(sum / float(n) - reference)) < 5e-3, "stochastic selection must be unbiased");
  }

  // The selection must stay in range even for a degenerate weight vector.
  #assert(hextile::hex_select(float3(1.0, 0.0, 0.0), 0.0) == 0);
  #assert(hextile::hex_select(float3(0.0, 1.0, 0.0), 0.5) == 1);
  #assert(hextile::hex_select(float3(0.0, 0.0, 1.0), 0.999) == 2);
}

unit_test "Hex tiling variance preservation restores contrast" {
  // The plain blend must be under-dispersed relative to the source, and the
  // variance-preserving blend must recover essentially all of the shortfall.
  const auto mean(float3(0.5));
  double plainVar = 0.0d, preservedVar = 0.0d, sourceVar = 0.0d;
  const int n = 200000;
  for (int i = 0; i < n; i++) {
    const auto tiling(hextile::hex_tiling_at((noise::hash_float2(int2(i + 77, i * 7919 + 5)) - 0.5) * 60.0, 1.0));
    const auto w(hextile::hex_weights(tiling));
    const auto value0(fakeTexture(tiling.tiles[0].coord));
    const auto value1(fakeTexture(tiling.tiles[1].coord));
    const auto value2(fakeTexture(tiling.tiles[2].coord));
    const auto plain(hextile::hex_blend(w, value0, value1, value2));
    const auto preserved(hextile::hex_blend_variance_preserving(w, value0, value1, value2, mean));
    plainVar += double((plain.x - 0.5) * (plain.x - 0.5));
    preservedVar += double((preserved.x - 0.5) * (preserved.x - 0.5));
    sourceVar += double((value0.x - 0.5) * (value0.x - 0.5));
  }
  plainVar /= n, preservedVar /= n, sourceVar /= n;
  #assert(plainVar < 0.95d * sourceVar, "the plain blend must lose variance");
  #assert(preservedVar > 0.99d * sourceVar, "variance preservation must restore it");
}

unit_test "Hex tiling rotation round trips directional data" {
  for (int i = 0; i < 4096; i++) {
    const auto id(int2(i % 64 - 32, i / 64 - 32));
    const auto rotation(hextile::hex_rotation(id, 1.0));
    #assert(#abs(#sum(rotation * rotation) - 1.0) < 1e-5, "the rotation must be a unit complex number");
    // Rotating a direction forward and then inverting must be the identity.
    const auto d(noise::hash_float2(int2(i, i + 1)) - 0.5);
    const auto forward(float2(rotation.x * d.x - rotation.y * d.y, rotation.y * d.x + rotation.x * d.y));
    #assert(#max_value(#abs(hextile::hex_rotate_inverse(rotation, forward) - d)) < 1e-5, "hex_rotate_inverse must undo the tile rotation");
  }

  // Zero rotation strength must leave the tiling unrotated.
  #assert(#max_value(#abs(hextile::hex_rotation(int2(3, 5), 0.0) - float2(1.0, 0.0))) < 1e-6);
}

unit_test "Hex tiling seeds decorrelate independent tilings" {
  // The lattice is the same, but the per-tile offsets must not be.
  int same = 0;
  for (int i = 0; i < 4096; i++) {
    const auto st(samplePoint(i, 20.0));
    const auto a(hextile::hex_tiling_at(st, 0.0, 0));
    const auto b(hextile::hex_tiling_at(st, 0.0, 1));
    for (int k = 0; k < 3; k++) {
      #assert(#all(a.tiles[k].id == b.tiles[k].id), "the seed must not move the lattice");
      #assert(#abs(a.tiles[k].weight - b.tiles[k].weight) < 1e-6, "the seed must not move the weights");
      if (#max_value(#abs(a.tiles[k].coord - b.tiles[k].coord)) < 1e-4)
        same++;
    }
  }
  #assert(same < 16, "the seed must decorrelate the per-tile offsets");
}

// The texture-facing entry points, checked against a texture whose texels are
// known exactly. A hex tiled lookup of a constant texture must reproduce that
// constant however the weights fall out, which is the strongest statement that
// can be made without depending on the lattice.
void runTextureTests(const texture_2d t) {
  #assert(tex::texture_isvalid(t));
  for (int i = 0; i < 2048; i++) {
    const auto st(samplePoint(i, 20.0));
    const auto samples(hextile::hex_lookup(t, st));
    #assert(#all(samples.weights >= 0.0), "lookup weights must be non-negative");
    #assert(#abs(#sum(samples.weights) - 1.0) < 1e-4, "lookup weights must sum to one");

    // Every accessor must agree with the blend of the three samples.
    const auto blended(hextile::hex_blend(samples));
    #assert(#all(hextile::hex_blend(samples.weights, samples.values[0], samples.values[1], samples.values[2]) //
                 ~== |1e-6| blended), "hex_blend overloads must agree");

    // The stochastic selection must always return one of the three samples.
    const auto picked(hextile::hex_select(samples, noise::hash_float(i)));
    #assert(#all(picked ~== |1e-6| samples.values[0]) || #all(picked ~== |1e-6| samples.values[1]) || #all(picked ~== |1e-6| samples.values[2]), "hex_select must return a sampled value");

    // The single-lookup stochastic form must likewise land on a real texel,
    // and in particular must never blend.
    const auto stochastic(hextile::hex_lookup_float4_stochastic(t, st, noise::hash_float(i + 7)));
    #assert(#all(stochastic >= -1e-5) && #all(stochastic <= 1.0 + 1e-5), "stochastic lookup must stay in range");
  }

  // The convenience family must be consistent with 'hex_lookup_float4'.
  for (int i = 0; i < 256; i++) {
    const auto st(samplePoint(i, 20.0));
    const auto value(hextile::hex_lookup_float4(t, st));
    #assert(#all(hextile::hex_lookup_float3(t, st) ~== |1e-6| value.xyz), "hex_lookup_float3");
    #assert(#all(hextile::hex_lookup_float2(t, st) ~== |1e-6| value.xy), "hex_lookup_float2");
    #assert(hextile::hex_lookup_float(t, st) ~== |1e-6| value.x, "hex_lookup_float");
  }
}

unit_test "Hex tiling texture lookups" {
  runTextureTests(texture_2d("4x4.png", tex::gamma_linear));
  runTextureTests(texture_2d("4x4.exr", tex::gamma_linear));
}
