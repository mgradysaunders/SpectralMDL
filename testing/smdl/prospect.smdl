#smdl

import ::math::*;
using prospect = ::models::prospect;
import prospect::*;

// A moderately pigmented green leaf, used by every case below.
prospect::prospect_result leaf(const float xanthophyll_cycle) = prospect::prospect(
  num_layers: 1.5, incident_cone_angle: 0.7, dry_matter: 9.0, water: 0.015, chlorophylls: 40.0,
  anthocyanins: 0.0, carotenoids: 10.0, proteins: 0.0, carbons: 0.0, browns: 0.0,
  xanthophyll_cycle: xanthophyll_cycle);

unit_test "PROSPECT" {
  const auto violaxanthin = leaf(0.0);
  const auto middle = leaf(0.5);
  const auto zeaxanthin = leaf(1.0);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    const auto wavelength = $state.wavelength_base[i];
    #assert(violaxanthin.reflectance[i] + violaxanthin.transmittance[i] <= 1.0);
    #assert(zeaxanthin.reflectance[i] + zeaxanthin.transmittance[i] <= 1.0);
    // The two carotenoid end members are identical outside 504..560 nm, so the
    // cycle must not perturb anything beyond its window -- in particular none
    // of the near or short-wave infrared.
    if (wavelength < prospect::PROSPECT_CX_MIN_WAVELENGTH ||
        wavelength > prospect::PROSPECT_CX_MAX_WAVELENGTH) {
      #assert(violaxanthin.reflectance[i] == zeaxanthin.reflectance[i]);
      #assert(violaxanthin.transmittance[i] == zeaxanthin.transmittance[i]);
    }
    // Well inside the window, de-epoxidation absorbs strictly more, so
    // reflectance falls off monotonically as the cycle runs toward zeaxanthin.
    if (wavelength > 508.0 && wavelength < 556.0) {
      #assert(violaxanthin.reflectance[i] > middle.reflectance[i]);
      #assert(middle.reflectance[i] > zeaxanthin.reflectance[i]);
    }
  }

  // Leaving the cycle unset gives the relaxed, unstressed leaf.
  const auto defaulted = prospect::prospect(
    num_layers: 1.5, incident_cone_angle: 0.7, dry_matter: 9.0, water: 0.015, chlorophylls: 40.0,
    anthocyanins: 0.0, carotenoids: 10.0, proteins: 0.0, carbons: 0.0, browns: 0.0);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    #assert(defaulted.reflectance[i] == violaxanthin.reflectance[i]);
    #assert(defaulted.transmittance[i] == violaxanthin.transmittance[i]);
  }

  // The cycle is clamped to the range Vilfan et al. calibrate over.
  const auto below = leaf(-1.0);
  const auto above = leaf(3.0);
  const auto limit = leaf(1.5);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    #assert(below.reflectance[i] == violaxanthin.reflectance[i]);
    #assert(above.reflectance[i] == limit.reflectance[i]);
  }

  // Absolute reflectance against the canonical PROSPECT-PRO implementation.
  // The tolerance admits the polynomial and rational fits that `prospect` uses
  // in place of the exact transcendentals, which top out near 2e-3, but is far
  // tighter than the 2e-2 to 5e-2 error that failing to spread the constituent
  // contents over the layers would introduce. Only meaningful on the default
  // spectral state, whose samples land on the wavelengths tabulated here.
  if ($WAVELENGTH_BASE_MAX == 16 && math::abs($state.wavelength_base[0] - 380.0) < 1e-3 &&
      math::abs($state.wavelength_base[15] - 720.0) < 1e-3) {
    #assert(zeaxanthin.reflectance[6] ~== |5e-3| 0.080119);   // 516.00 nm
    #assert(zeaxanthin.reflectance[7] ~== |5e-3| 0.144626);   // 538.67 nm
    #assert(zeaxanthin.reflectance[10] ~== |5e-3| 0.074349);  // 606.67 nm
    #assert(zeaxanthin.reflectance[15] ~== |5e-3| 0.306544);  // 720.00 nm
    #assert(violaxanthin.reflectance[7] ~== |5e-3| 0.150577); // 538.67 nm
  }
}
