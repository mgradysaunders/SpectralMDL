#smdl

import ::df::*;
import ::math::*;

// Stability regression tests for the epsilon-free rewrites in `df.smdl`:
// the cancelled closed forms for the microfacet quantities, the sheen
// reciprocity factor, and the sampler CDF inversions. These deliberately
// probe the corners the main suite leaves untouched: low roughness,
// horizon-grazing directions, and distribution tails, where an additive
// epsilon in a denominator silently rescales the density instead of
// guarding it.

unit_test "Smith normal PDF at low roughness" {
  const auto ggx = df::microfacet::ggx();
  const auto beckmann = df::microfacet::beckmann();
  // Roughness 0.01, i.e., alpha = 1e-4: the peak density is exactly
  // `1/(pi ax ay)`. An absolute epsilon added to the `ax ay cos^4`
  // denominator caps this roughly 100x too low, darkening every
  // light-sampled highlight while BSDF sampling cancels the error.
  const float2 alpha = float2(1.0e-4);
  const float peak = 1 / ($PI * alpha.x * alpha.y);
  #assert(df::microfacet::smith_normal_pdf(ggx, alpha, float3(0, 0, 1)) ~== (1e-4) peak);
  #assert(df::microfacet::smith_normal_pdf(beckmann, alpha, float3(0, 0, 1)) ~== (1e-4) peak);
  // At full roughness the GGX distribution is uniform, `D = 1/pi`, all
  // the way to horizon-grazing normals, where slope-space evaluation
  // degrades or zeroes out.
  const auto wmGrazing = math::normalize(float3(1.0, 0.0, 1.0e-4));
  #assert(df::microfacet::smith_normal_pdf(ggx, float2(1.0), wmGrazing) ~== (1e-2) float(1 / $PI));
}

unit_test "Smith Lambda and projected area closed forms" {
  const auto ggx = df::microfacet::ggx();
  const auto beckmann = df::microfacet::beckmann();
  // The rationalized GGX Lambda reaches the correct one-sided limit at
  // `m = 0` (this assert also fails on NaN) and the correct vanishing
  // tail at large `m` even after `m * m` overflows.
  #assert(df::microfacet::smith_lambda(ggx, 0.0) > 1e30);
  #assert(#abs(df::microfacet::smith_lambda(ggx, 1.0e25)) < 1e-6);
  // The projected area agrees with `(1 + Lambda) cos(theta)` where the
  // Lambda form is well-conditioned...
  const float2 alpha = float2(0.25);
  const auto w60 = float3(0.8660254, 0.0, 0.5);
  #assert(df::microfacet::smith_projected_area(ggx, alpha, w60) ~== (1e-4)
          ((1 + df::microfacet::smith_lambda(ggx, w60.z / math::length(alpha * w60.xy))) * w60.z));
  #assert(df::microfacet::smith_projected_area(beckmann, alpha, w60) ~== (1e-4)
          ((1 + df::microfacet::smith_lambda(beckmann, w60.z / math::length(alpha * w60.xy))) * w60.z));
  // ...and reaches the finite grazing limits `|alpha w.xy| / 2` (GGX)
  // and `|alpha w.xy| / (2 sqrt(pi))` (Beckmann), where `(1 + Lambda)
  // cos(theta)` is the indeterminate `infinity times zero`.
  const auto wGrazing = math::normalize(float3(1.0, 0.0, 1.0e-7));
  #assert(df::microfacet::smith_projected_area(ggx, alpha, wGrazing) ~== (1e-3) 0.125);
  #assert(df::microfacet::smith_projected_area(beckmann, alpha, wGrazing) ~== (1e-3) float(0.25 * 0.5 / #sqrt($PI)));
}

struct EvaluateResult {
  color f = color(0);
  float2 pdf = float2(0);
  bool success = false;
};

EvaluateResult evaluate(
  const bsdf scattering,
  float3 wo,
  float3 wi,
  const bool isImportance = false,
  const float ior = 1.4,
) {
  auto mat = material(ior: ior, surface: material_surface(scattering: scattering));
  auto instance = _MaterialInstance(&mat);
  instance.flags |= isImportance ? 1 : 0; // MATERIAL_TRANSPORT_IMPORTANCE
  instance.exterior_ior = 1.0;
  float pdfFwd = 0;
  float pdfRev = 0;
  color f = color(0);
  if (df::_scatterEvaluate(&instance, &wo, &wi, df::DF_ALL, &pdfFwd, &pdfRev, cast<&float>(&f)))
    return EvaluateResult(f, float2(pdfFwd, pdfRev), true);
  else
    return EvaluateResult();
}

struct SampleResult {
  float3 wi = float3(0);
  color f = color(0);
  int sampledLobe = 0;
  bool success = false;

  /// The Dirac test the entry point used to report on its own.
  bool isDelta = (sampledLobe & df::DF_DELTA) != 0;
};

SampleResult sample(const bsdf scattering, const float4 xi, float3 wo) {
  auto mat = material(ior: 1.4, surface: material_surface(scattering: scattering));
  auto instance = _MaterialInstance(&mat);
  instance.exterior_ior = 1.0;
  float4 xi1 = xi;
  float3 wi = float3(0);
  float pdfFwd = 0;
  float pdfRev = 0;
  color f = color(0);
  int sampledLobe = 0;
  float lobeChanceOut = 1.0;
  const auto success = df::_scatterSample(&instance, &xi1, &wo, df::DF_ALL, &wi, &pdfFwd, &pdfRev, cast<&float>(&f), &sampledLobe, &lobeChanceOut);
  return SampleResult(wi, f, sampledLobe, bool(success));
}

// The bidirectional consistency checks of the main suite, with relative
// instead of absolute tolerances so they remain meaningful for the
// enormous-but-finite densities of near-specular configurations.
void checkBidirectionalConsistencyRel(const bsdf scattering, const float3 wo, const float3 wi) {
  const auto rad01 = evaluate(scattering, wo, wi, false);
  const auto rad10 = evaluate(scattering, wi, wo, false);
  const auto imp01 = evaluate(scattering, wo, wi, true);
  const auto imp10 = evaluate(scattering, wi, wo, true);
  #assert(#any(rad01.f > 0.0)); // Else the checks pass vacuously
  #assert(#all(rad01.pdf ~== (1e-4) rad10.pdf.yx));
  #assert(#all(imp01.pdf ~== (1e-4) imp10.pdf.yx));
  #assert(#all(imp01.f * #abs(wo.z) ~== (1e-4) rad10.f * #abs(wi.z)));
  #assert(#all(imp10.f * #abs(wi.z) ~== (1e-4) rad01.f * #abs(wo.z)));
}

unit_test "Microfacet at roughness 0.01" {
  // The incoming direction mirrors the outgoing, so the half vector is
  // exactly the normal and the evaluation must reproduce the analytic
  // peak `D / (4 cos(theta))` in both the value and the densities.
  const auto wo = math::normalize(float3(0.05, -0.03, 1.0));
  const auto wi = float3(-wo.x, -wo.y, wo.z);
  const float expected = 1 / ($PI * 1.0e-8) / (4 * wo.z);
  const auto rGGX = evaluate(df::microfacet_ggx_smith_bsdf(roughness_u: 0.01, tint: 1.0), wo, wi);
  #assert(math::average(rGGX.f) ~== (1e-2) expected);
  #assert(rGGX.pdf[0] ~== (1e-2) expected);
  #assert(rGGX.pdf[1] ~== (1e-2) expected);
  const auto rBeckmann = evaluate(df::microfacet_beckmann_smith_bsdf(roughness_u: 0.01, tint: 1.0), wo, wi);
  #assert(math::average(rBeckmann.f) ~== (1e-2) expected);
  #assert(rBeckmann.pdf[0] ~== (1e-2) expected);
  checkBidirectionalConsistencyRel(df::microfacet_ggx_smith_bsdf(roughness_u: 0.01, tint: 1.0), wo, wi);
  checkBidirectionalConsistencyRel(df::microfacet_beckmann_smith_bsdf(roughness_u: 0.01, tint: 1.0), wo, wi);
  // Transmission through the matching refraction configuration, whose
  // half vector is also exactly the normal, exercises the projected-area
  // PDF denominators end to end.
  const auto wt = df::specular::refract(wo, float3(0, 0, 1), 1 / 1.4);
  checkBidirectionalConsistencyRel(df::microfacet_ggx_smith_bsdf(roughness_u: 0.02, tint: 1.0, mode: df::scatter_transmit), wo, wt);
}

unit_test "Low-roughness sample round trip" {
  const auto scattering = df::microfacet_ggx_smith_bsdf(roughness_u: 0.01, tint: 1.0);
  const auto wo = math::normalize(float3(0.1, 0.2, 1.0));
  const auto s = sample(scattering, float4(0.25, 0.05, 0.9, 0.5), wo);
  #assert(s.success & !s.isDelta);
  const auto r = evaluate(scattering, wo, s.wi);
  // The reported density of a near-specular sample is genuinely huge;
  // an absolute epsilon in the denominator caps it orders of magnitude
  // too low, which silently breaks multiple importance sampling.
  #assert(r.pdf[0] > 1.0e6);
  // The bounded-VNDF throughput weight never exceeds unity.
  #assert(math::average(r.f) / r.pdf[0] < 1.001);
}

unit_test "Grazing reciprocity" {
  const auto woGrazing = math::normalize(float3(1.0, 0.4, 2.0e-3));
  const auto wi = math::normalize(float3(-0.3, 0.2, 0.8));
  checkBidirectionalConsistencyRel(df::microfacet_ggx_smith_bsdf(roughness_u: 0.3, tint: 1.0), woGrazing, wi);
  checkBidirectionalConsistencyRel(df::microfacet_beckmann_smith_bsdf(roughness_u: 0.4, tint: 1.0), woGrazing, wi);
  checkBidirectionalConsistencyRel(df::sheen_bsdf(tint: 1.0, roughness: 0.4), woGrazing, wi);
  checkBidirectionalConsistencyRel(df::diffuse_reflection_bsdf(tint: 0.8, roughness: 0.7), woGrazing, wi);
  checkBidirectionalConsistencyRel(df::ward_geisler_moroder_bsdf(roughness_u: 0.4, roughness_v: 0.7, tint: 1.0), woGrazing, wi);
}

unit_test "Horizon culls zero value and densities together" {
  const auto wiUp = math::normalize(float3(-0.3, 0.2, 0.8));
  // The Ward NaN band: a double-grazing retro configuration whose
  // half-vector height underflows `h.z^4` to zero, turning the Gaussian
  // times the reciprocal into `0 * inf = NaN` in both the value and the
  // densities before the cull existed.
  const auto woNaN = math::normalize(float3(1.0, 0.0, 1.0e-12));
  const auto wiNaN = math::normalize(float3(-1.0, 1.0e-4, 1.0e-12));
  #assert(!evaluate(df::ward_geisler_moroder_bsdf(roughness_u: 0.4, tint: 1.0), woNaN, wiNaN).success);
  // Grazing directions cull across the elemental and layering lobes.
  const auto woGraze = math::normalize(float3(1.0, 0.0, 1.0e-7));
  #assert(!evaluate(df::microfacet_ggx_smith_bsdf(roughness_u: 0.3, tint: 1.0), woGraze, wiUp).success);
  #assert(!evaluate(df::diffuse_reflection_bsdf(tint: 0.8, roughness: 0.5), woGraze, wiUp).success);
  #assert(!evaluate(df::ward_geisler_moroder_bsdf(roughness_u: 0.4, tint: 1.0), woGraze, wiUp).success);
  #assert(!evaluate(df::micrograin_layer(filling_factor: 0.3, grain_diffuse_albedo: 0.4,
                                         base: df::diffuse_reflection_bsdf(tint: 0.5)),
                    woGraze, wiUp).success);
  // Just above the threshold everything is alive and finite.
  const auto woLive = math::normalize(float3(1.0, 0.0, 1.0e-3));
  const auto rLive = evaluate(df::microfacet_ggx_smith_bsdf(roughness_u: 0.3, tint: 1.0), woLive, wiUp);
  #assert(rLive.success & #any(rLive.f > 0.0));
  const auto rGrain = evaluate(df::micrograin_layer(filling_factor: 0.3, grain_diffuse_albedo: 0.4,
                                                    base: df::diffuse_reflection_bsdf(tint: 0.5)),
                               math::normalize(float3(0.3, -0.2, 0.9)), wiUp);
  #assert(rGrain.success & #any(rGrain.f > 0.0) & (rGrain.pdf[0] > 0.0));
}

unit_test "Thin film amplification is capped" {
  // A film on a nearly index-matched substrate: the coated-to-uncoated
  // reflectance ratio diverges as the base contrast vanishes, which on a
  // base BSDF without a matching Fresnel factor multiplies `f` without
  // any compensating density. The factor must saturate at the documented
  // maximum instead: constructive-interference wavelengths hit the cap
  // exactly, and nothing exceeds it.
  const auto wo = math::normalize(float3(0.2, 0.1, 0.9));
  const auto wi = math::normalize(float3(-0.3, 0.2, 0.8));
  const auto rBase = evaluate(df::diffuse_reflection_bsdf(tint: 1.0), wo, wi, false, 1.01);
  const auto rFilm = evaluate(df::thin_film(thickness: 300.0, ior: 1.8,
                                            base: df::diffuse_reflection_bsdf(tint: 1.0)),
                              wo, wi, false, 1.01);
  #assert(rBase.success & rFilm.success);
  const auto ratio = rFilm.f / rBase.f;
  #assert(#maxValue(ratio) < 100.001);
  #assert(#maxValue(ratio) > 99.0);
}

unit_test "Mixer black contract" {
  // A mixture whose components all have zero weight and zero chance must
  // report `isBlack`: a live result with `f = 0` and `pdf = 0` invites
  // `0/0` in the renderer's throughput division.
  const auto wo = math::normalize(float3(0.2, -0.1, 0.9));
  const auto wi = math::normalize(float3(-0.3, 0.2, 0.8));
  const auto mix = df::normalized_mix(df::bsdf_component[](
    df::bsdf_component(0.0, df::diffuse_reflection_bsdf(tint: 0.8)),
    df::bsdf_component(0.0, df::sheen_bsdf(tint: 0.8, roughness: 0.4)),
  ));
  #assert(!evaluate(mix, wo, wi).success);
  // A live component keeps the mixture live.
  const auto mixLive = df::normalized_mix(df::bsdf_component[](
    df::bsdf_component(0.0, df::diffuse_reflection_bsdf(tint: 0.8)),
    df::bsdf_component(0.5, df::sheen_bsdf(tint: 0.8, roughness: 0.4)),
  ));
  const auto rLive = evaluate(mixLive, wo, wi);
  #assert(rLive.success & #any(rLive.f > 0.0));
}

unit_test "Blinn exponent is exact below the cap" {
  // The Blinn exponent is `2 / alpha^2` capped at the documented maximum
  // rather than damped with an additive epsilon (which perturbed every
  // exponent below roughness ~0.03 by up to 2x). At the mirror
  // configuration the half vector is exactly the normal, so the value
  // and densities have simple closed forms.
  const auto wo = math::normalize(float3(0.05, -0.03, 1.0));
  const auto wi = float3(-wo.x, -wo.y, wo.z);
  const float e = 2 / #pow(0.05, 4);
  const auto r = evaluate(df::simple_glossy_bsdf(roughness_u: 0.05, tint: 1.0), wo, wi);
  #assert(math::average(r.f) ~== (1e-2) float((2 + e) / (2 * $PI) / (4 * wo.z)));
  #assert(r.pdf[0] ~== (1e-2) float((1 + e) / (2 * $PI) / (4 * wo.z)));
}

unit_test "Clamped Fresnel selection keeps densities live at TIR" {
  // Dense-side transmission just past the critical angle: the macro
  // Fresnel term saturates at 1, so unclamped PDF weights would report
  // zero density for a transmit direction whose microfacet refraction is
  // perfectly feasible, breaking MIS. The clamped chance keeps the
  // reported density positive and the throughput ratio bounded.
  const auto woIn = math::normalize(float3(-0.866, -0.1, 0.5));
  const auto wm = math::normalize(float3(-0.342, 0.0, 0.94));
  const auto wt = df::specular::refract(woIn, wm, 1.4);
  #assert(wt.z < 0.0); // The tilted microfacet refracts despite macro TIR
  const auto r = evaluate(df::microfacet_ggx_smith_bsdf(roughness_u: 0.3, tint: 1.0, mode: df::scatter_reflect_transmit), -woIn, -wt);
  #assert(r.success & #any(r.f > 0.0));
  #assert(r.pdf[0] > 0.0);
  #assert(math::average(r.f) < 300.0 * r.pdf[0]);
}

unit_test "Mixer delta selection compensation" {
  // A delta component selected with chance `c` must divide its folded
  // weight by `c`, exactly as the layer combinators do; otherwise the
  // mixture loses delta energy in proportion to the selection chance.
  const auto wo = math::normalize(float3(0.2, 0.1, 0.9));
  const auto mix = df::normalized_mix(df::bsdf_component[](
    df::bsdf_component(0.5, df::specular_bsdf(tint: 1.0)),
    df::bsdf_component(0.5, df::diffuse_reflection_bsdf(tint: 1.0)),
  ));
  const auto s = sample(mix, float4(0.1, 0.2, 0.25, 0.7), wo);
  #assert(s.success & s.isDelta);
  #assert(#all(s.f ~== (1e-5) color(1.0)));
}

unit_test "Layer weights saturate to the specified range" {
  // The specification restricts layer weights and reflectivities to
  // [0,1]; values beyond the range must clamp rather than push the
  // lerped values and densities out of range (or negative).
  const auto wo = math::normalize(float3(0.2, 0.1, 0.9));
  const auto wi = math::normalize(float3(-0.3, 0.2, 0.8));
  const auto base = df::diffuse_reflection_bsdf(tint: 0.5);
  const auto layer = df::sheen_bsdf(tint: 1.0, roughness: 0.4);
  const auto r1 = evaluate(df::custom_curve_layer(normal_reflectivity: 1.0, weight: 1.0, layer: layer, base: base), wo, wi);
  const auto r2 = evaluate(df::custom_curve_layer(normal_reflectivity: 3.0, weight: 2.0, layer: layer, base: base), wo, wi);
  #assert(#all(r1.f ~== (1e-5) r2.f));
  #assert(#all(r1.pdf ~== (1e-5) r2.pdf));
}

unit_test "Sampler pole exactness" {
  // Blinn normal sampling at the pole must return exactly the normal:
  // an epsilon inside the square root tilts every sample by up to a
  // milliradian, which is wider than the lobe itself at low roughness.
  const auto wmBlinn = df::microfacet::blinn_normal_sample(0.3, 1.0, float2(2.0e6));
  #assert(math::length(wmBlinn.xy) < 1e-4);
  #assert(#all(math::isfinite(wmBlinn)));
  // Micrograin normal sampling: `xi0 = 0` maps exactly to the pole...
  const auto wmGrain0 = df::micrograin::normal_sample(0.5, float2(1.0), 0.0, 0.3);
  #assert(wmGrain0.z ~== |1e-6| 1.0);
  // ...and the `xi0 -> 1` tail runs gracefully onto the horizon instead
  // of being bent inward by an epsilon that the density reported by
  // `normal_pdf` knows nothing about.
  const auto wmGrain1 = df::micrograin::normal_sample(0.5, float2(1.0), 0.99999994, 0.3);
  #assert(#all(math::isfinite(wmGrain1)) & (wmGrain1.z >= 0.0));
  const auto wmGrain2 = df::micrograin::normal_sample(0.5, float2(1.0), 1.0, 0.3);
  #assert(#all(math::isfinite(wmGrain2)));
}
