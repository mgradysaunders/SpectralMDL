mdl 1.9;

import ::anno::*;
import ::df::*;
// A module or package name in single quotes is a unicode identifier, which
// is how a name that is not an identifier is written, with the escapes of
// a literal string. Any name may be written so: these are `one.mdl`.
import .::'one'::*;
using .::'\u006fne' import shadowed;
using ::std import max;

/* Block comments nest, /* so this one closes here */ and the outer one
   goes on to its own close, and a // inside one starts nothing. */

// A conformant module: no `#smdl` marker, so none of the dialect is
// available here and the parser holds this file to the specification.
// `modules.mdl` imports it to prove the conformant path still resolves.
export const int conformantAnswer = 42;

// A floating point literal may begin with its decimal point.
export const float conformantHalf = .5;

// A material, so that the conformant path compiles everything a material
// compiles into, the entry points the compiler generates on its own among
// them. None of those may depend on the dialect, which the module that
// declares the material does not have.
export material conformantMaterial() = material(
  surface: material_surface(
    scattering: df::diffuse_reflection_bsdf(tint: color(0.5))));

// A struct whose fields have no initializers. The specification default
// constructs such a field when its argument is omitted, which the dialect
// does not: there the argument is required, which is how a distribution
// requires its parameters. The rule follows the module that declares the
// struct, so this one constructs from nothing anywhere.
export struct ConformantPoint {
  float x;
  int n;
  color c;
};

export ConformantPoint conformantOrigin() = ConformantPoint();

export int conformantDeclaredN() {
  ConformantPoint p;
  return p.n;
}

// An index past either end of an array reads the element type default
// constructed, and a write there goes nowhere, as MDL 1.8 has it. Only a
// compile-time index can be rejected where it compiles, so these take the
// index as a parameter. The struct has an initializer to tell its default
// from zero.
export struct ConformantDefaulted {
  int n = 7;
};

export int conformantAt(int i) {
  int[3] a(1, 2, 3);
  return a[i];
}

export int conformantSumAfterWrite(int i) {
  int[2] a;
  a[i] = 5;
  return a[0] + a[1];
}

export int conformantDefaultedAt(int i) {
  ConformantDefaulted[2] a(
    ConformantDefaulted(n: 1), ConformantDefaulted(n: 2));
  return a[i].n;
}

export float conformantComponent(int i) {
  float3 v(1.0, 2.0, 3.0);
  return v[i];
}

// Overload resolution as the specification has it. An `int` argument
// converts to `float` and to `double` alike, and `float` is the more
// specific, since it converts to `double`. A signature whose parameter
// types begin another's is the more specific of the two (MDL 1.9).
export int conformantWidened(float x [[anno::unused()]]) = 2;
export int conformantWidened(double x [[anno::unused()]]) = 3;

export int conformantPrefixed(int a [[anno::unused()]]) = 1;
export int conformantPrefixed(
  int a [[anno::unused()]], int b = 0 [[anno::unused()]]) = 2;

// A function declared ahead of its definition, with the default
// initializers on the declaration, and called in between.
export float conformantSum(float x, float y = 2.0);

export float conformantSumOfOne(float x) = conformantSum(x);

export float conformantSum(float x, float y) {
  return x + y;
}

// A cast converts a struct to another of as many fields, each of which
// casts to the field in the same position, whatever the fields are named:
// the specification's example, and the same with the pair nested beside an
// enum, which casts to another enum of the same values.
export struct ConformantColorPair {
  color dark;
  color bright;
};

export struct ConformantTwoColors {
  color c1;
  color c2;
};

export enum ConformantSide { conformant_front, conformant_back };

export enum ConformantFace { conformant_outside, conformant_inside };

export struct ConformantSidedPair {
  ConformantColorPair colors;
  ConformantSide side;
};

export struct ConformantFacedPair {
  ConformantTwoColors colors;
  ConformantFace face;
};

export ConformantTwoColors conformantRecolored(ConformantColorPair pair) =
  cast<ConformantTwoColors>(pair);

export ConformantFacedPair conformantFaced(ConformantSidedPair pair) =
  cast<ConformantFacedPair>(pair);

export ConformantTwoColors[2] conformantRecoloredAll(
  ConformantColorPair[2] pairs) = cast<ConformantTwoColors[2]>(pairs);

// A size-deferred parameter may name the size an earlier one declares,
// without the angle brackets, so that the two arrays are of one size, and
// so may the return type. Of the specification's two overloads, the one
// that binds both sizes to one name accepts less, so it is the more
// specific where both arrays are of one size.
export float conformantInnerProduct(
  float[<n>] a [[anno::unused()]], float[<m>] b [[anno::unused()]]) = -1.0;

export float conformantInnerProduct(float[<n>] a, float[n] b) {
  float result = 0.0;
  for (int i = 0; i < n; ++i)
    result += a[i] * b[i];
  return result;
}

export int[n] conformantDoubled(int[<n>] a) {
  int[n] result;
  for (int i = 0; i < n; ++i)
    result[i] = 2 * a[i];
  return result;
}

// An operator may be called as a function, with the arguments by position
// or by name: `x` and `y`, but `a` and `i` for `[]` and `cond`,
// `true_exp`, and `false_exp` for `?`.
export int conformantDifference(int x, int y) = operator-(y: y, x: x);

export int conformantNegated(int x) = operator-(x);

export int conformantElement(int[3] a, int i) = operator[](i: i, a: a);

export float conformantChosen(bool cond) =
  operator?(cond, false_exp: 2.0, true_exp: 1.0);

export bool conformantBoth(bool x, bool y) = operator&&(x, y);

export int conformantShiftedRight(int x) = operator>>>(x, 28);

// A name reached through a unicode identifier, and one it imported.
export int conformantQuotedOne() = 'one'::shadowed;

export int conformantUsedOne() = shadowed;

// A module adds overloads to a function it imports unqualified, as the
// specification's example adds `max(int, float)` to those of `::std`, and
// one with the parameter types of an imported overload hides it.
float max(int a, float b) = 10.0 + float(a) + b;

double max(double a, double b) = a + b - 10.0d;

export float conformantMaxLocal() = max(1, 2.0f);

export int conformantMaxImported() = max(1, 2);

export double conformantMaxHiding() = max(1.0d, 2.0d);
