/// An exported overload set for `extending.mdl` to add to and for
/// `modules.mdl` to reach by its qualified name. The union parameter type
/// is what makes the test decisive: `int` converts implicitly to
/// `(int | float)` but not the other way, so a privately declared
/// `overloadTarget(int)` leaking into this set would deterministically win
/// resolution for an integer argument instead of tying or being rejected.
#smdl

@(pure)
export int overloadTarget((int | float) v [[anno::unused()]]) = 1;

// A function for `extending.mdl` to vary under its own name.
@(pure)
export int scaledTarget(int x, int k = 1) = x * k;
