/// The module system: how a name gets from one file to another, and what
/// `export` does and does not gate.
///
/// A module is a file. Its qualified name comes from its path relative to
/// the search root the compiler was given, so `lang/packages/one.mdl`
/// under this suite's root is `::lang::packages::one`. A leading `.::`
/// spells a path relative to the importing module's own package and `..::`
/// one level up, exactly as `.` and `..` do in a filesystem path.
///
/// There are two ways to bring a module in, and they are not the same:
///
/// - `import X::*;` makes the module's exported names reachable *through
///   the qualifier* `X::`. The C++ analogue is a namespace alias: the
///   names are available but you still say where they came from.
/// - `using X import *;` opens the module, so its names resolve
///   unqualified as well. This is `using namespace X;`.
///
/// The rest of the suite uses the first form on purpose, so that every call
/// site says which module it reached into.
#smdl

// A module alias. The quoted form resolves like a one-component import,
// against the importing module's own directory first, which is why
// `sibling.mdl` sits beside this file rather than under `packages/`.
using quoted = "sibling";
using reexported = .::packages::nested::reexport;

import quoted::*;
import reexported::*;
import .::packages::one::*;
import .::packages::overloads::*;
// Importing `shadowing` guarantees it compiles before the tests below are
// emitted: its private `overloadTarget(int)` declaration is exactly what
// the cross-module leak test needs to have happened already.
import .::packages::shadowing::*;
import .::packages::conformant::*;

// A universal using-import, which opens the module for unqualified lookup.
// The second one is three components deep, which the lookup has to carry.
using .::packages::two import *;
using .::packages::nested::reexport import *;
using .::packages::namespaces import *;

unit_test "A module alias reaches its module through the alias" {
  #assert(quoted::message == "Hello, world!");
  #assert(reexported::message == "Hellope");
}

unit_test "A universal using-import does not hijack qualified names" {
  // Each module keeps its own `shadowed`, whatever else is opened.
  #assert(packages::one::shadowed == 1);
  #assert(packages::two::shadowed == 2);
  // Unqualified lookup legitimately resolves through the using-import.
  #assert(shadowed == 2);
}

unit_test "A universal using-import works at any path depth" {
  // The opened module is three components deep, and the name it exports
  // arrived there from one level further up through a re-export, so this
  // reads a name two modules away from where it was declared.
  #assert(message == "Hellope");
  #assert(reexported::message == "Hellope");
}

unit_test "A private overload does not leak across modules" {
  // `packages/shadowing.mdl` declares a private `overloadTarget(int)`
  // over the name it imports from here. That declaration must not join
  // this overload set: `int` converts implicitly to `(int | float)` but not
  // the other way, so a leaked overload would deterministically win both
  // calls below and return 2.
  #assert(packages::overloads::overloadTarget(5) == 1);
  #assert(packages::overloads::overloadTarget(1.5) == 1);
}

// `export` gates access to a namespace member across module boundaries
// only. Within the declaring module, qualified access works without it.
namespace local {

const int hidden = 5;

export const int shown = 6;

namespace inner {

const int deep = 7;

} // namespace inner

} // namespace local

unit_test "export gates a namespace member across modules, not within one" {
  #assert(local::shown == 6);
  #assert(local::hidden == 5);
  #assert(local::inner::deep == 7);
  // From another module, only the exported member is reachable.
  #assert(shielded::visible == 1);
}

unit_test "A conformant module resolves like any other" {
  // `packages/conformant.mdl` declares `mdl 1.9;` and has no `#smdl`
  // marker, so none of the dialect is available inside it. Nothing about
  // importing it differs.
  #assert(packages::conformant::conformantAnswer == 42);
  #assert(packages::conformant::conformantHalf == 0.5);
}

unit_test "A conformant struct constructs the fields it gives no initializer" {
  // See `packages/conformant.mdl`: what the specification asks of a field
  // with no initializer holds for the struct declared there, whoever
  // constructs it, including a declaration with no initializer of its own.
  const auto p = packages::conformant::conformantOrigin();
  #assert(p.x == 0.0 && p.n == 0 && #all(p.c == color(0.0)));
  #assert(packages::conformant::ConformantPoint().n == 0);
  #assert(packages::conformant::conformantDeclaredN() == 0);
}

unit_test "A conformant index out of bounds reads the default and writes nowhere" {
  // See `packages/conformant.mdl`. The check is the specification's, so it
  // is made where the index is written in a conformant module; an index in
  // the dialect is unchecked, as in C.
  #assert(packages::conformant::conformantAt(1) == 2);
  #assert(packages::conformant::conformantAt(3) == 0);
  #assert(packages::conformant::conformantAt(-1) == 0);
  #assert(packages::conformant::conformantSumAfterWrite(1) == 5);
  #assert(packages::conformant::conformantSumAfterWrite(2) == 0);
  #assert(packages::conformant::conformantSumAfterWrite(-1) == 0);
  #assert(packages::conformant::conformantDefaultedAt(1) == 2);
  #assert(packages::conformant::conformantDefaultedAt(2) == 7);
  #assert(packages::conformant::conformantComponent(2) == 3.0);
  #assert(packages::conformant::conformantComponent(3) == 0.0);
}

unit_test "A conformant overload set resolves as the specification has it" {
  #assert(packages::conformant::conformantWidened(1) == 2);
  #assert(packages::conformant::conformantWidened(1.0f) == 2);
  #assert(packages::conformant::conformantWidened(1.0d) == 3);
  #assert(packages::conformant::conformantPrefixed(1) == 1);
  #assert(packages::conformant::conformantPrefixed(1, 2) == 2);
  // Declared ahead of its definition, with the defaults on the declaration.
  #assert(packages::conformant::conformantSumOfOne(1.0) == 3.0);
  #assert(packages::conformant::conformantSum(1.0) == 3.0);
  #assert(packages::conformant::conformantSum(1.0, y: 5.0) == 6.0);
}

unit_test "A conformant struct casts to another whose fields cast in order" {
  const auto colors = packages::conformant::conformantRecolored(
    packages::conformant::ConformantColorPair(color(0.1), color(0.2)));
  #assert(#all(colors.c1 == color(0.1)) && #all(colors.c2 == color(0.2)));
  const auto faced = packages::conformant::conformantFaced(
    packages::conformant::ConformantSidedPair(
      packages::conformant::ConformantColorPair(color(0.3), color(0.4)),
      packages::conformant::conformant_back));
  #assert(#all(faced.colors.c2 == color(0.4)));
  #assert(faced.face == packages::conformant::conformant_inside);
  const auto recolored = packages::conformant::conformantRecoloredAll(
    packages::conformant::ConformantColorPair[2](
      packages::conformant::ConformantColorPair(color(0.5), color(0.6)),
      packages::conformant::ConformantColorPair(color(0.7), color(0.8))));
  #assert(#all(recolored[1].c2 == color(0.8)));
}

unit_test "A conformant size-deferred parameter reuses the size of another" {
  // The overload that binds both sizes to `n` takes arrays of one size,
  // and the other takes the rest.
  const float[2] a(1.0, 2.0);
  const float[2] b(3.0, 4.0);
  const float[3] c(3.0, 4.0, 5.0);
  #assert(packages::conformant::conformantInnerProduct(a, b) == 11.0);
  #assert(packages::conformant::conformantInnerProduct(a, c) == -1.0);
  const auto doubled = packages::conformant::conformantDoubled(int[3](1, 2, 3));
  #assert(#typeOf(doubled) == int[3]);
  #assert(doubled[2] == 6);
}

unit_test "A conformant operator is called as a function" {
  #assert(packages::conformant::conformantDifference(5, 3) == 2);
  #assert(packages::conformant::conformantNegated(5) == -5);
  #assert(packages::conformant::conformantElement(int[3](4, 5, 6), 2) == 6);
  #assert(packages::conformant::conformantChosen(true) == 1.0);
  #assert(packages::conformant::conformantChosen(false) == 2.0);
  #assert(packages::conformant::conformantBoth(true, true));
  #assert(!packages::conformant::conformantBoth(true, false));
  // The shift is logical, so the sign bit comes down as a one.
  #assert(packages::conformant::conformantShiftedRight(-1) == 15);
}

unit_test "A conformant module names another in single quotes" {
  #assert(packages::conformant::conformantQuotedOne() == 1);
  #assert(packages::conformant::conformantUsedOne() == 1);
  // A qualified name may quote its module names too.
  #assert(packages::'conformant'::conformantAnswer == 42);
  #assert('\u0070ackages'::conformant::conformantAnswer == 42);
}
