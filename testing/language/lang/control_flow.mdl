/// Statements, and the scopes they open.
///
/// Most of this is unsurprising, and the tests here say so rather than
/// leaving it unsaid: `do`-`while` tests its condition after the body, a
/// `for` with an empty condition loops, a `switch` case constant converts
/// to the switched-on type.
///
/// Three things are worth knowing before reading. `defer` registers work to
/// run when the enclosing scope exits, by any path, and each `switch` case
/// is a scope of its own, so a case-local `defer` runs on fallthrough.
/// `return_from { ... }` is an expression whose value a `return` inside it
/// supplies, which is how a loop can produce a value. And a `:=` binding
/// introduced in a condition outlives the statement, while one introduced
/// inside an arm does not -- a value that cannot dominate the merge cannot
/// escape to it.
#smdl

using probe = ::support::probe;
import probe::*;

// A redeclaration in the same scope is a compile error, verified out of
// tree since an error aborts the suite. Shadowing in a nested scope is
// legal, and guarded here.
const int moduleValue = 10;

// A `do`-`while` runs its body once before it ever tests the condition,
// which is the only loop in the language that does.
unit_test "A do-while body runs before its condition" {
  int i = 0;
  do {
    i++;
  } while (i < 3);
  #assert(i == 3);
  // Loop body must run at least once even if the condition is false.
  int j = 0;
  do {
    j++;
  } while (false);
  #assert(j == 1);
}

// A 'for' may leave its condition out entirely, in which case the loop
// runs until the body leaves it: there is no condition expression to read,
// and the emitter has to supply the always-true one itself.
unit_test "A for with an empty condition loops" {
  int j = 0;
  for (int n = 0; ; n++) {
    j++;
    if (n >= 4)
      break;
  }
  #assert(j == 5);
}

// A 'defer' may contain control flow of its own, so the block a 'return'
// value arrives from is the block the unwind ends in, not the one the
// 'return' started in.
int deferWithBranch(bool b) {
  int x = 1;
  defer {
    if (b) {
      x = 2;
    }
  }
  return x;
}

unit_test "A defer containing control flow still runs on return" {
  #assert(deferWithBranch(true) == 1);
  #assert(deferWithBranch(false) == 1);
}

// A case constant is converted to the type of the switched-on value, so a
// `bool` constant may label a case of an `int` switch.
unit_test "A switch case constant converts to the switch type" {
  int k = 0;
  switch (1) {
  case true:
    k = 7;
    break;
  default: k = 9;
  }
  #assert(k == 7);
}

unit_test "return_from is an expression a loop can leave" {
  auto result = return_from {
    int sum = 0;
    for (int i = 0; i < 10; i++) {
      sum += 3 * i + 1;
      return sum if (sum > 20);
    }
    return -17;
  };
  #assert(result == 22);
}

unit_test "Temporary let bindings leak from conditions, not arms" {
  // If-condition binding leaks into the branch and past the statement.
  if (x := probe::opaque(7)) {
    #assert(x == 7);
  }
  #assert(x == 7);
  // Ternary-condition bindings reach both arms, comptime and runtime alike.
  auto r0 = (y := 2) > 1 ? y : -y;
  #assert(r0 == 2);
  auto r1 = (z := probe::opaque(2)) > 1 ? z : -z;
  #assert(r1 == 2);
  // Argument bindings reach later operands of the same statement.
  auto s = probe::opaque(w := probe::opaque(4)) + w;
  #assert(s == 8);
}

unit_test "Shadowing is legal in nested scopes" {
  int x = 1;
  {
    int x = 2;
    #assert(x == 2);
  }
  #assert(x == 1);
  // The for-init statement opens its own scope.
  int i = 5;
  for (int i = 0; i < 3; i++) {
  }
  #assert(i == 5);
  // 'let' declarations open their own scope.
  auto v = let {
    int x = 3;
  } in x * x;
  #assert(v == 9);
  // Function-body scope may shadow module scope.
  int moduleValue = 20;
  #assert(moduleValue == 20);
}

// each switch case is its own scope. The dispatch may jump directly
// to any case, past the declarations of the cases before it, so a
// declaration is not visible beyond its own case, not even on fallthrough
// (jump-past-initialization is a compile error). Falling through unwinds
// the case scope like any other scope exit.
unit_test "Switch cases are separate scopes" {
  // The same name may be declared in different cases.
  int r = 0;
  switch (probe::opaque(2)) {
  case 1: {
    int v = 10;
    r = v;
    break;
  }
  case 2:
    int v = 20;
    r = v;
    break;
  }
  #assert(r == 20);
  // Fallthrough control flow still works.
  int n = 0;
  switch (probe::opaque(1)) {
  case 1: n += 1;
  case 2:
    n += 2;
    break;
  default: n += 100;
  }
  #assert(n == 3);
  // A case-local defer runs when the case falls through (scope exit).
  int count = 0;
  &int p = &count;
  switch (probe::opaque(1)) {
  case 1:
    defer *p += 10;
    #assert(count == 0);
  case 2:
    #assert(count == 10);
    break;
  }
  #assert(count == 10);
}
