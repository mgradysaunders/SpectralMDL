/// Lambdas: `\(parameters) = expression`, or `\(parameters) { ... }` for a
/// body with statements in it.
///
/// A lambda is a compile-time value, not a run-time one. There is no
/// closure object and nothing is ever allocated: the lambda is a handle the
/// compiler carries, and calling it expands its body at the call site. Two
/// consequences run through everything below.
///
/// First, a lambda can only travel through places a compile-time value can
/// go: a `const` binding, or a parameter of an `@(macro)` function, which
/// is why every helper here is a macro. A non-macro function taking `const
/// auto f` would have to expand a caller-capturing body inside its own
/// frame, and the compiler refuses.
///
/// Second, capture is by aliasing rather than by value. The C++ analogue is
/// `[&]`, except that the aliasing is not a reference the lambda holds but
/// the same variable, seen from inside an expansion that happens where the
/// variable lives. So a lambda reads later writes, and can write back.
#smdl

@(pure macro)
float apply(const auto f, const float x) = f(x);

@(pure macro)
float apply_twice(const auto f, const float x) = f(f(x));

@(pure macro)
auto apply_any(const auto f, const auto x) = f(x);

// Binding one at module scope, where a run-time value could not go.
const auto SQ = \(const float x) = x * x;

unit_test "A lambda may be bound at module scope" {
  #assert(SQ(3.0) == 9.0);
  #assert(apply(SQ, 4.0) == 16.0);
  #assert(apply_twice(SQ, 2.0) == 16.0);
}

unit_test "A lambda literal may be an argument" {
  #assert(apply(\(const float x) = x + 1.0, 2.0) == 3.0);
}

// Parameters may be generic and defaulted; the return type is always
// implicitly `auto`, inferred per expansion.
unit_test "A lambda takes generic and defaulted parameters" {
  const auto scale = \(const auto a, const auto b = 1.0) = a * b;
  #assert(apply_any(scale, 3.0) == 3.0);
  const auto twice = \(const auto a) = 2 * a;
  #assert(apply_any(twice, 3) == 6);
  #assert(#all(apply_any(twice, float3(1.0, 2.0, 3.0)) == float3(2.0, 4.0, 6.0)));
}

unit_test "A lambda body may be a compound statement" {
  const auto step = \(const float x) {
    if (x < 0.0) {
      return 0.0;
    }
    return 1.0;
  };
  #assert(apply(step, +0.5) == 1.0);
  #assert(apply(step, -0.5) == 0.0);
}

unit_test "A lambda may take no parameters" {
  const auto answer = \() = 42;
  #assert(answer() == 42);
}

unit_test "A lambda may nest inside another" {
  const auto outer = \(const float x) = apply(\(const float y) = 2.0 * y, x);
  const auto pick = true ? \(const float x) = x : \(const float x) = -x;
  #assert(apply(outer, 2.0) == 4.0);
  #assert(apply(pick, 5.0) == 5.0);
}

// The body resolves names visible at the point the lambda is written.
// Because every call inline-expands into the same generated function,
// the lambda sees the live variable, including mutation between calls
// (capture by aliasing), and writes through it.
unit_test "A lambda captures enclosing locals by aliasing" {
  const float scale = 3.0;
  #assert(apply(\(const float x) = scale * x, 2.0) == 6.0);

  float bias = 1.0;
  const auto add_bias = \(const float x) = x + bias;
  #assert(apply(add_bias, 1.0) == 2.0);
  bias = 10.0;
  #assert(apply(add_bias, 1.0) == 11.0);

  float sum = 0.0;
  const auto accumulate = \(const float x) {
    sum += x;
    return sum;
  };
  #assert(apply(accumulate, 1.0) == 1.0);
  #assert(apply(accumulate, 2.0) == 3.0);
  #assert(sum == 3.0);
}

// A lambda inside a macro body is re-anchored at every expansion of the
// macro, so each call site sees its own captured values. A lambda's type
// therefore cannot be interned by the declaration it is written in.
@(pure macro)
float scaled_increment(const float scale, const float x) {
  const auto f = \(const float y) = scale * y + 1.0;
  return f(x);
}

unit_test "A lambda re-anchors at every macro expansion" {
  #assert(scaled_increment(2.0, 3.0) == 7.0);
  #assert(scaled_increment(10.0, 3.0) == 31.0);
}

@(pure macro)
float apply_indirect(const auto f, const float x) = apply(f, x);

unit_test "A lambda forwards through nested macros" {
  const float k = 5.0;
  #assert(apply_indirect(\(const float x) = x - k, 8.0) == 3.0);
}

// A lambda has no purity attribute: it is as pure as its body. Touching
// `$state` is fine in a non-pure context.
@(macro)
float apply_statey(const auto f) = f();

unit_test "A lambda is as pure as its body" {
  const auto get_wavelength = \() = $state.wavelengthBase[0];
  #assert(apply_statey(get_wavelength) > 0.0);
}

@(pure macro)
float remap(const float x, const auto f = \(const float t) = t) = f(x);

unit_test "A lambda may be a default argument" {
  #assert(remap(7.0) == 7.0);
  #assert(remap(7.0, \(const float t) = -t) == -7.0);
}

// Lambdas survive being returned from macros and `return_from` blocks,
// which is what makes combinator factories work. The factory parameter
// is captured by the lambda and read at the later call.
@(pure macro)
auto make_offsetter(const float offset) = \(const float x) = x + offset;

unit_test "A lambda may be returned from a macro and from return_from" {
  const auto f = make_offsetter(4.0);
  #assert(f(1.0) == 5.0);
  const auto g = return_from {
    return \(const float x) = 2.0 * x;
  };
  #assert(g(3.0) == 6.0);
}
