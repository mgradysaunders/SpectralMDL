#smdl

import ::math::*;
using marmit = ::models::marmit;
import marmit::*;

// Every case below wets the same mid-gray substrate, so the results stay
// directly comparable.
const float DRY = 0.3;

// A film of pure water over that substrate.
marmit::marmit_result film(const float water_thickness) = marmit::marmit(
  reflectance: color(DRY), water_thickness: water_thickness);

// That film covering only part of the surface, which is now a separate step:
// `marmit()` describes the film alone, and the areal mixing is the caller's.
color partly(const float water_thickness, const float wet_fraction) = marmit::areal_mix(
  film(water_thickness).wet_reflectance, color(DRY), wet_fraction);

// A load of non-absorbing mineral grains suspended in a film of zero thickness.
// Taking the thickness to zero makes the layer perfectly transmissive, which
// isolates what the suspension does to the *index* of the film from what it does
// to its absorption.
marmit::marmit_result grains(const float suspension_fraction) = marmit::marmit(
  reflectance: color(DRY), water_thickness: 0.0, suspension_fraction: suspension_fraction);

// A fixed load of suspended particles of varying absorptivity, in a film thick
// enough for that absorption to register.
marmit::marmit_result murky(const float suspension_k) = marmit::marmit(
  reflectance: color(DRY), water_thickness: 0.01, suspension_fraction: 0.3,
  suspension_k: suspension_k);

unit_test "MARMIT" {
  const auto full = film(0.01);
  const auto none = partly(0.01, 0.0);
  const auto all = partly(0.01, 1.0);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    // The areal mix is a power mean between the wetted and dry reflectances, so
    // its end members must reproduce the two inputs exactly -- up to the round
    // trip through the two `pow`s, which is what the tolerance admits.
    #assert(none[i] ~== |1e-6| DRY);
    #assert(all[i] ~== |1e-6| full.wet_reflectance[i]);
    // Wetting always darkens: even a vanishingly thin film loses light to the
    // air/water interface and to the internal bounces underneath it.
    #assert(full.wet_reflectance[i] > 0.0);
    #assert(full.wet_reflectance[i] < DRY);
  }

  // Raising the covered fraction walks the surface monotonically from dry to
  // fully wetted, and never leaves that interval.
  for (int j = 1; j <= 4; j++) {
    const auto less = partly(0.01, 0.25 * (j - 1));
    const auto more = partly(0.01, 0.25 * j);
    for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
      #assert(more[i] < less[i]);
      #assert(more[i] >= full.wet_reflectance[i] - 1e-6);
      #assert(more[i] <= DRY);
    }
  }

  // The layer transmittance falls monotonically with optical depth, so a thicker
  // film is never a brighter one. Only the extremes are compared *strictly*: once
  // a lane sits inside a water absorption band the transmittance has already
  // bottomed out at zero, and two thicknesses that both extinguish it completely
  // are equal, not ordered.
  const auto thickness = float[5](0.0, 0.1, 1.0, 10.0, 100.0);
  const auto bare = film(0.0);
  const auto flooded = film(100.0);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    #assert(flooded.wet_reflectance[i] < bare.wet_reflectance[i]);
  }
  for (int j = 1; j < 5; j++) {
    const auto thin = film(thickness[j - 1]);
    const auto thick = film(thickness[j]);
    for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
      #assert(thick.wet_reflectance[i] <= thin.wet_reflectance[i]);
    }
  }

  // Deep enough water swallows the substrate at every wavelength, including the
  // 400..500 nm window where liquid water is most nearly transparent.
  const auto deep = film(1.0e6);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    #assert(deep.wet_reflectance[i] < 1e-5);
    #assert(deep.wet_reflectance[i] >= 0.0);
  }

  // The thickness is clamped to its documented domain, so nothing outside it can
  // extrapolate. This matters more than it looks: an unclamped negative thickness
  // overflows exp(-x) and -- with the transmittance fit's P/Q negative below zero
  // -- comes back as a fully opaque layer instead of as no layer at all.
  const auto negative = film(-1.0);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    #assert(negative.wet_reflectance[i] == bare.wet_reflectance[i]);
  }

  // The covered fraction is clamped for the same reason, now on the other side of
  // the split: an unclamped fraction above 1 drives the base of the power mean's
  // outer `pow` negative, and the NaN that raises through `saturate` would surface
  // as a fully white material.
  const auto beyond = partly(0.01, 4.0);
  const auto behind = partly(0.01, -3.0);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    #assert(beyond[i] == all[i]);
    #assert(behind[i] == none[i]);
  }

  // Degenerate substrates stay in range: nothing reflects off black, and a
  // perfect white reflector still loses light to the film. The mix of a
  // degenerate pair stays degenerate too, rather than coming back as a NaN from
  // `pow(0, e)` or drifting off 1 through the round trip.
  const auto black = marmit::marmit(reflectance: color(0.0), water_thickness: 0.01);
  const auto white = marmit::marmit(reflectance: color(1.0), water_thickness: 0.01);
  const auto mix_black = marmit::areal_mix(color(0.0), color(0.0), 0.5);
  const auto mix_white = marmit::areal_mix(color(1.0), color(1.0), 0.5);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    #assert(black.wet_reflectance[i] == 0.0);
    #assert(white.wet_reflectance[i] > 0.0);
    #assert(white.wet_reflectance[i] < 1.0);
    #assert(mix_black[i] == 0.0);
    #assert(mix_white[i] ~== |1e-6| 1.0);
  }

  // A zero volume fraction takes the no-suspension path, which must land on
  // exactly the pure-water result.
  const auto clear = marmit::marmit(
    reflectance: color(DRY), water_thickness: 0.01, suspension_fraction: 0.0);
  const auto unladen = grains(0.0);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    #assert(clear.wet_reflectance[i] == full.wet_reflectance[i]);
    #assert(unladen.wet_reflectance[i] == bare.wet_reflectance[i]);
  }

  // Suspended particles with a higher index than water (the 1.53 default, a
  // mineral grain) raise the effective index of the film, so the top interface
  // reflects more and the substrate sees less: the surface darkens as the load
  // rises. Note that this is only the *index* half of the story, which is why
  // the film here has no thickness -- in a real film inside a water absorption
  // band the trend inverts, because adding mineral displaces the water that was
  // doing the absorbing.
  for (int j = 1; j <= 4; j++) {
    const auto dilute = grains(0.2 * (j - 1));
    const auto dense = grains(0.2 * j);
    for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
      #assert(dense.wet_reflectance[i] < dilute.wet_reflectance[i]);
    }
  }

  // Making those particles absorbing darkens the film at every wavelength, on
  // top of however much the water around them already absorbs.
  for (int j = 1; j <= 4; j++) {
    const auto clearer = murky(0.0002 * (j - 1));
    const auto murkier = murky(0.0002 * j);
    for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
      #assert(murkier.wet_reflectance[i] < clearer.wet_reflectance[i]);
    }
  }

  // Particles with a *lower* index than water -- air bubbles, n_i = 1 -- pull the
  // effective index back toward air and brighten the film instead.
  const auto bubbles = marmit::marmit(
    reflectance: color(DRY), water_thickness: 0.01, suspension_ior: 1.0, suspension_fraction: 0.5);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    #assert(bubbles.wet_reflectance[i] > full.wet_reflectance[i]);
  }

  // The layered split. `wet_albedo` and `interface_reflectance` cut the wetted
  // reflectance into the half that belongs to the substrate and the half that
  // belongs to the top interface, so that a layered BSDF can put the interface
  // back as an actual specular lobe instead of discarding it the way a
  // reflectance model must. These pin the cut.
  //
  // The factorization is exact by construction: the wetted reflectance is the
  // base albedo admitted through the interface and nothing besides. It also
  // brackets the base albedo, which can be no darker than the wetted reflectance
  // it produces (the interface only ever takes light away) and no brighter than
  // the substrate it stands for (the film only ever absorbs).
  const auto split = float[6](0.0, 0.001, 0.01, 0.1, 1.0, 100.0);
  for (int j = 0; j < 6; j++) {
    const auto s = film(split[j]);
    for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
      #assert(s.wet_reflectance[i] ~== |1e-6| (1.0 - s.interface_reflectance[i]) * s.wet_albedo[i]);
      #assert(s.wet_albedo[i] >= s.wet_reflectance[i]);
      #assert(s.wet_albedo[i] <= DRY + 1e-6);
    }
  }

  // A thicker film is never a brighter one, in the base albedo exactly as in the
  // wetted reflectance, since the two differ by a factor that thickness does not
  // touch. Compared non-strictly for the reason given above: inside a water
  // absorption band the transmittance has already bottomed out.
  for (int j = 1; j < 6; j++) {
    const auto thinner = film(split[j - 1]);
    const auto thicker = film(split[j]);
    for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
      #assert(thicker.wet_albedo[i] <= thinner.wet_albedo[i]);
    }
  }

  // The endpoint identity, which is the whole reason the split is worth exposing.
  // A lossless film over a perfect white reflector must leave it white, and the
  // base albedo does reach exactly 1 there -- not approximately, and not only for
  // water. The Saunderson denominator carries `r21 = 1 - t21`, so `t21` cancels
  // in closed form at unit substrate reflectance and unit transmittance, for
  // every index of refraction.
  //
  // What `wet_reflectance` reaches in that same limit is `t12`, some 7% short,
  // and the shortfall is exactly the `r12` it discarded. That is the energy a
  // layered arrangement hands to the specular lobe, so the two must sum to one;
  // if they ever fail to, the lobe is being fed the wrong weight.
  //
  // The film is swept across effective indices by loading it with suspended
  // particles of varying index. The tolerance admits the two `1 - x` roundings
  // that separate `r21` from `t21`, which is the only inexactness in the
  // identity; the fit error in `r12` itself cancels between the two terms.
  const auto sweep_ior = float[5](1.0, 1.2, 1.53, 2.0, 2.5);
  const auto sweep_fraction = float[4](0.0, 0.25, 0.5, 0.75);
  for (int a = 0; a < 5; a++) {
    for (int b = 0; b < 4; b++) {
      const auto lossless = marmit::marmit(
        reflectance: color(1.0), water_thickness: 0.0,
        suspension_ior: sweep_ior[a], suspension_fraction: sweep_fraction[b]);
      for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
        #assert(lossless.wet_albedo[i] ~== |1e-5| 1.0);
        #assert(lossless.wet_reflectance[i] + lossless.interface_reflectance[i] ~== |1e-5| 1.0);
      }
    }
  }

  // The exposed index is the one the layer would actually refract at: water alone
  // by default, and the effective medium of the volume mix when a suspension is
  // present. Water spans 1.349 at 400 nm down to 1.254 at 2500 nm, so the bracket
  // holds whatever spectral state this runs under.
  const auto silty = grains(0.3);
  for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
    #assert(full.interface_ior[i] > 1.24);
    #assert(full.interface_ior[i] < 1.36);
    #assert(silty.interface_ior[i] > full.interface_ior[i]);
    #assert(bubbles.interface_ior[i] < full.interface_ior[i]);
    // The interface reflectance rises and falls with that index, which is the
    // mechanism behind the brightening and darkening asserted for the suspension
    // cases above -- here read off the interface directly instead of inferred
    // from what reaches the substrate.
    #assert(silty.interface_reflectance[i] > full.interface_reflectance[i]);
    #assert(bubbles.interface_reflectance[i] < full.interface_reflectance[i]);
  }

  // Absolute reflectance against the canonical MARMIT-2 implementation (Dupiau
  // et al. 2022, 'MARMIT2_function.py') driven by the 1 nm Segelstein and
  // Buiteveld/Kou/Wieliczka tables it ships with, sampled at the wavelengths of
  // the spectral state each block guards on. The tolerances admit the polynomial
  // and rational fits this module evaluates in place of the reference's log and
  // E1, plus its decimated absorption table; measured deviations top out around
  // 4e-4 for a thin film and 9e-4 once the film is optically thick.
  //
  // Note that lane 0 of the default state sits at 380 nm, below the 400 nm floor
  // of the optical constants, so these also pin the clamp there.
  if ($WAVELENGTH_BASE_MAX == 16 && math::abs($state.wavelength_base[0] - 380.0) < 1e-3 &&
      math::abs($state.wavelength_base[15] - 720.0) < 1e-3) {
    // A thin film (0.01 cm), fully wetted and 40% wetted. Water is almost
    // transparent across the visible, so these isolate the diffuse Fresnel terms
    // and the areal mixing from the layer transmittance.
    const auto REF_THIN = float[16](
      0.167245, 0.167337, 0.168069, 0.168705,
      0.169267, 0.169765, 0.170214, 0.170620,
      0.170990, 0.171329, 0.171632, 0.171924,
      0.172191, 0.172427, 0.172636, 0.172794);
    const auto REF_THIN_PARTIAL = float[16](
      0.241713, 0.241758, 0.242118, 0.242430,
      0.242705, 0.242948, 0.243168, 0.243366,
      0.243546, 0.243711, 0.243859, 0.244001,
      0.244131, 0.244246, 0.244348, 0.244424);
    // The same pair under a 10 m column of water. Absurd as a wet surface, but it
    // is the only way to sweep the layer transmittance across optical depths 0.06
    // to 10 within the visible, and it drives the wet and dry ends of the areal
    // mix far enough apart to pin the mixing exponent as well.
    const auto REF_COLUMN = float[16](
      0.130110, 0.129302, 0.116755, 0.106154,
      0.097465, 0.078992, 0.041932, 0.030891,
      0.017332, 0.005746, 0.000118, 0.000054,
      0.000020, 0.000003, 0.000000, 0.000000);
    const auto REF_COLUMN_PARTIAL = float[16](
      0.222614, 0.222177, 0.215250, 0.209168,
      0.204004, 0.192366, 0.164828, 0.154695,
      0.139602, 0.120885, 0.098654, 0.097302,
      0.096158, 0.094971, 0.094350, 0.094087);
    // A 20% mineral suspension, to pin the effective-medium branch.
    const auto REF_SILT = float[16](
      0.157936, 0.158003, 0.158532, 0.158991,
      0.159396, 0.159755, 0.160078, 0.160369,
      0.160634, 0.160877, 0.161094, 0.161303,
      0.161494, 0.161662, 0.161812, 0.161923);
    const auto thin_partial = partly(0.01, 0.4);
    const auto column = film(1000.0);
    const auto column_partial = partly(1000.0, 0.4);
    const auto silt = marmit::marmit(
      reflectance: color(DRY), water_thickness: 0.01, suspension_fraction: 0.2);
    for (int i = 0; i < 16; i++) {
      #assert(full.wet_reflectance[i] ~== |1e-3| REF_THIN[i]);
      #assert(thin_partial[i] ~== |1e-3| REF_THIN_PARTIAL[i]);
      #assert(column.wet_reflectance[i] ~== |1.5e-3| REF_COLUMN[i]);
      #assert(column_partial[i] ~== |1.5e-3| REF_COLUMN_PARTIAL[i]);
      #assert(silt.wet_reflectance[i] ~== |1e-3| REF_SILT[i]);
    }
  }

  // The same comparison in the shortwave infrared, where the vibrational bands of
  // water are what actually shape a wet soil spectrum and where the absorption
  // table therefore carries the model. The default spectral state never reaches
  // this far, so run it explicitly with
  //
  //   smdl test -wavelength-min 900 -wavelength-max 2400 testing/language/marmit.smdl
  //
  if ($WAVELENGTH_BASE_MAX == 16 && math::abs($state.wavelength_base[0] - 900.0) < 1e-3 &&
      math::abs($state.wavelength_base[15] - 2400.0) < 1e-3) {
    // Lanes land every 100 nm, straddling the 1450, 1940 and 2200 nm bands.
    const auto REF_SWIR = float[16](
      0.173553, 0.171352, 0.173554, 0.165775,
      0.165900, 0.089671, 0.082094, 0.132298,
      0.140701, 0.124521, 0.008193, 0.018007,
      0.064663, 0.090223, 0.074375, 0.035991);
    // A brighter substrate under a thicker film, which pushes the bands into
    // total extinction and the windows between them into the sensitive part of
    // the transmittance fit.
    const auto REF_SWIR_BRIGHT = float[16](
      0.508954, 0.463154, 0.492619, 0.373221,
      0.369515, 0.025884, 0.018128, 0.122856,
      0.158062, 0.092086, 0.000002, 0.000039,
      0.006414, 0.023064, 0.010359, 0.000550);
    const auto bright = marmit::marmit(reflectance: color(0.7), water_thickness: 0.05);
    for (int i = 0; i < 16; i++) {
      #assert(full.wet_reflectance[i] ~== |1.2e-3| REF_SWIR[i]);
      #assert(bright.wet_reflectance[i] ~== |2e-3| REF_SWIR_BRIGHT[i]);
    }
  }
}
