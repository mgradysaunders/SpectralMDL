#smdl

import ::df::*;
import ::math::*;
import ::tex::*;
using sampling = ::extras::sampling;
import sampling::*;

unit_test "Specular half vector for reflection" {
  const auto wo = math::normalize(float3(-0.4, 1.2, 1.6));
  const auto wi = math::normalize(float3(+0.1, -0.7, 0.4));
  const auto wm = math::normalize(df::specular::reflection_half_vector(wo, wi));
  #assert(#all(df::specular::reflect(wo, wm) ~== |1e-5| wi));
  #assert(#all(df::specular::reflect(wi, wm) ~== |1e-5| wo));
}

unit_test "Specular half vector for refraction" {
  const auto ior = 1 / 1.4;
  const auto wo = math::normalize(float3(-0.4, 1.2, 1.6));
  const auto wi = math::normalize(float3(+0.1, -0.7, -0.4));
  const auto wm = math::normalize(df::specular::refraction_half_vector(wo, wi, ior));
  #assert(#all(df::specular::refract(wo, wm, ior) ~== |1e-5| wi));
  #assert(#all(df::specular::refract(wi, wm, 1 / ior) ~== |1e-5| wo));
}

@(pure foreign)
double erf(double x);

unit_test "Erf inverse" {
  #assert(sampling::erf_inverse(erf(-1.1d)) ~== |1e-5d| -1.1d);
  #assert(sampling::erf_inverse(erf(-0.3d)) ~== |1e-5d| -0.3d);
  #assert(sampling::erf_inverse(erf(+1.2d)) ~== |1e-5d| +1.2d);
  #assert(sampling::erf_inverse(erf(+2.7d)) ~== |1e-5d| +2.7d);
}

@(pure)
auto runLowDiscrepancyTests(auto xi) {
  auto xiAverage(xi);
  for (int i = 0; i < 5000; i++) {
    xiAverage += sampling::next_low_discrepancy(&xi);
  }
  xiAverage /= 5000;
  #assert(#all(xiAverage ~== |1e-3| 0.5));
}

unit_test "Low discrepancy 2D" {
  runLowDiscrepancyTests(float2(0.1, 0.2));
}

unit_test "Low discrepancy 3D" {
  runLowDiscrepancyTests(float3(0.1, 0.2, 0.3));
}

unit_test "Low discrepancy 4D" {
  runLowDiscrepancyTests(float4(0.1, 0.2, 0.3, 0.4));
}

unit_test "Cosine-weighted hemisphere sample" {
  auto xi(float2(0.5, 0.7));
  auto wiAverage(float3(0.0));
  for (int i = 0; i < 5000; i++, sampling::next_low_discrepancy(&xi)) {
    wiAverage += sampling::cosine_hemisphere_sample(xi);
  }
  wiAverage /= 5000;
  #assert(#all(wiAverage ~== |1e-3| float3(0.0, 0.0, 0.666)));
}

// Integrate Smith slope PDF by transforming the open square `(-1, 1)^2` 
// into the entire plane `(-inf, inf)^2`.
@(pure)
float integrateSmithSlopePDF(const df::microfacet::distribution distr) {
  double fSum = 0;
  const int n = 512;
  for (int ix = 0; ix < n; ix++) {
    const float tx = math::lerp(-0.99999, 0.99999, ix / float(n - 1));
    const float mx = tx / (1 - tx * tx);
    double ftmp = 0;
    for (int iy = 0; iy < n; iy++) {
      const float ty = math::lerp(-0.99999, 0.99999, iy / float(n - 1));
      const float my = ty / (1 - ty * ty);
      ftmp += 2 * (1 + ty * ty) / #pow(1 - ty * ty, 2) * df::microfacet::smith_slope_pdf(distr, float2(mx, my));
    }
    fSum += 2 * (1 + tx * tx) / #pow(1 - tx * tx, 2) * ftmp / n;
  }
  return fSum / n;
}

// Integrate Smith normal PDF by cosine-weighted hemisphere sampling.
@(pure)
float integrateSmithNormalPDF(const df::microfacet::distribution distr, const float2 alpha) {
  double fSum = 0;
  const int n = 512 * 512;
  float2 xi = float2(0.228, 0.712);
  for (int i = 0; i < n; i++, sampling::next_low_discrepancy(&xi)) {
    fSum += df::microfacet::smith_normal_pdf(distr, alpha, sampling::cosine_hemisphere_sample(xi));
  }
  return $PI * fSum / n;
}

unit_test "Microfacet distributions" {
  #assert(integrateSmithSlopePDF(df::microfacet::ggx()) ~== |1e-2| 1.0);
  #assert(integrateSmithSlopePDF(df::microfacet::beckmann()) ~== |1e-2| 1.0);
  #assert(integrateSmithNormalPDF(df::microfacet::ggx(), float2(0.8, 1.2)) ~== |1e-2| 1.0);
  #assert(integrateSmithNormalPDF(df::microfacet::beckmann(), float2(1.1, 0.7)) ~== |1e-2| 1.0);
}

struct EvaluateResult {
  color f = color(0);
  float2 pdf = float2(0);
};

EvaluateResult evaluate(
  const bsdf scattering,
  float3 wo,
  float3 wi,
  const bool isImportance = false,
  const float3 normal = float3(0, 0, 1),
  const bool thin_walled = false,
  const float ior = 1.4,
  const float exterior_ior = 1.0,
  const int lobeMask = df::DF_ALL,
) {
  auto mat = material(thin_walled: thin_walled, ior: ior, surface: material_surface(scattering: scattering), geometry: material_geometry(normal: normal));
  auto instance = _MaterialInstance(&mat);
  instance.flags |= isImportance ? 1 : 0; // MATERIAL_TRANSPORT_IMPORTANCE
  instance.exterior_ior = exterior_ior;
  float pdfFwd = 0;
  float pdfRev = 0;
  color f = color(0);
  if (df::_scatterEvaluate(&instance, &wo, &wi, lobeMask, &pdfFwd, &pdfRev, cast<&float>(&f)))
    return EvaluateResult(f, float2(pdfFwd, pdfRev));
  else
    return EvaluateResult();
}

struct SampleResult {
  float3 wi = float3(0);
  color f = color(0);
  float2 pdf = float2(0);
  int sampledLobe = 0;
  bool success = false;
  float lobeChance = 1.0;

  /// The Dirac test the entry point used to report on its own.
  bool isDelta = (sampledLobe & df::DF_DELTA) != 0;
};

SampleResult sample(
  const bsdf scattering,
  const float4 xi,
  float3 wo,
  const bool isImportance = false,
  const float3 normal = float3(0, 0, 1),
  const bool thin_walled = false,
  const float ior = 1.4,
  const float exterior_ior = 1.0,
  const int lobeMask = df::DF_ALL,
) {
  auto mat = material(thin_walled: thin_walled, ior: ior, surface: material_surface(scattering: scattering), geometry: material_geometry(normal: normal));
  auto instance = _MaterialInstance(&mat);
  instance.flags |= isImportance ? 1 : 0; // MATERIAL_TRANSPORT_IMPORTANCE
  instance.exterior_ior = exterior_ior;
  float4 xi1 = xi;
  float3 wi = float3(0);
  float pdfFwd = 0;
  float pdfRev = 0;
  color f = color(0);
  int sampledLobe = 0;
  float lobeChanceOut = 1.0;
  const auto success = df::_scatterSample(&instance, &xi1, &wo, lobeMask, &wi, &pdfFwd, &pdfRev, cast<&float>(&f), &sampledLobe, &lobeChanceOut);
  return SampleResult(wi, f, float2(pdfFwd, pdfRev), sampledLobe, bool(success), lobeChanceOut);
}

struct NormalSampleResult {
  float3 wm = float3(0);
  float pdf = 0;
  float2 alpha = float2(0);
  bool success = false;
};

NormalSampleResult normalSample(
  const bsdf scattering,
  const float4 xi,
  float3 wo,
  const float3 normal = float3(0, 0, 1),
  const bool thin_walled = false,
  const float ior = 1.4,
  const float exterior_ior = 1.0,
  const int lobeMask = df::DF_GLOSSY,
) {
  auto mat = material(thin_walled: thin_walled, ior: ior, surface: material_surface(scattering: scattering), geometry: material_geometry(normal: normal));
  auto instance = _MaterialInstance(&mat);
  instance.exterior_ior = exterior_ior;
  float4 xi1 = xi;
  float3 wm = float3(0);
  float pdf = 0;
  float2 alpha = float2(0);
  const auto success = df::_scatterNormalSample(&instance, &xi1, &wo, lobeMask, &wm, &pdf, &alpha);
  return NormalSampleResult(wm, pdf, alpha, bool(success));
}

float normalEvaluate(
  const bsdf scattering,
  float3 wo,
  float3 wm,
  const float3 normal = float3(0, 0, 1),
  const bool thin_walled = false,
  const float ior = 1.4,
  const float exterior_ior = 1.0,
  const int lobeMask = df::DF_GLOSSY,
) {
  auto mat = material(thin_walled: thin_walled, ior: ior, surface: material_surface(scattering: scattering), geometry: material_geometry(normal: normal));
  auto instance = _MaterialInstance(&mat);
  instance.exterior_ior = exterior_ior;
  float pdf = 0;
  df::_scatterNormalEvaluate(&instance, &wo, &wm, lobeMask, &pdf);
  return pdf;
}

// The two mask axes filter independently, and naming nothing on an axis
// means every value of it. The domain axis is decided by the direction pair
// on the evaluation path and forced on the sampling path, so unlike the lobe
// kinds it partitions a `scatter_reflect_transmit` lobe rather than keeping
// all of it under either bit.

// The lobes a material reports.
int surfaceLobes(const bsdf scattering) {
  auto mat = material(ior: 1.5, surface: material_surface(scattering: scattering));
  return _MaterialInstance(&mat).df_lobes_surface;
}

// `df_lobes` unions over a whole BSDF tree, so a flag word has to keep each
// lobe's domain attached to its kind. Two axes OR'd together do not: these
// two trees have the same domains and the same kinds, and only the second
// has a Dirac lobe that transmits. A host deciding whether an interface is
// one a manifold walk can refract through reads exactly that difference.
unit_test "Lobes keep domain and kind together" {
  // The six lobes partition everything, so the rows and the columns of the
  // table are two ways of covering the same set and each row meets each
  // column in exactly one lobe.
  #assert(df::DF_ALL == (df::DF_BRDF | df::DF_BTDF));
  #assert(df::DF_ALL == (df::DF_GENERIC | df::DF_GLOSSY | df::DF_DELTA));
  #assert((df::DF_BRDF & df::DF_BTDF) == 0);
  #assert((df::DF_GENERIC & df::DF_GLOSSY) == 0);
  #assert((df::DF_GLOSSY & df::DF_DELTA) == 0);
  #assert(df::DF_DELTA_BTDF == (df::DF_BTDF & df::DF_DELTA));
  #assert(df::DF_GLOSSY_BRDF == (df::DF_BRDF & df::DF_GLOSSY));
  const auto N = float3(0, 0, 1);
  // A Dirac reflection over a diffuse transmission.
  const int mirrorOverDT = surfaceLobes(df::weighted_layer(
    weight: 0.5, normal: N,
    layer: df::specular_bsdf(mode: df::scatter_reflect),
    base: df::diffuse_transmission_bsdf(tint: 0.8)));
  // A Dirac reflection AND transmission over a diffuse reflection.
  const int glassOverDiffuse = surfaceLobes(df::weighted_layer(
    weight: 0.5, normal: N,
    layer: df::specular_bsdf(mode: df::scatter_reflect_transmit),
    base: df::diffuse_reflection_bsdf(tint: 0.8)));
  #assert(mirrorOverDT == (df::DF_DELTA_BRDF | df::DF_GENERIC_BTDF));
  #assert(glassOverDiffuse == (df::DF_GENERIC_BRDF | df::DF_DELTA_BRDF | df::DF_DELTA_BTDF));
  #assert((mirrorOverDT & df::DF_DELTA_BTDF) == 0);
  #assert((glassOverDiffuse & df::DF_DELTA_BTDF) != 0);
  // The axis unions answer the coarse questions identically for both, which
  // is the ambiguity the lobes resolve.
  #assert((mirrorOverDT & df::DF_BTDF) != 0);
  #assert((glassOverDiffuse & df::DF_BTDF) != 0);
  #assert((mirrorOverDT & df::DF_DELTA) != 0);
  #assert((glassOverDiffuse & df::DF_DELTA) != 0);
  // A tree with no Dirac transmission has nothing to give at that lobe,
  // however deeply the mask has to descend to find that out.
  const auto nested = df::weighted_layer(
    weight: 0.5, normal: N,
    layer: df::weighted_layer(
      weight: 0.5, normal: N,
      layer: df::specular_bsdf(mode: df::scatter_reflect),
      base: df::diffuse_transmission_bsdf(tint: 0.8)),
    base: df::diffuse_reflection_bsdf(tint: 0.9));
  const auto wo = math::normalize(float3(0.3, 0.1, 1.0));
  for (int i = 0; i < 8; i++) {
    #assert(!sample(nested, float4(0.3, 0.7, i / 8.0, 0.5), wo,
                    lobeMask: df::DF_DELTA_BTDF).success);
  }
}

unit_test "Lobe mask domain axis" {
  const auto wo = math::normalize(float3(0.2, -0.3, 0.93));
  const auto wiT = math::normalize(float3(-0.1, 0.2, -0.9)); // opposite hemisphere
  const auto wiR = math::normalize(float3(-0.1, 0.2, +0.9)); // same hemisphere
  const auto glass = df::microfacet_ggx_smith_bsdf(
    roughness_u: 0.3, roughness_v: 0.3, mode: df::scatter_reflect_transmit);
  // Evaluation: the pair fixes the domain, so the wrong mask gives nothing
  // and the two masks partition the value.
  const auto tWhole = evaluate(glass, wo, wiT);
  #assert(#any(tWhole.f > 0.0)); // Else the checks pass vacuously
  #assert(!#any(evaluate(glass, wo, wiT, lobeMask: df::DF_BRDF).f > 0.0));
  #assert(#all(evaluate(glass, wo, wiT, lobeMask: df::DF_BTDF).f ~== |1e-5| tWhole.f));
  const auto rWhole = evaluate(glass, wo, wiR);
  #assert(#any(rWhole.f > 0.0));
  #assert(!#any(evaluate(glass, wo, wiR, lobeMask: df::DF_BTDF).f > 0.0));
  #assert(#all(evaluate(glass, wo, wiR, lobeMask: df::DF_BRDF).f ~== |1e-5| rWhole.f));
  // Sampling: the mask forces the branch, whatever the Fresnel selection
  // sample would otherwise have chosen.
  for (int i = 0; i < 8; i++) {
    const auto xi = float4(0.3, 0.7, i / 8.0, 0.5);
    const auto transmitted = sample(glass, xi, wo, lobeMask: df::DF_BTDF);
    #assert(transmitted.success);
    #assert(transmitted.wi.z < 0.0); // `wo` is in the upper hemisphere
    const auto reflected = sample(glass, xi, wo, lobeMask: df::DF_BRDF);
    #assert(reflected.success);
    #assert(reflected.wi.z > 0.0);
  }
  // A mask naming a domain still says nothing about the lobe kinds, so a
  // diffuse reflector survives a bare `DF_BRDF`.
  #assert(#any(evaluate(df::diffuse_reflection_bsdf(tint: 0.7), wo, wiR,
                        lobeMask: df::DF_BRDF).f > 0.0));
  // One lobe is one domain paired with one kind: a diffuse reflector is not
  // a Dirac one, and `DF_BRDF & DF_DELTA` names the same lobe.
  #assert(df::DF_DELTA_BRDF == (df::DF_BRDF & df::DF_DELTA));
  #assert(!#any(evaluate(df::diffuse_reflection_bsdf(tint: 0.7), wo, wiR,
                         lobeMask: df::DF_DELTA_BRDF).f > 0.0));
}

// A lobe mask on the SAMPLING path is how a caller reaches one Dirac lobe of
// a layered material. No mask on the evaluation path can, because a Dirac
// lobe has no density to evaluate at a direction pair.
unit_test "Lobe mask sampling reaches a delta lobe" {
  const auto wo = math::normalize(float3(0.2, -0.3, 0.93));
  // A scalar weight, so the layer selection chance is the weight exactly.
  const auto scattering = df::weighted_layer(
    weight: 0.5,
    layer: df::simple_glossy_bsdf(roughness_u: 0.3, roughness_v: 0.3, tint: 0.9),
    base: df::specular_bsdf(mode: df::scatter_reflect_transmit));
  const auto masked = df::DF_DELTA;
  // The chances are renormalized over the lobes the mask keeps, so the dead
  // glossy layer is never selected however the selection sample falls.
  for (int i = 0; i < 8; i++) {
    const auto result = sample(scattering, float4(0.3, 0.7, 0.5, i / 8.0), wo, lobeMask: masked);
    #assert(result.success);
    #assert(result.isDelta);
    #assert(#any(result.f > 0.0));
  }
  // Against the unmasked sampler forced onto the same branch: an `xi.w` of
  // 0.75 exceeds the 0.5 chance, so the base is what it selects too. The
  // masked weight is the unmasked one scaled by the chance the mask removed,
  // which is what keeps the two estimators of the same lobe consistent.
  const auto xi = float4(0.3, 0.7, 0.5, 0.75);
  const auto whole = sample(scattering, xi, wo);
  const auto part = sample(scattering, xi, wo, lobeMask: masked);
  #assert(whole.isDelta & part.isDelta);
  #assert(#all(part.wi ~== |1e-5| whole.wi));
  #assert(#any(whole.f > 0.0));
  #assert(#all(part.f ~== |1e-5| whole.f * 0.5));
  // A mask naming no lobe of the distribution samples nothing.
  #assert(!sample(df::diffuse_reflection_bsdf(tint: 0.7), xi, wo, lobeMask: df::DF_DELTA).success);
}

// A lobe mask restricts which lobes contribute to the VALUE and renormalizes
// it by nothing, so the masked evaluations of disjoint lobes must sum
// to the unmasked one. The densities are the other half of the contract: each
// is the density of the sampler restricted to that mask, which takes its lobe
// with certainty once the mask has removed the alternatives, so they do not
// sum to anything. Together they make a masked value over a masked density an
// estimator of the masked part.
unit_test "Lobe mask additivity" {
  const auto wo = math::normalize(float3(+0.3, -0.5, 0.9));
  const auto wi = math::normalize(float3(-0.2, +0.4, 0.7));
  // One of every lobe: glossy over diffuse over specular.
  const auto scattering = df::weighted_layer(
    weight: 0.4,
    layer: df::simple_glossy_bsdf(roughness_u: 0.3, roughness_v: 0.3, tint: 0.9),
    base: df::weighted_layer(
      weight: 0.5,
      layer: df::diffuse_reflection_bsdf(tint: 0.7),
      base: df::specular_bsdf(mode: df::scatter_reflect_transmit)));
  const auto all = evaluate(scattering, wo, wi);
  const auto ndf = evaluate(scattering, wo, wi, lobeMask: df::DF_GLOSSY);
  const auto density = evaluate(scattering, wo, wi, lobeMask: df::DF_GENERIC);
  const auto delta = evaluate(scattering, wo, wi, lobeMask: df::DF_DELTA);
  #assert(#any(all.f > 0.0));     // Else the checks pass vacuously
  #assert(#any(ndf.f > 0.0));     // Else the split is not exercised
  #assert(#any(density.f > 0.0)); //
  #assert(#all(all.f ~== |1e-5| ndf.f + density.f + delta.f));
  // Each mask leaves exactly one lobe alive, so each masked density is that
  // lobe's own, undiluted by the selection chances the mask removed.
  const auto glossyAlone = evaluate(df::simple_glossy_bsdf(roughness_u: 0.3, roughness_v: 0.3, tint: 0.9), wo, wi);
  const auto diffuseAlone = evaluate(df::diffuse_reflection_bsdf(tint: 0.7), wo, wi);
  #assert(#all(ndf.pdf ~== |1e-4| glossyAlone.pdf));
  #assert(#all(density.pdf ~== |1e-4| diffuseAlone.pdf));
  #assert(!#any(delta.pdf > 0.0)); // A Dirac lobe has no density to report.
  // The unmasked density is the mixture of the two, so it lands strictly
  // below their sum.
  #assert(#all(all.pdf < ndf.pdf + density.pdf));
  // A mask naming no lobe of the distribution evaluates to nothing.
  #assert(!#any(evaluate(scattering, wo, wi, lobeMask: 0).f > 0.0));
}

// The density a masked SAMPLE reports has to be the density it drew from,
// which is the same restricted density the evaluation path reports. Weighing
// a direction drawn from the restricted sampler against the mixture density
// would inflate the estimator by exactly the selection mass the mask removed.
unit_test "Lobe mask density is the restricted sampler's" {
  const auto wo = math::normalize(float3(0.2, -0.3, 0.93));
  const auto layer = df::simple_glossy_bsdf(roughness_u: 0.3, roughness_v: 0.3, tint: 0.9);
  const auto scattering = df::weighted_layer(
    weight: 0.5, layer: layer, base: df::diffuse_reflection_bsdf(tint: 0.7));
  const auto masked = sample(scattering, float4(0.3, 0.7, 0.5, 0.9), wo, lobeMask: df::DF_GLOSSY);
  #assert(masked.success);
  #assert(!masked.isDelta);
  #assert(masked.pdf.x > 0.0);
  // The mask leaves only the layer, so that is what the sampler drew from.
  #assert(masked.pdf.x ~== |1e-3| evaluate(layer, wo, masked.wi).pdf.x);
  // And the mixture density, which is what the unmasked sampler draws from,
  // is a strictly smaller number at the same direction.
  #assert(evaluate(scattering, wo, masked.wi).pdf.x < masked.pdf.x);
}

// Sample under a mask naming one lobe, assert the sample says it came from
// that lobe, and return it so the caller can check the sweep reached every
// one. Returns 0 for a rejected sample, which a grazing draw may be.
int checkSampledLobe(const bsdf scattering, const float4 xi, const float3 wo, const int lobe) {
  const auto r = sample(scattering, xi, wo, lobeMask: lobe);
  return 0 if (!r.success);
  #assert(r.sampledLobe == lobe);
  // The domain agrees with the hemispheres the sample actually landed in,
  // and the Dirac bit agrees with the unit density a delta lobe reports.
  #assert(((lobe & df::DF_BRDF) != 0) == ((wo.z < 0.0) == (r.wi.z < 0.0)));
  #assert(((lobe & df::DF_DELTA) != 0) == (r.pdf.x == 1.0));
  return r.sampledLobe;
}

// A sample comes from ONE lobe. The selection descends to one branch of one
// leaf, and a branch has one domain and one kind, so the word the entry point
// reports has exactly one bit. It answers what `df_lobes_surface` cannot: that
// word says what the material COULD do, and this says what it DID.
unit_test "A sample reports the one lobe it came from" {
  const auto wo = math::normalize(float3(0.2, -0.3, 0.93));
  // One lobe of every kind, over both domains, and a leaf that declares two
  // kinds at once so the hand-written narrowing is exercised too.
  const auto scattering = df::weighted_layer(
    weight: 0.4,
    layer: df::microfacet_ggx_smith_bsdf(
      roughness_u: 0.6, roughness_v: 0.6, tint: 0.9, multiscatter_tint: color(1.0),
      mode: df::scatter_reflect_transmit),
    base: df::weighted_layer(
      weight: 0.5,
      layer: df::diffuse_reflection_bsdf(tint: 0.7),
      base: df::specular_bsdf(mode: df::scatter_reflect_transmit)));
  const int declared = surfaceLobes(scattering);
  #assert(declared == (df::DF_GENERIC_BRDF | df::DF_GLOSSY_BRDF | df::DF_DELTA_BRDF |
                       df::DF_GLOSSY_BTDF | df::DF_DELTA_BTDF));
  // Every declared lobe, reached deterministically by naming it.
  int seen = 0;
  for (int i = 0; i < 16; i++) {
    const auto xi = float4((i + 0.5) / 16, 0.7, ((i * 3) % 16 + 0.5) / 16, ((i * 5) % 16 + 0.5) / 16);
    seen |= checkSampledLobe(scattering, xi, wo, df::DF_GENERIC_BRDF);
    seen |= checkSampledLobe(scattering, xi, wo, df::DF_GLOSSY_BRDF);
    seen |= checkSampledLobe(scattering, xi, wo, df::DF_DELTA_BRDF);
    seen |= checkSampledLobe(scattering, xi, wo, df::DF_GLOSSY_BTDF);
    seen |= checkSampledLobe(scattering, xi, wo, df::DF_DELTA_BTDF);
  }
  #assert(seen == declared); // Else the checks above passed vacuously
  // And unmasked, where the sampler chooses for itself, the word is still a
  // single bit the material declared.
  for (int i = 0; i < 16; i++) {
    const auto xi = float4((i + 0.5) / 16, 0.7, ((i * 3) % 16 + 0.5) / 16, ((i * 5) % 16 + 0.5) / 16);
    const auto r = sample(scattering, xi, wo);
    continue if (!r.success);
    #assert((r.sampledLobe != 0) & ((r.sampledLobe & (r.sampledLobe - 1)) == 0));
    #assert((r.sampledLobe & declared) == r.sampledLobe);
    #assert(((r.sampledLobe & df::DF_BRDF) != 0) == ((wo.z < 0.0) == (r.wi.z < 0.0)));
    #assert(((r.sampledLobe & df::DF_DELTA) != 0) == (r.pdf.x == 1.0));
  }
  // Nothing sampled, nothing reported.
  #assert(sample(df::diffuse_reflection_bsdf(tint: 0.7), float4(0.3), wo,
                 lobeMask: df::DF_DELTA).sampledLobe == 0);
}

// The Kulla-Conty compensation lobe of a `multiscatter_tint` is a cosine
// hemisphere with no normal distribution behind it, so the lobe carrying it
// is GENERIC as well as GLOSSY and a mask can cut between the two kinds. A
// caller asking for a normal distribution must not be handed the diffuse term
// that exists to make up for the energy one loses.
unit_test "Multiscatter compensation is a lobe of its own" {
  const auto wo = math::normalize(float3(0.2, -0.3, 0.93));
  const auto wi = math::normalize(float3(-0.2, 0.4, 0.88));
  const auto rough = df::microfacet_ggx_smith_bsdf(
    roughness_u: 0.8, roughness_v: 0.8, tint: 0.9, multiscatter_tint: color(1.0));
  // Declared only when the compensation is actually there, and only on the
  // domain it scatters to.
  #assert(surfaceLobes(rough) == (df::DF_GLOSSY_BRDF | df::DF_GENERIC_BRDF));
  #assert(surfaceLobes(df::microfacet_ggx_smith_bsdf(
            roughness_u: 0.8, roughness_v: 0.8, tint: 0.9)) == df::DF_GLOSSY_BRDF);
  #assert(surfaceLobes(df::microfacet_ggx_smith_bsdf(
            roughness_u: 0.8, roughness_v: 0.8, tint: 0.9,
            multiscatter_tint: 0.0)) == df::DF_GLOSSY_BRDF);
  // A lobe that only transmits never reaches the compensation, which
  // reflects, so it declares nothing generic either.
  #assert(surfaceLobes(df::microfacet_ggx_smith_bsdf(
            roughness_u: 0.8, roughness_v: 0.8, tint: 0.9, multiscatter_tint: color(1.0),
            mode: df::scatter_transmit)) == df::DF_GLOSSY_BTDF);
  // The two kinds partition the value.
  const auto all = evaluate(rough, wo, wi);
  const auto ndf = evaluate(rough, wo, wi, lobeMask: df::DF_GLOSSY);
  const auto comp = evaluate(rough, wo, wi, lobeMask: df::DF_GENERIC);
  #assert(#any(all.f > 0.0));  // Else the checks pass vacuously
  #assert(#any(ndf.f > 0.0));  // Else the split is not exercised
  #assert(#any(comp.f > 0.0)); //
  #assert(#all(all.f ~== |1e-5| ndf.f + comp.f));
  // Each masked density is the restricted sampler's. The compensation alone
  // is the cosine hemisphere, undiluted by the mixture chance the mask
  // removed, and the unmasked density is a strict mixture of the two.
  #assert(comp.pdf.x ~== |1e-5| #abs(wi.z) / $PI);
  #assert(comp.pdf.y ~== |1e-5| #abs(wo.z) / $PI);
  #assert(ndf.pdf.x > 0.0);
  #assert(!(ndf.pdf.x ~== |1e-3| comp.pdf.x)); // Else the mixture is invisible
  #assert((#min(ndf.pdf.x, comp.pdf.x) < all.pdf.x) & (all.pdf.x < #max(ndf.pdf.x, comp.pdf.x)));
}

// Drawing the compensation lobe is a selection like any other: the mask
// renormalizes it away, and `lobeChance` reports what the unmasked sampler
// would have done, which is the weight the unmasked density mixes by.
unit_test "Multiscatter compensation selection chance" {
  const auto wo = math::normalize(float3(0.2, -0.3, 0.93));
  const auto rough = df::microfacet_ggx_smith_bsdf(
    roughness_u: 0.8, roughness_v: 0.8, tint: 0.9, multiscatter_tint: color(1.0));
  // `xi.w` below the chance takes the compensation lobe and above it takes
  // the single scattering. Nothing else chooses here, so the two reported
  // chances are the selection and its complement.
  const auto comp = sample(rough, float4(0.3, 0.7, 0.5, 0.05), wo);
  const auto ndf = sample(rough, float4(0.3, 0.7, 0.5, 0.95), wo);
  #assert(comp.success & ndf.success);
  #assert(!#all(comp.wi ~== |1e-3| ndf.wi)); // Else the two lobes coincide
  #assert(comp.lobeChance + ndf.lobeChance ~== |1e-5| 1.0);
  #assert((0.0 < comp.lobeChance) & (comp.lobeChance < 1.0));
  // The mask renormalizes the selection, so the compensation lobe is
  // unreachable under `DF_GLOSSY` and certain under `DF_GENERIC` however the
  // selection sample falls, while the chance reported stays the unmasked one.
  for (int i = 0; i < 8; i++) {
    const auto xi = float4(0.3, 0.7, 0.5, i / 8.0);
    const auto glossyOnly = sample(rough, xi, wo, lobeMask: df::DF_GLOSSY);
    const auto genericOnly = sample(rough, xi, wo, lobeMask: df::DF_GENERIC);
    #assert(glossyOnly.success & genericOnly.success);
    #assert(#all(genericOnly.wi ~== |1e-5| comp.wi));
    #assert(!#all(glossyOnly.wi ~== |1e-3| comp.wi));
    #assert(genericOnly.lobeChance ~== |1e-5| comp.lobeChance);
    #assert(glossyOnly.lobeChance ~== |1e-5| ndf.lobeChance);
    // And what a masked sample reports is the density it drew from.
    #assert(genericOnly.pdf.x ~== |1e-5| evaluate(rough, wo, genericOnly.wi, lobeMask: df::DF_GENERIC).pdf.x);
    #assert(glossyOnly.pdf.x ~== |1e-3| evaluate(rough, wo, glossyOnly.wi, lobeMask: df::DF_GLOSSY).pdf.x);
  }
}

// `DF_GLOSSY` promises a normal distribution behind the lobe, and these two
// queries are how a caller reaches it. What their correctness rests on is one
// property and only one: the density the evaluate reports is the density the
// sample draws with. Everything a manifold estimator does with them is built
// on that, so it is what these cases pin down.
unit_test "Normal distribution sample and evaluate agree" {
  const auto wo = math::normalize(float3(0.2, -0.3, 0.93));
  // Two glossy lobes of different roughness under a layer, so the reported
  // density is a mixture and not one leaf's own.
  const auto rough = df::microfacet_ggx_smith_bsdf(roughness_u: 0.6, roughness_v: 0.6, tint: 0.9);
  const auto smooth = df::microfacet_beckmann_smith_bsdf(roughness_u: 0.25, roughness_v: 0.25, tint: 0.9);
  const auto layered = df::weighted_layer(weight: 0.4, layer: smooth, base: rough);
  int seenSmooth = 0;
  int seenRough = 0;
  for (int i = 0; i < 16; i++) {
    const auto xi = float4((i + 0.5) / 16, 0.7, ((i * 3) % 16 + 0.5) / 16, ((i * 5) % 16 + 0.5) / 16);
    const auto r = normalSample(layered, xi, wo);
    #assert(r.success);
    #assert(r.pdf > 0.0);
    #assert(#all(math::normalize(r.wm) ~== |1e-5| r.wm)); // Unit...
    #assert(math::dot(r.wm, wo) > 0.0);                   // ...on `wo`'s side
    #assert(normalEvaluate(layered, wo, r.wm) ~== |1e-5| r.pdf);
    // The reported roughness is the drawn lobe's own, not the mixture's.
    #assert((r.alpha.x ~== |1e-6| 0.36) | (r.alpha.x ~== |1e-6| 0.0625));
    seenSmooth += int(r.alpha.x < 0.1);
    seenRough += int(r.alpha.x > 0.1);
  }
  #assert((seenSmooth > 0) & (seenRough > 0)); // Else the mixture is untested
  // The mixture is strictly between the two lobes it mixes, which is what
  // makes the agreement above a statement about the mixture rather than
  // about one lobe the layer happened to always pick.
  const auto wm = normalSample(layered, float4(0.3, 0.7, 0.5, 0.05), wo).wm;
  const auto densitySmooth = normalEvaluate(smooth, wo, wm);
  const auto densityRough = normalEvaluate(rough, wo, wm);
  const auto densityBoth = normalEvaluate(layered, wo, wm);
  #assert((densitySmooth > 0.0) & (densityRough > 0.0));
  #assert(!(densitySmooth ~== |1e-3| densityRough)); // Else nothing is mixed
  #assert(#min(densitySmooth, densityRough) < densityBoth);
  #assert(densityBoth < #max(densitySmooth, densityRough));
}

// Check that the reported normal density integrates to one over the
// hemisphere, which it must or it is not the density of anything. This is the
// check that would have caught reporting a tightened sampling density against
// its untightened support.
void checkNormalIntegral(const bsdf scattering, const float3 wo) {
  const int n = 400;
  double integral = 0;
  for (int i = 0; i < n; i++) {
    for (int j = 0; j < n; j++) {
      const auto wm = sampling::uniform_hemisphere_sample(float2((i + 0.5) / n, (j + 0.5) / n));
      integral += normalEvaluate(scattering, wo, wm);
    }
  }
  #assert(float(integral * $TWO_PI / (n * n)) ~== |2e-2| 1.0);
}

unit_test "Normal distribution normalization" {
  const auto wo = math::normalize(float3(0.2, -0.3, 0.93));
  checkNormalIntegral(df::microfacet_ggx_smith_bsdf(roughness_u: 0.5, roughness_v: 0.5, tint: 1.0), wo);
  checkNormalIntegral(df::microfacet_ggx_smith_bsdf(roughness_u: 0.5, roughness_v: 0.5, tint: 1.0, mode: df::scatter_reflect_transmit), wo);
  checkNormalIntegral(df::microfacet_ggx_vcavities_bsdf(roughness_u: 0.5, roughness_v: 0.5, tint: 1.0), wo);
  checkNormalIntegral(df::microfacet_beckmann_smith_bsdf(roughness_u: 0.5, roughness_v: 0.5, tint: 1.0), wo);
  checkNormalIntegral(df::simple_glossy_bsdf(roughness_u: 0.5, roughness_v: 0.5, tint: 1.0), wo);
  checkNormalIntegral(df::ward_geisler_moroder_bsdf(roughness_u: 0.5, roughness_v: 0.5, tint: 1.0), wo);
  // And a mixture, where the density is the mixture's rather than a leaf's.
  checkNormalIntegral(df::weighted_layer(
    weight: 0.4,
    layer: df::microfacet_ggx_smith_bsdf(roughness_u: 0.4, roughness_v: 0.4, tint: 1.0),
    base: df::microfacet_beckmann_smith_bsdf(roughness_u: 0.7, roughness_v: 0.7, tint: 1.0)), wo);
  checkNormalIntegral(df::normalized_mix(df::bsdf_component[2](
    df::bsdf_component(weight: 0.3, component: df::microfacet_ggx_smith_bsdf(roughness_u: 0.4, tint: 1.0)),
    df::bsdf_component(weight: 0.7, component: df::simple_glossy_bsdf(roughness_u: 0.6, tint: 1.0)))), wo);
}

// The proposal is the lobe's own distribution and not merely something
// lobe-shaped: the density reported here, carried through the half-vector
// Jacobian, is the density `scatterEvaluate` reports for the direction that
// half vector produces. Masked to one domain, so the reflect-transmit
// selection weight drops out of both sides.
//
// Reflection-only GGX lobes are deliberately absent: `scatterSample` draws
// those from a bounded spherical cap and the normal queries do not, which is
// the one place the two distributions differ on purpose.
unit_test "Normal distribution matches the scattering density" {
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.87));
  const auto glass = df::microfacet_ggx_smith_bsdf(
    roughness_u: 0.45, roughness_v: 0.45, tint: 1.0, mode: df::scatter_reflect_transmit);
  const auto ior = 1.0 / 1.4; // The relative ratio the BSDF works in
  for (int i = 0; i < 8; i++) {
    const auto xi = float4((i + 0.5) / 8, 0.7, 0.5, 0.5);
    const auto r = normalSample(glass, xi, wo);
    #assert(r.success);
    const auto wm = r.wm;
    // Reflection: the Jacobian is `1 / (4 |wo . wm|)`.
    const auto wiR = df::specular::reflect(wo, wm);
    if (wiR.z > 0.05) {
      const auto expect = r.pdf / (4 * math::dot(wo, wm));
      #assert(evaluate(glass, wo, wiR, lobeMask: df::DF_GLOSSY_BRDF).pdf.x ~== |1e-3| expect);
    }
    // Transmission: the Jacobian the refraction half vector carries.
    const auto wiT = df::specular::refract(wo, wm, ior);
    if (wiT.z < -0.05) {
      const auto expect = r.pdf * df::specular::refraction_half_vector_jacobian(wo, wiT, ior);
      #assert(evaluate(glass, wo, wiT, lobeMask: df::DF_GLOSSY_BTDF).pdf.x ~== |1e-3| expect);
    }
  }
}

// Nothing without a normal distribution answers, whatever the mask says, and
// a mask naming a domain the glossy lobes do not reach answers with nothing.
unit_test "Normal distribution masking" {
  const auto wo = math::normalize(float3(0.2, -0.3, 0.93));
  const auto xi = float4(0.3, 0.7, 0.5, 0.5);
  // A reflection-only glossy lobe has nothing transmissive to offer.
  const auto glossyReflect = df::microfacet_ggx_smith_bsdf(roughness_u: 0.4, tint: 0.9);
  #assert(normalSample(glossyReflect, xi, wo).success);
  #assert(!normalSample(glossyReflect, xi, wo, lobeMask: df::DF_GLOSSY_BTDF).success);
  // Neither does a Dirac lobe, nor a diffuse one, at any mask: the promise is
  // attached to `DF_GLOSSY` and nothing else makes it.
  #assert(!normalSample(df::specular_bsdf(mode: df::scatter_reflect_transmit), xi, wo, lobeMask: df::DF_ALL).success);
  #assert(!normalSample(df::diffuse_reflection_bsdf(tint: 0.7), xi, wo, lobeMask: df::DF_ALL).success);
  #assert(!normalSample(df::sheen_bsdf(tint: 0.8, roughness: 0.4), xi, wo, lobeMask: df::DF_ALL).success);
  // Nor the micrograin layer, which declares GENERIC precisely so that it
  // does not: its base is what answers here.
  const auto dusted = df::micrograin_layer(
    filling_factor: 0.4, grain_diffuse_albedo: color(0.5), base: glossyReflect);
  #assert(normalSample(dusted, xi, wo).success);
  #assert(!normalSample(df::micrograin_layer(
    filling_factor: 0.4, grain_diffuse_albedo: color(0.5),
    base: df::diffuse_reflection_bsdf(tint: 0.7)), xi, wo, lobeMask: df::DF_ALL).success);
  // A mask naming nothing selects nothing, as everywhere else.
  #assert(!normalSample(glossyReflect, xi, wo, lobeMask: 0).success);
  #assert(normalEvaluate(glossyReflect, wo, float3(0, 0, 1), lobeMask: 0) == 0.0);
  // A backface hit reports a normal on the side `wo` is on, so that the
  // caller never has to know which side it asked from.
  const auto woBack = math::normalize(float3(0.2, -0.3, -0.93));
  const auto back = normalSample(glossyReflect, xi, woBack);
  #assert(back.success);
  #assert(math::dot(back.wm, woBack) > 0.0);
  #assert(back.wm.z < 0.0);
  #assert(normalEvaluate(glossyReflect, woBack, back.wm) ~== |1e-5| back.pdf);
}

// A layer whose own lobe the mask removes still weights its base by what the
// layer transmits: the pore visibility is this layer's weight on the base,
// not a lobe of its own, so masking cannot drop it.
//
// The base is glossy so the mask has something to cut on. The micrograin lobe
// is GENERIC, deliberately, so a diffuse base would be indistinguishable from
// it by mask and there would be no split to test.
unit_test "Micrograin layer masked additivity" {
  const auto wo = math::normalize(float3(0.2, -0.3, 0.93));
  const auto wi = math::normalize(float3(-0.25, 0.35, 0.9));
  const auto base = df::microfacet_ggx_smith_bsdf(roughness_u: 0.5, roughness_v: 0.5, tint: 0.8);
  const auto scattering = df::micrograin_layer(
    filling_factor: 0.4, beta_u: 0.3, beta_v: 0.3,
    grain_diffuse_albedo: color(0.5), base: base);
  const auto all = evaluate(scattering, wo, wi);
  const auto grain = evaluate(scattering, wo, wi, lobeMask: df::DF_GENERIC);
  const auto through = evaluate(scattering, wo, wi, lobeMask: df::DF_GLOSSY);
  #assert(#any(all.f > 0.0));   // Else the checks pass vacuously
  #assert(#any(grain.f > 0.0)); // Else the split is not exercised
  #assert(#all(all.f ~== |1e-5| grain.f + through.f));
  // The base through the pores is strictly darker than the bare base.
  #assert(#all(through.f > 0.0));
  #assert(#all(through.f < evaluate(base, wo, wi).f));
  // And the micrograin lobe is not a normal distribution a caller can ask
  // for, whatever it has inside: naming the glossy kinds reaches the base.
  #assert(surfaceLobes(scattering) == (df::DF_GENERIC_BRDF | df::DF_GLOSSY_BRDF));
}

// Check the bidirectional consistency of the given BSDF for the given directions:
// 1. The forward and reverse PDFs must swap when the directions swap.
// 2. Importance transport must be the adjoint of radiance transport:
//    `fImp(wo -> wi) / |cos(wi, ng)| == fRad(wi -> wo) / |cos(wo, ng)|`
//    where `ng` is the geometric normal, such that the identity must hold whether or
//    not the shading normal agrees with the geometric normal.
void checkBidirectionalConsistency(const bsdf scattering, const float3 wo, const float3 wi, const float3 normal = float3(0, 0, 1)) {
  const auto rad01 = evaluate(scattering, wo, wi, false, normal);
  const auto rad10 = evaluate(scattering, wi, wo, false, normal);
  const auto imp01 = evaluate(scattering, wo, wi, true, normal);
  const auto imp10 = evaluate(scattering, wi, wo, true, normal);
  #assert(#any(rad01.f > 0.0)); // Else the checks pass vacuously
  #assert(#all(rad01.pdf ~== |1e-5| rad10.pdf.yx));
  #assert(#all(imp01.pdf ~== |1e-5| imp10.pdf.yx));
  #assert(#all(imp01.f * #abs(wo.z) ~== |1e-5| rad10.f * #abs(wi.z)));
  #assert(#all(imp10.f * #abs(wi.z) ~== |1e-5| rad01.f * #abs(wo.z)));
}

// Check that the scattering PDF integrates over the hemisphere selected by
// `zSign` to the sampling acceptance rate, which numerically confirms the
// change-of-variables Jacobian from whatever the sampling routine draws
// internally to incoming directions.
void checkScatterPDFIntegral(const bsdf scattering, const float3 wo, const float zSign,
                             const int lobeMask = df::DF_ALL) {
  const int n = 128;
  double pdfIntegral = 0;
  for (int i = 0; i < n; i++) {
    for (int j = 0; j < n; j++) {
      const auto xi = float2((i + 0.5) / n, (j + 0.5) / n);
      const auto wi = sampling::uniform_hemisphere_sample(xi) * float3(1, 1, zSign);
      pdfIntegral += evaluate(scattering, wo, wi, lobeMask: lobeMask).pdf[0];
    }
  }
  pdfIntegral *= $TWO_PI / (n * n);
  int accepted = 0;
  for (int i = 0; i < n; i++) {
    for (int j = 0; j < n; j++) {
      const auto xi = float4((i + 0.5) / n, (j + 0.5) / n, 0.83, 0.44);
      accepted += #select(sample(scattering, xi, wo, lobeMask: lobeMask).success, 1, 0);
    }
  }
  #assert(#abs(pdfIntegral - accepted / double(n * n)) < 0.015);
}

unit_test "Reciprocity" {
  const auto wo = math::normalize(float3(-0.4, 1.2, 0.2));
  const auto wi = math::normalize(float3(+0.1, -0.7, 0.4));
  const auto f = df::weighted_layer(
    weight: 0.5,
    layer: df::sheen_bsdf(tint: 0.8, roughness: 0.6),
    base: df::fresnel_layer(
      ior: 1.4,
      layer: df::weighted_layer(
        weight: 0.5,
        layer: df::ward_geisler_moroder_bsdf(roughness_u: 0.4, roughness_v: 0.8, tint: 1.0, multiscatter_tint: 1.0),
        base: df::microfacet_ggx_smith_bsdf(roughness_u: 0.2, roughness_v: 0.5, tint: 1.0, multiscatter_tint: 1.0),
      ),
      base: df::diffuse_reflection_bsdf(tint: 0.8, roughness: 0.6),
    ),
  );
  const auto result0 = evaluate(f, wo, wi);
  const auto result1 = evaluate(f, wi, wo);
  #assert(#all(result0.pdf ~== |1e-6| result1.pdf.yx));
  #assert(#all(result0.f / #abs(wi.z) ~== |1e-6| result1.f / #abs(wo.z)));
}

unit_test "Bidirectional consistency" {
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto wi = math::normalize(float3(+0.5, 0.2, 0.9));
  const auto wt = math::normalize(float3(+0.5, 0.2, -0.9));
  const auto ns = math::normalize(float3(0.2, -0.1, 1.0)); // Tilted shading normal
  const auto ggx = df::microfacet_ggx_smith_bsdf(roughness_u: 0.2, roughness_v: 0.5, tint: 1.0, multiscatter_tint: 1.0);
  // Elemental reflection lobes.
  checkBidirectionalConsistency(df::diffuse_reflection_bsdf(tint: 0.8, roughness: 0.7, multiscatter_tint: 0.5), wo, wi);
  checkBidirectionalConsistency(df::diffuse_reflection_bsdf(tint: 0.8, roughness: 0.7, multiscatter_tint: 0.5), wo, wi, ns);
  checkBidirectionalConsistency(df::sheen_bsdf(tint: 0.8, roughness: 0.6, multiscatter_tint: 0.7), wo, wi);
  checkBidirectionalConsistency(df::sheen_bsdf(tint: 0.8, roughness: 0.6, multiscatter_tint: 0.7), wo, wi, ns);
  checkBidirectionalConsistency(df::ward_geisler_moroder_bsdf(roughness_u: 0.4, roughness_v: 0.8, tint: 1.0, multiscatter_tint: 1.0), wo, wi, ns);
  checkBidirectionalConsistency(df::simple_glossy_bsdf(roughness_u: 0.3, roughness_v: 0.6, tint: 0.9), wo, wi, ns);
  checkBidirectionalConsistency(df::microfacet_beckmann_vcavities_bsdf(roughness_u: 0.4, roughness_v: 0.4, tint: 1.0), wo, wi, ns);
  checkBidirectionalConsistency(ggx, wo, wi);
  checkBidirectionalConsistency(ggx, wo, wi, ns);
  // Transmission lobes. NOTE: `wt2` is near the ideal refraction of `wo` so that the
  // narrow Blinn lobe evaluates to something substantial.
  const auto wt2 = math::normalize(float3(0.15, -0.25, -0.9));
  checkBidirectionalConsistency(df::diffuse_transmission_bsdf(tint: 0.7), wo, wt, ns);
  checkBidirectionalConsistency(df::microfacet_ggx_smith_bsdf(roughness_u: 0.3, roughness_v: 0.3, tint: 1.0, mode: df::scatter_transmit), wo, wt);
  checkBidirectionalConsistency(df::microfacet_ggx_smith_bsdf(roughness_u: 0.3, roughness_v: 0.3, tint: 1.0, mode: df::scatter_transmit), wo, wt, ns);
  checkBidirectionalConsistency(df::simple_glossy_bsdf(roughness_u: 0.8, tint: 1.0, mode: df::scatter_transmit), wo, wt2);
  checkBidirectionalConsistency(df::simple_glossy_bsdf(roughness_u: 0.8, tint: 1.0, mode: df::scatter_transmit), wo, wt2, ns);
  checkBidirectionalConsistency(df::simple_glossy_bsdf(roughness_u: 0.8, tint: 1.0, mode: df::scatter_reflect_transmit), wo, wt2);
  checkBidirectionalConsistency(df::microfacet_ggx_smith_bsdf(roughness_u: 0.3, roughness_v: 0.3, tint: 1.0, mode: df::scatter_reflect_transmit), wo, wi);
  checkBidirectionalConsistency(df::microfacet_ggx_smith_bsdf(roughness_u: 0.3, roughness_v: 0.3, tint: 1.0, mode: df::scatter_reflect_transmit), wo, wt);
  // Modifiers.
  checkBidirectionalConsistency(df::thin_film(thickness: 300.0, ior: 1.6, base: ggx), wo, wi);
  checkBidirectionalConsistency(df::thin_film(thickness: 300.0, ior: 1.6, base: ggx), wo, wi, ns);
  checkBidirectionalConsistency(df::thin_film(thickness: 250.0, ior: color(1.35), base: ggx), wo, wi, ns);
  checkBidirectionalConsistency(df::tint(0.5, ggx), wo, wi, ns);
  checkBidirectionalConsistency(df::directional_factor(normal_tint: 0.9, grazing_tint: 0.3, base: ggx), wo, wi, ns);
  checkBidirectionalConsistency(df::fresnel_factor(ior: 1.5, extinction_coefficient: 2.0, base: ggx), wo, wi, ns);
  checkBidirectionalConsistency(df::measured_curve_factor(curve_values: color[3](color(0.9), color(0.5), color(0.2)), base: ggx), wo, wi, ns);
  checkBidirectionalConsistency(df::measured_factor(values: texture_2d("4x4.png", tex::gamma_linear), base: ggx), wo, wi, ns);
  // Layers.
  const auto composite = df::weighted_layer(
    weight: 0.5,
    layer: df::sheen_bsdf(tint: 0.8, roughness: 0.6),
    base: df::fresnel_layer(
      ior: 1.4,
      layer: df::ward_geisler_moroder_bsdf(roughness_u: 0.4, roughness_v: 0.8, tint: 1.0, multiscatter_tint: 1.0),
      base: df::diffuse_reflection_bsdf(tint: 0.8, roughness: 0.6),
    ),
  );
  checkBidirectionalConsistency(composite, wo, wi);
  checkBidirectionalConsistency(composite, wo, wi, ns);
  const auto curveLayer = df::custom_curve_layer(
    normal_reflectivity: 0.2,
    grazing_reflectivity: 0.9,
    exponent: 4.0,
    weight: 0.8,
    layer: df::sheen_bsdf(tint: 1.0, roughness: 0.4),
    base: df::diffuse_reflection_bsdf(tint: 0.3),
  );
  checkBidirectionalConsistency(curveLayer, wo, wi);
  checkBidirectionalConsistency(curveLayer, wo, wi, ns);
  checkBidirectionalConsistency(
    df::color_custom_curve_layer(
      normal_reflectivity: color(0.3),
      grazing_reflectivity: color(0.9),
      weight: color(0.7),
      layer: ggx,
      base: df::diffuse_reflection_bsdf(tint: 0.5),
    ),
    wo, wi, ns,
  );
  checkBidirectionalConsistency(
    df::micrograin_layer(
      filling_factor: 0.5,
      beta_u: 2.0,
      grain_ior: 1.0152,
      grain_extinction: 6.6273,
      base: df::diffuse_reflection_bsdf(tint: 0.8),
    ),
    wo, wi,
  );
  checkBidirectionalConsistency(
    df::micrograin_layer(
      filling_factor: 0.3,
      grain_diffuse_albedo: color(0.6, 0.4, 0.2),
      grain_ior: 1.6,
      base: df::diffuse_reflection_bsdf(tint: 0.5, roughness: 0.4),
    ),
    wo, wi, ns,
  );
  checkBidirectionalConsistency(
    df::micrograin_layer(
      filling_factor: 0.4,
      grain_diffuse_albedo: 0.3,
      base: df::diffuse_transmission_bsdf(tint: 0.7),
    ),
    wo, wt,
  );
  checkBidirectionalConsistency(
    df::micrograin_layer(
      filling_factor: 0.6,
      beta_u: 3.0,
      beta_v: 0.5,
      grain_ior: 1.0152,
      grain_extinction: 6.6273,
      base: df::diffuse_reflection_bsdf(tint: 0.6),
    ),
    wo, wi, ns,
  );
  const auto measuredLayer = df::measured_curve_layer(
    curve_values: color[2](color(0.9), color(0.1)),
    weight: 0.8,
    layer: df::sheen_bsdf(tint: 1.0, roughness: 0.4),
    base: df::diffuse_reflection_bsdf(tint: 0.3),
  );
  checkBidirectionalConsistency(measuredLayer, wo, wi);
  checkBidirectionalConsistency(measuredLayer, wo, wi, ns);
}

unit_test "Microfacet transmission PDF" {
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  checkScatterPDFIntegral(df::simple_glossy_bsdf(roughness_u: 0.7, tint: 1.0, mode: df::scatter_transmit), wo, -1.0);
  checkScatterPDFIntegral(df::simple_glossy_bsdf(roughness_u: 0.4, tint: 1.0, mode: df::scatter_transmit), wo, -1.0);
  checkScatterPDFIntegral(df::microfacet_ggx_smith_bsdf(roughness_u: 0.7, tint: 1.0, mode: df::scatter_transmit), wo, -1.0);
  checkScatterPDFIntegral(df::microfacet_ggx_smith_bsdf(roughness_u: 0.4, tint: 1.0, mode: df::scatter_transmit), wo, -1.0);
}

unit_test "Measured BSDF" {
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto wi = math::normalize(float3(+0.5, 0.2, 0.9));
  const auto ns = math::normalize(float3(0.2, -0.1, 1.0));
  const auto m = bsdf_measurement("test.mbsdf");
  #assert(df::bsdf_measurement_isvalid(m));
  // The synthetic measurement is reciprocal, so the full bidirectional
  // consistency harness applies, tilted shading normal included.
  checkBidirectionalConsistency(df::measured_bsdf(measurement: m), wo, wi);
  checkBidirectionalConsistency(df::measured_bsdf(measurement: m), wo, wi, ns);
  // The PDF must integrate over the reflection hemisphere to the sampling
  // acceptance rate.
  checkScatterPDFIntegral(df::measured_bsdf(measurement: m), wo, +1.0);
  // The multiplier scales the scattering function and leaves the PDFs alone.
  const auto result1 = evaluate(df::measured_bsdf(measurement: m), wo, wi);
  const auto result2 = evaluate(df::measured_bsdf(measurement: m, multiplier: 2.0), wo, wi);
  #assert(#any(result1.f > 0.0));
  #assert(#all(result2.f ~== |1e-5| 2.0 * result1.f));
  #assert(#all(result2.pdf ~== |1e-6| result1.pdf));
}

unit_test "Specular delta shading normal correction" {
  const auto ns = math::normalize(float3(0.2, -0.1, 1.0)); // Tilted shading normal
  const auto wo = math::normalize(float3(0.3, 0.2, 1.5));
  const auto xi = float4(0.3, 0.4, 0.5, 0.6);
  // Reflection: radiance transport applies no weight, importance transport applies
  // the shading normal correction.
  {
    const auto bsdfR = df::specular_bsdf(tint: 1.0, mode: df::scatter_reflect);
    const auto rad = sample(bsdfR, xi, wo, false, ns);
    const auto imp = sample(bsdfR, xi, wo, true, ns);
    #assert(rad.success && rad.isDelta);
    #assert(imp.success && imp.isDelta);
    #assert(#all(imp.wi ~== |1e-6| rad.wi));
    #assert(#all(rad.f ~== |1e-6| color(1.0)));
    const auto corr = #abs(math::dot(wo, ns) * rad.wi.z) / #abs(math::dot(rad.wi, ns) * wo.z);
    #assert(#all(imp.f ~== |1e-5| color(corr)));
    // With the default shading normal the correction must be the identity.
    const auto impDefault = sample(bsdfR, xi, wo, true);
    #assert(#all(impDefault.f ~== |1e-6| color(1.0)));
  }
  // Transmission: radiance transport applies the solid-angle compression `ior * ior`,
  // importance transport applies the shading normal correction.
  {
    const auto bsdfT = df::specular_bsdf(tint: 1.0, mode: df::scatter_transmit);
    const auto rad = sample(bsdfT, xi, wo, false, ns);
    const auto imp = sample(bsdfT, xi, wo, true, ns);
    #assert(rad.success && rad.isDelta);
    #assert(imp.success && imp.isDelta);
    #assert(#all(imp.wi ~== |1e-6| rad.wi));
    #assert(rad.wi.z < 0.0);
    #assert(#all(rad.f ~== |1e-5| color((1.0 / 1.4) * (1.0 / 1.4)))); // Material IOR defaults to 1.4
    const auto corr = #abs(math::dot(wo, ns) * rad.wi.z) / #abs(math::dot(rad.wi, ns) * wo.z);
    #assert(#all(imp.f ~== |1e-5| color(corr)));
  }
}

unit_test "Specular transmission round trip" {
  // Enter a solid dielectric through the front face, then send the ray back
  // out through the same interface from inside: the exit direction must undo
  // the entry refraction exactly, and the `ior * ior` radiance compressions
  // must cancel. This exercises the backface reciprocation of the relative
  // IOR through the full sampling machinery.
  const auto bsdfT = df::specular_bsdf(tint: 1.0, mode: df::scatter_transmit);
  const auto xi = float4(0.3, 0.4, 0.5, 0.6);
  const auto wo = math::normalize(float3(0.6, -0.2, 0.9));
  const auto rIn = sample(bsdfT, xi, wo);
  #assert(rIn.success && rIn.isDelta);
  #assert(rIn.wi.z < 0.0);
  const auto rOut = sample(bsdfT, xi, rIn.wi);
  #assert(rOut.success && rOut.isDelta);
  #assert(#all(rOut.wi ~== |1e-5| wo));
  #assert(#all(rIn.f * rOut.f ~== |1e-5| color(1.0)));
}

unit_test "Thin-walled specular delta transmission" {
  // Thin-walled surfaces enclose no volume: specular transmission passes
  // straight through, with no refraction and no radiance compression.
  const auto wo = math::normalize(float3(0.3, 0.2, 1.5));
  const auto r = sample(df::specular_bsdf(tint: 1.0, mode: df::scatter_transmit), float4(0.8, 0.4, 0.5, 0.6), wo, false, float3(0, 0, 1), true);
  #assert(r.success && r.isDelta);
  #assert(#all(r.wi ~== |1e-6| -wo));
  #assert(#all(r.f ~== |1e-6| color(1.0)));
}

unit_test "Fresnel layer backface total internal reflection" {
  // From inside a solid (a backface hit), the layer weight must use the
  // dense-to-rare ratio, which reaches total internal reflection.
  const auto wo = math::normalize(float3(+0.866, 0.1, -0.5));
  const auto wi = math::normalize(float3(-0.866, 0.1, -0.5));
  const auto layerB = df::diffuse_reflection_bsdf(tint: 1.0);
  const auto rLayer = evaluate(layerB, wo, wi);
  #assert(#any(rLayer.f > 0.0));
  // Beyond the critical angle the Fresnel weight is exactly 1, so the
  // layered result equals the bare layer.
  const auto rBack = evaluate(df::fresnel_layer(ior: 1.5, layer: layerB), wo, wi);
  #assert(#all(rBack.f ~== |1e-5| rLayer.f));
  // The mirrored front-face geometry is nowhere near total: the weight is
  // the ordinary dielectric reflectance, well below 1.
  const auto rFront = evaluate(df::fresnel_layer(ior: 1.5, layer: layerB), -wo, -wi);
  #assert(#all(rFront.f < 0.5 * rLayer.f));
}

unit_test "Fresnel layer defines the layer interface" {
  // The nested layer refracts with the fresnel_layer IOR rather than the
  // material IOR, and the PDF weight equals the dielectric Fresnel selection
  // chance exactly, so the layered PDF must be the bare-layer PDF (evaluated
  // in a material whose IOR matches the layer interface) scaled by the
  // chance.
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto layerB = df::microfacet_ggx_smith_bsdf(roughness_u: 0.5, tint: 1.0, mode: df::scatter_transmit);
  const auto layered = df::fresnel_layer(ior: 1.8, layer: layerB);
  const auto chance = df::specular::dielectric_fresnel(wo.z, 1 / 1.8);
  auto xi2 = float2(0.3, 0.7);
  for (int k = 0; k < 16; k++, sampling::next_low_discrepancy(&xi2)) {
    const auto wi = sampling::uniform_hemisphere_sample(xi2) * float3(1, 1, -1.0);
    const auto rBare = evaluate(layerB, wo, wi, false, float3(0, 0, 1), false, 1.8);
    const auto rLayered = evaluate(layered, wo, wi, false, float3(0, 0, 1), false, 1.8);
    #assert(rLayered.pdf[0] ~== |1e-5| chance * rBare.pdf[0]);
  }
  // The layered transmission must also satisfy the full bidirectional
  // consistency identities even when the layer interface disagrees with the
  // material IOR, which requires the Fresnel weight to see the same half
  // vector from both directions.
  const auto wt = math::normalize(float3(0.18, -0.24, -0.95));
  checkBidirectionalConsistency(layered, wo, wt);
}

unit_test "Nested dielectric exterior IOR" {
  // A glass interface (IOR 1.5) submerged in water (IOR 4/3) must behave
  // exactly like an interface with the equivalent relative IOR 1.5/(4/3)
  // in vacuum: same refraction direction, same radiance compression, same
  // Fresnel weights.
  const auto nWater = 4.0 / 3.0;
  const auto nGlass = 1.5;
  const auto bsdfT = df::specular_bsdf(tint: 1.0, mode: df::scatter_transmit);
  const auto xi = float4(0.3, 0.4, 0.5, 0.6);
  const auto wo = math::normalize(float3(0.6, -0.2, 0.9));
  const auto r1 = sample(bsdfT, xi, wo, false, float3(0, 0, 1), false, nGlass, nWater);
  const auto r2 = sample(bsdfT, xi, wo, false, float3(0, 0, 1), false, nGlass / nWater, 1.0);
  #assert(r1.success && r2.success);
  #assert(#all(r1.wi ~== |1e-5| r2.wi));
  #assert(#all(r1.f ~== |1e-5| r2.f));
  #assert(#all(r1.f ~== |1e-5| color(#pow(nWater / nGlass, 2))));
  // Exiting back out through the interface restores the direction and
  // cancels the radiance compression.
  const auto rOut = sample(bsdfT, xi, r1.wi, false, float3(0, 0, 1), false, nGlass, nWater);
  #assert(rOut.success);
  #assert(#all(rOut.wi ~== |1e-5| wo));
  #assert(#all(r1.f * rOut.f ~== |1e-5| color(1.0)));
  // Modifiers convert their absolute IOR against the same exterior: a
  // fresnel_layer in water equals the equivalent relative layer in vacuum.
  const auto wiR = math::normalize(float3(-0.5, 0.1, 0.8));
  const auto layerB = df::diffuse_reflection_bsdf(tint: 1.0);
  const auto e1 = evaluate(df::fresnel_layer(ior: nGlass, layer: layerB), wo, wiR, false, float3(0, 0, 1), false, nGlass, nWater);
  const auto e2 = evaluate(df::fresnel_layer(ior: nGlass / nWater, layer: layerB), wo, wiR, false, float3(0, 0, 1), false, nGlass / nWater, 1.0);
  #assert(#any(e1.f > 0.0));
  #assert(#all(e1.f ~== |1e-5| e2.f));
  #assert(#all(e1.pdf ~== |1e-5| e2.pdf));
}

unit_test "Fresnel-weighted reflect-transmit decomposition" {
  // With `scatter_reflect_transmit`, the microfacet lobe must be the pure
  // reflect and transmit lobes weighted by the dielectric Fresnel term: the
  // scattering function by the term at the half vector, and the PDFs by the
  // term at the macro normal (forward lane from the wo side, reverse lane
  // from the wi side), which is exactly the sampling selection chance.
  const auto eta = 1 / 1.4; // Entering relative ratio at the default material IOR
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto wiR = math::normalize(float3(+0.5, 0.2, 0.9));
  const auto wiT = math::normalize(float3(0.2, -0.3, -0.9));
  const auto bR = df::microfacet_ggx_smith_bsdf(roughness_u: 0.5, tint: 1.0, mode: df::scatter_reflect);
  const auto bT = df::microfacet_ggx_smith_bsdf(roughness_u: 0.5, tint: 1.0, mode: df::scatter_transmit);
  const auto bRT = df::microfacet_ggx_smith_bsdf(roughness_u: 0.5, tint: 1.0, mode: df::scatter_reflect_transmit);
  const auto Fo = df::specular::dielectric_fresnel(wo.z, eta);
  // Reflection pair.
  {
    const auto r1 = evaluate(bR, wo, wiR);
    const auto r2 = evaluate(bRT, wo, wiR);
    const auto h = math::normalize(wo + wiR);
    const auto Fh = df::specular::dielectric_fresnel(math::dot(wo, h), eta);
    const auto Fi = df::specular::dielectric_fresnel(wiR.z, eta);
    #assert(#any(r1.f > 0.0));
    #assert(#all(r2.f ~== |1e-5| Fh * r1.f));
    // The pure reflect lobe reports bounded-VNDF densities (Eto and
    // Tokuyoshi 2023) while the reflect-transmit lobe samples the full
    // spherical cap, so undo the bound before comparing the PDFs.
    const auto alpha = float2(0.5 * 0.5);
    const auto kO = df::microfacet::ggx_bounded_cap_factor(alpha, wo);
    const auto kI = df::microfacet::ggx_bounded_cap_factor(alpha, wiR);
    const auto tO = math::length(float3(alpha.x * wo.x, alpha.y * wo.y, wo.z));
    const auto tI = math::length(float3(alpha.x * wiR.x, alpha.y * wiR.y, wiR.z));
    const auto unbound = float2((kO * wo.z + tO) / (wo.z + tO), (kI * wiR.z + tI) / (wiR.z + tI));
    #assert(#all(r2.pdf ~== |1e-5| float2(Fo, Fi) * r1.pdf * unbound));
  }
  // Transmission pair. The reverse PDF lane sees the reciprocal ratio.
  {
    const auto r1 = evaluate(bT, wo, wiT);
    const auto r2 = evaluate(bRT, wo, wiT);
    const auto h = math::normalize(df::specular::refraction_half_vector(wo, wiT, eta));
    const auto Fh = df::specular::dielectric_fresnel(math::dot(wo, h), eta);
    const auto Fi = df::specular::dielectric_fresnel(-wiT.z, 1 / eta);
    #assert(#any(r1.f > 0.0));
    #assert(#all(r2.f ~== |1e-5| (1 - Fh) * r1.f));
    #assert(#all(r2.pdf ~== |1e-5| (1 - float2(Fo, Fi)) * r1.pdf));
  }
}

// Integrate the BSDF over the full sphere of incoming directions under
// importance transport (which carries no solid-angle compression), giving
// the single-scattering albedo.
float furnaceIntegral(const bsdf scattering, const float3 wo) {
  const int n = 100;
  double sum = 0;
  for (int i = 0; i < n; i++) {
    for (int j = 0; j < n; j++) {
      const auto xi = float2((i + 0.5) / n, (j + 0.5) / n);
      const auto wi = sampling::uniform_sphere_sample(xi);
      sum += evaluate(scattering, wo, wi, true).f[0];
    }
  }
  return 2 * $TWO_PI * sum / (n * n);
}

unit_test "Fresnel-weighted dielectric white furnace" {
  // The one-shot Fresnel-weighted `scatter_reflect_transmit` lobe must
  // (approximately) conserve energy: the full-sphere integral is the
  // single-scattering albedo, bounded by 1 and close to it for moderate
  // roughness. From inside beyond the critical angle, transmission shuts
  // off and reflection must pick up the energy -- the pre-Fresnel 50/50
  // split lost half of it there.
  const auto bRT = df::microfacet_ggx_smith_bsdf(roughness_u: 0.5, tint: 1.0, mode: df::scatter_reflect_transmit);
  const auto Eout = furnaceIntegral(bRT, math::normalize(float3(0.5, 0.2, 0.9)));
  #assert((0.80 < Eout) & (Eout < 1.01));
  const auto Ein = furnaceIntegral(bRT, math::normalize(float3(0.8, 0.1, -0.6)));
  #assert((0.70 < Ein) & (Ein < 1.01));
}

unit_test "EON diffuse white furnace" {
  // The energy-preserving Oren-Nayar model must integrate to the
  // single-scattering albedo 1 at unit tint, for any roughness and any
  // view direction.
  for (int k = 0; k < 3; k++) {
    const auto r = float(0.25 + 0.375 * k);
    const auto b = df::diffuse_reflection_bsdf(tint: 1.0, roughness: r);
    const auto E0 = furnaceIntegral(b, math::normalize(float3(0.1, 0.2, 0.97)));
    const auto E1 = furnaceIntegral(b, math::normalize(float3(0.8, 0.1, 0.35)));
    #assert((0.97 < E0) & (E0 < 1.03));
    #assert((0.97 < E1) & (E1 < 1.03));
  }
}

unit_test "EON CLTC sampling PDF" {
  // The CLTC + uniform mixture density reported by evaluation must match
  // the sampling routine, including at grazing views where the CLTC lobe
  // leans below the horizon.
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto woG = math::normalize(float3(0.8, 0.1, 0.15));
  checkScatterPDFIntegral(df::diffuse_reflection_bsdf(tint: 0.8, roughness: 0.5), wo, 1.0);
  checkScatterPDFIntegral(df::diffuse_reflection_bsdf(tint: 0.8, roughness: 1.0), wo, 1.0);
  checkScatterPDFIntegral(df::diffuse_reflection_bsdf(tint: 0.8, roughness: 1.0), woG, 1.0);
}

unit_test "Bounded VNDF sampling PDF" {
  // The tightened densities reported for reflection-only GGX lobes must
  // match the bounded spherical-cap sampling routine.
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto woG = math::normalize(float3(0.8, 0.1, 0.2));
  checkScatterPDFIntegral(df::microfacet_ggx_smith_bsdf(roughness_u: 0.2, tint: 1.0), wo, 1.0);
  checkScatterPDFIntegral(df::microfacet_ggx_smith_bsdf(roughness_u: 0.9, tint: 1.0), wo, 1.0);
  checkScatterPDFIntegral(df::microfacet_ggx_smith_bsdf(roughness_u: 0.9, roughness_v: 0.3, tint: 1.0), woG, 1.0);
  checkScatterPDFIntegral(df::microfacet_ggx_vcavities_bsdf(roughness_u: 0.7, tint: 1.0), wo, 1.0);
  // With a compensation lobe in the mixture, each restricted density has to
  // integrate to its OWN sampler's acceptance rate rather than the mixture's,
  // which is what makes a masked value over a masked density an estimator of
  // the masked part.
  const auto ms = df::microfacet_ggx_smith_bsdf(roughness_u: 0.8, tint: 1.0, multiscatter_tint: color(1.0));
  checkScatterPDFIntegral(ms, wo, 1.0);
  checkScatterPDFIntegral(ms, wo, 1.0, df::DF_GLOSSY);
  checkScatterPDFIntegral(ms, wo, 1.0, df::DF_GENERIC);
}

unit_test "LTC sheen energy and sampling PDF" {
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto woG = math::normalize(float3(0.8, 0.1, 0.2));
  // The sheen lobe reflects at most the tabulated directional albedo, so
  // at unit tint the furnace integral must stay bounded by 1.
  for (int k = 0; k < 3; k++) {
    const auto r = float(0.2 + 0.4 * k);
    const auto b = df::sheen_bsdf(tint: 1.0, roughness: r);
    const auto E0 = furnaceIntegral(b, wo);
    const auto E1 = furnaceIntegral(b, woG);
    #assert((0.0 <= E0) & (E0 < 1.02));
    #assert((0.0 <= E1) & (E1 < 1.02));
  }
  // With full multiscatter compensation the total stays near or below 1.
  const auto EMS = furnaceIntegral(df::sheen_bsdf(tint: 1.0, roughness: 0.6, multiscatter_tint: 1.0), wo);
  #assert((0.2 < EMS) & (EMS < 1.05));
  // The LTC sampling densities must match the sampling routine, including
  // the cosine fallback where the fit degenerates and the multiscatter
  // sampling chance.
  checkScatterPDFIntegral(df::sheen_bsdf(tint: 1.0, roughness: 0.3), wo, 1.0);
  checkScatterPDFIntegral(df::sheen_bsdf(tint: 1.0, roughness: 0.8), woG, 1.0);
  checkScatterPDFIntegral(df::sheen_bsdf(tint: 1.0, roughness: 0.6, multiscatter_tint: 0.8), wo, 1.0);
}

// Like `checkScatterPDFIntegral`, but drives the sampling routine with a
// full 4D low-discrepancy sequence so that stochastic lobe-selection
// branches (e.g. layer-vs-base chances) are explored in proportion. This is
// required whenever the component lobes have different acceptance rates.
void checkScatterPDFIntegralStochastic(const bsdf scattering, const float3 wo, const float zSign) {
  const int n = 128;
  double pdfIntegral = 0;
  for (int i = 0; i < n; i++) {
    for (int j = 0; j < n; j++) {
      const auto xiDir = float2((i + 0.5) / n, (j + 0.5) / n);
      const auto wi = sampling::uniform_hemisphere_sample(xiDir) * float3(1, 1, zSign);
      pdfIntegral += evaluate(scattering, wo, wi).pdf[0];
    }
  }
  pdfIntegral *= $TWO_PI / (n * n);
  int accepted = 0;
  float4 xi = float4(0.19, 0.53, 0.83, 0.44);
  for (int i = 0; i < n * n; i++, sampling::next_low_discrepancy(&xi)) {
    const auto r = sample(scattering, xi, wo);
    accepted += #select(r.success & (r.wi.z * zSign > 0.0), 1, 0);
  }
  #assert(#abs(pdfIntegral - accepted / double(n * n)) < 0.015);
}

unit_test "Ward sampling PDF" {
  // The anisotropic Ward-Geisler-Moroder sampling routine must match the
  // density evaluation reports. The multiscatter variant selects its
  // diffuse lobe stochastically, so it needs the low-discrepancy checker.
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto woG = math::normalize(float3(0.8, 0.1, 0.2));
  checkScatterPDFIntegral(df::ward_geisler_moroder_bsdf(roughness_u: 0.4, roughness_v: 0.8, tint: 1.0), wo, 1.0);
  // The grazing view keeps the roughness high enough for the checker's
  // grid to resolve the lobe, as in "Bounded VNDF sampling PDF".
  checkScatterPDFIntegral(df::ward_geisler_moroder_bsdf(roughness_u: 0.7, roughness_v: 0.3, tint: 1.0), woG, 1.0);
  checkScatterPDFIntegralStochastic(df::ward_geisler_moroder_bsdf(roughness_u: 0.5, roughness_v: 0.3, tint: 1.0, multiscatter_tint: 1.0), wo, 1.0);
}

unit_test "Micrograin NDF and GAF" {
  // The cosine-weighted hemisphere integral of the micrograin NDF must be
  // 1, including for anisotropic stretching.
  {
    const auto configs = float3[4](
      float3(0.10, 0.5, 0.5), float3(0.50, 1.0, 1.0),
      float3(0.90, 3.0, 3.0), float3(0.50, 3.0, 0.5));
    for (int k = 0; k < 4; k++) {
      const auto tau0 = configs[k].x;
      const auto beta = float2(configs[k].y, configs[k].z);
      double fSum = 0;
      const int n = 512 * 512;
      float2 xi = float2(0.228, 0.712);
      for (int i = 0; i < n; i++, sampling::next_low_discrepancy(&xi)) {
        fSum += df::micrograin::normal_pdf(tau0, beta, sampling::cosine_hemisphere_sample(xi));
      }
      #assert($PI * fSum / n ~== |1e-2| 1.0);
    }
  }
  // The sampling routine must agree with the NDF: verify the closed-form
  // CDF inversion round trip at a few quantiles for isotropic grains.
  {
    const auto tau0 = 0.6;
    for (int k = 1; k < 8; k++) {
      const auto wm = df::micrograin::normal_sample(tau0, float2(2.0), k / 8.0, 0.37);
      #assert(wm.z > 0.0);
      #assert(math::length(wm) ~== |1e-5| 1.0);
    }
  }
  // Shadow areas are non-negative and vanish at normal incidence and at
  // the grain tip; the distant GAF is in (0, 1] and equals 1 at normal
  // incidence.
  #assert(df::micrograin::shadow_area(1.0, 0.5) == 0.0);
  #assert(df::micrograin::shadow_area(0.3, 1.0) == 0.0);
  #assert(df::micrograin::shadow_area(0.3, 0.0) > 0.0);
  for (int k = 0; k < 5; k++) {
    const auto mu = 0.05 + 0.9 * k / 4.0;
    const auto G = df::micrograin::distant_gaf(0.5, float3(#sqrt(1 - mu * mu), 0.0, mu), float3(0.0, 0.0, 1.0), 0.3);
    #assert((0.0 < G) & (G <= 1.0));
  }
  #assert(df::micrograin::distant_gaf(0.5, float3(0.0, 0.0, 1.0), float3(0.0, 0.0, 1.0), 0.5) ~== |1e-6| 1.0);
  // At pore level the shadow area has the closed form of Appendix C.
  #assert(df::micrograin::shadow_area(0.4, 0.0) ~== |1e-5| float(0.5 * $PI * (1.0 / 0.4 - 1.0)));
}

// Brute-force reference for the micrograin shadow areas of Appendix A/B:
// is the point `p` on the plane at height `h` shadowed by the unit-sphere
// cap above `h` from direction `d`, excluding the cap footprint itself?
@(pure)
bool micrograinInShadow(const float3 d, const float h, const float2 p) {
  return false if (#sum(p * p) <= 1 - h * h + 1e-9);
  const auto p0(float3(p, h));
  const float b(#sum(p0 * d));
  const float c(#sum(p0 * p0) - 1);
  const float disc(b * b - c);
  return false if (!(disc > 0));
  const float sq(#sqrt(disc));
  return ((t0 := -b - sq) > 1e-6 && p0.z + t0 * d.z >= h - 1e-6) ||
         ((t1 := -b + sq) > 1e-6 && p0.z + t1 * d.z >= h - 1e-6);
}

unit_test "Micrograin shadow areas against brute force" {
  // Validate the closed-form spherical-cap shadow area and the shadow
  // overlap area against area-sampled ray-traced references, over a mix
  // of zenith angles, azimuthal separations, and heights.
  const auto configs = float4[6](
    float4(0.4, 0.7, 0.0, 0.3),  // thetai-cos, thetao-cos, dphi, h
    float4(0.3, 0.3, 0.5, 0.5),
    float4(0.6, 0.25, 2.5, 0.4),
    float4(0.5, 0.5, 3.14159, 0.6),
    float4(0.35, 0.45, 1.0, 0.0),
    float4(0.25, 0.3, 0.15, 0.35));
  for (int k = 0; k < 6; k++) {
    const auto mui = configs[k].x;
    const auto muo = configs[k].y;
    const auto dphi = configs[k].z;
    const auto h = configs[k].w;
    const auto wiT = float3(#sqrt(1 - mui * mui), 0.0, mui);
    const auto woT = float3(#sqrt(1 - muo * muo) * float2(#cos(dphi), #sin(dphi)), muo);
    const float R = 1.5 / #min(mui, muo) + 2.0;
    double countI = 0;
    double countBoth = 0;
    const int n = 512 * 512;
    float2 xi = float2(0.37, 0.61);
    for (int s = 0; s < n; s++, sampling::next_low_discrepancy(&xi)) {
      const auto p = R * (2 * xi - 1);
      const bool inI = micrograinInShadow(wiT, h, p);
      const bool inO = micrograinInShadow(woT, h, p);
      countI += #select(inI, 1.0, 0.0);
      countBoth += #select(inI & inO, 1.0, 0.0);
    }
    const float area = 4.0 * R * R / n;
    const float sigmaIRef = float(countI * area);
    const float sigmaBothRef = float(countBoth * area);
    const float sigmaI = df::micrograin::shadow_area(mui, h);
    const float sigmaBoth = df::micrograin::shadow_overlap_area(wiT, woT, h);
    #assert(#abs(sigmaI - sigmaIRef) < 0.03 * (1.0 + sigmaIRef));
    #assert(#abs(sigmaBoth - sigmaBothRef) < 0.04 * (1.0 + sigmaBothRef));
  }
}

unit_test "Micrograin retro-reflection" {
  // The directional correlation of the fully-correlated GAF must produce
  // a retro-reflection peak: with view and light aligned, the shadows
  // coincide and attenuation drops [paper Fig. 11].
  const auto wo = math::normalize(float3(0.75, 0.0, 0.55));
  const auto woOff = math::normalize(float3(0.75 * #cos(0.35), 0.75 * #sin(0.35), 0.55));
  const auto m = df::micrograin_layer(
    filling_factor: 0.2, beta_u: 2.0,
    grain_ior: 1.0152, grain_extinction: 6.6273, base: bsdf());
  const auto fRetro = evaluate(m, wo, wo).f;
  const auto fOff = evaluate(m, wo, woOff).f;
  #assert(#any(fRetro > 0.0));
  #assert(#all(fRetro > fOff));
}

unit_test "Micrograin grazing brightening" {
  // The signature dusty-layer behavior: toward grazing the visible grain
  // fraction tends to 1 while the base is masked away, so a diffuse-grain
  // layer on a black base must brighten -- never darken to a rim outline
  // -- as the view goes to grazing [2024 paper Eqs. 21 and 25, Fig. 8].
  const auto m = df::micrograin_layer(
    filling_factor: 0.3,
    grain_diffuse_albedo: 0.8,
    grain_ior: 1.4,
    base: bsdf());
  const auto E0 = furnaceIntegral(m, math::normalize(float3(0.2, 0.1, 0.97)));
  const auto E1 = furnaceIntegral(m, math::normalize(float3(0.85, 0.1, 0.15)));
  #assert((0.0 < E0) & (E0 < 1.02));
  #assert((0.0 < E1) & (E1 < 1.02));
  #assert(E1 > 1.5 * E0);
}

unit_test "Micrograin layer" {
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto wi = math::normalize(float3(+0.5, 0.2, 0.9));
  const auto woG = math::normalize(float3(0.8, 0.1, 0.2));
  const auto baseD = df::diffuse_reflection_bsdf(tint: 0.8);
  // As the filling factor vanishes, the layer degenerates to the base.
  {
    const auto m = df::micrograin_layer(filling_factor: 1.0e-4, base: baseD);
    const auto r0 = evaluate(baseD, wo, wi);
    const auto r1 = evaluate(m, wo, wi);
    #assert(#all(r1.f ~== |1e-3| r0.f));
    #assert(#all(r1.pdf ~== |1e-3| r0.pdf));
  }
  // Single-scattering energy bound: conductor micrograins on a black base
  // and on a diffuse base stay below 1 in the furnace.
  for (int k = 0; k < 3; k++) {
    const auto tau0 = 0.2 + 0.3 * k;
    const auto mBlack = df::micrograin_layer(
      filling_factor: tau0, beta_u: 1.0,
      grain_ior: 1.0152, grain_extinction: 6.6273, base: bsdf());
    const auto mDiff = df::micrograin_layer(
      filling_factor: tau0, beta_u: 1.0,
      grain_ior: 1.0152, grain_extinction: 6.6273, base: baseD);
    const auto E0 = furnaceIntegral(mBlack, wo);
    const auto E1 = furnaceIntegral(mDiff, wo);
    #assert((0.0 < E0) & (E0 < 1.02));
    #assert((E0 < E1) & (E1 < 1.02));
  }
  // Sampling PDF consistency across parameters, grain types, and views,
  // using the stochastic variant so the pore-vs-grain and
  // diffuse-vs-specular selection chances are explored in proportion.
  checkScatterPDFIntegralStochastic(df::micrograin_layer(filling_factor: 0.3, base: baseD), wo, 1.0);
  checkScatterPDFIntegralStochastic(df::micrograin_layer(filling_factor: 0.7, beta_u: 2.0, grain_ior: 1.0152, grain_extinction: 6.6273, base: baseD), wo, 1.0);
  checkScatterPDFIntegralStochastic(df::micrograin_layer(filling_factor: 0.5, beta_u: 0.5, grain_diffuse_albedo: 0.6, base: baseD), woG, 1.0);
  checkScatterPDFIntegralStochastic(df::micrograin_layer(filling_factor: 0.9, beta_u: 3.0, grain_diffuse_albedo: color(0.5, 0.3, 0.1), grain_ior: 1.5, base: bsdf()), wo, 1.0);
  checkScatterPDFIntegralStochastic(df::micrograin_layer(filling_factor: 0.4, beta_u: 2.5, beta_v: 0.4, grain_ior: 1.0152, grain_extinction: 6.6273, base: baseD), woG, 1.0);
  // Anisotropic grains stay within the single-scattering energy bound.
  const auto EAniso = furnaceIntegral(df::micrograin_layer(filling_factor: 0.5, beta_u: 2.5, beta_v: 0.4, grain_ior: 1.0152, grain_extinction: 6.6273, base: bsdf()), wo);
  #assert((0.0 < EAniso) & (EAniso < 1.02));
  // Unit-albedo diffuse grains at a grazing view are the worst case for
  // the visible-grain-fraction weighting of the coupled diffuse term.
  const auto EDiff = furnaceIntegral(df::micrograin_layer(filling_factor: 0.6, grain_diffuse_albedo: 1.0, grain_ior: 1.0, base: bsdf()), woG);
  #assert((0.0 < EDiff) & (EDiff < 1.02));
}

unit_test "Fresnel-weighted specular delta dielectric" {
  const auto bRT = df::specular_bsdf(tint: 1.0, mode: df::scatter_reflect_transmit);
  const auto wo = math::normalize(float3(0.3, 0.2, 1.5));
  const auto F = df::specular::dielectric_fresnel(wo.z, 1 / 1.4);
  // Entering: a random number below the Fresnel term reflects with weight
  // `tint`; above it refracts with the `ior * ior` compression, the
  // selection chance canceling against the lobe weight exactly.
  {
    const auto r = sample(bRT, float4(0.9 * F, 0.4, 0.5, 0.6), wo);
    #assert(r.success && r.isDelta);
    #assert(r.wi.z > 0.0);
    #assert(#all(r.f ~== |1e-5| color(1.0)));
  }
  {
    const auto r = sample(bRT, float4(F + 0.9 * (1 - F), 0.4, 0.5, 0.6), wo);
    #assert(r.success && r.isDelta);
    #assert(r.wi.z < 0.0);
    #assert(#all(r.f ~== |1e-5| color((1.0 / 1.4) * (1.0 / 1.4))));
  }
  // From inside beyond the critical angle the Fresnel term is 1, so every
  // sample reflects: total internal reflection wastes nothing. (The 50/50
  // split used to reject half of these samples outright.)
  const auto woIn = math::normalize(float3(0.8, 0.1, -0.6));
  for (int k = 0; k < 8; k++) {
    const auto r = sample(bRT, float4((k + 0.5) / 8, 0.4, 0.5, 0.6), woIn);
    #assert(r.success && r.isDelta);
    #assert(r.wi.z < 0.0); // Reflection stays on the incident side
    #assert(#all(r.f ~== |1e-5| color(1.0)));
  }
}

unit_test "Measured curve factor" {
  const auto wo = math::normalize(float3(-0.4, 1.2, 0.9));
  const auto wi = math::normalize(float3(+0.3, -0.6, 0.7));
  const auto base = df::diffuse_reflection_bsdf(tint: 0.8, roughness: 0.3);
  const auto result0 = evaluate(base, wo, wi);
  #assert(#any(result0.f > 0.0));
  // A constant single-entry curve scales uniformly.
  {
    const auto result1 = evaluate(df::measured_curve_factor(curve_values: color[1](color(0.25)), base: base), wo, wi);
    #assert(#all(result1.f ~== |1e-6| 0.25 * result0.f));
    #assert(#all(result1.pdf ~== |1e-6| result0.pdf)); // The factor must not affect the PDFs
  }
  // An all-ones curve is the identity.
  {
    const auto result1 = evaluate(df::measured_curve_factor(curve_values: color[3](color(1.0), color(1.0), color(1.0)), base: base), wo, wi);
    #assert(#all(result1.f ~== |1e-6| result0.f));
  }
  // A varying curve linearly interpolates over the angle between the outgoing
  // direction and the half vector in the pre-image range from zero to pi/2.
  {
    const auto curve = color[4](color(1.0), color(0.7), color(0.4), color(0.1));
    const auto result1 = evaluate(df::measured_curve_factor(curve_values: curve, base: base), wo, wi);
    const auto h = math::normalize(wo + wi);
    const auto t = math::saturate(math::acos(math::saturate(math::dot(wo, h))) * (2 / $PI)) * 3;
    const int i = int(t);
    const auto expected = math::lerp(curve[i], curve[#min(i + 1, 3)], t - i);
    #assert(#all(result1.f ~== |1e-5| expected * result0.f));
  }
}

unit_test "Measured factor" {
  const auto values = texture_2d("4x4.png", tex::gamma_linear);
  const auto wo = math::normalize(float3(-0.4, 1.2, 0.9));
  const auto wi = math::normalize(float3(+0.3, -0.6, 0.7));
  const auto base = df::diffuse_reflection_bsdf(tint: 1.0);
  const auto result0 = evaluate(base, wo, wi);
  const auto result1 = evaluate(df::measured_factor(values: values, base: base), wo, wi);
  // The u coordinate is the angle between the outgoing direction and the half
  // vector, and the v coordinate is the angle between the half vector and the
  // shading normal, both normalized by pi/2 and clamped.
  const auto h = math::normalize(wo + wi);
  const auto expected = math::saturate(
    tex::lookup_color(
      values,
      float2(math::acos(math::saturate(math::dot(wo, h))), math::acos(math::saturate(h.z))) * (2 / $PI),
      tex::wrap_clamp,
      tex::wrap_clamp,
    ),
  );
  // The texel here is a saturated red, which a 1-band grid pinned at
  // mid-visible genuinely cannot see (the RGB-to-color red basis is zero
  // near 550nm), so only guard against vacuousness on wider grids.
  if ($WAVELENGTH_BASE_MAX > 1) {
    #assert(#any(expected > 0.0));
  }
  #assert(#all(result1.f ~== |1e-6| expected * result0.f));
  #assert(#all(result1.pdf ~== |1e-6| result0.pdf)); // The factor must not affect the PDFs
}

unit_test "Thin film" {
  const auto wo = math::normalize(float3(-0.4, 1.2, 0.9));
  const auto wi = math::normalize(float3(+0.3, -0.6, 0.7));
  const auto base = df::diffuse_reflection_bsdf(tint: 0.8);
  const auto result0 = evaluate(base, wo, wi);
  // Zero thickness is the identity, for both float and color film IOR.
  {
    const auto result1 = evaluate(df::thin_film(thickness: 0.0, ior: 1.5, base: base), wo, wi);
    #assert(#all(result1.f ~== |1e-5| result0.f));
    #assert(#all(result1.pdf ~== |1e-6| result0.pdf)); // The factor must not affect the PDFs
  }
  {
    const auto result1 = evaluate(df::thin_film(thickness: 0.0, ior: color(1.5), base: base), wo, wi);
    #assert(#all(result1.f ~== |1e-5| result0.f));
  }
  // The same identity holds on the delta sampling path.
  {
    const auto r = sample(df::thin_film(thickness: 0.0, ior: 1.5, base: df::specular_bsdf(tint: 1.0)), float4(0.3, 0.4, 0.5, 0.6), wo);
    #assert(r.success && r.isDelta);
    #assert(#all(r.f ~== |1e-5| color(1.0)));
  }
  // At normal incidence with the default material IOR of 1.4. The design
  // band is the middle of the grid (band 8 on the default 16-band grid),
  // so these checks stay in bounds and meaningful at any
  // 'WAVELENGTH_BASE_MAX'.
  const auto wz = float3(0, 0, 1);
  const auto resultz = evaluate(base, wz, wz);
  const int k = $WAVELENGTH_BASE_MAX / 2;
  const auto lambda = $state.wavelength_base[k];
  // A half-wave film is invisible at its design wavelength.
  {
    const auto result1 = evaluate(df::thin_film(thickness: lambda / (2 * 1.5), ior: 1.5, base: base), wz, wz);
    #assert(result1.f[k] ~== |1e-4| resultz.f[k]);
  }
  // A quarter-wave film with the ideal anti-reflection IOR `sqrt(1.4)` blacks out
  // the interface at its design wavelength, but not at distant wavelengths.
  {
    const auto arIOR = #sqrt(1.4);
    const auto result1 = evaluate(df::thin_film(thickness: lambda / (4 * arIOR), ior: arIOR, base: base), wz, wz);
    #assert(result1.f[k] ~== |1e-4| 0.0);
    // Band 0 sits an octave-ish below the mid-grid design wavelength on
    // the default 380-720nm range, far enough that reflectivity has
    // recovered. A 1-band grid has no distant band to check.
    if ($WAVELENGTH_BASE_MAX > 1) {
      #assert(result1.f[0] > 0.01);
    }
  }
}

unit_test "Custom curve layer" {
  const auto wo = math::normalize(float3(-0.4, 1.2, 0.9));
  const auto wi = math::normalize(float3(+0.3, -0.6, 0.7));
  const auto layerB = df::sheen_bsdf(tint: 1.0, roughness: 0.4);
  const auto baseB = df::diffuse_reflection_bsdf(tint: 0.3);
  const auto rLayer = evaluate(layerB, wo, wi);
  const auto rBase = evaluate(baseB, wo, wi);
  #assert(#any(rLayer.f > 0.0));
  #assert(#any(rBase.f > 0.0));
  // Zero weight selects the base.
  {
    const auto r = evaluate(df::custom_curve_layer(normal_reflectivity: 0.2, weight: 0.0, layer: layerB, base: baseB), wo, wi);
    #assert(#all(r.f ~== |1e-6| rBase.f));
    #assert(#all(r.pdf ~== |1e-6| rBase.pdf));
  }
  // A unit curve with unit weight selects the layer.
  {
    const auto r = evaluate(df::custom_curve_layer(normal_reflectivity: 1.0, grazing_reflectivity: 1.0, weight: 1.0, layer: layerB, base: baseB), wo, wi);
    #assert(#all(r.f ~== |1e-6| rLayer.f));
    #assert(#all(r.pdf ~== |1e-6| rLayer.pdf));
  }
  // Otherwise blend by the Schlick-style curve, evaluated at the half vector for the
  // scattering function and at the normal cosines for the PDFs.
  {
    const auto r = evaluate(df::custom_curve_layer(normal_reflectivity: 0.2, grazing_reflectivity: 0.9, exponent: 4.0, weight: 0.8, layer: layerB, base: baseB), wo, wi);
    const auto h = math::normalize(wo + wi);
    const auto fWeight = 0.8 * (0.2 + (0.9 - 0.2) * #pow(#max(1 - #abs(math::dot(wo, h)), 0), 4.0));
    const auto pWeight = 0.8 * (0.2 + (0.9 - 0.2) * #pow(#max(1 - float2(wo.z, wi.z), 0), 4.0));
    #assert(#all(r.f ~== |1e-5| math::lerp(rBase.f, rLayer.f, fWeight)));
    #assert(#all(r.pdf ~== |1e-5| math::lerp(rBase.pdf, rLayer.pdf, pWeight)));
  }
  // A delta sample from the layer compensates the selection chance exactly when the
  // weight is uniform and the shading normal is default, so the tint passes through.
  {
    const auto r = sample(
      df::custom_curve_layer(normal_reflectivity: 0.2, grazing_reflectivity: 0.9, weight: 0.8, layer: df::specular_bsdf(tint: 1.0), base: baseB),
      float4(0.3, 0.4, 0.05, 0.6),
      wo,
    );
    #assert(r.success && r.isDelta);
    #assert(#all(r.f ~== |1e-5| color(1.0)));
  }
}

unit_test "Measured curve layer" {
  const auto wo = math::normalize(float3(-0.4, 1.2, 0.9));
  const auto wi = math::normalize(float3(+0.3, -0.6, 0.7));
  const auto layerB = df::sheen_bsdf(tint: 1.0, roughness: 0.4);
  const auto baseB = df::diffuse_reflection_bsdf(tint: 0.3);
  const auto rLayer = evaluate(layerB, wo, wi);
  const auto rBase = evaluate(baseB, wo, wi);
  // Zero weight selects the base.
  {
    const auto r = evaluate(df::measured_curve_layer(curve_values: color[2](color(0.9), color(0.1)), weight: 0.0, layer: layerB, base: baseB), wo, wi);
    #assert(#all(r.f ~== |1e-6| rBase.f));
    #assert(#all(r.pdf ~== |1e-6| rBase.pdf));
  }
  // A unit curve with unit weight selects the layer.
  {
    const auto r = evaluate(df::measured_curve_layer(curve_values: color[1](color(1.0)), weight: 1.0, layer: layerB, base: baseB), wo, wi);
    #assert(#all(r.f ~== |1e-6| rLayer.f));
    #assert(#all(r.pdf ~== |1e-6| rLayer.pdf));
  }
  // Otherwise blend by the interpolated curve, evaluated at the half vector for the
  // scattering function and at the normal cosines for the PDFs.
  {
    const auto r = evaluate(df::measured_curve_layer(curve_values: color[2](color(0.9), color(0.1)), weight: 0.8, layer: layerB, base: baseB), wo, wi);
    const auto h = math::normalize(wo + wi);
    const auto fWeight = 0.8 * math::lerp(0.9, 0.1, math::saturate(math::acos(math::saturate(math::dot(wo, h))) * (2 / $PI)));
    const auto pWeight = 0.8 * math::lerp(float2(0.9), float2(0.1), math::saturate(math::acos(math::saturate(float2(wo.z, wi.z))) * (2 / $PI)));
    #assert(#all(r.f ~== |1e-5| math::lerp(rBase.f, rLayer.f, fWeight)));
    #assert(#all(r.pdf ~== |1e-5| math::lerp(rBase.pdf, rLayer.pdf, pWeight)));
  }
}

unit_test "Mixers" {
  // Every mixer must compile and execute through both entry points --
  // 'unbounded_mix' shipped with a broken field path ('component.df_lobes')
  // that no test exercised.
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto wi = math::normalize(float3(+0.5, 0.2, 0.9));
  const auto xi = float4(0.3, 0.4, 0.5, 0.6);
  const auto lobeA = df::diffuse_reflection_bsdf(tint: 0.8);
  const auto lobeB = df::microfacet_ggx_smith_bsdf(roughness_u: 0.4, roughness_v: 0.4, tint: 1.0);
  const auto fA = evaluate(lobeA, wo, wi).f;
  const auto fB = evaluate(lobeB, wo, wi).f;
  // Weights summing below 1: all three mixers agree and equal the
  // weighted sum of the components.
  {
    const auto components = auto[2](
      df::bsdf_component(weight: 0.3, component: lobeA),
      df::bsdf_component(weight: 0.4, component: lobeB));
    const auto rN = evaluate(df::normalized_mix(components), wo, wi);
    const auto rC = evaluate(df::clamped_mix(components), wo, wi);
    const auto rU = evaluate(df::unbounded_mix(components), wo, wi);
    #assert(#all(rN.f ~== |1e-5| 0.3 * fA + 0.4 * fB));
    #assert(#all(rC.f ~== |1e-5| rN.f));
    #assert(#all(rU.f ~== |1e-5| rN.f));
    #assert(#all(rC.pdf ~== |1e-5| rN.pdf));
    #assert(#all(rU.pdf ~== |1e-5| rN.pdf));
    #assert(sample(df::normalized_mix(components), xi, wo).success);
    #assert(sample(df::clamped_mix(components), xi, wo).success);
    #assert(sample(df::unbounded_mix(components), xi, wo).success);
  }
  // Weights summing above 1: the mixers implement their namesake
  // policies -- normalized rescales to sum 1, clamped truncates in
  // declaration order, unbounded leaves the weights alone.
  {
    const auto components = auto[2](
      df::bsdf_component(weight: 1.5, component: lobeA),
      df::bsdf_component(weight: 1.5, component: lobeB));
    const auto rN = evaluate(df::normalized_mix(components), wo, wi);
    const auto rC = evaluate(df::clamped_mix(components), wo, wi);
    const auto rU = evaluate(df::unbounded_mix(components), wo, wi);
    #assert(#all(rN.f ~== |1e-5| 0.5 * fA + 0.5 * fB));
    #assert(#all(rC.f ~== |1e-5| 1.0 * fA));
    #assert(#all(rU.f ~== |1e-5| 1.5 * fA + 1.5 * fB));
  }
  // The clamp keeps the truncated component's chance and flags: with
  // default chances, the PDF mixes by the raw weights normalized over
  // both components, and the flags agree with the normalized mixer over
  // the same components. (Both were dropped before this test existed.)
  {
    const auto components = auto[2](
      df::bsdf_component(weight: 0.7, component: lobeA),
      df::bsdf_component(weight: 0.5, component: lobeB));
    const auto pA = evaluate(lobeA, wo, wi).pdf;
    const auto pB = evaluate(lobeB, wo, wi).pdf;
    const auto rC = evaluate(df::clamped_mix(components), wo, wi);
    #assert(#all(rC.f ~== |1e-5| 0.7 * fA + 0.3 * fB));
    #assert(#all(rC.pdf ~== |1e-5| (0.7 * pA + 0.5 * pB) / 1.2));
    #assert(df::clamped_mix(components).df_lobes == df::normalized_mix(components).df_lobes);
  }
}

unit_test "Color mixers" {
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto wi = math::normalize(float3(+0.5, 0.2, 0.9));
  const auto xi = float4(0.3, 0.4, 0.5, 0.6);
  const auto lobeA = df::diffuse_reflection_bsdf(tint: 0.8);
  const auto lobeB = df::microfacet_ggx_smith_bsdf(roughness_u: 0.4, roughness_v: 0.4, tint: 1.0);
  const auto fA = evaluate(lobeA, wo, wi).f;
  const auto fB = evaluate(lobeB, wo, wi).f;
  const auto pA = evaluate(lobeA, wo, wi).pdf;
  const auto pB = evaluate(lobeB, wo, wi).pdf;
  // Uniform color weights agree with the float mixers exactly.
  {
    const auto componentsF = auto[2](
      df::bsdf_component(weight: 0.3, component: lobeA),
      df::bsdf_component(weight: 0.4, component: lobeB));
    const auto componentsC = auto[2](
      df::color_bsdf_component(weight: color(0.3), component: lobeA),
      df::color_bsdf_component(weight: color(0.4), component: lobeB));
    const auto rF = evaluate(df::normalized_mix(componentsF), wo, wi);
    const auto rN = evaluate(df::color_normalized_mix(componentsC), wo, wi);
    const auto rC = evaluate(df::color_clamped_mix(componentsC), wo, wi);
    const auto rU = evaluate(df::color_unbounded_mix(componentsC), wo, wi);
    #assert(#all(rN.f ~== |1e-5| rF.f));
    #assert(#all(rN.pdf ~== |1e-5| rF.pdf));
    #assert(#all(rC.f ~== |1e-5| rF.f));
    #assert(#all(rU.f ~== |1e-5| rF.f));
    #assert(sample(df::color_normalized_mix(componentsC), xi, wo).success);
    #assert(sample(df::color_clamped_mix(componentsC), xi, wo).success);
    #assert(sample(df::color_unbounded_mix(componentsC), xi, wo).success);
  }
  // Spectrally varying weights: normalization is per channel, so
  // channels whose weights sum above 1 rescale to sum 1 and channels
  // below are left alone; the sampling chance is the weight average.
  {
    const auto wA = color(float3(0.9, 0.3, 0.2));
    const auto wB = color(float3(0.8, 0.5, 0.1));
    const auto scale = 1.0 / math::max(wA + wB, 1.0);
    const auto chanceA = math::average(wA);
    const auto chanceB = math::average(wB);
    const auto r = evaluate(df::color_normalized_mix(auto[2](
      df::color_bsdf_component(weight: wA, component: lobeA),
      df::color_bsdf_component(weight: wB, component: lobeB))), wo, wi);
    #assert(#all(r.f ~== |1e-5| (scale * wA) * fA + (scale * wB) * fB));
    #assert(#all(r.pdf ~== |1e-5| (chanceA * pA + chanceB * pB) / (chanceA + chanceB)));
  }
  // The clamp is also per channel: the second weight is truncated to
  // the per-channel budget left by the first.
  {
    const auto wA = color(float3(0.9, 0.5, 0.2));
    const auto wB = color(float3(0.8, 0.9, 0.3));
    const auto wBClamped = math::min(wB, 1.0 - wA);
    const auto r = evaluate(df::color_clamped_mix(auto[2](
      df::color_bsdf_component(weight: wA, component: lobeA),
      df::color_bsdf_component(weight: wB, component: lobeB))), wo, wi);
    #assert(#all(r.f ~== |1e-5| wA * fA + wBClamped * fB));
  }
}

unit_test "Tinted VDF" {
  auto wo = math::normalize(float3(+0.1, 0.2, +1.0));
  auto wi = math::normalize(float3(-0.3, 0.5, -0.8));
  auto matPlain = material(volume: material_volume(scattering: df::anisotropic_vdf(directional_bias: 0.4)));
  auto matTinted = material(volume: material_volume(scattering: df::tint(tint: color(0.5), base: df::anisotropic_vdf(directional_bias: 0.4))));
  auto instPlain = _MaterialInstance(&matPlain);
  auto instTinted = _MaterialInstance(&matTinted);
  const auto pPlain = df::_volumeScatterEvaluate(&instPlain, &wo, &wi);
  const auto pTinted = df::_volumeScatterEvaluate(&instTinted, &wo, &wi);
  #assert(pPlain > 0.0);
  // The scalar volume entry point folds a color tint to its average.
  #assert(pTinted ~== |1e-6| 0.5 * pPlain);
}

unit_test "Additive volume flag" {
  auto matDefault = material(volume: material_volume(absorption_coefficient: color(0.5)));
  auto matAdditive = material(ior: 1.0, volume: material_volume(absorption_coefficient: color(0.5), additive: true));
  #assert(!matDefault.volume.additive);
  #assert(matAdditive.volume.additive);
  // The declaration reaches the instance flags, mirroring
  // 'smdl::JIT::MATERIAL_ADDITIVE_VOLUME'.
  const int MATERIAL_ADDITIVE_VOLUME = (1 << 11);
  auto instDefault = _MaterialInstance(&matDefault);
  auto instAdditive = _MaterialInstance(&matAdditive);
  #assert((instDefault.flags & MATERIAL_ADDITIVE_VOLUME) == 0);
  #assert((instAdditive.flags & MATERIAL_ADDITIVE_VOLUME) != 0);
}

unit_test "Modifier sampling" {
  // Every factor modifier must also compile and execute through the
  // sampling entry point -- 'measured_curve_factor' shipped with a typo
  // ('actorScatterSample') that only detonated on sample, which no test
  // exercised.
  const auto wo = math::normalize(float3(0.3, 0.2, 1.5));
  const auto xi = float4(0.3, 0.4, 0.5, 0.6);
  const auto base = df::microfacet_ggx_smith_bsdf(roughness_u: 0.4, roughness_v: 0.4, tint: 1.0);
  {
    const auto r = sample(df::tint(tint: color(0.5), base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
  {
    const auto r = sample(df::thin_film(thickness: 300.0, ior: 1.6, base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
  {
    const auto r = sample(df::directional_factor(normal_tint: 0.9, grazing_tint: 0.3, base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
  {
    const auto r = sample(df::fresnel_factor(ior: 1.5, extinction_coefficient: 2.0, base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
  {
    const auto r = sample(df::measured_curve_factor(curve_values: color[3](color(0.9), color(0.5), color(0.2)), base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
  {
    const auto r = sample(df::measured_factor(values: texture_2d("4x4.png", tex::gamma_linear), base: base), xi, wo);
    #assert(r.success);
    #assert(#all(r.f >= 0.0));
  }
  {
    const auto r = sample(df::horizon_shadow_factor(slopes: float4(0.0), base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
}
