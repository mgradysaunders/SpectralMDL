#smdl

using noise = ::extras::noise;

import noise::*;
import ::math::*;

// A deterministic spread of sample positions over a wide region, so that
// every lattice cell configuration and simplex ordering gets exercised.
@(pure) float3 samplePoint(const int i) {
  return (noise::hash_float3(int3(i, i * 7919 + 13, i * 104729 + 7)) - 0.5) * 512.0;
}

unit_test "Noise hash" {
  // The 1D hash is a bijection, so a run of consecutive keys must produce a
  // run of distinct results. Checking pairwise over a small window is enough
  // to catch a broken output permutation.
  for (int i = 0; i < 512; i++) {
    for (int j = i + 1; j < 512; j++) {
      #assert(noise::hash(i) != noise::hash(j), "1D hash collided on small keys");
    }
  }

  // Avalanche: flipping one bit of the key must change about half the bits of
  // the result. A hash that merely scrambles low bits fails this badly.
  int flipped = 0, total = 0;
  for (int i = 0; i < 4096; i++) {
    for (int b = 0; b < 32; b++) {
      const auto diff(noise::hash(i) ^ noise::hash(i ^ (1 << b)));
      for (int k = 0; k < 32; k++)
        flipped += (diff >>> k) & 1;
      total += 32;
    }
  }
  #assert(math::abs(float(flipped) / total - 0.5) < 0.01, "1D hash avalanche is biased");

  // The unit-interval conversions must stay in range and be uniform.
  const int n = 200'000;
  double sum = 0, sum2 = 0;
  for (int i = 0; i < n; i++) {
    const auto u(noise::hash_float(i));
    #assert(u >= 0.0 && u < 1.0, "hash_float out of range");
    sum += u, sum2 += double(u) * u;
  }
  #assert(math::abs(sum / n - 0.5) < 0.01, "hash_float mean");
  #assert(math::abs(sum2 / n - (sum / n) * (sum / n) - 1.0 / 12.0) < 0.01, "hash_float variance");

  for (int i = 0; i < 4096; i++) {
    #assert(#all(noise::hash_float2(int2(i, i + 1)) >= 0.0) && #all(noise::hash_float2(int2(i, i + 1)) < 1.0));
    #assert(#all(noise::hash_float3(int3(i, i + 1, i + 2)) >= 0.0) && #all(noise::hash_float3(int3(i, i + 1, i + 2)) < 1.0));
    #assert(#all(noise::hash_float4(int4(i, i + 1, i + 2, i + 3)) >= 0.0) &&
            #all(noise::hash_float4(int4(i, i + 1, i + 2, i + 3)) < 1.0));
  }
}

unit_test "Noise simplex range and moments" {
  const int n = 400'000;
  double sum2 = 0, sum3 = 0;
  double sumSq2 = 0, sumSq3 = 0;
  for (int i = 0; i < n; i++) {
    const auto p(samplePoint(i));
    const auto f2(noise::simplex_noise(p.xy));
    const auto f3(noise::simplex_noise(p));
    #assert(f2 >= -1.0 && f2 <= 1.0, "2D simplex left [-1, 1]");
    #assert(f3 >= -1.0 && f3 <= 1.0, "3D simplex left [-1, 1]");
    sum2 += f2, sumSq2 += double(f2) * f2;
    sum3 += f3, sumSq3 += double(f3) * f3;
  }
  // Mean zero, and the variance the documentation promises. The variance is
  // the statistic fractal summation has to normalize against, so a change
  // here silently invalidates every fbm built on top of this module.
  #assert(math::abs(sum2 / n) < 0.01, "2D simplex mean");
  #assert(math::abs(sum3 / n) < 0.01, "3D simplex mean");
  #assert(math::abs(sumSq2 / n - 0.2905) < 0.01, "2D simplex variance drifted from documented 0.2905");
  #assert(math::abs(sumSq3 / n - 0.1539) < 0.01, "3D simplex variance drifted from documented 0.1539");
}

unit_test "Noise simplex derivative" {
  // Central differences agree with the analytic derivative only where the
  // field is smooth, so this doubles as the continuity test: a kernel radius
  // above the sound bracket drops corner contributions and puts steps in the
  // field, which show up here as errors two orders of magnitude too large.
  const int n = 100'000;
  const float h = 0.001;
  for (int i = 0; i < n; i++) {
    const auto p(samplePoint(i));

    const auto r2(noise::simplex_noise_deriv(p.xy));
    #assert(r2.value == noise::simplex_noise(p.xy), "2D value disagrees with derivative overload");
    const auto fd2 = float2(                                                                       //
        noise::simplex_noise(p.xy + float2(h, 0.0)) - noise::simplex_noise(p.xy - float2(h, 0.0)), //
        noise::simplex_noise(p.xy + float2(0.0, h)) - noise::simplex_noise(p.xy - float2(0.0, h))) / (2.0 * h);
    #assert(math::length(fd2 - r2.deriv) < 0.1, "2D analytic derivative disagrees with finite differences");

    const auto r3(noise::simplex_noise_deriv(p));
    #assert(r3.value == noise::simplex_noise(p), "3D value disagrees with derivative overload");
    const auto fd3 = float3(                                                                                 //
        noise::simplex_noise(p + float3(h, 0.0, 0.0)) - noise::simplex_noise(p - float3(h, 0.0, 0.0)),       //
        noise::simplex_noise(p + float3(0.0, h, 0.0)) - noise::simplex_noise(p - float3(0.0, h, 0.0)),       //
        noise::simplex_noise(p + float3(0.0, 0.0, h)) - noise::simplex_noise(p - float3(0.0, 0.0, h))) / (2.0 * h);
    #assert(math::length(fd3 - r3.deriv) < 0.1, "3D analytic derivative disagrees with finite differences");
  }
}

unit_test "Noise simplex degenerate ranking" {
  // Positions on the main diagonal make all three coordinates of the cell
  // relative offset equal, which is where the branchless simplex ranking has
  // nothing to rank. The value there must agree with the limit approached from
  // the surrounding tetrahedra rather than spiking.
  const auto e(1e-4);
  const auto nudges(float3[](float3(+e, 0.0, 0.0), float3(-e, 0.0, 0.0), float3(0.0, +e, 0.0), //
                             float3(0.0, -e, 0.0), float3(0.0, 0.0, +e), float3(0.0, 0.0, -e)));
  for (int i = -64; i < 64; i++) {
    const auto t(float(i) * 0.125);
    const auto atTie(noise::simplex_noise(float3(t, t, t)));
    float lo = $INF, hi = -$INF;
    for (int k = 0; k < 6; k++) {
      const auto f(noise::simplex_noise(float3(t, t, t) + nudges[k]));
      lo = #min(lo, f), hi = #max(hi, f);
    }
    #assert(atTie > lo - 1e-3 && atTie < hi + 1e-3, "3D simplex spikes on the main diagonal");
  }
}

unit_test "Noise simplex seeding" {
  // Distinct seeds must give statistically independent fields at the same
  // position, which is what lets a material layer several without them
  // rhyming with one another.
  const int n = 200'000;
  double sumAB2 = 0, sumAB3 = 0;
  for (int i = 0; i < n; i++) {
    const auto p(samplePoint(i));
    sumAB2 += double(noise::simplex_noise(p.xy, 0)) * noise::simplex_noise(p.xy, 1);
    sumAB3 += double(noise::simplex_noise(p, 0)) * noise::simplex_noise(p, 1);
  }
  #assert(math::abs(sumAB2 / n / 0.2905) < 0.02, "2D seeds 0 and 1 are correlated");
  #assert(math::abs(sumAB3 / n / 0.1539) < 0.02, "3D seeds 0 and 1 are correlated");

  // And evaluation must be a pure function of position and seed.
  for (int i = 0; i < 1024; i++) {
    const auto p(samplePoint(i));
    #assert(noise::simplex_noise(p.xy, 7) == noise::simplex_noise(p.xy, 7), "2D simplex is not deterministic");
    #assert(noise::simplex_noise(p, 7) == noise::simplex_noise(p, 7), "3D simplex is not deterministic");
  }
}

unit_test "Noise fbm normalization" {
  // The module documents that dividing a fractal sum by the square root of
  // the sum of squared amplitudes preserves the variance of a single octave.
  // If that is wrong, every material that follows the documented recipe comes
  // out with the wrong contrast.
  const int n = 200'000;
  double sumSq = 0;
  for (int i = 0; i < n; i++) {
    auto p(samplePoint(i).xy);
    float f(0.0), a(1.0), norm(0.0);
    for (int k = 0; k < 5; k++) {
      f += a * noise::simplex_noise(p, k);
      norm += a * a;
      p *= 2.0, a *= 0.5;
    }
    f /= #sqrt(norm);
    sumSq += double(f) * f;
  }
  #assert(math::abs(sumSq / n - 0.2905) < 0.02, "fbm normalized by RMS amplitude did not preserve octave variance");
}

unit_test "Noise fractal combinators" {
  // One octave is the bare field: the normalization is exactly 1.
  for (int i = 0; i < 512; i++) {
    const auto p(samplePoint(i).xy);
    #assert(noise::fractal_noise(p, 1, \(const float2 q, const int octave) = noise::simplex_noise(q, octave)) //
            == noise::simplex_noise(p, 0), "one octave must be the bare field");
  }

  // The combinator must reproduce the hand-written recipe of the
  // "Noise fbm normalization" test above, and the derivative version must
  // agree on the value while summing the chain-rule derivative.
  for (int i = 0; i < 4096; i++) {
    const auto p(samplePoint(i).xy);
    const auto value(noise::fractal_noise(p, 5, \(const float2 q, const int octave) = noise::simplex_noise(q, octave)));
    const auto d(noise::fractal_noise_deriv(p, 5, \(const float2 q, const int octave) = noise::simplex_noise_deriv(q, octave)));
    auto q(p);
    float f(0.0), a(1.0), freq(1.0), norm(0.0);
    auto deriv(float2(0.0));
    for (int k = 0; k < 5; k++) {
      const auto nk(noise::simplex_noise_deriv(q, k));
      f += a * nk.value;
      deriv += a * freq * nk.deriv;
      norm += a * a;
      q *= 2.0, freq *= 2.0, a *= 0.5;
    }
    f /= #sqrt(norm);
    deriv /= #sqrt(norm);
    #assert(math::abs(value - f) < 1e-6, "fractal_noise must match the hand-written recipe");
    #assert(math::abs(d.value - f) < 1e-6, "fractal_noise_deriv must agree on the value");
    #assert(math::length(d.deriv - deriv) < 1e-5, "fractal_noise_deriv must sum the chain-rule derivative");
  }

  // The field type is generic: a vector-valued field fractals
  // componentwise, matching independent scalar fractals per channel.
  for (int i = 0; i < 512; i++) {
    const auto p(samplePoint(i).xy);
    const auto v(noise::fractal_noise(p, 3, \(const float2 q, const int octave) //
                                      = float2(noise::simplex_noise(q, octave), noise::simplex_noise(q, octave + 8))));
    #assert(math::abs(v.x - noise::fractal_noise(p, 3, \(const float2 q, const int octave) = noise::simplex_noise(q, octave))) < 1e-6, //
            "vector fractal channel 0");
    #assert(math::abs(v.y - noise::fractal_noise(p, 3, \(const float2 q, const int octave) = noise::simplex_noise(q, octave + 8))) < 1e-6, //
            "vector fractal channel 1");
  }

  // Ridging is a lambda, not an API: each ridged octave lies in [-1, 1],
  // so the normalized sum is bounded by the amplitude sum over the RMS.
  for (int i = 0; i < 512; i++) {
    const auto p(samplePoint(i).xy);
    const auto r(noise::fractal_noise(p, 4, \(const float2 q, const int octave) //
                                      = 1.0 - 2.0 * #abs(noise::simplex_noise(q, octave))));
    #assert(math::abs(r) < 1.875 / #sqrt(1.328125) + 1e-4, "ridged fractal must respect the normalized bound");
  }
}

unit_test "Noise worley" {
  const int n = 200'000;
  for (int i = 0; i < n; i++) {
    const auto p(samplePoint(i));

    const auto w2(noise::worley_noise(p.xy));
    #assert(w2.f1 <= w2.f2, "2D worley f1 > f2");
    #assert(w2.f1 >= 0.0, "2D worley f1 negative");
    // The derivative of f1 is -offset1/f1, which is only a unit vector if the
    // reported offset really is the one that produced f1.
    #assert(math::abs(math::length(w2.offset1) - w2.f1) < 1e-4, "2D worley offset1 inconsistent with f1");

    const auto w3(noise::worley_noise(p));
    #assert(w3.f1 <= w3.f2, "3D worley f1 > f2");
    #assert(w3.f1 >= 0.0, "3D worley f1 negative");
    #assert(math::abs(math::length(w3.offset1) - w3.f1) < 1e-4, "3D worley offset1 inconsistent with f1");
  }

  // With no jitter the feature points sit exactly at the cell centers, so f1
  // is the distance to the nearest center and cannot exceed the half diagonal
  // of a cell. This pins down the cell layout independently of the hash.
  for (int i = 0; i < 20'000; i++) {
    const auto p(samplePoint(i));
    #assert(noise::worley_noise(p.xy, 0, 0.0).f1 <= #sqrt(0.5) + 1e-5, "2D worley jitter 0 is not a regular grid");
    #assert(noise::worley_noise(p, 0, 0.0).f1 <= #sqrt(0.75) + 1e-5, "3D worley jitter 0 is not a regular grid");
  }

  // Cells are identified consistently: two positions that report the same
  // feature point must agree on its identifier.
  for (int i = 0; i < 20'000; i++) {
    const auto p(samplePoint(i).xy);
    const auto w(noise::worley_noise(p));
    const auto q(p + 1e-4 * w.offset1);
    const auto v(noise::worley_noise(q));
    if (math::length(v.offset1 - (w.offset1 - (q - p))) < 1e-5)
      #assert(v.id1 == w.id1, "2D worley cell identifier is unstable");
  }
}
