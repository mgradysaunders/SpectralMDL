#smdl
#search_dir "../../fixtures"

import ::df::*;
import ::math::*;
import ::tex::*;
using parallax = ::extras::parallax;
import parallax::*;
using scatter = ::support::scatter;
import scatter::*;

// `df::relief_shadow_factor`: exact binary self-shadowing by a height
// field's maximum mip chain, applied to the incoming direction inside the
// BSDF, so NEE, BSDF sampling, and MIS stay consistent.
//
// Evaluation goes through `::support::scatter`. The default test state
// has an identity tangent frame, so the directions below read directly as
// natural-tangent-frame vectors, with x along +U of the height field.
// The field is the ridge fixture: height 0.2 everywhere except the
// one-texel wall at x = 8 (height 1.0) of a 16x16 image, whose faces ramp
// over one texel on either side.

const auto BASE = df::diffuse_reflection_bsdf(tint: 0.8);

@(pure macro)
float3 WO() = math::normalize(float3(0.2, -0.3, 1.0));

// The shading point on the flat at texel 4, whose shadow ray toward +U
// meets the wall's near face unless it clears the top of the wall first.
const float2 ON_FLAT = float2(0.25, 0.5);
const float SCALE = 0.5;

unit_test "The ridge shadows the directions the geometry says it should" {
  const auto ridge = texture_2d("ridge_16.png", tex::gamma_linear, max_mipmap: true);
  const auto shadowed = df::relief_shadow_factor(height: ridge, coord: ON_FLAT, scale: SCALE, base: BASE);
  // Toward the wall: with the ray starting at 0.22 and rising e / 8 per
  // texel, it clears the top of the wall (4.5 texels away) when
  // 0.22 + 4.5 e / 8 > 1, i.e. above e = 1.3867.
  const auto low = scatter::evaluate(shadowed, WO(), scatter::dirAt(float2(1.0, 0.0), 1.3));
  #assert(#all(low.f == color(0.0)));
  const auto high = scatter::evaluate(shadowed, WO(), scatter::dirAt(float2(1.0, 0.0), 1.5));
  const auto highBase = scatter::evaluate(BASE, WO(), scatter::dirAt(float2(1.0, 0.0), 1.5));
  #assert(#any(highBase.f > 0.0));
  #assert(#all(high.f == highBase.f));
  // Away from the wall the field repeats, and the previous wall's far
  // face is 10.5 texels off: a grazing light meets it, a higher one tops
  // out before reaching it.
  const auto backLow = scatter::evaluate(shadowed, WO(), scatter::dirAt(float2(-1.0, 0.0), 0.3));
  #assert(#all(backLow.f == color(0.0)));
  const auto backHigh = scatter::evaluate(shadowed, WO(), scatter::dirAt(float2(-1.0, 0.0), 1.0));
  const auto backHighBase = scatter::evaluate(BASE, WO(), scatter::dirAt(float2(-1.0, 0.0), 1.0));
  #assert(#all(backHigh.f == backHighBase.f));
  // Along V the field is constant, and straight up nothing occludes.
  const auto side = scatter::evaluate(shadowed, WO(), scatter::dirAt(float2(0.0, 1.0), 0.3));
  const auto sideBase = scatter::evaluate(BASE, WO(), scatter::dirAt(float2(0.0, 1.0), 0.3));
  #assert(#all(side.f == sideBase.f));
  const auto up = scatter::evaluate(shadowed, WO(), float3(0.0, 0.0, 1.0));
  const auto upBase = scatter::evaluate(BASE, WO(), float3(0.0, 0.0, 1.0));
  #assert(#all(up.f == upBase.f));
  // Just past the wall, a light from over the wall is blocked by its
  // far face right away.
  const auto behind = df::relief_shadow_factor(height: ridge, coord: float2(10.0 / 16.0, 0.5), scale: SCALE, base: BASE);
  const auto blocked = scatter::evaluate(behind, WO(), scatter::dirAt(float2(-1.0, 0.0), 1.0));
  #assert(#all(blocked.f == color(0.0)));
  const auto open = scatter::evaluate(behind, WO(), scatter::dirAt(float2(1.0, 0.0), 1.0));
  const auto openBase = scatter::evaluate(BASE, WO(), scatter::dirAt(float2(1.0, 0.0), 1.0));
  #assert(#all(open.f == openBase.f));
}

unit_test "A flat scale, a chainless texture, and the three transports pass through" {
  const auto ridge = texture_2d("ridge_16.png", tex::gamma_linear, max_mipmap: true);
  const auto wi = scatter::dirAt(float2(1.0, 0.0), 0.5); // shadowed from ON_FLAT
  const auto shadowed = df::relief_shadow_factor(height: ridge, coord: ON_FLAT, scale: SCALE, base: BASE);
  #assert(#all(scatter::evaluate(shadowed, WO(), wi).f == color(0.0)));
  const auto base = scatter::evaluate(BASE, WO(), wi);
  #assert(#any(base.f > 0.0));
  // A non-positive scale is an exact passthrough.
  const auto flat = df::relief_shadow_factor(height: ridge, coord: ON_FLAT, scale: 0.0, base: BASE);
  #assert(#all(scatter::evaluate(flat, WO(), wi).f == base.f));
  // So is a texture without a maximum chain, and an invalid texture.
  const auto plain = texture_2d("ridge_16.png", tex::gamma_linear);
  #assert(!plain.max_mipmap);
  const auto unchained = df::relief_shadow_factor(height: plain, coord: ON_FLAT, scale: SCALE, base: BASE);
  #assert(#all(scatter::evaluate(unchained, WO(), wi).f == base.f));
  const auto invalid = df::relief_shadow_factor(height: texture_2d(), coord: ON_FLAT, scale: SCALE, base: BASE);
  #assert(#all(scatter::evaluate(invalid, WO(), wi).f == base.f));
  scatter::checkFactorPassesThrough(
    \(const bsdf base) = df::relief_shadow_factor(height: ridge, coord: ON_FLAT, scale: SCALE, base: base),
    WO(), wi, math::normalize(float3(0.2, -0.3, -1.0)), math::normalize(float3(1.0, 0.0, -0.5)));
}

unit_test "A Dirac weight passes through or goes to zero" {
  // A mirror at 45 degrees: `wo = normalize(1, 0, 1)` reflects to
  // `wi = normalize(-1, 0, 1)`, toward -U at slope 1.
  const auto ridge = texture_2d("ridge_16.png", tex::gamma_linear, max_mipmap: true);
  const auto mirror = df::specular_bsdf(tint: 0.9);
  const auto wo = math::normalize(float3(1.0, 0.0, 1.0));
  const auto xi = float4(0.3, 0.4, 0.5, 0.6);
  const auto bare = scatter::sample(mirror, xi, wo);
  #assert(bare.success & bare.isDirac);
  #assert(#any(bare.f > 0.0));
  // From the flat, the reflected light tops out before the previous wall:
  // exact passthrough of the Dirac weight.
  const auto open = scatter::sample(df::relief_shadow_factor(height: ridge, coord: ON_FLAT, scale: SCALE, base: mirror), xi, wo);
  #assert(open.success & open.isDirac);
  #assert(#all(open.wi ~== |1e-6| bare.wi));
  #assert(#all(open.f == bare.f));
  // From just past the wall, the same direction runs into its far face:
  // the Dirac weight goes to 0 (the sample itself still succeeds).
  const auto blocked = scatter::sample(df::relief_shadow_factor(height: ridge, coord: float2(10.0 / 16.0, 0.5), scale: SCALE, base: mirror), xi, wo);
  #assert(blocked.success);
  #assert(#all(blocked.f == color(0.0)));
}

unit_test "The factor agrees with relief_visible and only removes energy" {
  const auto bumps = texture_2d("bumps_32.png", tex::gamma_linear, max_mipmap: true);
  const float2 coord = float2(0.37, 0.61);
  const float scale = 0.3;
  const auto shadowed = df::relief_shadow_factor(height: bumps, coord: coord, scale: scale, base: BASE);
  int visibleCount = 0;
  for (int a = 0; a < 8; a++) {
    for (int e = 1; e <= 6; e++) {
      const float phi = 2.0 * $PI * a / 8.0;
      const auto wi = scatter::dirAt(float2(math::cos(phi), math::sin(phi)), 0.3 * e);
      const auto s = scatter::evaluate(shadowed, WO(), wi);
      const auto b = scatter::evaluate(BASE, WO(), wi);
      const bool visible = parallax::relief_visible(bumps, coord, wi, scale);
      visibleCount += visible ? 1 : 0;
      for (int i = 0; i < $WAVELENGTH_BASE_MAX; i++) {
        #assert(s.f[i] == (visible ? b.f[i] : 0.0));
        #assert(s.f[i] <= b.f[i]);
      }
    }
  }
  // The field is rough, so the sweep must see both outcomes.
  #assert(visibleCount > 0);
  #assert(visibleCount < 48);
}
