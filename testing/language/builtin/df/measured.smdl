/// Measured data as an input: a measured BSDF read from an `.mbsdf` file,
/// and the measured curve and texture factors and layers, whose lookups
/// scale the value and leave the density alone.
#smdl
#search_dir "../../fixtures"

import ::df::*;
import ::math::*;
import ::tex::*;
using scatter = ::support::scatter;
import scatter::*;

unit_test "A measured BSDF is consistent and its multiplier scales only the value" {
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto wi = math::normalize(float3(+0.5, 0.2, 0.9));
  const auto ns = math::normalize(float3(0.2, -0.1, 1.0));
  const auto m = bsdf_measurement("test.mbsdf");
  #assert(df::bsdf_measurement_isvalid(m));
  // The synthetic measurement is reciprocal, so the full bidirectional
  // consistency harness applies, tilted shading normal included.
  scatter::checkBidirectionalConsistency(df::measured_bsdf(measurement: m), wo, wi);
  scatter::checkBidirectionalConsistency(df::measured_bsdf(measurement: m), wo, wi, ns);
  // The PDF must integrate over the reflection hemisphere to the sampling
  // acceptance rate.
  scatter::checkDensityAgainstAcceptance(df::measured_bsdf(measurement: m), wo, +1.0);
  // The multiplier scales the scattering function and leaves the PDFs alone.
  const auto result1 = scatter::evaluate(df::measured_bsdf(measurement: m), wo, wi);
  const auto result2 = scatter::evaluate(df::measured_bsdf(measurement: m, multiplier: 2.0), wo, wi);
  #assert(#any(result1.f > 0.0));
  #assert(#all(result2.f ~== |1e-5| 2.0 * result1.f));
  #assert(#all(result2.pdf ~== |1e-6| result1.pdf));
}

unit_test "A measured curve factor interpolates and leaves the density alone" {
  const auto wo = math::normalize(float3(-0.4, 1.2, 0.9));
  const auto wi = math::normalize(float3(+0.3, -0.6, 0.7));
  const auto base = df::diffuse_reflection_bsdf(tint: 0.8, roughness: 0.3);
  const auto result0 = scatter::evaluate(base, wo, wi);
  #assert(#any(result0.f > 0.0));
  // A constant single-entry curve scales uniformly.
  {
    const auto result1 = scatter::evaluate(df::measured_curve_factor(curve_values: color[1](color(0.25)), base: base), wo, wi);
    #assert(#all(result1.f ~== |1e-6| 0.25 * result0.f));
    #assert(#all(result1.pdf ~== |1e-6| result0.pdf)); // The factor must not affect the PDFs
  }
  // An all-ones curve is the identity.
  {
    const auto result1 = scatter::evaluate(df::measured_curve_factor(curve_values: color[3](color(1.0), color(1.0), color(1.0)), base: base), wo, wi);
    #assert(#all(result1.f ~== |1e-6| result0.f));
  }
  // A varying curve linearly interpolates over the angle between the outgoing
  // direction and the half vector in the pre-image range from zero to pi/2.
  {
    const auto curve = color[4](color(1.0), color(0.7), color(0.4), color(0.1));
    const auto result1 = scatter::evaluate(df::measured_curve_factor(curve_values: curve, base: base), wo, wi);
    const auto h = math::normalize(wo + wi);
    const auto t = math::saturate(math::acos(math::saturate(math::dot(wo, h))) * (2 / $PI)) * 3;
    const int i = int(t);
    const auto expected = math::lerp(curve[i], curve[#min(i + 1, 3)], t - i);
    #assert(#all(result1.f ~== |1e-5| expected * result0.f));
  }
}

unit_test "A measured texture factor looks up by the two angles" {
  const auto values = texture_2d("4x4.png", tex::gamma_linear);
  const auto wo = math::normalize(float3(-0.4, 1.2, 0.9));
  const auto wi = math::normalize(float3(+0.3, -0.6, 0.7));
  const auto base = df::diffuse_reflection_bsdf(tint: 1.0);
  const auto result0 = scatter::evaluate(base, wo, wi);
  const auto result1 = scatter::evaluate(df::measured_factor(values: values, base: base), wo, wi);
  // The u coordinate is the angle between the outgoing direction and the half
  // vector, and the v coordinate is the angle between the half vector and the
  // shading normal, both normalized by pi/2 and clamped.
  const auto h = math::normalize(wo + wi);
  const auto expected = math::saturate(
    tex::lookup_color(
      values,
      float2(math::acos(math::saturate(math::dot(wo, h))), math::acos(math::saturate(h.z))) * (2 / $PI),
      tex::wrap_clamp,
      tex::wrap_clamp,
    ),
  );
  // The texel here is a saturated red, which a 1-band grid pinned at
  // mid-visible genuinely cannot see (the RGB-to-color red basis is zero
  // near 550nm), so only guard against vacuousness on wider grids.
  if ($WAVELENGTH_BASE_MAX > 1) {
    #assert(#any(expected > 0.0));
  }
  #assert(#all(result1.f ~== |1e-6| expected * result0.f));
  #assert(#all(result1.pdf ~== |1e-6| result0.pdf)); // The factor must not affect the PDFs
}

unit_test "A measured curve layer blends by the curve at the half vector" {
  const auto wo = math::normalize(float3(-0.4, 1.2, 0.9));
  const auto wi = math::normalize(float3(+0.3, -0.6, 0.7));
  const auto layerB = df::sheen_bsdf(tint: 1.0, roughness: 0.4);
  const auto baseB = df::diffuse_reflection_bsdf(tint: 0.3);
  const auto rLayer = scatter::evaluate(layerB, wo, wi);
  const auto rBase = scatter::evaluate(baseB, wo, wi);
  // Zero weight selects the base.
  {
    const auto r = scatter::evaluate(df::measured_curve_layer(curve_values: color[2](color(0.9), color(0.1)), weight: 0.0, layer: layerB, base: baseB), wo, wi);
    #assert(#all(r.f ~== |1e-6| rBase.f));
    #assert(#all(r.pdf ~== |1e-6| rBase.pdf));
  }
  // A unit curve with unit weight selects the layer.
  {
    const auto r = scatter::evaluate(df::measured_curve_layer(curve_values: color[1](color(1.0)), weight: 1.0, layer: layerB, base: baseB), wo, wi);
    #assert(#all(r.f ~== |1e-6| rLayer.f));
    #assert(#all(r.pdf ~== |1e-6| rLayer.pdf));
  }
  // Otherwise blend by the interpolated curve, evaluated at the half vector for the
  // scattering function and at the normal cosines for the PDFs.
  {
    const auto r = scatter::evaluate(df::measured_curve_layer(curve_values: color[2](color(0.9), color(0.1)), weight: 0.8, layer: layerB, base: baseB), wo, wi);
    const auto h = math::normalize(wo + wi);
    const auto fWeight = 0.8 * math::lerp(0.9, 0.1, math::saturate(math::acos(math::saturate(math::dot(wo, h))) * (2 / $PI)));
    const auto pWeight = 0.8 * math::lerp(float2(0.9), float2(0.1), math::saturate(math::acos(math::saturate(float2(wo.z, wi.z))) * (2 / $PI)));
    #assert(#all(r.f ~== |1e-5| math::lerp(rBase.f, rLayer.f, fWeight)));
    #assert(#all(r.pdf ~== |1e-5| math::lerp(rBase.pdf, rLayer.pdf, pWeight)));
  }
}
