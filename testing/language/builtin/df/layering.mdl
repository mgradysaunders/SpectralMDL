/// Composition: the curve layers, the three mixer policies, and the
/// factor modifiers, on the evaluation path and the sampling path alike.
/// The clear coat's absorption is held to the path lengths of NVIDIA's
/// reference implementation, `coat_absorption` in the MDL SDK's libbsdf,
/// and the F82 curve to a double-precision port of its
/// `generalized_custom_curve_factor`.
#smdl
#search_dir "../../fixtures"

import ::df::*;
import ::math::*;
import ::tex::*;
using scatter = ::support::scatter;
import scatter::*;

unit_test "A custom curve layer blends by Schlick at the half vector" {
  const auto wo = math::normalize(float3(-0.4, 1.2, 0.9));
  const auto wi = math::normalize(float3(+0.3, -0.6, 0.7));
  const auto layerB = df::sheen_bsdf(tint: 1.0, roughness: 0.4);
  const auto baseB = df::diffuse_reflection_bsdf(tint: 0.3);
  const auto rLayer = scatter::evaluate(layerB, wo, wi);
  const auto rBase = scatter::evaluate(baseB, wo, wi);
  #assert(#any(rLayer.f > 0.0));
  #assert(#any(rBase.f > 0.0));
  // Zero weight selects the base.
  {
    const auto r = scatter::evaluate(df::custom_curve_layer(normal_reflectivity: 0.2, weight: 0.0, layer: layerB, base: baseB), wo, wi);
    #assert(#all(r.f ~== |1e-6| rBase.f));
    #assert(r.pdf ~== |1e-6| rBase.pdf);
  }
  // A unit curve with unit weight selects the layer.
  {
    const auto r = scatter::evaluate(df::custom_curve_layer(normal_reflectivity: 1.0, grazing_reflectivity: 1.0, weight: 1.0, layer: layerB, base: baseB), wo, wi);
    #assert(#all(r.f ~== |1e-6| rLayer.f));
    #assert(r.pdf ~== |1e-6| rLayer.pdf);
  }
  // Otherwise blend by the Schlick-style curve, evaluated at the half vector for the
  // scattering function and at the outgoing cosine for the PDF.
  {
    const auto r = scatter::evaluate(df::custom_curve_layer(normal_reflectivity: 0.2, grazing_reflectivity: 0.9, exponent: 4.0, weight: 0.8, layer: layerB, base: baseB), wo, wi);
    const auto h = math::normalize(wo + wi);
    const auto fWeight = 0.8 * (0.2 + (0.9 - 0.2) * #pow(#max(1 - #abs(math::dot(wo, h)), 0), 4.0));
    const auto pWeight = 0.8 * (0.2 + (0.9 - 0.2) * #pow(#max(1 - wo.z, 0), 4.0));
    #assert(#all(r.f ~== |1e-5| math::lerp(rBase.f, rLayer.f, fWeight)));
    #assert(r.pdf ~== |1e-5| math::lerp(rBase.pdf, rLayer.pdf, pWeight));
  }
  // A Dirac sample from the layer compensates the selection chance exactly when the
  // weight is uniform and the shading normal is default, so the tint passes through.
  {
    const auto r = scatter::sample(
      df::custom_curve_layer(normal_reflectivity: 0.2, grazing_reflectivity: 0.9, weight: 0.8, layer: df::specular_bsdf(tint: 1.0), base: baseB),
      float4(0.3, 0.4, 0.05, 0.6),
      wo,
    );
    #assert(r.success && r.isDirac);
    #assert(#all(r.f ~== |1e-5| color(1.0)));
  }
}

unit_test "The F82 tint bends the curve as the reference implementation does" {
  // With `wo` and `wi` mirrored about the normal, the half vector is the
  // normal, so the curve is read at the cosine of either direction. The
  // third cosine is 1/7, where the curve is the F82 tint times the
  // Schlick curve.
  const auto lambert = df::diffuse_reflection_bsdf(tint: 1.0);
  const auto mu = float[4](0.6, 0.3, 1.0 / 7.0, 0.3);
  const auto F0 = float[4](0.9, 0.9, 0.9, 0.5);
  const auto F90 = float[4](1.0, 1.0, 1.0, 0.9);
  const auto F82 = float[4](0.8, 0.8, 0.8, 0.6);
  const auto exponent = float[4](5.0, 5.0, 5.0, 3.0);
  const auto expected = float[4](
    0.8928141842962963, 0.7989021406585649, 0.7570131492830368,
    0.4498276576206276);
  for (int i = 0; i < 4; i++) {
    const float s = #sqrt(1 - mu[i] * mu[i]);
    const auto wo = float3(s, 0, mu[i]);
    const auto wi = float3(-s, 0, mu[i]);
    const auto fBase = scatter::evaluate(lambert, wo, wi).f;
    const auto fFactor = scatter::evaluate(
      df::directional_factor(
        normal_tint: F0[i],
        grazing_tint: F90[i],
        exponent: exponent[i],
        f82_factor: F82[i],
        base: lambert),
      wo, wi).f;
    #assert(#all(fFactor ~== (1e-5) expected[i] * fBase));
    // A curve layer over nothing is the curve times its layer.
    const auto fLayer = scatter::evaluate(
      df::color_custom_curve_layer(
        normal_reflectivity: color(F0[i]),
        grazing_reflectivity: color(F90[i]),
        exponent: exponent[i],
        f82_factor: color(F82[i]),
        layer: lambert),
      wo, wi).f;
    #assert(#all(fLayer ~== (1e-5) expected[i] * fBase));
  }
  const auto wo = math::normalize(float3(-0.4, 1.2, 0.9));
  const auto wi = math::normalize(float3(+0.3, -0.6, 0.7));
  // A tint of one is the Schlick curve exactly.
  #assert(#all(
    scatter::evaluate(
      df::directional_factor(normal_tint: 0.4, f82_factor: 1.0, base: lambert),
      wo, wi).f ==
    scatter::evaluate(df::directional_factor(normal_tint: 0.4, base: lambert), wo, wi).f));
  // The tint comes after the parameters it precedes in MDL 1.10, so that a
  // call written to an earlier version binds its exponent and base by
  // position as it always has.
  #assert(#all(
    scatter::evaluate(df::directional_factor(0.5, 1.0, 3.0, lambert), wo, wi).f ==
    scatter::evaluate(
      df::directional_factor(
        normal_tint: 0.5, grazing_tint: 1.0, exponent: 3.0, base: lambert),
      wo, wi).f));
  // The selection chance bends with the curve, so sampling agrees with the
  // density, and a Dirac draw from the layer is weighted by the curve over
  // the chance of drawing it, which is one for a uniform tint.
  scatter::checkDensityAgainstAcceptance(
    df::custom_curve_layer(
      normal_reflectivity: 0.2,
      f82_factor: 0.5,
      weight: 0.8,
      layer: df::sheen_bsdf(tint: 1.0, roughness: 0.4),
      base: df::diffuse_reflection_bsdf(tint: 0.3)),
    wo,
    1.0,
    isStochastic: true);
  const auto r = scatter::sample(
    df::custom_curve_layer(
      normal_reflectivity: 0.2,
      f82_factor: 0.5,
      weight: 0.8,
      layer: df::specular_bsdf(tint: 1.0),
      base: lambert),
    float4(0.3, 0.4, 0.05, 0.6),
    wo);
  #assert(r.success && r.isDirac);
  #assert(#all(r.f ~== |1e-5| color(1.0)));
}

unit_test "The three mixer policies differ only above weight one" {
  // Every mixer has to compile and execute through both entry points. A
  // mixer reached only through evaluation can carry a broken field path on
  // its sampling side indefinitely, so each one is exercised both ways.
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto wi = math::normalize(float3(+0.5, 0.2, 0.9));
  const auto xi = float4(0.3, 0.4, 0.5, 0.6);
  const auto lobeA = df::diffuse_reflection_bsdf(tint: 0.8);
  const auto lobeB = df::microfacet_ggx_smith_bsdf(roughness_u: 0.4, roughness_v: 0.4, tint: 1.0);
  const auto fA = scatter::evaluate(lobeA, wo, wi).f;
  const auto fB = scatter::evaluate(lobeB, wo, wi).f;
  // Weights summing below 1: all three mixers agree and equal the
  // weighted sum of the components.
  {
    const auto components = auto[2](
      df::bsdf_component(weight: 0.3, component: lobeA),
      df::bsdf_component(weight: 0.4, component: lobeB));
    const auto rN = scatter::evaluate(df::normalized_mix(components), wo, wi);
    const auto rC = scatter::evaluate(df::clamped_mix(components), wo, wi);
    const auto rU = scatter::evaluate(df::unbounded_mix(components), wo, wi);
    #assert(#all(rN.f ~== |1e-5| 0.3 * fA + 0.4 * fB));
    #assert(#all(rC.f ~== |1e-5| rN.f));
    #assert(#all(rU.f ~== |1e-5| rN.f));
    #assert(rC.pdf ~== |1e-5| rN.pdf);
    #assert(rU.pdf ~== |1e-5| rN.pdf);
    #assert(scatter::sample(df::normalized_mix(components), xi, wo).success);
    #assert(scatter::sample(df::clamped_mix(components), xi, wo).success);
    #assert(scatter::sample(df::unbounded_mix(components), xi, wo).success);
  }
  // Weights summing above 1: the mixers implement their namesake
  // policies -- normalized rescales to sum 1, clamped truncates in
  // declaration order, unbounded leaves the weights alone.
  {
    const auto components = auto[2](
      df::bsdf_component(weight: 1.5, component: lobeA),
      df::bsdf_component(weight: 1.5, component: lobeB));
    const auto rN = scatter::evaluate(df::normalized_mix(components), wo, wi);
    const auto rC = scatter::evaluate(df::clamped_mix(components), wo, wi);
    const auto rU = scatter::evaluate(df::unbounded_mix(components), wo, wi);
    #assert(#all(rN.f ~== |1e-5| 0.5 * fA + 0.5 * fB));
    #assert(#all(rC.f ~== |1e-5| 1.0 * fA));
    #assert(#all(rU.f ~== |1e-5| 1.5 * fA + 1.5 * fB));
  }
  // The clamp keeps the truncated component's chance and flags: with
  // default chances, the PDF mixes by the raw weights normalized over
  // both components, and the flags agree with the normalized mixer over
  // the same components.
  {
    const auto components = auto[2](
      df::bsdf_component(weight: 0.7, component: lobeA),
      df::bsdf_component(weight: 0.5, component: lobeB));
    const auto pA = scatter::evaluate(lobeA, wo, wi).pdf;
    const auto pB = scatter::evaluate(lobeB, wo, wi).pdf;
    const auto rC = scatter::evaluate(df::clamped_mix(components), wo, wi);
    #assert(#all(rC.f ~== |1e-5| 0.7 * fA + 0.3 * fB));
    #assert(rC.pdf ~== |1e-5| (0.7 * pA + 0.5 * pB) / 1.2);
    #assert(df::clamped_mix(components)._lobes == df::normalized_mix(components)._lobes);
  }
}

unit_test "A color mixer agrees with the float mixer at uniform weights" {
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto wi = math::normalize(float3(+0.5, 0.2, 0.9));
  const auto xi = float4(0.3, 0.4, 0.5, 0.6);
  const auto lobeA = df::diffuse_reflection_bsdf(tint: 0.8);
  const auto lobeB = df::microfacet_ggx_smith_bsdf(roughness_u: 0.4, roughness_v: 0.4, tint: 1.0);
  const auto fA = scatter::evaluate(lobeA, wo, wi).f;
  const auto fB = scatter::evaluate(lobeB, wo, wi).f;
  const auto pA = scatter::evaluate(lobeA, wo, wi).pdf;
  const auto pB = scatter::evaluate(lobeB, wo, wi).pdf;
  // Uniform color weights agree with the float mixers exactly.
  {
    const auto componentsF = auto[2](
      df::bsdf_component(weight: 0.3, component: lobeA),
      df::bsdf_component(weight: 0.4, component: lobeB));
    const auto componentsC = auto[2](
      df::color_bsdf_component(weight: color(0.3), component: lobeA),
      df::color_bsdf_component(weight: color(0.4), component: lobeB));
    const auto rF = scatter::evaluate(df::normalized_mix(componentsF), wo, wi);
    const auto rN = scatter::evaluate(df::color_normalized_mix(componentsC), wo, wi);
    const auto rC = scatter::evaluate(df::color_clamped_mix(componentsC), wo, wi);
    const auto rU = scatter::evaluate(df::color_unbounded_mix(componentsC), wo, wi);
    #assert(#all(rN.f ~== |1e-5| rF.f));
    #assert(rN.pdf ~== |1e-5| rF.pdf);
    #assert(#all(rC.f ~== |1e-5| rF.f));
    #assert(#all(rU.f ~== |1e-5| rF.f));
    #assert(scatter::sample(df::color_normalized_mix(componentsC), xi, wo).success);
    #assert(scatter::sample(df::color_clamped_mix(componentsC), xi, wo).success);
    #assert(scatter::sample(df::color_unbounded_mix(componentsC), xi, wo).success);
  }
  // Spectrally varying weights: normalization is per channel, so
  // channels whose weights sum above 1 rescale to sum 1 and channels
  // below are left alone; the sampling chance is the weight average.
  {
    const auto wA = color(float3(0.9, 0.3, 0.2));
    const auto wB = color(float3(0.8, 0.5, 0.1));
    const auto scale = 1.0 / math::max(wA + wB, 1.0);
    const auto chanceA = math::average(wA);
    const auto chanceB = math::average(wB);
    const auto r = scatter::evaluate(df::color_normalized_mix(auto[2](
      df::color_bsdf_component(weight: wA, component: lobeA),
      df::color_bsdf_component(weight: wB, component: lobeB))), wo, wi);
    #assert(#all(r.f ~== |1e-5| (scale * wA) * fA + (scale * wB) * fB));
    #assert(r.pdf ~== |1e-5| (chanceA * pA + chanceB * pB) / (chanceA + chanceB));
  }
  // The clamp is also per channel: the second weight is truncated to
  // the per-channel budget left by the first.
  {
    const auto wA = color(float3(0.9, 0.5, 0.2));
    const auto wB = color(float3(0.8, 0.9, 0.3));
    const auto wBClamped = math::min(wB, 1.0 - wA);
    const auto r = scatter::evaluate(df::color_clamped_mix(auto[2](
      df::color_bsdf_component(weight: wA, component: lobeA),
      df::color_bsdf_component(weight: wB, component: lobeB))), wo, wi);
    #assert(#all(r.f ~== |1e-5| wA * fA + wBClamped * fB));
  }
}

unit_test "A mix of one component is that component at its weight" {
  // The specification spells a mix of one as an array of one literal
  // component, which every mixer's inferred-size parameter has to take as
  // the array it is.
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto wi = math::normalize(float3(+0.5, 0.2, 0.9));
  const auto xi = float4(0.3, 0.4, 0.5, 0.6);
  const auto lobe = df::diffuse_reflection_bsdf(tint: 0.8);
  const auto f = scatter::evaluate(lobe, wo, wi).f;
  const auto components = df::bsdf_component[](
    df::bsdf_component(weight: 0.5, component: lobe));
  const auto componentsC = df::color_bsdf_component[](
    df::color_bsdf_component(weight: color(0.5), component: lobe));
  #assert(#all(scatter::evaluate(df::normalized_mix(components), wo, wi).f ~== |1e-5| 0.5 * f));
  #assert(#all(scatter::evaluate(df::clamped_mix(components), wo, wi).f ~== |1e-5| 0.5 * f));
  #assert(#all(scatter::evaluate(df::unbounded_mix(components), wo, wi).f ~== |1e-5| 0.5 * f));
  #assert(#all(scatter::evaluate(df::color_normalized_mix(componentsC), wo, wi).f ~== |1e-5| 0.5 * f));
  #assert(#all(scatter::evaluate(df::color_clamped_mix(componentsC), wo, wi).f ~== |1e-5| 0.5 * f));
  #assert(#all(scatter::evaluate(df::color_unbounded_mix(componentsC), wo, wi).f ~== |1e-5| 0.5 * f));
  #assert(scatter::sample(df::normalized_mix(components), xi, wo).success);
  #assert(scatter::sample(df::color_normalized_mix(componentsC), xi, wo).success);
}

unit_test "Every factor modifier survives the sampling path" {
  // Every factor modifier has to compile and execute through the sampling
  // entry point as well as the evaluation one. A modifier whose sampling
  // side is never called can name a function that does not exist.
  const auto wo = math::normalize(float3(0.3, 0.2, 1.5));
  const auto xi = float4(0.3, 0.4, 0.5, 0.6);
  const auto base = df::microfacet_ggx_smith_bsdf(roughness_u: 0.4, roughness_v: 0.4, tint: 1.0);
  {
    const auto r = scatter::sample(df::tint(tint: color(0.5), base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
  {
    const auto r = scatter::sample(df::thin_film(thickness: 300.0, ior: 1.6, base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
  {
    const auto r = scatter::sample(df::directional_factor(normal_tint: 0.9, grazing_tint: 0.3, base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
  {
    const auto r = scatter::sample(df::fresnel_factor(ior: 1.5, extinction_coefficient: 2.0, base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
  {
    const auto r = scatter::sample(df::coat_absorption_factor(ior: 1.5, absorption_coefficient: 500.0, thickness: 0.001, base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
  {
    const auto r = scatter::sample(df::measured_curve_factor(curve_values: color[3](color(0.9), color(0.5), color(0.2)), base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
  {
    const auto r = scatter::sample(df::measured_factor(values: texture_2d("4x4.png", tex::gamma_linear), base: base), xi, wo);
    #assert(r.success);
    #assert(#all(r.f >= 0.0));
  }
  {
    const auto r = scatter::sample(df::horizon_shadow_factor(slopes: float4(0.0), base: base), xi, wo);
    #assert(r.success);
    #assert(#any(r.f > 0.0));
  }
}

unit_test "A clear coat absorbs along the paths refracted into it" {
  // A coat of index 1.5 and optical depth 1 straight through: a path at
  // normal incidence crosses it twice, and an oblique one crosses at the
  // angle it refracts to.
  const auto coat = \(const bsdf base) = df::coat_absorption_factor(
    ior: 1.5, absorption_coefficient: 1000.0, thickness: 0.001, base: base);
  const auto lambert = df::diffuse_reflection_bsdf(tint: 1.0);
  const auto n = float3(0, 0, 1);
  #assert(scatter::evaluate(coat(lambert), n, n).f[0] ~== (1e-5) #exp(-2.0) / $PI);
  const auto wo = float3(0.8, 0.0, 0.6);
  const auto wi = float3(-0.8, 0.0, 0.6);
  const float crossing = 1 / #sqrt(1 - 0.64 / 2.25);
  #assert(
    scatter::evaluate(coat(lambert), wo, wi).f[0] ~== (1e-5)
    #exp(-2 * crossing) * 0.6 / $PI);
  // A transmitted path crosses the coat once, so it travels half as far.
  #assert(
    scatter::evaluate(coat(df::diffuse_transmission_bsdf(tint: 1.0)), n, -n).f[0] ~==
    (1e-5) #exp(-1.0) / $PI);
  // A Dirac draw is attenuated as an evaluation would be.
  const auto r = scatter::sample(coat(df::specular_bsdf(tint: 1.0)), float4(0.5), wo);
  #assert(r.success);
  #assert(r.f[0] ~== (1e-5) #exp(-2 * crossing));
  // A coat with no thickness, or with a lower index than the incident
  // medium, absorbs nothing.
  #assert(#all(
    scatter::evaluate(
      df::coat_absorption_factor(ior: 1.5, absorption_coefficient: 1000.0, base: lambert),
      wo, wi).f == scatter::evaluate(lambert, wo, wi).f));
  #assert(#all(
    scatter::evaluate(
      df::coat_absorption_factor(
        ior: 0.9, absorption_coefficient: 1000.0, thickness: 0.001, base: lambert),
      wo, wi).f == scatter::evaluate(lambert, wo, wi).f));
}

unit_test "A two-value tint tints each side by its own tint" {
  // Evaluation knows the side from the direction pair, and sampling from
  // the side the draw landed on, so each path chooses the tint its own way
  // and both are held to it. Each draw is compared with the same draw of
  // the untinted base.
  const auto reflectionTint = color(0.5);
  const auto transmissionTint = color(0.25);
  {
    const auto base = df::microfacet_ggx_smith_bsdf(
      roughness_u: 0.4, roughness_v: 0.4, tint: 1.0, mode: df::scatter_reflect_transmit);
    const auto tinted = df::tint(
      reflection_tint: reflectionTint, transmission_tint: transmissionTint, base: base);
    const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
    const auto wiR = math::normalize(float3(+0.5, 0.2, 0.9));
    const auto wiT = math::normalize(float3(+0.5, 0.2, -0.9));
    const auto fR = scatter::evaluate(base, wo, wiR).f;
    const auto fT = scatter::evaluate(base, wo, wiT).f;
    #assert(#any(fR > 0.0) && #any(fT > 0.0));
    #assert(#all(scatter::evaluate(tinted, wo, wiR).f ~== |1e-5| reflectionTint * fR));
    #assert(#all(scatter::evaluate(tinted, wo, wiT).f ~== |1e-5| transmissionTint * fT));
  }
  {
    const auto base = df::specular_bsdf(mode: df::scatter_reflect_transmit);
    const auto tinted = df::tint(
      reflection_tint: reflectionTint, transmission_tint: transmissionTint, base: base);
    const auto wo = math::normalize(float3(0.9, 0.0, 0.2));
    bool sawReflection = false;
    bool sawTransmission = false;
    for (int i = 0; i < 32; i++) {
      const auto xi = float4((float(i) + 0.5) / 32.0);
      const auto r0 = scatter::sample(base, xi, wo);
      const auto r1 = scatter::sample(tinted, xi, wo);
      #assert(r0.success && r1.success);
      const bool isReflection = r1.wi.z > 0.0;
      sawReflection = sawReflection || isReflection;
      sawTransmission = sawTransmission || !isReflection;
      #assert(#all(r1.f ~== |1e-5| (isReflection ? reflectionTint : transmissionTint) * r0.f));
    }
    #assert(sawReflection && sawTransmission);
  }
}
