/// The rough reflection lobes that are not microfacet models: the EON
/// diffuse model and the LTC sheen fit, both of which must conserve energy
/// and report a density their sampling routine draws from.
#smdl

import ::df::*;
import ::math::*;
using scatter = ::support::scatter;
import scatter::*;

unit_test "The EON model conserves energy in a white furnace" {
  // The energy-preserving Oren-Nayar model must integrate to the
  // single-scattering albedo 1 at unit tint, for any roughness and any
  // view direction.
  for (int k = 0; k < 3; k++) {
    const auto r = float(0.25 + 0.375 * k);
    const auto b = df::diffuse_reflection_bsdf(tint: 1.0, roughness: r);
    const auto E0 =
      scatter::furnaceIntegral(b, math::normalize(float3(0.1, 0.2, 0.97)));
    const auto E1 =
      scatter::furnaceIntegral(b, math::normalize(float3(0.8, 0.1, 0.35)));
    #assert((0.97 < E0) & (E0 < 1.03));
    #assert((0.97 < E1) & (E1 < 1.03));
  }
}

unit_test "The LTC sheen fit conserves energy and matches its acceptance" {
  const auto wo = math::normalize(float3(-0.3, 0.4, 0.8));
  const auto woG = math::normalize(float3(0.8, 0.1, 0.2));
  // The sheen lobe reflects at most the tabulated directional albedo, so
  // at unit tint the furnace integral must stay bounded by 1.
  for (int k = 0; k < 3; k++) {
    const auto r = float(0.2 + 0.4 * k);
    const auto b = df::sheen_bsdf(tint: 1.0, roughness: r);
    const auto E0 = scatter::furnaceIntegral(b, wo);
    const auto E1 = scatter::furnaceIntegral(b, woG);
    #assert((0.0 <= E0) & (E0 < 1.02));
    #assert((0.0 <= E1) & (E1 < 1.02));
  }
  // With full multiscatter compensation the total stays near or below 1.
  const auto EMS = scatter::furnaceIntegral(
    df::sheen_bsdf(tint: 1.0, roughness: 0.6, multiscatter_tint: 1.0), wo);
  #assert((0.2 < EMS) & (EMS < 1.05));
  // The LTC sampling densities must match the sampling routine, including
  // the cosine fallback where the fit degenerates and the multiscatter
  // sampling chance.
  scatter::checkDensityAgainstAcceptance(
    df::sheen_bsdf(tint: 1.0, roughness: 0.3), wo, 1.0);
  scatter::checkDensityAgainstAcceptance(
    df::sheen_bsdf(tint: 1.0, roughness: 0.8), woG, 1.0);
  scatter::checkDensityAgainstAcceptance(
    df::sheen_bsdf(tint: 1.0, roughness: 0.6, multiscatter_tint: 0.8), wo, 1.0);
}
