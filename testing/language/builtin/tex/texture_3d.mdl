/// Tests for `texture_3d` and the `tex` module 3D lookups, backed by
/// two checked-in fixtures under `fixtures/`:
///
/// - `linear_32x8x4.vol`: a Mitsuba volume holding the linear field
///   `value = x + 10*y + 100*z`, so trilinear filtering reproduces it
///   exactly at any coordinate.
/// - `blob.nvdb`: a NanoVDB file holding two named float grids, both
///   written with NanoVDB's own `build::Grid`/`createNanoGrid`/
///   `writeGrids` tooling:
///   - `density`, first in the file: a dense box over the *global*
///     index region `[3,22] x [-5,10] x [7,20]`, so the active origin
///     is deliberately non-aligned and partially negative, with
///     `value = 0.25 * ((x + y + z) mod 5)` in global index
///     coordinates. Local voxel `(x, y, z)` therefore has the value
///     `0.25 * ((x + y + z + 5) mod 5)`.
///   - `temperature`: an 8x8x8 box of the constant 500.
///
/// The NanoVDB cases are gated on `$HAS_NANOVDB` so that the suite still
/// passes when built with `-DSMDL_ENABLE_NANOVDB=OFF`.
#smdl
#search_dir "../../fixtures"

import ::tex::*;

unit_test "A Mitsuba volume reads its voxels and filters exactly" {
  const auto t = texture_3d("linear_32x8x4.vol");
  #assert(tex::texture_isvalid(t));
  #assert(tex::width(t) == 32);
  #assert(tex::height(t) == 8);
  #assert(tex::depth(t) == 4);
  #assert(#all(tex::extent(t) == int3(32, 8, 4)));
  #assert(tex::first_frame(t) == 0);
  #assert(tex::last_frame(t) == 0);
  // The value bounds of the linear field 'x + 10*y + 100*z'.
  #assert(tex::min_value(t) == 0.0);
  #assert(tex::max_value(t) == 31.0 + 70.0 + 300.0);
  // Exact voxel fetches.
  #assert(tex::texel_float(t, int3(0)) == 0.0);
  #assert(tex::texel_float(t, int3(3, 4, 2)) == 243.0);
  #assert(tex::texel_float(t, int3(31, 7, 3)) == 401.0);
  // Out-of-extent texels resolve to the background of zero.
  #assert(tex::texel_float(t, int3(32, 0, 0)) == 0.0);
  #assert(tex::texel_float(t, int3(0, -1, 0)) == 0.0);
  // The single-channel splat convention: '(v, v, v, 1)'.
  #assert(
    #all(tex::texel_float4(t, int3(1, 0, 0)) == float4(1.0, 1.0, 1.0, 1.0)));
  #assert(#all(tex::texel_color(t, int3(1, 0, 0)) == color(1.0)));
  // The extents are powers of two, so voxel-center coordinates are
  // exact and the lookup must reproduce the texel exactly.
  #assert(tex::lookup_float(t, float3(3.5 / 32, 4.5 / 8, 2.5 / 4)) == 243.0);
  #assert(#all(
    tex::lookup_float4(t, float3(3.5 / 32, 4.5 / 8, 2.5 / 4)) == float4(243.0, 243.0, 243.0, 1.0)));
  // Halfway between voxels 3 and 4 in x, the linear field averages.
  #assert(tex::lookup_float(t, float3(4.0 / 32, 4.5 / 8, 2.5 / 4)) == 243.5);
  // The clip wrap mode returns zero outside [0, 1) per axis.
  #assert(
    tex::lookup_float(t, float3(+1.5, 0.5, 0.5), wrap_u: tex::wrap_clip) == 0.0);
  #assert(
    tex::lookup_float(t, float3(-0.5, 0.5, 0.5), wrap_u: tex::wrap_clip) == 0.0);
  #assert(
    tex::lookup_float(t, float3(0.5, 0.5, +1.5), wrap_w: tex::wrap_clip) == 0.0);
  // The clamp wrap mode holds the boundary voxel: x clamps to 31 while
  // y and z stay at voxel centers 4 and 2.
  #assert(
    tex::lookup_float(t, float3(1.1, 4.5 / 8, 2.5 / 4), wrap_u: tex::wrap_clamp) == 31.0 + 40.0 + 200.0);
  // The corners resolve through one brick when they share it and voxel
  // by voxel when they straddle a brick boundary, and both must
  // reproduce the linear field: bricks are 16 voxels, so x = 15.5
  // straddles the boundary and x = 16.5 does not.
  #assert(
    tex::lookup_float(t, float3(16.0 / 32, 4.5 / 8, 2.5 / 4)) == 15.5 + 40.0 + 200.0);
  #assert(
    tex::lookup_float(t, float3(17.0 / 32, 4.5 / 8, 2.5 / 4)) == 16.5 + 40.0 + 200.0);
  // A repeat wrap at the far edge pairs voxel 7 with voxel 0 of the
  // same brick, so the one-brick corners step below their base voxel.
  #assert(
    tex::lookup_float(t, float3(3.5 / 32, 1.0, 2.5 / 4)) == 3.0 + 35.0 + 200.0);
}

unit_test "A NanoVDB density grid reads its voxels" {
  if $($HAS_NANOVDB) {
    // An empty selector loads the first grid in the file.
    const auto t = texture_3d("blob.nvdb");
    #assert(tex::texture_isvalid(t));
    #assert(#all(tex::extent(t) == int3(20, 16, 14)));
    #assert(tex::min_value(t) == 0.0);
    #assert(tex::max_value(t) == 1.0);
    // Local voxel (x, y, z) has value '0.25 * ((x + y + z + 5) mod 5)'.
    #assert(tex::texel_float(t, int3(0)) == 0.0);
    #assert(tex::texel_float(t, int3(1, 2, 3)) == 0.25);
    #assert(tex::texel_float(t, int3(2, 3, 4)) == 1.0);
    #assert(tex::texel_float(t, int3(19, 15, 13)) == 0.5);
    // A lookup at the center of voxel (2, 3, 4). The extents are not
    // powers of two, so the coordinates are inexact and the comparison
    // is approximate.
    #assert(
      tex::lookup_float(t, float3(2.5 / 20, 3.5 / 16, 4.5 / 14)) ~== |1e-4| 1.0);
    // Halfway between voxels (2,3,4) and (3,3,4): the sawtooth wraps
    // from 1.0 back to 0.0, so the interpolant is 0.5.
    #assert(
      tex::lookup_float(t, float3(3.0 / 20, 3.5 / 16, 4.5 / 14)) ~== |1e-4| 0.5);
    // Straddling the brick boundary at x = 16: voxels (15, 3, 4) and
    // (16, 3, 4) hold 0.5 and 0.75.
    #assert(
      tex::lookup_float(t, float3(16.0 / 20, 3.5 / 16, 4.5 / 14)) ~== |1e-4| 0.625);
  }
}

unit_test "A named NanoVDB grid coexists with the first" {
  if $($HAS_NANOVDB) {
    // The selector picks a named grid out of the same file. The cache is
    // keyed by content hash and selector, so this coexists with the
    // 'density' load above.
    const auto t = texture_3d("blob.nvdb", 0, "temperature");
    #assert(tex::texture_isvalid(t));
    #assert(#all(tex::extent(t) == int3(8, 8, 8)));
    #assert(tex::min_value(t) == 500.0);
    #assert(tex::max_value(t) == 500.0);
    #assert(tex::texel_float(t, int3(3, 4, 5)) == 500.0);
    // A constant field is constant under filtering at any coordinate.
    #assert(tex::lookup_float(t, float3(0.5)) == 500.0);
    #assert(tex::lookup_float(t, float3(0.9, 0.1, 0.7)) == 500.0);
  }
}
