/// The builtin `api` module, whose exports every module sees as keywords:
/// here, the observer the spectral color conversions and `math::luminance`
/// weigh a spectrum by. It is the piecewise Gaussian fit of CIE 1931 XYZ
/// by Wyman, Sloan, and Shirley (2013), scaled by 0.01, and exactly so in
/// the tails, where a truncated exponential series is several times too
/// high.
#smdl

import ::math::*;

float lobe(
  const float w, const float center, const float below, const float above) {
  const float x = (w - center) * (w < center ? below : above);
  return math::exp(-0.5 * x * x);
}

unit_test "The observer is the Gaussian fit out to its tails" {
  for (int i = 360; i <= 830; i += 10) {
    const float w = float(i);
    const float3 xyz = _wymanXYZ(w);
    #assert(
      xyz.x ~== (1e-4) 0.01 * (0.362 * lobe(w, 442.0, 0.0624, 0.0374) +
                               1.056 * lobe(w, 599.8, 0.0264, 0.0323) -
                               0.065 * lobe(w, 501.1, 0.0490, 0.0382)));
    #assert(
      xyz.y ~== (1e-4) 0.01 * (0.821 * lobe(w, 568.8, 0.0213, 0.0247) +
                               0.286 * lobe(w, 530.9, 0.0613, 0.0322)));
    #assert(
      xyz.z ~== (1e-4) 0.01 * (1.217 * lobe(w, 437.0, 0.0845, 0.0278) +
                               0.681 * lobe(w, 459.0, 0.0385, 0.0725)));
    #assert(_wymanY(w) ~== (1e-6) xyz.y);
  }
}
