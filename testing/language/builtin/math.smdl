/// `::math`: the standard library's scalar, vector, and spectral
/// functions. Where the MDL specification pins a behaviour, such as the
/// argument order of `smoothstep`, the test says so.
#smdl

import ::math::*;

unit_test "The classification predicates agree on infinity and NaN" {
  #assert(math::abs(-7) == 7);
  #assert(math::abs(-7.1) == 7.1);
  #assert(math::isinf($INF) && !math::isnan($INF) && !math::isfinite($INF));
  #assert(math::isnan($NAN) && !math::isinf($NAN) && !math::isfinite($NAN));
}

unit_test "The trigonometric functions invert each other" {
  #assert(math::cos(math::acos(0.349)) ~== |1e-5| 0.349);
  #assert(math::sin(math::asin(0.715)) ~== |1e-5| 0.715);
  #assert(math::tan(math::atan(0.631)) ~== |1e-5| 0.631);
  #assert(math::atan2(math::sin(theta := 1.491), math::cos(theta)) ~== |1e-5| theta);
  #assert(math::cosh(+3.872) ~== |1e-5| 24.029591748);
  #assert(math::sinh(-1.299) ~== |1e-5| -1.69641237193);
  #assert(math::tanh(-2.137) ~== |1e-5| -0.972530602491);
}

unit_test "Each logarithm inverts the exponential of its own base" {
  #assert(math::log(math::exp(0.617)) ~== |1e-5| 0.617);
  #assert(math::log2(math::exp2(0.617)) ~== |1e-5| 0.617);
  #assert(math::log10(math::exp10(0.617)) ~== |1e-5| 0.617);
}

unit_test "lerp is exact at both ends" {
  #assert(math::lerp(2.7, 8.1, 0.5) ~== |1e-5| 0.5 * (2.7 + 8.1));
  #assert(math::lerp(2.7, 8.1, 0.0) == 2.7);
  #assert(math::lerp(2.7, 8.1, 1.0) == 8.1);
}

unit_test "smoothstep takes its edges first, per the specification" {
  // The edges are the first two arguments and the value is the last: 0
  // below `a`, 1 above `b`, an S-curve in between.
  #assert(math::smoothstep(2.7, 8.1, 2.0) == 0.0);
  #assert(math::smoothstep(2.7, 8.1, 9.0) == 1.0);
  #assert(math::smoothstep(2.7, 8.1, 2.7) == 0.0);
  #assert(math::smoothstep(2.7, 8.1, 8.1) == 1.0);
  #assert(math::smoothstep(2.7, 8.1, 0.5 * (2.7 + 8.1)) ~== |1e-6| 0.5);
}

unit_test "smoothstep is monotone, bounded, and symmetric about its midpoint" {
  auto prev = 0.0;
  for (int i = 0; i <= 40; i++) {
    const auto x = 2.0 + 0.2 * i;
    const auto s = math::smoothstep(2.7, 8.1, x);
    #assert(s >= prev && 0.0 <= s && s <= 1.0);
    #assert(s + math::smoothstep(2.7, 8.1, 2.7 + 8.1 - x) ~== |1e-6| 1.0);
    prev = s;
  }
}

unit_test "Reversed smoothstep edges give the falling ramp" {
  #assert(math::smoothstep(8.1, 2.7, 4.3) ~== |1e-6| 1.0 - math::smoothstep(2.7, 8.1, 4.3));
  // Coincident edges degrade to a hard step at the edge.
  #assert(math::smoothstep(1.0, 1.0, 0.9999) == 0.0);
  #assert(math::smoothstep(1.0, 1.0, 1.0001) == 1.0);
}

unit_test "smoothstep broadcasts a scalar against per-component edges" {
  // The specification's mixed overload is per-component edges against a
  // scalar value; the transposed spelling broadcasts just as well.
  #assert(#all(math::smoothstep(float3(0.0, 2.0, 4.0), float3(2.0, 4.0, 6.0), 3.0) ~== |1e-6| float3(1.0, 0.5, 0.0)));
  #assert(#all(math::smoothstep(0.0, 2.0, float3(-1.0, 1.0, 3.0)) ~== |1e-6| float3(0.0, 0.5, 1.0)));
  // Spectral colors are an extension, but they fall out of the generic form.
  #assert(math::smoothstep(color(0.0), color(2.0), color(1.0))[0] ~== |1e-6| 0.5);
}

unit_test "sincos and modf return both halves" {
  const auto sc = math::sincos(0.411);
  #assert(sc[0] ~== |1e-5| math::sin(0.411));
  #assert(sc[1] ~== |1e-5| math::cos(0.411));
  const auto ip = math::modf(float2(-1.8, 11.7));
  #assert(#all(ip[0] ~== |1e-5| float2(-1, 11)));
  #assert(#all(ip[1] ~== |1e-5| float2(-0.8, 0.7)));
}

unit_test "The reductions reduce, and a scalar is its own reduction" {
  #assert(math::average(float4(3, 5, 7, 9)) ~== |1e-5| 6.0);
  #assert(math::average(1.25) == 1.25);
  #assert(math::min_value(float4(-0.1, -1.2, 4.7, 3.1)) == -1.2);
  #assert(math::max_value(float4(-0.1, -1.2, 4.7, 3.1)) == 4.7);
}

unit_test "The vector algebra is self-consistent" {
  const auto v = float3(1.5, -0.8, -1.3);
  #assert(math::length(math::normalize(v)) ~== |1e-5| 1.0);
  #assert(math::dot(v, math::normalize(v)) ~== |1e-5| math::length(v));
  #assert(#all(math::cross(float3(1, 0, 0), float3(0, 1, 0)) == float3(0, 0, 1)));
  #assert(math::radians(45) ~== |1e-5| $PI / 4);
  #assert(math::degrees(math::radians(51.3)) ~== |1e-5| 51.3);
}

unit_test "A spectrum evaluates between its samples" {
  if $($WAVELENGTH_BASE_MAX >= 2) {
    color c(0);
    c[0] = 0.617;
    c[1] = 0.243;
    const float w(0.5 * ($state.wavelengthBase[0] + $state.wavelengthBase[1]));
    #assert(math::eval_at_wavelength(c, w) ~== |1e-5| 0.43);
  }
}

unit_test "A flat spectrum becomes a flat color" {
  // A flat spectrum resamples to a flat color; a single sample
  // broadcasts; the color overload is the identity.
  #assert(#all(math::emission_color(float[2](400.0, 700.0), float[2](1.0, 1.0)) ~== |1e-5| color(1.0)));
  #assert(#all(math::emission_color(float[1](550.0), float[1](0.25)) ~== |1e-6| color(0.25)));
  #assert(#all(math::emission_color(color(0.7)) == color(0.7)));
}

unit_test "The bit casts round trip" {
  #assert(math::int_bits_to_float(0x3F800000) == 1.0);
  #assert(math::float_bits_to_int(1.0) == 0x3F800000);
  #assert(math::int_bits_to_float(math::float_bits_to_int(-2.5)) == -2.5);
  #assert(math::float_bits_to_int(math::int_bits_to_float(12345)) == 12345);
}
