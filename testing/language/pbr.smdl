#smdl

import ::math::*;
using parallax = ::extras::parallax;
import parallax::*;
using pbr = ::extras::pbr;
import pbr::*;

// The horizon map fixture stores constant channels 0.25, 0.5, 0.75, 1.0
// in R, G, B, A with 'max_slope: 4' and intrinsic relief
// 'physical_relief / physical_extent.x = 0.25', so the decoded slopes
// have closed forms at any coordinate.

unit_test "PBR horizon map decode" {
  const auto pack = pbr::pbr_maps("pbr_fixture/fixture.pbr");
  #assert(#hasField(pack, "horizon"));
  #assert(#hasField(pack, "height"));
  #assert(!#hasField(pack, "basecolor"));
  #assert(pack.horizon.max_slope == 4.0);
  // Height and horizon maps load without mip chains, so any lod-aware
  // lookup reads level 0.
  #assert(pack.horizon.tex.num_levels == 1);
  #assert(pack.height.tex.num_levels == 1);
  // The relief scale is derived from the physical pair, which the pack
  // still carries verbatim.
  #assert(pack.physical_relief == 0.5);
  #assert(pack.physical_extent.x == 2.0);
  #assert(pack.relief_scale == 0.25);
  // The height role reuses the horizon image with 'channel: r', a
  // constant 0.25.
  #assert(pack.height.channel == 0);
  #assert(pbr::lookup_float(pack.height, float2(0.5, 0.5)) ~== |1e-3| 0.25);
  const float2 uv = float2(0.5, 0.5);
  // The default is the intrinsic scale: decoded = max_slope * stored.
  const auto s0 = pbr::horizon_slopes(pack, uv);
  #assert(s0.x ~== |1e-3| 1.0);
  #assert(s0.y ~== |1e-3| 2.0);
  #assert(s0.z ~== |1e-3| 3.0);
  #assert(s0.w ~== |1e-3| 4.0);
  // Half the intrinsic relief halves every slope.
  const auto s1 = pbr::horizon_slopes(pack, uv, relief_scale: 0.125);
  #assert(s1.x ~== |1e-3| 0.5);
  #assert(s1.w ~== |1e-3| 2.0);
  // Zero scale is the shadow factor's passthrough.
  #assert(#all(pbr::horizon_slopes(pack, uv, relief_scale: 0.0) == float4(0.0)));
  // Large scales cap at PARALLAX_MAX_SLOPE, like the runtime search.
  const auto s2 = pbr::horizon_slopes(pack, uv, relief_scale: 10.0);
  #assert(#all(s2 <= parallax::PARALLAX_MAX_SLOPE));
  #assert(s2.w ~== |1e-3| parallax::PARALLAX_MAX_SLOPE);
}

// The same maps with the relief scale declared directly rather than
// derived from a physical extent and relief: the bespoke-asset case,
// where there is no meaningful extent to divide by. Both spellings must
// decode identically.
unit_test "PBR direct relief scale" {
  const auto pack = pbr::pbr_maps("pbr_fixture/fixture_relief_scale.pbr");
  #assert(#hasField(pack, "relief_scale"));
  #assert(pack.relief_scale == 0.25);
  // The physical metadata is genuinely absent, so a material reading it
  // would not compile; only the resolved scale is there.
  #assert(!#hasField(pack, "physical_relief"));
  #assert(!#hasField(pack, "physical_extent"));
  const float2 uv = float2(0.5, 0.5);
  const auto s0 = pbr::horizon_slopes(pack, uv);
  #assert(s0.x ~== |1e-3| 1.0);
  #assert(s0.y ~== |1e-3| 2.0);
  #assert(s0.z ~== |1e-3| 3.0);
  #assert(s0.w ~== |1e-3| 4.0);
  // And rescaling relative to it behaves the same way.
  const auto s1 = pbr::horizon_slopes(pack, uv, relief_scale: 0.125);
  #assert(s1.x ~== |1e-3| 0.5);
  #assert(s1.w ~== |1e-3| 2.0);
  #assert(#all(pbr::horizon_slopes(pack, uv, relief_scale: 0.0) == float4(0.0)));
}

// The fixture ships no basecolor and no emission map, so the decoded
// neutral defaults must stay scalar floats rather than upsampling to
// spectral colors: the '$(color | float)' fields resolve to 'float'.
unit_test "PBR neutral defaults stay scalar" {
  const auto pack = pbr::pbr_maps("pbr_fixture/fixture.pbr");
  const auto s = pbr::sample(pack);
  #assert(#typeOf(s.basecolor) == float);
  #assert(#typeOf(s.emission) == float);
  #assert(s.basecolor == 1.0);
  #assert(s.emission == 0.0);
  const auto p = pbr::prepared(pack);
  #assert(#typeOf(p.basecolor) == float);
  #assert(#typeOf(p.emission) == float);
  #assert(p.basecolor == 1.0);
  #assert(p.emission == 0.0);
}

// A hand-built set that declares only the maps it has works everywhere
// 'pbr_maps' does (see the module doc), and a present basecolor map
// resolves the union field to a spectral 'color'.
struct HandSet {
  const auto basecolor = pbr::pbr_map(tex: texture_2d("4x4.png"));
};

unit_test "PBR hand-built basecolor is spectral" {
  const auto s = pbr::sample(HandSet());
  #assert(#typeOf(s.basecolor) == color);
  #assert(#typeOf(s.emission) == float);
  #assert(s.emission == 0.0);
}

// The texel-level normal decoder dispatches on the convention alone, so
// hand-built maps with no texture at all exercise every branch. The
// constant values mirror 'PBRMaps::NormalConvention' in C++; the
// Emitter passes the enum through as a plain int, so these asserts
// pin the contract.
unit_test "PBR normal decode" {
  #assert(pbr::NORMAL_OPENGL == 0);
  #assert(pbr::NORMAL_DIRECTX == 1);
  #assert(pbr::NORMAL_OPENGL_XY == 2);
  #assert(pbr::NORMAL_DIRECTX_XY == 3);
  // 3-channel: DirectX is OpenGL with Y negated.
  const float4 t3 = float4(0.75, 1.0, 1.0, 1.0);
  const auto og = pbr::decode_normal_texel(pbr::pbr_map(convention: pbr::NORMAL_OPENGL), t3);
  const auto dx = pbr::decode_normal_texel(pbr::pbr_map(convention: pbr::NORMAL_DIRECTX), t3);
  #assert(math::length(og) ~== |1e-5| 1.0);
  #assert(og.x ~== |1e-5| dx.x);
  #assert(og.y ~== |1e-5| -dx.y);
  #assert(og.z ~== |1e-5| dx.z);
  // 2-channel: Z is reconstructed and the stored Z and W are ignored.
  const auto flat = pbr::decode_normal_texel(
      pbr::pbr_map(convention: pbr::NORMAL_OPENGL_XY), float4(0.5, 0.5, 0.123, 0.9));
  #assert(#all(flat ~== |1e-5| float3(0.0, 0.0, 1.0)));
  // xy = (0.6, 0.3) reconstructs z = sqrt(1 - 0.36 - 0.09), already
  // unit; DirectX XY is the same with Y negated.
  const float4 t2 = float4(0.8, 0.65, 0.0, 0.0);
  const auto og_xy = pbr::decode_normal_texel(pbr::pbr_map(convention: pbr::NORMAL_OPENGL_XY), t2);
  const auto dx_xy = pbr::decode_normal_texel(pbr::pbr_map(convention: pbr::NORMAL_DIRECTX_XY), t2);
  #assert(#all(og_xy ~== |1e-5| float3(0.6, 0.3, math::sqrt(0.55))));
  #assert(og_xy.x ~== |1e-5| dx_xy.x);
  #assert(og_xy.y ~== |1e-5| -dx_xy.y);
  #assert(og_xy.z ~== |1e-5| dx_xy.z);
}

// The compile-time load flags of 'pbr_maps'. What each flag decides is
// the *type* of the resulting set, so these assertions are about which
// fields exist and how many levels each texture reads: compile-time
// facts either way. Every role of 'fixture_flags.pbr' reuses one 4x4
// image, so an opted-in map has exactly 3 levels.

unit_test "PBR flags: mip filtering is opt in" {
  const auto pack = pbr::pbr_maps("pbr_fixture/fixture_flags.pbr");
  #assert(pack.basecolor.tex.num_levels == 1);
  #assert(pack.roughness.tex.num_levels == 1);
  #assert(pack.class_map.tex.num_levels == 1);
  const auto packMips = pbr::pbr_maps("pbr_fixture/fixture_flags.pbr", use_mipmap: true);
  #assert(packMips.basecolor.tex.num_levels == 3);
  #assert(packMips.roughness.tex.num_levels == 3);
  #assert(packMips.class_map.tex.num_levels == 3);
  // The height and horizon maps are the permanent exception: box
  // filtering is wrong for both, so they read level 0 either way.
  #assert(packMips.height.tex.num_levels == 1);
  #assert(packMips.horizon.tex.num_levels == 1);
  // Both readings of the same file share one image, so level 0 is
  // identical whichever way the set was loaded.
  #assert(pbr::lookup_float(pack.roughness, float2(0.5)) ~== |1e-6| pbr::lookup_float(packMips.roughness, float2(0.5)));
}

unit_test "PBR flags: no_basecolor" {
  const auto pack = pbr::pbr_maps("pbr_fixture/fixture_flags.pbr", no_basecolor: true);
  #assert(!#hasField(pack, "basecolor"));
  // Nothing else is disturbed.
  #assert(#hasField(pack, "roughness"));
  #assert(#hasField(pack, "height"));
  // Without the map the decoded base color is the neutral scalar white,
  // so the union field resolves to 'float' instead of 'color'.
  const auto s = pbr::sample(pack);
  #assert(#typeOf(s.basecolor) == float);
  #assert(s.basecolor == 1.0);
}

unit_test "PBR flags: no_class_map" {
  const auto pack = pbr::pbr_maps("pbr_fixture/fixture_flags.pbr", no_class_map: true);
  #assert(!#hasField(pack, "class_map"));
  // Without the flag the fixture carries it, and the weights are always
  // four: the map does not say how many classes were fit into it.
  const auto packWith = pbr::pbr_maps("pbr_fixture/fixture_flags.pbr");
  #assert(#hasField(packWith, "class_map"));
  #assert(#num(pbr::class_weights(packWith)) == 4);
}

unit_test "PBR flags: no_height implies no_parallax" {
  const auto pack = pbr::pbr_maps("pbr_fixture/fixture_flags.pbr", no_height: true);
  #assert(!#hasField(pack, "height"));
  // The horizon map has no consumer once the relief pipeline is off.
  #assert(!#hasField(pack, "horizon"));
  #assert(pack.no_parallax);
  #assert(!pbr::uses_parallax(pack));
  #assert(#hasField(pack, "basecolor"));
  const auto p = pbr::prepared(pack);
  #assert(p.height == 1.0); // The neutral default.
}

unit_test "PBR flags: no_parallax keeps the height map" {
  const auto pack = pbr::pbr_maps("pbr_fixture/fixture_flags.pbr", no_parallax: true);
  #assert(#hasField(pack, "height"));
  #assert(!#hasField(pack, "horizon"));
  #assert(pack.no_parallax);
  #assert(!pbr::uses_parallax(pack));
  // The march does not run, so the coordinate passes through untouched
  // and the slopes are the shadow factor's exact passthrough.
  const float2 uv = float2(0.3, 0.7);
  const auto p = pbr::prepared(pack, uv);
  #assert(#all(p.coord == uv));
  #assert(#all(p.horizon_slopes == float4(0.0)));
  // But the map is loaded, so the height is still reported where the
  // other maps read it: channel r of the fixture, a constant 0.25.
  #assert(p.height ~== |1e-3| 0.25);
  #assert(p.height ~== |1e-6| pbr::lookup_float(pack.height, uv));
  // And the same set without the flag does march the relief.
  const auto packRelief = pbr::pbr_maps("pbr_fixture/fixture_flags.pbr");
  #assert(pbr::uses_parallax(packRelief));
  #assert(!packRelief.no_parallax);
}

// A hand-built set declares only the fields it has, so it never carries
// the flag: the relief gate must fall back to presence alone.
struct HandSetHeight {
  const auto height = pbr::pbr_map(tex: texture_2d("4x4.png"));
};

unit_test "PBR flags: hand-built sets need no flag field" {
  #assert(!#hasField(HandSetHeight(), "no_parallax"));
  #assert(pbr::uses_parallax(HandSetHeight()));
  // And a set with no height map has no relief either way.
  #assert(!pbr::uses_parallax(HandSet()));
}
