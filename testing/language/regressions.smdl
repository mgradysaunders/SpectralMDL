#smdl

import ::tex::*;

// string '=='/'!=' compared only strlen(lhs) bytes, so a prefix compared
// equal to a longer string (and the comparison was asymmetric).
unit_test "String comparison is not prefix-based" {
  #assert(!("abc" == "abcdef"));
  #assert(!("abcdef" == "abc"));
  #assert("abc" == "abc");
  #assert("abc" != "abcd");
  #assert(!("" == "x"));
  #assert("" == "");
}

// 'do { } while ();' never branched into the loop body, so every use
// failed LLVM-IR verification.
unit_test "Do-while executes" {
  int i = 0;
  do {
    i++;
  } while (i < 3);
  #assert(i == 3);
  // Loop body must run at least once even if the condition is false.
  int j = 0;
  do {
    j++;
  } while (false);
  #assert(j == 1);
}

// a 'for' with an empty condition made the emitter dereference a null
// condition expression.
unit_test "For with empty condition" {
  int j = 0;
  for (int n = 0; ; n++) {
    j++;
    if (n >= 4)
      break;
  }
  #assert(j == 5);
}

// 'return' recorded its PHI predecessor block before unwinding 'defer's,
// so a 'defer' containing control flow broke the PHI wiring.
int defer_with_branch(bool b) {
  int x = 1;
  defer {
    if (b) {
      x = 2;
    }
  }
  return x;
}

unit_test "Defer with control flow before return" {
  #assert(defer_with_branch(true) == 1);
  #assert(defer_with_branch(false) == 1);
}

// converting a wider union to a narrower one at 'return' emits control
// flow; 'createResult' used to splice it in front of an existing terminator.
(int | float) narrow_union(bool b) {
  (int | float | string) u = 1;
  if (b)
    return u;
  return 2;
}

int union_as_int(int x) = x;

unit_test "Union narrowing at return under if" {
  auto v0 = narrow_union(true);
  auto v1 = narrow_union(false);
  #assert(#typeOf(visit v0) == int);
  #assert(#typeOf(visit v1) == int);
  #assert(union_as_int(visit v0) == 1);
  #assert(union_as_int(visit v1) == 2);
}

// bool-typed 'case' constants were passed to the LLVM switch without
// conversion and failed IR verification.
unit_test "Switch case constants convert to int" {
  int k = 0;
  switch (1) {
  case true:
    k = 7;
    break;
  default: k = 9;
  }
  #assert(k == 7);
}

// constructing an array from a pointer to its element type compared the
// pointer type against the element type instead of the pointee, so the
// feature never fired.
unit_test "Construct array from pointer to element" {
  float[2] src = float[2](3.0, 4.0);
  auto p = &src[0];
  float[2] dst = float[2](p);
  #assert(dst[0] == 3.0 && dst[1] == 4.0);
}

// 'color' arguments to '#testFPClass' and '#atan2' crashed the
// compiler (invalid downcast / sanity abort).
unit_test "Color arguments to isfpclass and atan2" {
  // 96 = negative zero | positive zero, 256 = positive normal
  // '#any'/'#all' rather than '[0]' so the checks stay well-formed at
  // 'WAVELENGTH_BASE_MAX = 1', where the result is a scalar bool.
  #assert(!#any(#testFPClass(color(0.5), 96)));
  #assert(#all(#testFPClass(color(0.5), 256)));
  color c = #atan2(color(1.0), color(1.0));
  #assert(c[0] > 0.78 && c[0] < 0.79); // ~pi/4
}

// '#unpackFloat4' computed '1ULL << 64' (shift-by-width UB) for 64-bit
// texel types, producing an infinite scale factor.
unit_test "Finite unpack_float4 of 64-bit int" {
  auto u = #unpackFloat4(#getIntType(64)(3));
  #assert(u.x >= 0.0 && u.x < 1.0);
  #assert(u.w == 1.0);
}

// execs are now emitted pure, matching the C++ 'JIT::Function<void()>'
// signature; previously the JIT'd exec expected a '$state' pointer the
// caller never passed.
exec {
  #assert(1 + 1 == 2);
}

// The short-circuit logic operators are emitted through the shared
// two-arm-merge helper; guard both the truth table and the guarantee that
// the right-hand side does not evaluate when the left-hand side decides.
unit_test "Short-circuit logic operators" {
  int n = 0;
  bool f = false;
  bool r0 = f && ((n = n + 1) > 0);
  #assert(!r0 && n == 0);
  bool t = true;
  bool r1 = t || ((n = n + 1) > 0);
  #assert(r1 && n == 0);
  bool r2 = t && ((n = n + 1) > 0);
  #assert(r2 && n == 1);
  bool r3 = f || ((n = n + 1) > 1);
  #assert(r3 && n == 2);
}

// overload ranking never consulted the arguments, so for mutually implicitly
// convertible parameter types (like 'int'/'float') the earlier overload 
// silently won - an exact argument-type match lost to a conversion. The 
// 'float' overload is deliberately declared first: the old ranking picked 
// it for the integer call below.
@(pure)
int overload_rank(float x) {
  x; // Silence unused parameter warning
  return 1;
}

@(pure)
int overload_rank(int x) {
  x; // Silence unused parameter warning
  return 2;
}

unit_test "Exact overload match beats implicit conversion" {
  #assert(overload_rank(5) == 2);
  #assert(overload_rank(1.5) == 1);
}

// Inline expansion at module scope crashed the compiler. An initializer there
// is emitted with no LLVM insert point, on the understanding that it folds
// away, but a macro call or a struct constructor with a declared constructor
// goes through 'createFunctionImplementation', which needs a function to hold
// its blocks and hit an 'SMDL_SANITY_CHECK' when it tried to move the return
// block into a null one. This bit every module-scope 'texture_2d(...)', which
// is the natural way to declare a texture shared between materials.
//
// The expansion now happens in a scratch function that is discarded once the
// result is confirmed to be a compile-time constant, so what must hold is that
// the body folds away completely. A body that needs memory to do its work, such
// as a 'return_from' that mutates a local, still does not, and is reported as an
// error rather than crashing.
@(pure macro)
int module_scope_macro(const int x) = x + 1;

@(pure macro)
int module_scope_macro_branching(const int x) {
  if (x > 0) {
    return x;
  } else {
    return -x;
  }
}

// NOTE: Two parameters, so that this cannot be confused with the field-wise
// constructor and the declared one is genuinely the overload selected.
struct module_scope_ctor {
  module_scope_ctor(const int x, const int y) = module_scope_ctor(value: x * y);

  int value = 0;
};

const auto MODULE_SCOPE_MACRO = module_scope_macro(1);
const auto MODULE_SCOPE_BRANCHING = module_scope_macro_branching(-3);
const auto MODULE_SCOPE_CTOR = module_scope_ctor(6, 7);
const auto MODULE_SCOPE_TEXTURE = texture_2d("4x4.png", tex::gamma_linear);

unit_test "Inline expansion at module scope" {
  #assert(MODULE_SCOPE_MACRO == 2);
  #assert(MODULE_SCOPE_BRANCHING == 3);
  #assert(MODULE_SCOPE_CTOR.value == 42);

  // The texture must be genuinely loaded, not merely constructed without
  // crashing, and must behave the same as one built inside a function.
  #assert(tex::texture_isvalid(MODULE_SCOPE_TEXTURE));
  #assert(tex::width(MODULE_SCOPE_TEXTURE) == 4);
  #assert(tex::height(MODULE_SCOPE_TEXTURE) == 4);
  const auto local(texture_2d("4x4.png", tex::gamma_linear));
  for (int x = 0; x < 4; x++)
    for (int y = 0; y < 4; y++)
      #assert(#all(tex::texel_float4(MODULE_SCOPE_TEXTURE, int2(x, y)) ~== |1e-6| tex::texel_float4(local, int2(x, y))));
}

// The 'visit' statement's case binding took ownership of the visited
// storage: in the non-union case the binding is the visited variable's
// own alloca passed through verbatim, so the case scope's unwind emitted
// 'llvm.lifetime.end' on the variable at the end of every visit -- IR-level
// use-after-lifetime for all later uses, which optimization is entitled
// to turn into garbage once the alloca is big enough to stay in memory.
unit_test "Visit statement leaves the visited variable alive" {
  // Non-union: the ternary promotes int to float, so 'u' is a plain
  // float variable and the binding aliases its alloca directly.
  auto u = ($state.wavelength_min > 0.0) ? float(3.5) : int(7);
  float sum = 0.0;
  visit v in u {
    sum = sum + v;
  }
  visit v in u {
    sum = sum + v;
  }
  #assert(sum == 7.0);

  // Genuine optional union, visited twice and reused after: the case
  // pointer is derived storage either way, but pin the behavior.
  auto w = ($state.wavelength_min > 0.0) ? float(2.5) : none;
  float sum2 = 0.0;
  visit v in w {
    if $(!#isVoid(v)) {
      sum2 = sum2 + v;
    }
  }
  visit v in w {
    if $(!#isVoid(v)) {
      sum2 = sum2 + v;
    }
  }
  #assert(sum2 == 5.0);
  #assert(bool(w));
}
