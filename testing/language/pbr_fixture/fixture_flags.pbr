# Test fixture for the compile-time load flags of 'pbr_maps'. Every
# role reuses 'horizon_4x4.png' (constant per channel: 0.25, 0.5, 0.75,
# 1.0 in R, G, B, A), which is enough to test what the flags decide:
# which fields exist, and which textures carry mip levels. The 4x4
# extent means an opted-in map has exactly 3 levels.
#
# NOTE: Several manifests in one directory is fine only because every
# test loads them by explicit file path; loading the directory itself
# would hit the exactly-one-manifest rule of 'PBRMaps::resolveFileName'.
name: Flags Fixture
relief_scale: 0.25
basecolor:
  file: horizon_4x4.png
  color_space: linear
roughness:
  file: horizon_4x4.png
  channel: g
height:
  file: horizon_4x4.png
  channel: r
horizon:
  file: horizon_4x4.png
  max_slope: 4
class: horizon_4x4.png
