# Test fixture for '::extras::pbr' horizon map decoding. The horizon
# map is constant per channel: 0.25, 0.5, 0.75, 1.0 in R, G, B, A. The
# height role reuses the same image (R, so a constant 0.25), which also
# exercises sharing one file between roles in the image cache.
#
# NOTE: 'fixture_relief_scale.pbr' alongside this file spells the same
# relief scale directly. Two manifests in one directory is fine only
# because every test loads them by explicit file path; loading the
# directory itself would hit the exactly-one-manifest rule of
# 'PBRMaps::resolveFileName'.
name: Horizon Fixture
physical_extent: [2.0, 2.0]
physical_relief: 0.5
height:
  file: horizon_4x4.png
  channel: r
horizon:
  file: horizon_4x4.png
  max_slope: 4
