# Test fixture for the per-map remap facts: 'range' on the scalar
# roles and 'factor' on emission. Every role reuses 'horizon_4x4.png'
# (constant per channel: 0.25, 0.5, 0.75, 1.0 in R, G, B, A), so each
# decode has a closed form. 'fixture_remap_plain.pbr' alongside is the
# factor-free twin the emission assertions compare against.
name: Remap Fixture
roughness:
  file: horizon_4x4.png
  channel: r
  range: [0.1, 0.3]
metallic:
  file: horizon_4x4.png
  channel: b
  range: [1, 0]
emission:
  file: horizon_4x4.png
  color_space: linear
  factor: 2.0
