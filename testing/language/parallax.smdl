#smdl

import ::math::*;
import ::state::*;
import ::tex::*;
using parallax = ::extras::parallax;
import parallax::*;

// The march core with explicit view vectors and analytic height lambdas,
// where the intersections have closed forms; then the state wrappers under
// the default all-zero LOD state, where everything must be the identity.

unit_test "Parallax zero-state identity" {
  // No populated direction: the view vector is exactly zero, and every
  // wrapper returns its input untouched.
  #assert(#all(parallax::view_vector() == float3(0.0)));
  const float2 uv = float2(0.3, 0.7);
  const auto tex = texture_2d("4x4.png", tex::gamma_linear);
  #assert(#all(parallax::parallax_uv(tex, 0.05, uv) == uv));
  #assert(#all(parallax::parallax_uv(texture_2d(), 0.05, uv) == uv));
  // The core with a zero view is likewise the identity.
  #assert(#all(parallax::parallax_offset_with(\(const float2 c) = 0.5, uv, float3(0.0), 0.1) == uv));
}

unit_test "Parallax march on constant heights" {
  const float2 uv = float2(0.6, 0.4);
  const auto flat = \(const float2 c [[anno::unused()]]) = 0.25;
  // Straight-on view: zero slope, zero offset, at any depth.
  #assert(#all(parallax::parallax_offset_with(flat, uv, float3(0.0, 0.0, 1.0), 0.1) == uv));
  // Height 1 is the un-displaced surface: identity, exactly.
  const float3 v = math::normalize(float3(0.4, -0.2, 0.8));
  #assert(#all(parallax::parallax_offset_with(\(const float2 c [[anno::unused()]]) = 1.0, uv, v, 0.1) == uv));
  // Heights above 1 clamp to the surface: still the identity.
  #assert(#all(parallax::parallax_offset_with(\(const float2 c [[anno::unused()]]) = 1.5, uv, v, 0.1) == uv));
  // Constant height h: the secant refinement makes the march exact, so
  // the offset is -view.xy / view.z * scale * (1 - h) regardless of the
  // step count.
  const float scale = 0.1;
  const float2 expected = uv - v.xy / v.z * (scale * 0.75);
  const float2 got = parallax::parallax_offset_with(flat, uv, v, scale);
  #assert(math::abs(got.x - expected.x) < 1e-6);
  #assert(math::abs(got.y - expected.y) < 1e-6);
  const float2 coarse = parallax::parallax_offset_with(flat, uv, v, scale, 4, 4);
  const float2 fine = parallax::parallax_offset_with(flat, uv, v, scale, 64, 64);
  #assert(math::abs(coarse.x - fine.x) < 1e-6);
  #assert(math::abs(coarse.y - fine.y) < 1e-6);
}

unit_test "Parallax march on a linear ramp" {
  // Height 1 - k * u, i.e., depth k * u: the clearance is linear in the
  // layer, so the secant intersection is the closed form
  // l* = k * u0 / (1 + k * slope_x * scale) at any step count.
  const float k = 0.5;
  const auto ramp = \(const float2 c) = 1.0 - k * c.x;
  const float2 uv = float2(0.6, 0.4);
  const float scale = 0.2;
  const float3 v = math::normalize(float3(0.3, 0.0, 0.9));
  const float slope_x = v.x / v.z;
  const float l_star = k * uv.x / (1.0 + k * slope_x * scale);
  const float2 expected = uv - float2(slope_x, 0.0) * (scale * l_star);
  const float2 got = parallax::parallax_offset_with(ramp, uv, v, scale);
  #assert(math::abs(got.x - expected.x) < 1e-5);
  #assert(math::abs(got.y - expected.y) < 1e-5);
  // Step-count independence, again from the secant exactness.
  const float2 coarse = parallax::parallax_offset_with(ramp, uv, v, scale, 4, 4);
  #assert(math::abs(coarse.x - got.x) < 1e-5);
  #assert(math::abs(coarse.y - got.y) < 1e-5);
}

unit_test "Parallax guards" {
  const float2 uv = float2(0.5, 0.5);
  const auto flat = \(const float2 c [[anno::unused()]]) = 0.5;
  // Backface views are the identity.
  #assert(#all(parallax::parallax_offset_with(flat, uv, float3(0.0, 0.0, -1.0), 0.1) == uv));
  // Non-positive scales are the identity.
  #assert(#all(parallax::parallax_offset_with(flat, uv, float3(0.0, 0.0, 1.0), 0.0) == uv));
  #assert(#all(parallax::parallax_offset_with(flat, uv, math::normalize(float3(0.4, 0.0, 0.8)), -0.1) == uv));
  // Near the view floor the slope caps at PARALLAX_MAX_SLOPE, so the offset
  // for constant depth d is exactly PARALLAX_MAX_SLOPE * scale * d.
  const float3 oblique = math::normalize(float3(1.0, 0.0, 0.06));
  const float scale = 0.01;
  const float2 got = parallax::parallax_offset_with(flat, uv, oblique, scale);
  #assert(math::length(got - uv) <= parallax::PARALLAX_MAX_SLOPE * scale * 0.5 + 1e-6);
  #assert(math::abs((uv.x - got.x) - parallax::PARALLAX_MAX_SLOPE * scale * 0.5) < 1e-6);
  // At and below PARALLAX_MIN_VIEW_Z the view Z clamps up to the floor
  // instead of cutting to the identity, so grazing views land on the same
  // saturated plateau: no discontinuity at the floor.
  const float2 grazing = parallax::parallax_offset_with(flat, uv, math::normalize(float3(1.0, 0.0, 0.03)), scale);
  const float2 extreme = parallax::parallax_offset_with(flat, uv, math::normalize(float3(1.0, 0.0, 1.0e-4)), scale);
  #assert(math::abs(grazing.x - got.x) < 1e-6);
  #assert(math::abs(grazing.y - got.y) < 1e-6);
  #assert(math::abs(extreme.x - got.x) < 1e-6);
  #assert(math::abs(extreme.y - got.y) < 1e-6);
}

unit_test "Parallax horizon slopes" {
  const float2 uv = float2(0.5, 0.5);
  // Constant heights have no horizon anywhere, exactly (including
  // out-of-range heights, which clamp before differencing).
  #assert(#all(parallax::horizon_slopes_with(\(const float2 c [[anno::unused()]]) = 0.5, uv, 0.1) == float4(0.0)));
  #assert(#all(parallax::horizon_slopes_with(\(const float2 c [[anno::unused()]]) = 1.5, uv, 0.1) == float4(0.0)));
  // Non-positive scale is the off switch, regardless of the field.
  #assert(#all(parallax::horizon_slopes_with(\(const float2 c) = c.x, uv, 0.0) == float4(0.0)));
  #assert(#all(parallax::horizon_slopes_with(\(const float2 c) = c.x, uv, -1.0) == float4(0.0)));

  // A step blocker toward +U only, its edge exactly on a sample distance
  // (the defaults place samples at 0.25 / 2^k): the +U slope is exactly
  // scale * (1 - h0) / d from that sample, and every other direction
  // sees flat ground.
  const float d = 0.03125;
  const float scale = 0.1;
  const auto step = \(const float2 c) = c.x >= uv.x + d ? 1.0 : 0.2;
  const auto s1 = parallax::horizon_slopes_with(step, uv, scale);
  #assert(math::abs(s1.x - scale * 0.8 / d) < 1e-5);
  #assert((s1.y == 0.0) & (s1.z == 0.0) & (s1.w == 0.0));

  // An uphill ramp toward +U: the blocker slope is the same at every
  // sample distance, so the marched slope is exactly scale * k, and the
  // downhill -U direction clamps to zero.
  const float k = 2.0;
  const auto ramp = \(const float2 c) = 0.2 + k * (c.x - uv.x);
  const auto s2 = parallax::horizon_slopes_with(ramp, uv, scale);
  #assert(math::abs(s2.x - scale * k) < 1e-5);
  #assert(s2.y == 0.0);

  // A wall at the nearest sample would exceed PARALLAX_MAX_SLOPE; the result caps
  // there, consistent with the march's own slope cap.
  const auto wall = \(const float2 c) = c.x >= uv.x + 0.001 ? 1.0 : 0.0;
  #assert(parallax::horizon_slopes_with(wall, uv, scale).x == parallax::PARALLAX_MAX_SLOPE);
}

unit_test "Parallax perturbed normal" {
  const float2 uv = float2(0.5, 0.5);
  // Constant heights give the shading normal back to normalization
  // precision. (Not bit-exactly: fast-math lowers `normalize` through an
  // approximate rsqrt, so even a unit vector moves by an ulp or so.)
  const float3 n0 = parallax::perturbed_normal_with(\(const float2 c [[anno::unused()]]) = 0.25, uv, 0.5, float2(0.01));
  #assert(#all(math::abs(n0 - state::normal()) < float3(1e-6)));
  // The guard paths return the shading normal untouched, bit-exactly.
  #assert(#all(parallax::perturbed_normal_with(\(const float2 c) = c.x, uv, 0.5, float2(0.0)) == state::normal()));
  #assert(#all(parallax::perturbed_normal(texture_2d(), 0.5, uv) == state::normal()));
  // A linear ramp has an exact central difference, so the normal is the
  // closed-form slope normal. The default test state tangent frame is the
  // identity, so the tangent-frame normal passes through unchanged.
  const float a = 0.25;
  const float scale = 0.4;
  const float3 expected = math::normalize(float3(-scale * a, 0.0, 1.0));
  const float3 got = parallax::perturbed_normal_with(\(const float2 c) = a * c.x, uv, scale, float2(0.01));
  #assert(math::abs(got.x - expected.x) < 1e-6);
  #assert(math::abs(got.y - expected.y) < 1e-6);
  #assert(math::abs(got.z - expected.z) < 1e-6);
}

unit_test "Parallax march refinement and jitter" {
  // A curved (quadratic) height field: depth k*x^2 bends within a
  // layer, so the single secant of the coarse march leaves a residual
  // clearance -- the per-layer error that shows up as banding on steep
  // relief. The false-position refinement must drive that residual to
  // (near) zero. The residual is measured directly: recover the layer
  // from the returned offset and compare against the field.
  const float k = 0.8;
  const auto bowl = \(const float2 c) = 1.0 - k * c.x * c.x;
  const float2 uv = float2(0.7, 0.5);
  const float scale = 0.3;
  const float3 v = math::normalize(float3(0.5, 0.0, 0.8));
  const float s = v.x / v.z;
  const auto residual = \(const float2 p) {
    const float l = (uv.x - p.x) / (s * scale);
    return math::abs(l - k * p.x * p.x);
  };
  // Two coarse layers, no refinement vs. three refinement passes.
  const auto coarse = parallax::parallax_offset_with(bowl, uv, v, scale, 2, 2, 0.0, 0);
  const auto refined = parallax::parallax_offset_with(bowl, uv, v, scale, 2, 2, 0.0, 3);
  #assert(residual(coarse) > 1e-4);
  #assert(residual(refined) < 1e-5);
  #assert(residual(refined) < residual(coarse));

  // On fields where the secant is already exact -- constant heights and
  // linear ramps -- the jittered layer grid is a provable no-op, so any
  // per-sample jitter fed by a renderer cannot disturb them.
  const auto flat = \(const float2 c [[anno::unused()]]) = 0.25;
  const float2 expectFlat = uv - v.xy / v.z * (scale * 0.75);
  const auto ramp = \(const float2 c) = 1.0 - 0.5 * c.x;
  const float lRamp = 0.5 * uv.x / (1.0 + 0.5 * s * scale);
  const float2 expectRamp = uv - float2(s, 0.0) * (scale * lRamp);
  for (int j = 0; j < 3; j++) {
    const float xi = float(j) * 0.33;
    const auto gotFlat = parallax::parallax_offset_with(flat, uv, v, scale, 8, 8, xi);
    #assert(math::length(gotFlat - expectFlat) < 1e-5);
    const auto gotRamp = parallax::parallax_offset_with(ramp, uv, v, scale, 8, 8, xi);
    #assert(math::length(gotRamp - expectRamp) < 1e-5);
  }
}

// The hierarchical march over a maximum mip chain. The ridge fixture is a
// 16x16 field at height 0.2 with a one-texel wall at x = 8 (height 1.0),
// so along u the bilinear field ramps from 0.2 at texel center 7.5 to 1.0
// at 8.5 and back down to 0.2 at 9.5. A ray entering at texel X0 with
// slope s (UV per unit depth) sits at X(l) = X0 + 16 s l and height 1 - l,
// and meets the up-ramp where 1 - l = 0.2 + 0.8 (X(l) - 7.5).

unit_test "Maximum chain bounds the ridge" {
  const auto ridge = texture_2d("relief_fixture/ridge_16.png", tex::gamma_linear, max_mipmap: true);
  #assert(ridge.max_mipmap);
  #assert(ridge.num_levels == 5);
  #assert(#all(tex::level_extent(ridge, 1) == int2(8)));
  #assert(#all(tex::level_extent(ridge, 4) == int2(1)));
  // Level 1 cell c covers texels [2c - 1, 2c + 2]: cells 3 and 4 see the
  // wall at texel 8, cells 2 and 5 do not.
  #assert(tex::level_texel_float(ridge, 1, int2(3, 2)) == 1.0);
  #assert(tex::level_texel_float(ridge, 1, int2(4, 2)) == 1.0);
  #assert(math::abs(tex::level_texel_float(ridge, 1, int2(2, 2)) - 0.2) < 1e-6);
  #assert(math::abs(tex::level_texel_float(ridge, 1, int2(5, 2)) - 0.2) < 1e-6);
  // Level 2 cell c covers [4c - 1, 4c + 4]; the wrapped border of the
  // last cell reaches texel 0, which is flat.
  #assert(tex::level_texel_float(ridge, 2, int2(1, 0)) == 1.0);
  #assert(tex::level_texel_float(ridge, 2, int2(2, 0)) == 1.0);
  #assert(math::abs(tex::level_texel_float(ridge, 2, int2(0, 0)) - 0.2) < 1e-6);
  #assert(math::abs(tex::level_texel_float(ridge, 2, int2(3, 0)) - 0.2) < 1e-6);
  // The coarsest levels see the wall everywhere, and the cell index wraps.
  #assert(tex::level_texel_float(ridge, 3, int2(0, 0)) == 1.0);
  #assert(tex::level_texel_float(ridge, 4, int2(7, -3)) == 1.0);
  #assert(tex::level_texel_float(ridge, 1, int2(11, 0)) == tex::level_texel_float(ridge, 1, int2(3, 0)));
  // Level 0 is the image itself.
  #assert(tex::level_texel_float(ridge, 0, int2(8, 5)) == 1.0);
  #assert(math::abs(tex::level_texel_float(ridge, 0, int2(7, 5)) - 0.2) < 1e-6);
}

unit_test "Hierarchical march hits the ridge where the layer march tunnels" {
  const auto ridge = texture_2d("relief_fixture/ridge_16.png", tex::gamma_linear, max_mipmap: true);
  const float scale = 0.5;
  // From X0 = 4 with s = 2 (view.xy / view.z = (-4, 0), so the surface
  // ray runs toward +u): the up-ramp is met at l = 3.6 / 26.6.
  const float2 uv = float2(0.25, 0.5);
  const float3 v = math::normalize(float3(-4.0, 0.0, 1.0));
  const float l_star = 3.6 / 26.6;
  const float2 got = parallax::parallax_offset_max(ridge, uv, v, scale);
  #assert(math::abs(got.x - (uv.x + 2.0 * l_star)) < 1e-4);
  #assert(got.y == uv.y);
  // Eight fixed layers step clean over the two-texel wall and land on
  // its next repetition, one full tile later.
  const auto field = \(const float2 c) = tex::lookup_float(ridge, c);
  const float2 layered = parallax::parallax_offset_with(field, uv, v, scale, 8, 8);
  #assert(layered.x > uv.x + 1.0);
  // A shallower ray (s = 1/2) reaches the ramp deeper, at l = 3.6 / 7.4.
  const float3 v_half = math::normalize(float3(-1.0, 0.0, 1.0));
  const float2 got_half = parallax::parallax_offset_max(ridge, uv, v_half, scale);
  #assert(math::abs(got_half.x - (uv.x + 0.5 * 3.6 / 7.4)) < 1e-4);
  // A diagonal ray crosses a v cell per u cell and meets the same wall at
  // the same depth, since the field is constant along v.
  const float3 v_diag = math::normalize(float3(-4.0, -4.0, 1.0));
  const float2 got_diag = parallax::parallax_offset_max(ridge, uv, v_diag, scale);
  #assert(math::abs(got_diag.x - (uv.x + 2.0 * l_star)) < 1e-4);
  #assert(math::abs(got_diag.y - (uv.y + 2.0 * l_star)) < 1e-4);
  // A ray toward -u from X0 = 12 meets the down-ramp (texel centers 9.5
  // to 8.5) where 1 - l = 0.2 + 0.8 (9.5 - (12 - 32 l)).
  const float3 v_back = math::normalize(float3(4.0, 0.0, 1.0));
  const float2 got_back = parallax::parallax_offset_max(ridge, float2(0.75, 0.5), v_back, scale);
  #assert(math::abs(got_back.x - (0.75 - 2.0 * 2.8 / 26.6)) < 1e-4);
}

unit_test "Hierarchical march wraps and clamps" {
  const auto ridge = texture_2d("relief_fixture/ridge_16.png", tex::gamma_linear, max_mipmap: true);
  const float scale = 0.5;
  const float3 v = math::normalize(float3(-4.0, 0.0, 1.0));
  // From X0 = 14.4 under repeat the wall is met one tile over, where
  // 1 - l = 0.2 + 0.8 (14.4 + 32 l - 23.5).
  const float2 uv = float2(0.9, 0.5);
  const float2 wrapped = parallax::parallax_offset_max(ridge, uv, v, scale);
  #assert(math::abs(wrapped.x - (uv.x + 2.0 * 8.08 / 26.6)) < 1e-4);
  // Under clamp the field past the edge holds the edge texel's 0.2, so
  // the ray bottoms out on the flat at l = 0.8.
  const float2 clamped = parallax::parallax_offset_max(ridge, uv, v, scale, tex::wrap_clamp, tex::wrap_clamp);
  #assert(math::abs(clamped.x - (uv.x + 2.0 * 0.8)) < 1e-4);
  // Starting outside the image under clamp, the ray crosses the flat edge
  // region, enters, and meets the wall as if it had started inside:
  // X(l) = -4 + 32 l meets the up-ramp where 1 - l = 0.2 + 0.8 (32 l - 11.5).
  const float2 outside = float2(-0.25, 0.5);
  const float2 entered = parallax::parallax_offset_max(ridge, outside, v, scale, tex::wrap_clamp, tex::wrap_clamp);
  #assert(math::abs(entered.x - (outside.x + 2.0 * 10.0 / 26.6)) < 1e-4);
}

unit_test "Hierarchical march finds the first crossing" {
  // On a rough field with no closed form, the march must return a point
  // on the surface that no earlier point of the ray is below: the
  // definition of the first crossing, checked by dense sampling.
  const auto bumps = texture_2d("relief_fixture/bumps_32.png", tex::gamma_linear, max_mipmap: true);
  #assert(bumps.max_mipmap);
  const auto field = \(const float2 c) = math::saturate(tex::lookup_float(bumps, c));
  // smdl format off
  const auto views = auto[](
    math::normalize(float3(-4.0, 1.0, 1.0)), math::normalize(float3(0.3, -0.7, 0.8)),
    math::normalize(float3(2.0, 2.0, 0.3)), math::normalize(float3(-0.05, 0.02, 1.0)),
    math::normalize(float3(7.0, -3.0, 1.0)), math::normalize(float3(0.0, 1.0, 0.5)));
  const auto coords = auto[](float2(0.1, 0.2), float2(0.53, 0.91), float2(0.99, 0.5), float2(0.37, 0.005));
  // smdl format on
  const float scale = 0.3;
  for (int k = 0; k < 6; k++) {
    for (int j = 0; j < 4; j++) {
      const float3 v = views[k];
      const float2 uv = coords[j];
      const float2 got = parallax::parallax_offset_max(bumps, uv, v, scale);
      // Recover the depth from the offset (the slope is what the march
      // used, cap included).
      float2 slope = v.xy / #max(v.z, parallax::PARALLAX_MIN_VIEW_Z);
      const float slope_len = math::length(slope);
      slope *= slope_len > parallax::PARALLAX_MAX_SLOPE ? parallax::PARALLAX_MAX_SLOPE / slope_len : 1.0;
      slope *= scale;
      const float l_star = math::length(uv - got) / math::length(slope);
      #assert(l_star >= 0.0);
      #assert(l_star <= 1.0 + 1e-6);
      // On the surface: the field at the hit equals the ray height there,
      // within the patch solve's tolerance.
      #assert(math::abs(field(got) - (1.0 - l_star)) < 2e-3);
      // And above it everywhere before: the field never exceeds the ray.
      for (int i = 0; i < 400; i++) {
        const float l = l_star * (float(i) + 0.5) / 400.0;
        #assert(field(uv - slope * l) < 1.0 - l + 2e-3);
      }
    }
  }
}

unit_test "Hierarchical march guards" {
  const auto ridge = texture_2d("relief_fixture/ridge_16.png", tex::gamma_linear, max_mipmap: true);
  const float2 uv = float2(0.3, 0.6);
  // The same guards as the layer march: backfaces, non-positive scale, an
  // invalid texture, and a surface already at its reference height.
  #assert(#all(parallax::parallax_offset_max(ridge, uv, float3(0.0, 0.0, -1.0), 0.1) == uv));
  #assert(#all(parallax::parallax_offset_max(ridge, uv, float3(0.0, 0.0, 1.0), 0.0) == uv));
  #assert(#all(parallax::parallax_offset_max(ridge, uv, math::normalize(float3(0.4, 0.0, 0.8)), -0.1) == uv));
  #assert(#all(parallax::parallax_offset_max(texture_2d(), uv, math::normalize(float3(0.4, 0.0, 0.8)), 0.1) == uv));
  const float2 on_wall = float2(8.5 / 16.0, 0.5);
  #assert(#all(parallax::parallax_offset_max(ridge, on_wall, math::normalize(float3(0.4, 0.0, 0.8)), 0.1) == on_wall));
  // Straight down there is no offset: the ray bottoms out on the flat at
  // depth 0.8 under the entry point.
  #assert(#all(parallax::parallax_offset_max(ridge, uv, float3(0.0, 0.0, 1.0), 0.1) == uv));
  // A capped traversal stops above the surface, never below it.
  const float3 v = math::normalize(float3(-4.0, 0.0, 1.0));
  const float2 capped = parallax::parallax_offset_max(ridge, float2(0.25, 0.5), v, 0.5, max_steps: 2);
  const float l_capped = (capped.x - 0.25) / 2.0;
  #assert(l_capped >= 0.0);
  #assert(l_capped <= 3.6 / 26.6 + 1e-6);
}

unit_test "parallax_uv selects the march by the chain" {
  // A populated direction with the identity tangent frame of the test
  // state: the view vector is the negated direction.
  const float3 v = math::normalize(float3(-4.0, 0.0, 1.0));
  $state.direction = -v;
  defer $state.direction = float3(0.0);
  #assert(#all(parallax::view_vector() ~== |1e-6| v));
  const float2 uv = float2(0.25, 0.5);
  const float scale = 0.5;
  const auto ridge_max = texture_2d("relief_fixture/ridge_16.png", tex::gamma_linear, max_mipmap: true);
  // An image holds one chain, so the mean-chain texture is over a file
  // no test wants a maximum chain for.
  const auto steps_mean = texture_2d("4x4.png", tex::gamma_linear, use_mipmap: true);
  #assert(!steps_mean.max_mipmap);
  // A maximum chain takes the hierarchical march.
  #assert(#all(parallax::parallax_uv(ridge_max, scale, uv) == parallax::parallax_offset_max(ridge_max, uv, v, scale)));
  // A mean chain takes the layer march with the given layer parameters.
  const auto field = \(const float2 c) = tex::lookup_float(steps_mean, c);
  #assert(#all(parallax::parallax_uv(steps_mean, scale, uv, min_steps: 4, max_steps: 4) == parallax::parallax_offset_with(field, uv, v, scale, 4, 4)));
  // So does a maximum chain under a wrap mode the traversal does not take.
  const auto field_mirror = \(const float2 c) = tex::lookup_float(ridge_max, c, tex::wrap_mirrored_repeat, tex::wrap_mirrored_repeat);
  #assert(#all(parallax::parallax_uv(ridge_max, scale, uv, wrap_u: tex::wrap_mirrored_repeat, wrap_v: tex::wrap_mirrored_repeat) == parallax::parallax_offset_with(field_mirror, uv, v, scale)));
}

// The light-side march: `relief_visible()` runs the same traversal upward
// from the surface point, so a light direction is either clear of the
// relief or not. On the ridge, from the flat at texel 4 toward the wall,
// the ray starts at height 0.2 + bias and rises e / 8 per texel for a
// light at elevation slope e (scale 0.5, 8 texels per unit height at
// e = 1), so it clears the top of the wall 4.5 texels away exactly when
// 0.22 + 4.5 e / 8 > 1, i.e. above e = 1.3867.

unit_test "Relief visibility on the ridge" {
  const auto ridge = texture_2d("relief_fixture/ridge_16.png", tex::gamma_linear, max_mipmap: true);
  const float2 uv = float2(0.25, 0.5);
  const float scale = 0.5;
  const auto toward = \(const float e) = math::normalize(float3(1.0, 0.0, e));
  const auto away = \(const float e) = math::normalize(float3(-1.0, 0.0, e));
  #assert(!parallax::relief_visible(ridge, uv, toward(1.3), scale));
  #assert(parallax::relief_visible(ridge, uv, toward(1.5), scale));
  // Away from the wall the field repeats: the previous wall's far face
  // is 10.5 texels off, met by a grazing light and topped out over by a
  // higher one.
  #assert(!parallax::relief_visible(ridge, uv, away(0.3), scale));
  #assert(parallax::relief_visible(ridge, uv, away(1.0), scale));
  // Along V the field is constant; straight up nothing occludes.
  #assert(parallax::relief_visible(ridge, uv, math::normalize(float3(0.0, 1.0, 0.3)), scale));
  #assert(parallax::relief_visible(ridge, uv, float3(0.0, 0.0, 1.0), scale));
  // Just past the wall, a light from over the wall is blocked at once.
  #assert(!parallax::relief_visible(ridge, float2(10.0 / 16.0, 0.5), away(1.0), scale));
  #assert(parallax::relief_visible(ridge, float2(10.0 / 16.0, 0.5), toward(1.0), scale));
  // A larger bias lifts the start of the ray, so the threshold moves down.
  #assert(parallax::relief_visible(ridge, uv, toward(1.3), scale, bias: 0.1));
  // Under clamp the field past the edge is flat, so from near the edge
  // toward it nothing occludes, while the wall behind still does.
  const float2 edge = float2(0.9, 0.5);
  #assert(parallax::relief_visible(ridge, edge, toward(0.2), scale, tex::wrap_clamp, tex::wrap_clamp));
  #assert(!parallax::relief_visible(ridge, edge, toward(0.2), scale));
  #assert(!parallax::relief_visible(ridge, edge, away(0.5), scale, tex::wrap_clamp, tex::wrap_clamp));
  // The guards: below the tangent plane, non-positive scale or bias, an
  // invalid texture or one without a maximum chain, and a point at the
  // un-displaced surface are all visible.
  #assert(parallax::relief_visible(ridge, uv, float3(1.0, 0.0, 0.0), scale));
  #assert(parallax::relief_visible(ridge, uv, math::normalize(float3(1.0, 0.0, -0.5)), scale));
  #assert(parallax::relief_visible(ridge, uv, toward(0.5), 0.0));
  #assert(parallax::relief_visible(ridge, uv, toward(0.5), scale, bias: 0.0));
  #assert(parallax::relief_visible(texture_2d(), uv, toward(0.5), scale));
  #assert(parallax::relief_visible(texture_2d("relief_fixture/ridge_16.png", tex::gamma_linear), uv, toward(0.5), scale));
  #assert(parallax::relief_visible(ridge, float2(8.5 / 16.0, 0.5), toward(0.5), scale));
}

unit_test "Relief visibility agrees with dense sampling" {
  // On the rough field, the answer must agree with a dense sample of the
  // shadow ray wherever that sample is decisive: occluded when the field
  // clearly rises above the ray somewhere, visible when it clearly never
  // does.
  const auto bumps = texture_2d("relief_fixture/bumps_32.png", tex::gamma_linear, max_mipmap: true);
  const auto field = \(const float2 c) = math::saturate(tex::lookup_float(bumps, c));
  const float scale = 0.3;
  const float bias = 0.02;
  int decided = 0;
  int occluded = 0;
  for (int a = 0; a < 12; a++) {
    for (int e = 1; e <= 5; e++) {
      for (int j = 0; j < 3; j++) {
        const float phi = 2.0 * $PI * (float(a) + 0.5) / 12.0;
        const float3 wi = math::normalize(float3(math::cos(phi), math::sin(phi), 0.25 * e));
        const float2 uv = float2(0.13 + 0.3 * j, 0.71 - 0.2 * j);
        const bool visible = parallax::relief_visible(bumps, uv, wi, scale, bias: bias);
        float2 slope = wi.xy / #max(wi.z, parallax::PARALLAX_MIN_VIEW_Z);
        const float slope_len = math::length(slope);
        slope *= slope_len > parallax::PARALLAX_MAX_SLOPE ? parallax::PARALLAX_MAX_SLOPE / slope_len : 1.0;
        slope *= scale;
        const float start = field(uv) + bias;
        const float t_end = 1.0 - start;
        float worst = -1.0;
        for (int i = 0; i < 800; i++) {
          const float t = t_end * (float(i) + 0.5) / 800.0;
          worst = #max(worst, field(uv + slope * t) - (start + t));
        }
        if (worst > 2e-3) {
          #assert(!visible);
          decided += 1;
          occluded += 1;
        } else if (worst < -2e-3) {
          #assert(visible);
          decided += 1;
        }
      }
    }
  }
  #assert(decided > 120);
  #assert(occluded > 20);
  #assert(occluded < decided);
}
